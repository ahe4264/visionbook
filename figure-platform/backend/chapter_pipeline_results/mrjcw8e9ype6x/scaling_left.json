  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; width:100%; height:100%; background:#fff; }\n.interactive { cursor:pointer; }\n.shape-hover { transition: stroke-width 0.15s ease, opacity 0.15s ease; }\n.shape-hover:hover { stroke-width:4.5; }\n.text-hover { transition: opacity 0.15s ease; cursor:pointer; }\n.text-hover:hover { opacity:0.7; }\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  display:none;\n}\n</style>\n</head>\n<body>\n<svg id=\"fig\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 600\" preserveAspectRatio=\"xMidYMid meet\" aria-label=\"Unit square centered at the origin on Cartesian axes\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"12\" markerHeight=\"12\" refX=\"11\" refY=\"6\" orient=\"auto\">\n      <path d=\"M0,0 L0,12 L12,6 z\" fill=\"#000000\"></path>\n    </marker>\n  </defs>\n\n  <rect\n    id=\"unitSquare\"\n    class=\"interactive shape-hover\"\n    x=\"161\"\n    y=\"215\"\n    width=\"224\"\n    height=\"224\"\n    fill=\"#ff8000\"\n    stroke=\"#000000\"\n    stroke-width=\"3\"\n    data-tip=\"Unit square — original region before scaling\"\n    data-popup-title=\"Unit square\"\n    data-popup-body=\"This orange square is centered at the origin and spans from x = -1 to x = 1 and from y = -1 to y = 1. It represents the starting shape before any scaling transformation changes its size or proportions.\">\n  </rect>\n\n  <line\n    id=\"xAxis\"\n    class=\"interactive shape-hover\"\n    x1=\"0\"\n    y1=\"327\"\n    x2=\"542\"\n    y2=\"327\"\n    stroke=\"#000000\"\n    stroke-width=\"3\"\n    marker-end=\"url(#arr)\"\n    data-tip=\"x-axis — horizontal coordinate direction\"\n    data-popup-title=\"x-axis\"\n    data-popup-body=\"The x-axis measures horizontal position. Points to the right of the y-axis have positive x-values, while points to the left have negative x-values.\">\n  </line>\n\n  <line\n    id=\"yAxis\"\n    class=\"interactive shape-hover\"\n    x1=\"273\"\n    y1=\"600\"\n    x2=\"273\"\n    y2=\"48\"\n    stroke=\"#000000\"\n    stroke-width=\"3\"\n    marker-end=\"url(#arr)\"\n    data-tip=\"y-axis — vertical coordinate direction\"\n    data-popup-title=\"y-axis\"\n    data-popup-body=\"The y-axis measures vertical position. Points above the x-axis have positive y-values, while points below it have negative y-values.\">\n  </line>\n\n  <text\n    id=\"xTickMinus\"\n    class=\"interactive text-hover\"\n    x=\"152\"\n    y=\"337\"\n    text-anchor=\"end\"\n    font-family=\"Times New Roman, serif\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"x = -1 — left side of the square\"\n    data-popup-title=\"x = -1\"\n    data-popup-body=\"This label marks the left vertical edge of the square. Every point on that edge has horizontal coordinate x = -1.\">-1</text>\n\n  <text\n    id=\"xTickPlus\"\n    class=\"interactive text-hover\"\n    x=\"394\"\n    y=\"337\"\n    text-anchor=\"start\"\n    font-family=\"Times New Roman, serif\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"x = 1 — right side of the square\"\n    data-popup-title=\"x = 1\"\n    data-popup-body=\"This label marks the right vertical edge of the square. Every point on that edge has horizontal coordinate x = 1.\">1</text>\n\n  <text\n    id=\"yTickPlus\"\n    class=\"interactive text-hover\"\n    x=\"260\"\n    y=\"205\"\n    text-anchor=\"end\"\n    font-family=\"Times New Roman, serif\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"y = 1 — top side of the square\"\n    data-popup-title=\"y = 1\"\n    data-popup-body=\"This label marks the top horizontal edge of the square. Every point on that edge has vertical coordinate y = 1.\">1</text>\n\n  <text\n    id=\"yTickMinus\"\n    class=\"interactive text-hover\"\n    x=\"260\"\n    y=\"476\"\n    text-anchor=\"end\"\n    font-family=\"Times New Roman, serif\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"y = -1 — bottom side of the square\"\n    data-popup-title=\"y = -1\"\n    data-popup-body=\"This label marks the bottom horizontal edge of the square. Every point on that edge has vertical coordinate y = -1.\">-1</text>\n\n  <text\n    id=\"xLabel\"\n    class=\"interactive text-hover\"\n    x=\"528\"\n    y=\"386\"\n    text-anchor=\"start\"\n    font-family=\"Times New Roman, serif\"\n    font-style=\"italic\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"x — horizontal coordinate variable\"\n    data-popup-title=\"x\"\n    data-popup-body=\"The symbol x names the horizontal coordinate. A scaling transformation can stretch or compress this coordinate direction independently of the y direction.\">x</text>\n\n  <text\n    id=\"yLabel\"\n    class=\"interactive text-hover\"\n    x=\"252\"\n    y=\"45\"\n    text-anchor=\"middle\"\n    font-family=\"Times New Roman, serif\"\n    font-style=\"italic\"\n    font-size=\"24\"\n    fill=\"#000000\"\n    data-tip=\"y — vertical coordinate variable\"\n    data-popup-title=\"y\"\n    data-popup-body=\"The symbol y names the vertical coordinate. In a scaling transformation, changing y-values stretches or compresses the shape vertically.\">y</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('fig');\n  const tt = document.getElementById('tooltip');\n  const square = document.getElementById('unitSquare');\n  const xAxis = document.getElementById('xAxis');\n  const yAxis = document.getElementById('yAxis');\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title:title, body:body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  document.addEventListener('mousemove', function(e) {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  const interactive = svg.querySelectorAll('.interactive');\n  interactive.forEach(function(el) {\n    el.addEventListener('mouseenter', function() {\n      const tip = el.getAttribute('data-tip');\n      if (tip) {\n        tt.textContent = tip;\n        tt.style.display = 'block';\n      }\n    });\n\n    el.addEventListener('mouseleave', function() {\n      tt.style.display = 'none';\n    });\n\n    el.addEventListener('click', function(e) {\n      e.stopPropagation();\n      const title = el.getAttribute('data-popup-title') || '';\n      const body = el.getAttribute('data-popup-body') || '';\n      showPopup(title, body);\n      if (el.id === 'unitSquare' || el.id === 'xAxis' || el.id === 'yAxis') {\n        runInitialStateSequence();\n      }\n    });\n  });\n\n  svg.addEventListener('click', function(e) {\n    if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n  });\n\n  let timers = [];\n  function clearTimers() {\n    timers.forEach(function(t) { clearTimeout(t); });\n    timers = [];\n  }\n\n  function resetVisuals() {\n    square.style.fill = '#ff8000';\n    square.style.stroke = '#000000';\n    square.style.strokeWidth = '3';\n    xAxis.style.stroke = '#000000';\n    xAxis.style.strokeWidth = '3';\n    yAxis.style.stroke = '#000000';\n    yAxis.style.strokeWidth = '3';\n  }\n\n  function runInitialStateSequence() {\n    clearTimers();\n    resetVisuals();\n\n    square.style.transition = 'fill 0.35s ease, stroke 0.35s ease, stroke-width 0.35s ease';\n    xAxis.style.transition = 'stroke 0.35s ease, stroke-width 0.35s ease';\n    yAxis.style.transition = 'stroke 0.35s ease, stroke-width 0.35s ease';\n\n    timers.push(setTimeout(function() {\n      xAxis.style.stroke = '#3b6fc4';\n      xAxis.style.strokeWidth = '4.5';\n      yAxis.style.stroke = '#3b6fc4';\n      yAxis.style.strokeWidth = '4.5';\n    }, 40));\n\n    timers.push(setTimeout(function() {\n      square.style.fill = '#c8f0c8';\n      square.style.stroke = '#2c7a2c';\n      square.style.strokeWidth = '4.5';\n    }, 520));\n\n    timers.push(setTimeout(function() {\n      resetVisuals();\n    }, 1400));\n  }\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
