  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { width:100%; height:100%; display:block; background:#fff; }\n.mathText { font-family:\"Times New Roman\", Times, serif; font-size:18; fill:#111; user-select:none; }\n.axisLabel { font-family:\"Times New Roman\", Times, serif; font-size:18; font-style:italic; fill:#111; user-select:none; }\n.hoverable { cursor:pointer; }\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  display:none;\n}\n</style>\n</head>\n<body>\n<svg id=\"fig\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 600\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Unit square centered at the origin\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"12\" markerHeight=\"12\" refX=\"11\" refY=\"6\" orient=\"auto\">\n      <path d=\"M0,0 L0,12 L12,6 z\" fill=\"#000000\"/>\n    </marker>\n  </defs>\n\n  <rect id=\"background\" x=\"0\" y=\"0\" width=\"600\" height=\"600\" fill=\"#ffffff\"/>\n\n  <rect id=\"unitSquareFill\"\n        class=\"hoverable\"\n        x=\"133.333333\" y=\"133.333333\" width=\"333.333333\" height=\"333.333333\"\n        fill=\"#ff8000\"\n        data-tip=\"Unit square — all points with -1 ≤ x ≤ 1 and -1 ≤ y ≤ 1\"\n        data-title=\"Unit square\"\n        data-body=\"The orange region represents the square centered at the origin. Its sides lie at x = -1, x = 1, y = -1, and y = 1, so every point inside satisfies both coordinate bounds.\"/>\n\n  <line id=\"xAxis\"\n        class=\"hoverable\"\n        x1=\"0\" y1=\"300\" x2=\"576\" y2=\"300\"\n        stroke=\"#000000\" stroke-width=\"3\" marker-end=\"url(#arr)\"\n        data-tip=\"x-axis — horizontal coordinate direction\"\n        data-title=\"x-axis\"\n        data-body=\"The x-axis measures horizontal position. Moving right increases x, and the square reaches from x = -1 to x = 1.\"/>\n\n  <line id=\"yAxis\"\n        class=\"hoverable\"\n        x1=\"300\" y1=\"600\" x2=\"300\" y2=\"24\"\n        stroke=\"#000000\" stroke-width=\"3\" marker-end=\"url(#arr)\"\n        data-tip=\"y-axis — vertical coordinate direction\"\n        data-title=\"y-axis\"\n        data-body=\"The y-axis measures vertical position. Moving upward increases y, and the square reaches from y = -1 to y = 1.\"/>\n\n  <rect id=\"unitSquareBorder\"\n        class=\"hoverable\"\n        x=\"133.333333\" y=\"133.333333\" width=\"333.333333\" height=\"333.333333\"\n        fill=\"none\" stroke=\"#000000\" stroke-width=\"3\"\n        data-tip=\"Boundary — the four sides occur at coordinate value ±1\"\n        data-title=\"Square boundary\"\n        data-body=\"The black outline marks the exact limits of the unit square. The left and right sides are x = -1 and x = 1; the bottom and top sides are y = -1 and y = 1.\"/>\n\n  <line id=\"xBoundHighlight\"\n        x1=\"133.333333\" y1=\"300\" x2=\"466.666667\" y2=\"300\"\n        stroke=\"#c8e0ff\" stroke-width=\"8\" stroke-linecap=\"butt\" opacity=\"0\" pointer-events=\"none\"/>\n  <line id=\"yBoundHighlight\"\n        x1=\"300\" y1=\"466.666667\" x2=\"300\" y2=\"133.333333\"\n        stroke=\"#c8f0c8\" stroke-width=\"8\" stroke-linecap=\"butt\" opacity=\"0\" pointer-events=\"none\"/>\n\n  <text id=\"xTickPos\" class=\"mathText hoverable\" x=\"475\" y=\"325\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"x = 1 — right side of the square\"\n        data-title=\"x = 1\"\n        data-body=\"This label marks the positive horizontal boundary. The right edge of the orange square is one unit to the right of the origin.\">1</text>\n  <text id=\"xTickNeg\" class=\"mathText hoverable\" x=\"91.666667\" y=\"325\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"x = -1 — left side of the square\"\n        data-title=\"x = -1\"\n        data-body=\"This label marks the negative horizontal boundary. The left edge of the orange square is one unit to the left of the origin.\">-1</text>\n  <text id=\"yTickPos\" class=\"mathText hoverable\" x=\"270\" y=\"116.666667\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"y = 1 — top side of the square\"\n        data-title=\"y = 1\"\n        data-body=\"This label marks the positive vertical boundary. The top edge of the orange square is one unit above the origin.\">1</text>\n  <text id=\"yTickNeg\" class=\"mathText hoverable\" x=\"258.333333\" y=\"483.333333\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"y = -1 — bottom side of the square\"\n        data-title=\"y = -1\"\n        data-body=\"This label marks the negative vertical boundary. The bottom edge of the orange square is one unit below the origin.\">-1</text>\n\n  <text id=\"xLabel\" class=\"axisLabel hoverable\" x=\"583.333333\" y=\"333.333333\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"x — horizontal axis label\"\n        data-title=\"The x coordinate\"\n        data-body=\"The symbol x names the horizontal coordinate. Points farther to the right have larger x-values.\">x</text>\n  <text id=\"yLabel\" class=\"axisLabel hoverable\" x=\"266.666667\" y=\"16.666667\" text-anchor=\"middle\" dominant-baseline=\"middle\"\n        data-tip=\"y — vertical axis label\"\n        data-title=\"The y coordinate\"\n        data-body=\"The symbol y names the vertical coordinate. Points higher on the plane have larger y-values.\">y</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('fig');\n  const tt = document.getElementById('tooltip');\n  const strokeOriginal = new Map();\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  document.addEventListener('mousemove', e => {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  function showTip(el) {\n    const tip = el.getAttribute('data-tip');\n    if (!tip) return;\n    tt.textContent = tip;\n    tt.style.display = 'block';\n  }\n\n  function hideTip() {\n    tt.style.display = 'none';\n  }\n\n  function emphasize(el) {\n    if (el.tagName === 'line' || el.tagName === 'rect') {\n      const sw = el.getAttribute('stroke-width');\n      if (sw && sw !== '0') {\n        if (!strokeOriginal.has(el)) strokeOriginal.set(el, sw);\n        el.setAttribute('stroke-width', String(parseFloat(sw) + 1.5));\n      } else {\n        el.style.opacity = '0.7';\n      }\n    } else if (el.tagName === 'text') {\n      el.style.opacity = '0.7';\n    }\n  }\n\n  function deemphasize(el) {\n    if (strokeOriginal.has(el)) {\n      el.setAttribute('stroke-width', strokeOriginal.get(el));\n    }\n    el.style.opacity = '';\n  }\n\n  let animating = false;\n  function animateBounds() {\n    if (animating) return;\n    animating = true;\n\n    const fill = document.getElementById('unitSquareFill');\n    const xh = document.getElementById('xBoundHighlight');\n    const yh = document.getElementById('yBoundHighlight');\n\n    fill.style.transition = 'fill 0.35s ease, stroke 0.35s ease';\n    xh.style.transition = 'opacity 0.35s ease, stroke 0.35s ease';\n    yh.style.transition = 'opacity 0.35s ease, stroke 0.35s ease';\n\n    xh.setAttribute('opacity', '0');\n    yh.setAttribute('opacity', '0');\n    fill.setAttribute('fill', '#ff8000');\n\n    setTimeout(() => {\n      xh.setAttribute('opacity', '0.85');\n    }, 80);\n\n    setTimeout(() => {\n      yh.setAttribute('opacity', '0.85');\n    }, 650);\n\n    setTimeout(() => {\n      fill.setAttribute('fill', '#ffa64a');\n    }, 1220);\n\n    setTimeout(() => {\n      xh.setAttribute('opacity', '0');\n      yh.setAttribute('opacity', '0');\n      fill.setAttribute('fill', '#ff8000');\n    }, 2050);\n\n    setTimeout(() => {\n      animating = false;\n    }, 2500);\n  }\n\n  const hoverables = svg.querySelectorAll('.hoverable');\n  hoverables.forEach(el => {\n    el.addEventListener('mouseenter', () => {\n      showTip(el);\n      emphasize(el);\n    });\n    el.addEventListener('mouseleave', () => {\n      hideTip();\n      deemphasize(el);\n    });\n    el.addEventListener('click', e => {\n      e.stopPropagation();\n      const title = el.getAttribute('data-title');\n      const body = el.getAttribute('data-body');\n      if (title && body) showPopup(title, body);\n      if (el.id === 'unitSquareFill' || el.id === 'unitSquareBorder') animateBounds();\n    });\n  });\n\n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.id === 'background') hidePopup();\n  });\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
