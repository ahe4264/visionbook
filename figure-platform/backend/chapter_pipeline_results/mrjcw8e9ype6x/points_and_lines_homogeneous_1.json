  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #fff;\n  }\n  svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n    background: #fff;\n  }\n  .math-label {\n    font-family: \"Times New Roman\", Times, serif;\n    font-style: italic;\n    font-weight: 700;\n    fill: #000;\n    dominant-baseline: alphabetic;\n    transition: fill 0.35s ease, opacity 0.2s ease;\n    cursor: pointer;\n    user-select: none;\n  }\n  .point {\n    fill: #000;\n    stroke: #000;\n    stroke-width: 0;\n    transition: fill 0.35s ease, stroke-width 0.2s ease, opacity 0.2s ease;\n    cursor: pointer;\n  }\n  .construction-line {\n    stroke: #000;\n    stroke-width: 5;\n    stroke-linecap: butt;\n    transition: stroke 0.35s ease, stroke-width 0.2s ease, opacity 0.2s ease;\n    cursor: pointer;\n  }\n  .hit-line {\n    stroke: transparent;\n    stroke-width: 22;\n    fill: none;\n    pointer-events: stroke;\n    cursor: pointer;\n  }\n  .interactive:hover .math-label {\n    opacity: 0.7;\n  }\n  .tooltip {\n    position: fixed;\n    background: rgba(0,0,0,0.55);\n    color: #fff;\n    font: 11px/1.4 sans-serif;\n    padding: 3px 8px;\n    border-radius: 4px;\n    pointer-events: none;\n    z-index: 100;\n    white-space: nowrap;\n    display: none;\n  }\n</style>\n</head>\n<body>\n<svg id=\"figure\" viewBox=\"0 0 600 337\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\">\n  <g id=\"lineGroup\" class=\"interactive\" data-tooltip=\"Line l — the unique line through both points\" data-title=\"Line l\" data-body=\"In homogeneous coordinates, a line can be represented by a vector l. The cross product p₁ × p₂ gives the line whose equation is satisfied by both points.\">\n    <line id=\"line\" class=\"construction-line\" x1=\"-30\" y1=\"294.8\" x2=\"535\" y2=\"-9.5\"></line>\n    <line class=\"hit-line\" x1=\"-30\" y1=\"294.8\" x2=\"535\" y2=\"-9.5\"></line>\n  </g>\n\n  <g id=\"p1Group\" class=\"interactive\" data-tooltip=\"Point p₁ — one point defining the line\" data-title=\"Point p₁\" data-body=\"The point p₁ is one of the two homogeneous points used to construct the line. Any line through p₁ has a zero incidence product with this point.\">\n    <circle id=\"p1\" class=\"point\" cx=\"51\" cy=\"251\" r=\"24\"></circle>\n  </g>\n\n  <g id=\"p2Group\" class=\"interactive\" data-tooltip=\"Point p₂ — the second point defining the line\" data-title=\"Point p₂\" data-body=\"The point p₂ supplies the second constraint. Together, p₁ and p₂ determine one unique line in the projective plane.\">\n    <circle id=\"p2\" class=\"point\" cx=\"456\" cy=\"33\" r=\"24\"></circle>\n  </g>\n\n  <g id=\"p1LabelGroup\" class=\"interactive\" data-tooltip=\"Label p₁ — names the first point\" data-title=\"Label p₁\" data-body=\"This label identifies the first homogeneous point. It is one of the two inputs to the cross product that constructs the line.\">\n    <text class=\"math-label\" x=\"70\" y=\"309\" font-size=\"50\">\n      <tspan>p</tspan><tspan font-size=\"29\" dy=\"15\">1</tspan>\n    </text>\n  </g>\n\n  <g id=\"p2LabelGroup\" class=\"interactive\" data-tooltip=\"Label p₂ — names the second point\" data-title=\"Label p₂\" data-body=\"This label identifies the second homogeneous point. Using two distinct points avoids ambiguity and fixes a single line.\">\n    <text class=\"math-label\" x=\"505\" y=\"84\" font-size=\"50\">\n      <tspan>p</tspan><tspan font-size=\"29\" dy=\"15\">2</tspan>\n    </text>\n  </g>\n\n  <g id=\"formulaGroup\" class=\"interactive\" data-tooltip=\"l = p₁ × p₂ — line from the cross product\" data-title=\"l = p₁ × p₂\" data-body=\"The formula states that the homogeneous line l is obtained by taking the cross product of the two point vectors. This operation produces coefficients of the line passing through both points.\">\n    <text id=\"formula\" class=\"math-label\" x=\"272\" y=\"181\" font-size=\"50\">\n      <tspan>l</tspan><tspan>=p</tspan><tspan font-size=\"29\" dy=\"15\">1</tspan><tspan dy=\"-15\">×p</tspan><tspan font-size=\"29\" dy=\"15\">2</tspan>\n    </text>\n  </g>\n</svg>\n\n<div id=\"tooltip\" class=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('figure');\n  const tooltip = document.getElementById('tooltip');\n  const line = document.getElementById('line');\n  const p1 = document.getElementById('p1');\n  const p2 = document.getElementById('p2');\n  const formula = document.getElementById('formula');\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n  });\n\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n\n  const interactiveGroups = Array.from(document.querySelectorAll('.interactive'));\n\n  interactiveGroups.forEach(group => {\n    group.addEventListener('mouseenter', () => {\n      const text = group.getAttribute('data-tooltip') || '';\n      tooltip.textContent = text;\n      tooltip.style.display = 'block';\n\n      if (group.id === 'lineGroup') {\n        line.style.strokeWidth = '6.5';\n      }\n      if (group.id === 'p1Group') {\n        p1.style.strokeWidth = '1.5';\n      }\n      if (group.id === 'p2Group') {\n        p2.style.strokeWidth = '1.5';\n      }\n    });\n\n    group.addEventListener('mouseleave', () => {\n      tooltip.style.display = 'none';\n\n      if (group.id === 'lineGroup') {\n        line.style.strokeWidth = '5';\n      }\n      if (group.id === 'p1Group') {\n        p1.style.strokeWidth = '0';\n      }\n      if (group.id === 'p2Group') {\n        p2.style.strokeWidth = '0';\n      }\n    });\n\n    group.addEventListener('click', e => {\n      e.stopPropagation();\n      const title = group.getAttribute('data-title');\n      const body = group.getAttribute('data-body');\n      showPopup(title, body);\n\n      if (group.id === 'formulaGroup' || group.id === 'lineGroup' || group.id === 'p1Group' || group.id === 'p2Group') {\n        runConstructionSequence();\n      }\n    });\n  });\n\n  let sequenceTimer = [];\n\n  function clearTimers() {\n    sequenceTimer.forEach(t => clearTimeout(t));\n    sequenceTimer = [];\n  }\n\n  function resetColors() {\n    p1.style.fill = '#000';\n    p1.style.stroke = '#000';\n    p2.style.fill = '#000';\n    p2.style.stroke = '#000';\n    line.style.stroke = '#000';\n    formula.style.fill = '#000';\n  }\n\n  function runConstructionSequence() {\n    clearTimers();\n    resetColors();\n\n    sequenceTimer.push(setTimeout(() => {\n      p1.style.fill = '#c8e0ff';\n      p1.style.stroke = '#000';\n    }, 80));\n\n    sequenceTimer.push(setTimeout(() => {\n      p2.style.fill = '#c8e0ff';\n      p2.style.stroke = '#000';\n    }, 520));\n\n    sequenceTimer.push(setTimeout(() => {\n      line.style.stroke = '#5f8fd6';\n      formula.style.fill = '#5f8fd6';\n    }, 960));\n\n    sequenceTimer.push(setTimeout(() => {\n      resetColors();\n    }, 2100));\n  }\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
