  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { width:100%; height:100%; display:block; background:#fff; }\n.interactive { cursor:pointer; transition:stroke-width 0.15s ease, opacity 0.15s ease, fill 0.35s ease, stroke 0.35s ease; }\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  display:none;\n}\n</style>\n</head>\n<body>\n<svg id=\"fig\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 600\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"12\" markerHeight=\"12\" refX=\"11\" refY=\"6\" orient=\"auto\">\n      <path d=\"M0,0 L0,12 L12,6 z\" fill=\"#1a1a1a\"></path>\n    </marker>\n  </defs>\n\n  <rect id=\"unitSquare\" class=\"interactive\"\n        x=\"156\" y=\"206\" width=\"216\" height=\"216\"\n        fill=\"#ff8000\" stroke=\"#1a1a1a\" stroke-width=\"3\"\n        data-tip=\"Unit square: spans from -1 to 1 on both axes\"\n        data-title=\"Unit square\"\n        data-body=\"This orange square is centered at the origin and extends from x = -1 to x = 1 and from y = -1 to y = 1. It is a simple template shape often used before applying transformations such as scaling, rotation, shear, or translation.\"></rect>\n\n  <line id=\"xAxis\" class=\"interactive\"\n        x1=\"0\" y1=\"314\" x2=\"526\" y2=\"314\"\n        stroke=\"#1a1a1a\" stroke-width=\"3\" marker-end=\"url(#arr)\"\n        data-tip=\"x-axis: horizontal coordinate direction\"\n        data-title=\"x-axis\"\n        data-body=\"The horizontal axis measures x-coordinates. The square crosses this axis at its center, showing that the template is balanced equally to the left and right of the origin.\"></line>\n\n  <line id=\"yAxis\" class=\"interactive\"\n        x1=\"264\" y1=\"600\" x2=\"264\" y2=\"43\"\n        stroke=\"#1a1a1a\" stroke-width=\"3\" marker-end=\"url(#arr)\"\n        data-tip=\"y-axis: vertical coordinate direction\"\n        data-title=\"y-axis\"\n        data-body=\"The vertical axis measures y-coordinates. It passes through the center of the square, showing that the template extends equally above and below the origin.\"></line>\n\n  <text x=\"150\" y=\"347\" text-anchor=\"end\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" fill=\"#111\">-1</text>\n  <text x=\"379\" y=\"347\" text-anchor=\"start\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" fill=\"#111\">1</text>\n  <text x=\"251\" y=\"193\" text-anchor=\"end\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" fill=\"#111\">1</text>\n  <text x=\"251\" y=\"476\" text-anchor=\"end\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" fill=\"#111\">-1</text>\n\n  <text x=\"540\" y=\"349\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" font-style=\"italic\" fill=\"#111\">x</text>\n  <text x=\"202\" y=\"37\" font-family=\"Times New Roman, Times, serif\" font-size=\"24\" font-style=\"italic\" fill=\"#111\">y</text>\n</svg>\n<div id=\"tooltip\"></div>\n<script>\ntry {\n  const svg = document.getElementById('fig');\n  const tt = document.getElementById('tooltip');\n  const strokeWidth = 3;\n  const hoverStrokeWidth = strokeWidth + 1.5;\n  const elements = Array.from(document.querySelectorAll('.interactive'));\n  let sequenceRunning = false;\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title:title, body:body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  document.addEventListener('mousemove', function(e) {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  function resetVisuals() {\n    const square = document.getElementById('unitSquare');\n    const xAxis = document.getElementById('xAxis');\n    const yAxis = document.getElementById('yAxis');\n    square.setAttribute('fill', '#ff8000');\n    square.setAttribute('stroke', '#1a1a1a');\n    square.setAttribute('stroke-width', strokeWidth);\n    xAxis.setAttribute('stroke', '#1a1a1a');\n    xAxis.setAttribute('stroke-width', strokeWidth);\n    yAxis.setAttribute('stroke', '#1a1a1a');\n    yAxis.setAttribute('stroke-width', strokeWidth);\n  }\n\n  function runUnitSquareSequence() {\n    if (sequenceRunning) return;\n    sequenceRunning = true;\n\n    const square = document.getElementById('unitSquare');\n    const xAxis = document.getElementById('xAxis');\n    const yAxis = document.getElementById('yAxis');\n\n    resetVisuals();\n\n    setTimeout(function() {\n      xAxis.setAttribute('stroke', '#5c8edc');\n    }, 50);\n\n    setTimeout(function() {\n      xAxis.setAttribute('stroke', '#1a1a1a');\n      yAxis.setAttribute('stroke', '#5c8edc');\n    }, 550);\n\n    setTimeout(function() {\n      yAxis.setAttribute('stroke', '#1a1a1a');\n      square.setAttribute('fill', '#ffc46b');\n      square.setAttribute('stroke', '#5c8edc');\n    }, 1050);\n\n    setTimeout(function() {\n      resetVisuals();\n      sequenceRunning = false;\n    }, 1750);\n  }\n\n  elements.forEach(function(el) {\n    el.addEventListener('mouseenter', function() {\n      if (!sequenceRunning) el.setAttribute('stroke-width', hoverStrokeWidth);\n      tt.textContent = el.getAttribute('data-tip') || '';\n      tt.style.display = 'block';\n    });\n\n    el.addEventListener('mouseleave', function() {\n      if (!sequenceRunning) el.setAttribute('stroke-width', strokeWidth);\n      tt.style.display = 'none';\n    });\n\n    el.addEventListener('click', function(e) {\n      e.stopPropagation();\n      showPopup(el.getAttribute('data-title'), el.getAttribute('data-body'));\n      runUnitSquareSequence();\n    });\n  });\n\n  svg.addEventListener('click', function(e) {\n    if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n  });\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
