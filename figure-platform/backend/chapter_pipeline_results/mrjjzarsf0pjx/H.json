  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; width:100%; height:100%; background:#fff; }\n.mathText { font-family:\"Times New Roman\", Times, serif; fill:#000; }\n.hit { fill:transparent; stroke:transparent; pointer-events:all; }\n.flowLine { stroke:#000; stroke-width:1.2; fill:none; transition:stroke 0.35s ease, stroke-width 0.15s ease, opacity 0.15s ease; }\n.inkText { transition:fill 0.35s ease, opacity 0.15s ease; }\n.inkStroke { transition:stroke 0.35s ease, opacity 0.15s ease; }\n.blockRect { fill:#fff; stroke:#000; stroke-width:1.2; transition:fill 0.35s ease, stroke 0.35s ease, stroke-width 0.15s ease; }\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  display:none;\n}\n</style>\n</head>\n<body>\n<svg id=\"figure\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 86\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Discrete system response to a complex exponential\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\" markerUnits=\"strokeWidth\">\n      <path d=\"M0,0 L0,5 L5,2.5 z\" fill=\"#000000\"></path>\n    </marker>\n    <marker id=\"arrActive\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\" markerUnits=\"strokeWidth\">\n      <path d=\"M0,0 L0,5 L5,2.5 z\" fill=\"#2d6fc4\"></path>\n    </marker>\n  </defs>\n\n  <g id=\"inputExpr\" class=\"interactive\" data-title=\"Complex exponential input\" data-tooltip=\"Input: a single discrete-frequency complex exponential\" data-body=\"This signal is a complex exponential at frequency index u₀. For linear shift-invariant discrete systems, this waveform is an eigenfunction: the system changes its amplitude and phase but not its frequency.\">\n    <rect class=\"hit\" x=\"0\" y=\"17\" width=\"154\" height=\"52\"></rect>\n    <g class=\"mathText\">\n      <text class=\"inkText\" x=\"0\" y=\"51\" font-size=\"21\" font-style=\"normal\">exp</text>\n      <text class=\"inkText\" x=\"33\" y=\"52\" font-size=\"28\" font-style=\"normal\">(</text>\n      <text class=\"inkText\" x=\"49\" y=\"51\" font-size=\"21\" font-style=\"normal\">2π</text>\n      <text class=\"inkText\" x=\"76\" y=\"51\" font-size=\"21\" font-style=\"italic\">j</text>\n      <text class=\"inkText\" x=\"87\" y=\"37\" font-size=\"13\" font-style=\"italic\">u</text>\n      <text class=\"inkText\" x=\"94\" y=\"40\" font-size=\"9\" font-style=\"normal\">0</text>\n      <text class=\"inkText\" x=\"103\" y=\"37\" font-size=\"13\" font-style=\"italic\">n</text>\n      <line class=\"inkStroke\" x1=\"84\" y1=\"42\" x2=\"119\" y2=\"42\" stroke=\"#000\" stroke-width=\"1\"></line>\n      <text class=\"inkText\" x=\"97\" y=\"58\" font-size=\"13\" font-style=\"italic\">N</text>\n      <text class=\"inkText\" x=\"124\" y=\"52\" font-size=\"28\" font-style=\"normal\">)</text>\n    </g>\n  </g>\n\n  <g id=\"arrowIn\" class=\"interactive\" data-title=\"Signal enters the system\" data-tooltip=\"Forward arrow: the input is applied to H[u]\" data-body=\"The arrow indicates that the complex exponential is fed into the discrete system. The direction matters: the expression on the left is the excitation, and the block computes the response.\">\n    <line class=\"flowLine\" x1=\"174\" y1=\"43\" x2=\"210\" y2=\"43\" marker-end=\"url(#arr)\"></line>\n    <line class=\"hit\" x1=\"172\" y1=\"43\" x2=\"212\" y2=\"43\" stroke-width=\"14\"></line>\n  </g>\n\n  <g id=\"systemBlock\" class=\"interactive\" data-title=\"System H[u]\" data-tooltip=\"System: frequency response evaluated by index u\" data-body=\"The block represents a discrete system through its frequency response H[u]. At the input frequency u₀, the system contributes the magnitude |H[u₀]| and a phase shift.\">\n    <rect class=\"blockRect\" x=\"213.75\" y=\"10.75\" width=\"64.5\" height=\"64.5\"></rect>\n    <rect class=\"hit\" x=\"211\" y=\"8\" width=\"70\" height=\"70\"></rect>\n    <text class=\"mathText inkText\" x=\"246\" y=\"52\" font-size=\"25\" text-anchor=\"middle\" font-style=\"italic\">\n      H<tspan font-style=\"normal\"> [</tspan><tspan font-style=\"italic\">u</tspan><tspan font-style=\"normal\">]</tspan>\n    </text>\n  </g>\n\n  <g id=\"arrowOut\" class=\"interactive\" data-title=\"System response leaves the block\" data-tooltip=\"Forward arrow: the transformed exponential emerges\" data-body=\"The output remains a complex exponential at the same discrete frequency. The system only scales it by the frequency-response magnitude and shifts its phase.\">\n    <line class=\"flowLine\" x1=\"282\" y1=\"43\" x2=\"318\" y2=\"43\" marker-end=\"url(#arr)\"></line>\n    <line class=\"hit\" x1=\"280\" y1=\"43\" x2=\"320\" y2=\"43\" stroke-width=\"14\"></line>\n  </g>\n\n  <g id=\"outputExpr\" class=\"interactive\" data-title=\"Output expression\" data-tooltip=\"Output: same frequency with gain and phase shift\" data-body=\"The factor |H[u₀]| is the gain applied at the input frequency. The added phase term j∠H[u] shows that the exponential is shifted in phase while retaining its original frequency index u₀.\">\n    <rect class=\"hit\" x=\"319\" y=\"17\" width=\"281\" height=\"52\"></rect>\n    <g class=\"mathText\" transform=\"translate(324,0)\">\n      <text class=\"inkText\" x=\"0\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">|</text>\n      <text class=\"inkText\" x=\"8\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">H</text>\n      <text class=\"inkText\" x=\"24\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">[</text>\n      <text class=\"inkText\" x=\"31\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">u</text>\n      <text class=\"inkText\" x=\"40\" y=\"55\" font-size=\"8.5\" font-style=\"normal\">0</text>\n      <text class=\"inkText\" x=\"48\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">]|</text>\n\n      <text class=\"inkText\" x=\"67\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">exp</text>\n      <text class=\"inkText\" x=\"105\" y=\"52\" font-size=\"25\" font-style=\"normal\">(</text>\n\n      <text class=\"inkText\" x=\"119\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">2π</text>\n      <text class=\"inkText\" x=\"143\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">j</text>\n      <text class=\"inkText\" x=\"154\" y=\"37\" font-size=\"12\" font-style=\"italic\">u</text>\n      <text class=\"inkText\" x=\"161\" y=\"40\" font-size=\"8\" font-style=\"normal\">0</text>\n      <text class=\"inkText\" x=\"169\" y=\"37\" font-size=\"12\" font-style=\"italic\">n</text>\n      <line class=\"inkStroke\" x1=\"151\" y1=\"42\" x2=\"183\" y2=\"42\" stroke=\"#000\" stroke-width=\"1\"></line>\n      <text class=\"inkText\" x=\"163\" y=\"58\" font-size=\"12\" font-style=\"italic\">N</text>\n\n      <text class=\"inkText\" x=\"190\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">+</text>\n      <text class=\"inkText\" x=\"207\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">j</text>\n      <text class=\"inkText\" x=\"220\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">∠</text>\n      <text class=\"inkText\" x=\"237\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">H</text>\n      <text class=\"inkText\" x=\"253\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">[</text>\n      <text class=\"inkText\" x=\"260\" y=\"51\" font-size=\"18.5\" font-style=\"italic\">u</text>\n      <text class=\"inkText\" x=\"271\" y=\"51\" font-size=\"18.5\" font-style=\"normal\">]</text>\n      <text class=\"inkText\" x=\"280\" y=\"52\" font-size=\"25\" font-style=\"normal\">)</text>\n    </g>\n  </g>\n</svg>\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const plan = {\n    aspectRatio: 7,\n    elementSizes: { strokeWidth: 1.2, fontSize: 14, arrowheadSize: 5 }\n  };\n  const W = 600;\n  const H = Math.round(W / plan.aspectRatio);\n  const strokeW = plan.elementSizes.strokeWidth;\n  const fontSize = plan.elementSizes.fontSize;\n  const arrSize = plan.elementSizes.arrowheadSize;\n\n  const svg = document.getElementById('figure');\n  const tt = document.getElementById('tooltip');\n  const activeColor = '#2d6fc4';\n  const activeFill = '#eef6ff';\n  let flowTimer = null;\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title, body }, '*');\n  }\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('mousemove', e => {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  function nearestInteractive(target) {\n    while (target && target !== svg) {\n      if (target.classList && target.classList.contains('interactive')) return target;\n      target = target.parentNode;\n    }\n    return null;\n  }\n\n  function setFormulaColor(group, color) {\n    group.querySelectorAll('.inkText').forEach(el => { el.style.fill = color; });\n    group.querySelectorAll('.inkStroke').forEach(el => { el.style.stroke = color; });\n  }\n\n  function resetFlow() {\n    if (flowTimer) {\n      clearTimeout(flowTimer);\n      flowTimer = null;\n    }\n    setFormulaColor(document.getElementById('inputExpr'), '#000');\n    setFormulaColor(document.getElementById('outputExpr'), '#000');\n    const block = document.querySelector('#systemBlock .blockRect');\n    block.style.fill = '#fff';\n    block.style.stroke = '#000';\n    document.querySelectorAll('.flowLine').forEach(line => {\n      line.style.stroke = '#000';\n      line.setAttribute('marker-end', 'url(#arr)');\n    });\n  }\n\n  function highlightArrow(id, on) {\n    const line = document.querySelector('#' + id + ' .flowLine');\n    line.style.stroke = on ? activeColor : '#000';\n    line.setAttribute('marker-end', on ? 'url(#arrActive)' : 'url(#arr)');\n  }\n\n  function runFlow() {\n    resetFlow();\n    const input = document.getElementById('inputExpr');\n    const output = document.getElementById('outputExpr');\n    const block = document.querySelector('#systemBlock .blockRect');\n\n    const steps = [\n      () => setFormulaColor(input, activeColor),\n      () => highlightArrow('arrowIn', true),\n      () => { block.style.fill = activeFill; block.style.stroke = activeColor; },\n      () => highlightArrow('arrowOut', true),\n      () => setFormulaColor(output, activeColor),\n      () => resetFlow()\n    ];\n\n    let i = 0;\n    function next() {\n      if (i < steps.length) {\n        steps[i++]();\n        flowTimer = setTimeout(next, i === steps.length ? 1150 : 520);\n      }\n    }\n    next();\n  }\n\n  svg.addEventListener('mouseover', e => {\n    const g = nearestInteractive(e.target);\n    if (!g) return;\n    tt.textContent = g.getAttribute('data-tooltip') || '';\n    tt.style.display = 'block';\n\n    if (g.id === 'arrowIn' || g.id === 'arrowOut') {\n      const line = g.querySelector('.flowLine');\n      line.style.strokeWidth = (strokeW + 1.5);\n    } else if (g.id === 'systemBlock') {\n      const rect = g.querySelector('.blockRect');\n      rect.style.strokeWidth = (strokeW + 1.5);\n    } else {\n      g.querySelectorAll('.inkText,.inkStroke').forEach(el => { el.style.opacity = '0.72'; });\n    }\n  });\n\n  svg.addEventListener('mouseout', e => {\n    const g = nearestInteractive(e.target);\n    if (!g) return;\n    tt.style.display = 'none';\n\n    if (g.id === 'arrowIn' || g.id === 'arrowOut') {\n      const line = g.querySelector('.flowLine');\n      line.style.strokeWidth = strokeW;\n    } else if (g.id === 'systemBlock') {\n      const rect = g.querySelector('.blockRect');\n      rect.style.strokeWidth = strokeW;\n    } else {\n      g.querySelectorAll('.inkText,.inkStroke').forEach(el => { el.style.opacity = '1'; });\n    }\n  });\n\n  svg.addEventListener('click', e => {\n    const g = nearestInteractive(e.target);\n    if (!g || e.target === svg || e.target.tagName === 'svg') {\n      hidePopup();\n      return;\n    }\n    showPopup(g.getAttribute('data-title'), g.getAttribute('data-body'));\n    runFlow();\n    e.stopPropagation();\n  });\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') {\n      hidePopup();\n      resetFlow();\n    }\n  });\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
