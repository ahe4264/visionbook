  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { width:100%; height:100%; display:block; background:#fff; }\n.hoverable { cursor:pointer; }\n.mathText {\n  font-family: \"Cambria Math\", \"STIX Two Math\", \"STIXGeneral\", \"Times New Roman\", serif;\n  fill:#000000;\n  user-select:none;\n}\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  opacity:0;\n}\n</style>\n</head>\n<body>\n<svg id=\"fig\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 103\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Frequency-domain linear filtering system\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000000\"></path>\n    </marker>\n  </defs>\n\n  <g id=\"inputGroup\" class=\"hoverable mathText\" data-name=\"Input spectrum\" data-tip=\"frequency-domain input entering the filter\">\n    <text x=\"54\" y=\"59\" text-anchor=\"middle\" font-size=\"28\">\n      <tspan font-style=\"normal\">&#x2112;</tspan><tspan font-size=\"14\" baseline-shift=\"sub\" font-style=\"normal\">in</tspan><tspan font-style=\"normal\">[</tspan><tspan font-style=\"italic\">u, v</tspan><tspan font-style=\"normal\">]</tspan>\n    </text>\n  </g>\n\n  <g id=\"arrow1Group\" class=\"hoverable\" data-name=\"Forward connection\" data-tip=\"passes the input spectrum to the system\">\n    <line id=\"arrow1\" x1=\"108\" y1=\"51.5\" x2=\"150\" y2=\"51.5\" stroke=\"#000000\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"></line>\n    <line x1=\"108\" y1=\"51.5\" x2=\"150\" y2=\"51.5\" stroke=\"transparent\" stroke-width=\"14\"></line>\n  </g>\n\n  <g id=\"blockGroup\" class=\"hoverable\" data-name=\"Transfer function\" data-tip=\"multiplies each frequency component\">\n    <rect id=\"blockRect\" x=\"153\" y=\"6.5\" width=\"90\" height=\"90\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1.5\"></rect>\n    <text class=\"mathText\" x=\"198\" y=\"59\" text-anchor=\"middle\" font-size=\"26\">\n      <tspan font-style=\"italic\">H</tspan><tspan font-style=\"normal\"> [</tspan><tspan font-style=\"italic\">u, v</tspan><tspan font-style=\"normal\">]</tspan>\n    </text>\n  </g>\n\n  <g id=\"arrow2Group\" class=\"hoverable\" data-name=\"Filtered connection\" data-tip=\"carries the spectrum after filtering\">\n    <line id=\"arrow2\" x1=\"246\" y1=\"51.5\" x2=\"288\" y2=\"51.5\" stroke=\"#000000\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"></line>\n    <line x1=\"246\" y1=\"51.5\" x2=\"288\" y2=\"51.5\" stroke=\"transparent\" stroke-width=\"14\"></line>\n  </g>\n\n  <g id=\"outputGroup\" class=\"hoverable mathText\" data-name=\"Output spectrum\" data-tip=\"input multiplied by the transfer function\">\n    <text x=\"300\" y=\"59\" text-anchor=\"start\" font-size=\"28\">\n      <tspan font-style=\"normal\">&#x2112;</tspan><tspan font-size=\"14\" baseline-shift=\"sub\" font-style=\"normal\">out</tspan><tspan font-style=\"normal\">[</tspan><tspan font-style=\"italic\">u, v</tspan><tspan font-style=\"normal\">] = </tspan><tspan font-style=\"italic\">H</tspan><tspan font-style=\"normal\"> [</tspan><tspan font-style=\"italic\">u, v</tspan><tspan font-style=\"normal\">] </tspan><tspan font-style=\"normal\">&#x2112;</tspan><tspan font-size=\"14\" baseline-shift=\"sub\" font-style=\"normal\">in</tspan><tspan font-style=\"normal\">[</tspan><tspan font-style=\"italic\">u, v</tspan><tspan font-style=\"normal\">]</tspan>\n    </text>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('fig');\n  const tt = document.getElementById('tooltip');\n  const strokeW = 1.5;\n  const highlight = '#2f6fbd';\n  const softFill = '#c8e0ff';\n  let timers = [];\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n  });\n\n  document.addEventListener('mousemove', e => {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  function clearTimers() {\n    timers.forEach(t => clearTimeout(t));\n    timers = [];\n  }\n\n  function resetFlow() {\n    document.getElementById('inputGroup').style.fill = '#000000';\n    document.getElementById('outputGroup').style.fill = '#000000';\n    document.getElementById('arrow1').setAttribute('stroke', '#000000');\n    document.getElementById('arrow2').setAttribute('stroke', '#000000');\n    document.getElementById('blockRect').setAttribute('fill', '#ffffff');\n    document.getElementById('blockRect').setAttribute('stroke', '#000000');\n  }\n\n  function runFlow() {\n    clearTimers();\n    resetFlow();\n\n    const input = document.getElementById('inputGroup');\n    const arrow1 = document.getElementById('arrow1');\n    const block = document.getElementById('blockRect');\n    const arrow2 = document.getElementById('arrow2');\n    const output = document.getElementById('outputGroup');\n\n    [input, output].forEach(el => {\n      el.style.transition = 'fill 0.35s ease, opacity 0.15s ease';\n    });\n    [arrow1, arrow2, block].forEach(el => {\n      el.style.transition = 'fill 0.35s ease, stroke 0.35s ease';\n    });\n\n    timers.push(setTimeout(() => { input.style.fill = highlight; }, 40));\n    timers.push(setTimeout(() => { arrow1.setAttribute('stroke', highlight); }, 420));\n    timers.push(setTimeout(() => {\n      block.setAttribute('fill', softFill);\n      block.setAttribute('stroke', highlight);\n    }, 800));\n    timers.push(setTimeout(() => { arrow2.setAttribute('stroke', highlight); }, 1180));\n    timers.push(setTimeout(() => { output.style.fill = highlight; }, 1560));\n    timers.push(setTimeout(resetFlow, 2600));\n  }\n\n  function addTextHover(group) {\n    group.addEventListener('mouseenter', () => {\n      group.style.opacity = '0.72';\n      tt.textContent = group.dataset.name + ': ' + group.dataset.tip;\n      tt.style.opacity = '1';\n    });\n    group.addEventListener('mouseleave', () => {\n      group.style.opacity = '1';\n      tt.style.opacity = '0';\n    });\n  }\n\n  function addArrowHover(group, line) {\n    group.addEventListener('mouseenter', () => {\n      line.setAttribute('stroke-width', String(strokeW + 1.5));\n      tt.textContent = group.dataset.name + ': ' + group.dataset.tip;\n      tt.style.opacity = '1';\n    });\n    group.addEventListener('mouseleave', () => {\n      line.setAttribute('stroke-width', String(strokeW));\n      tt.style.opacity = '0';\n    });\n  }\n\n  function addBlockHover(group, rect) {\n    group.addEventListener('mouseenter', () => {\n      rect.setAttribute('stroke-width', String(strokeW + 1.5));\n      tt.textContent = group.dataset.name + ': ' + group.dataset.tip;\n      tt.style.opacity = '1';\n    });\n    group.addEventListener('mouseleave', () => {\n      rect.setAttribute('stroke-width', String(strokeW));\n      tt.style.opacity = '0';\n    });\n  }\n\n  addTextHover(document.getElementById('inputGroup'));\n  addTextHover(document.getElementById('outputGroup'));\n  addArrowHover(document.getElementById('arrow1Group'), document.getElementById('arrow1'));\n  addArrowHover(document.getElementById('arrow2Group'), document.getElementById('arrow2'));\n  addBlockHover(document.getElementById('blockGroup'), document.getElementById('blockRect'));\n\n  document.getElementById('inputGroup').addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Input spectrum', 'The input is represented in the frequency domain as L_in[u, v]. Each coordinate pair [u, v] denotes one frequency component before filtering.');\n    runFlow();\n  });\n\n  document.getElementById('arrow1Group').addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Signal flow into the filter', 'The first arrow indicates that the input spectrum is supplied to the filtering system. The animation traces the same left-to-right flow.');\n    runFlow();\n  });\n\n  document.getElementById('blockGroup').addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Transfer function H[u, v]', 'The central block is the frequency response of the linear filter. In the frequency domain, filtering is performed by multiplying each input frequency component by H[u, v].');\n    runFlow();\n  });\n\n  document.getElementById('arrow2Group').addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Flow after filtering', 'After the transfer function acts on the input spectrum, the result is passed to the output side. This arrow represents the filtered spectrum leaving the system.');\n    runFlow();\n  });\n\n  document.getElementById('outputGroup').addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Output relation', 'The output spectrum satisfies L_out[u, v] = H[u, v] L_in[u, v]. This compact equation states that linear filtering becomes pointwise multiplication in the frequency domain.');\n    runFlow();\n  });\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
