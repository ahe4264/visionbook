  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; width:100%; height:100%; background:#fff; }\n.math { font-family:\"Cambria Math\",\"STIX Two Text\",\"Times New Roman\",serif; fill:#000; }\n.hot { cursor:pointer; }\n.edge { stroke:#000; stroke-width:1.5; fill:none; transition:stroke 0.35s ease, stroke-width 0.15s ease, opacity 0.15s ease; }\n.blockBox { fill:#fff; stroke:#000; stroke-width:1.5; transition:stroke 0.35s ease, stroke-width 0.15s ease; }\n.formulaGroup { transition:fill 0.35s ease, opacity 0.15s ease; }\n#tooltip {\n  position:fixed;\n  background:rgba(0,0,0,0.55);\n  color:#fff;\n  font:11px/1.4 sans-serif;\n  padding:3px 8px;\n  border-radius:4px;\n  pointer-events:none;\n  z-index:100;\n  white-space:nowrap;\n  display:none;\n}\n</style>\n</head>\n<body>\n<svg id=\"fig\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 92\" preserveAspectRatio=\"xMidYMid meet\" aria-label=\"2D discrete system flow chart\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\" markerUnits=\"strokeWidth\">\n      <path d=\"M0,0 L0,8 L8,4 z\" fill=\"context-stroke\"></path>\n    </marker>\n  </defs>\n\n  <g id=\"inputExpr\" class=\"hot formulaGroup\" data-kind=\"text\" data-tooltip=\"Input signal — the 2D signal entering the system\">\n    <rect x=\"0\" y=\"20\" width=\"108\" height=\"48\" fill=\"transparent\" pointer-events=\"all\"></rect>\n    <text class=\"math\" x=\"0\" y=\"56\" font-size=\"24\">\n      <tspan font-style=\"italic\">ℓ</tspan><tspan baseline-shift=\"-34%\" font-size=\"15\" font-style=\"normal\">in</tspan><tspan font-weight=\"700\" font-style=\"italic\">[n,m]</tspan>\n    </text>\n  </g>\n\n  <line id=\"arrowIn\" class=\"edge hot\" x1=\"103\" y1=\"46\" x2=\"143.5\" y2=\"46\" marker-end=\"url(#arr)\"\n        data-kind=\"edge\" data-tooltip=\"Input arrow — carries the signal into the system block\"></line>\n\n  <g id=\"systemBlock\" class=\"hot\" data-kind=\"block\" data-tooltip=\"System block — applies the impulse response h[n,m]\">\n    <rect class=\"blockBox\" x=\"145\" y=\"1\" width=\"93\" height=\"90\" pointer-events=\"all\"></rect>\n    <text class=\"math\" x=\"191.5\" y=\"55\" font-size=\"24\" text-anchor=\"middle\">\n      <tspan font-style=\"italic\">h</tspan><tspan font-weight=\"700\" font-style=\"italic\">[n,m]</tspan>\n    </text>\n  </g>\n\n  <line id=\"arrowOut\" class=\"edge hot\" x1=\"238\" y1=\"46\" x2=\"276.5\" y2=\"46\" marker-end=\"url(#arr)\"\n        data-kind=\"edge\" data-tooltip=\"Output arrow — shows the processed signal leaving the system\"></line>\n\n  <g id=\"outputExpr\" class=\"hot formulaGroup\" data-kind=\"text\" data-tooltip=\"Output signal — convolution of h[n,m] with the input\">\n    <rect x=\"284\" y=\"20\" width=\"316\" height=\"48\" fill=\"transparent\" pointer-events=\"all\"></rect>\n    <text class=\"math\" x=\"284\" y=\"56\" font-size=\"24\">\n      <tspan font-style=\"italic\">ℓ</tspan><tspan baseline-shift=\"-34%\" font-size=\"15\" font-style=\"normal\">out</tspan><tspan font-weight=\"700\" font-style=\"italic\">[n,m]</tspan>\n      <tspan> = </tspan>\n      <tspan font-style=\"italic\">h</tspan><tspan font-weight=\"700\" font-style=\"italic\">[n,m]</tspan>\n      <tspan> ∘ </tspan>\n      <tspan font-style=\"italic\">ℓ</tspan><tspan baseline-shift=\"-34%\" font-size=\"15\" font-style=\"normal\">in</tspan><tspan font-weight=\"700\" font-style=\"italic\">[n,m]</tspan>\n    </text>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('fig');\n  const tt = document.getElementById('tooltip');\n  const inputExpr = document.getElementById('inputExpr');\n  const outputExpr = document.getElementById('outputExpr');\n  const arrowIn = document.getElementById('arrowIn');\n  const arrowOut = document.getElementById('arrowOut');\n  const block = document.getElementById('systemBlock');\n  const blockBox = block.querySelector('.blockBox');\n  const activeColor = '#1f6fb2';\n  let timers = [];\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title, body }, '*');\n  }\n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n\n  document.addEventListener('mousemove', e => {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n\n  function clearTimers() {\n    timers.forEach(t => clearTimeout(t));\n    timers = [];\n  }\n\n  function resetFlow() {\n    inputExpr.style.fill = '';\n    outputExpr.style.fill = '';\n    arrowIn.style.stroke = '#000';\n    arrowOut.style.stroke = '#000';\n    blockBox.style.stroke = '#000';\n  }\n\n  function later(ms, fn) {\n    timers.push(setTimeout(fn, ms));\n  }\n\n  function runFlow() {\n    clearTimers();\n    resetFlow();\n    later(0, () => {\n      inputExpr.style.fill = activeColor;\n    });\n    later(450, () => {\n      arrowIn.style.stroke = activeColor;\n    });\n    later(900, () => {\n      blockBox.style.stroke = activeColor;\n    });\n    later(1350, () => {\n      arrowOut.style.stroke = activeColor;\n    });\n    later(1800, () => {\n      outputExpr.style.fill = activeColor;\n    });\n    later(2800, resetFlow);\n  }\n\n  function setHover(el, on) {\n    const kind = el.getAttribute('data-kind');\n    if (kind === 'edge') {\n      el.style.strokeWidth = on ? '3' : '1.5';\n    } else if (kind === 'block') {\n      blockBox.style.strokeWidth = on ? '3' : '1.5';\n    } else if (kind === 'text') {\n      el.style.opacity = on ? '0.7' : '1';\n    }\n  }\n\n  function popupFor(id) {\n    if (id === 'inputExpr') {\n      showPopup('Input signal', 'The expression ℓ_in[n,m] represents the two-dimensional discrete signal before the system acts on it. The indices n and m identify sample locations on a 2D grid.');\n    } else if (id === 'arrowIn') {\n      showPopup('Signal enters the system', 'This arrow indicates the direction of processing: the input signal is fed into the system block. Nothing is transformed until the signal reaches the block labeled h[n,m].');\n    } else if (id === 'systemBlock') {\n      showPopup('System impulse response', 'The block labeled h[n,m] represents the 2D system. Conceptually, it combines with the input through convolution to determine how each input sample contributes to the output.');\n    } else if (id === 'arrowOut') {\n      showPopup('Processed signal leaves', 'This arrow marks the result flowing out after the system operation. It separates the internal action of the block from the final output expression.');\n    } else if (id === 'outputExpr') {\n      showPopup('Output by convolution', 'The output ℓ_out[n,m] is written as h[n,m] ∘ ℓ_in[n,m]. The circle operator denotes convolution: the impulse response shapes the input signal to produce the output.');\n    }\n  }\n\n  document.querySelectorAll('.hot').forEach(el => {\n    el.addEventListener('mouseenter', () => {\n      setHover(el, true);\n      const msg = el.getAttribute('data-tooltip');\n      if (msg) {\n        tt.textContent = msg;\n        tt.style.display = 'block';\n      }\n    });\n    el.addEventListener('mouseleave', () => {\n      setHover(el, false);\n      tt.style.display = 'none';\n    });\n    el.addEventListener('click', e => {\n      e.stopPropagation();\n      popupFor(el.id);\n      runFlow();\n    });\n  });\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.tagName.toLowerCase() === 'svg') hidePopup();\n  });\n} catch (err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
