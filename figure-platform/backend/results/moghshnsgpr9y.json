  "filename": "figure_6",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); opacity:0; transition:opacity 0.2s; }\n.ray { cursor:pointer; }\n.ray:hover { stroke-width:2.5; }\n.annotation { font:10px sans-serif; fill:#333; }\n.label { font:11px sans-serif; fill:#0066cc; }\n.axis-label { font:10px sans-serif; fill:#cc0000; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 432 301\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#0066ff\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel a) - Top diagram -->\n  <g transform=\"translate(216,75)\">\n    <!-- Optical axis -->\n    <line x1=\"-200\" y1=\"0\" x2=\"200\" y2=\"0\" stroke=\"#cc0000\" stroke-width=\"1\"/>\n    \n    <!-- Thin lens -->\n    <line x1=\"0\" y1=\"-40\" x2=\"0\" y2=\"40\" stroke=\"#000\" stroke-width=\"2\"/>\n    <text x=\"5\" y=\"50\" class=\"annotation\">thin lens</text>\n    \n    <!-- Incoming rays -->\n    <line class=\"ray\" x1=\"-180\" y1=\"-30\" x2=\"0\" y2=\"-20\" stroke=\"#0066ff\" stroke-width=\"1\" data-label=\"θ₁ — incident ray\"/>\n    <line class=\"ray\" x1=\"-180\" y1=\"-20\" x2=\"0\" y2=\"-10\" stroke=\"#0066ff\" stroke-width=\"1\" stroke-dasharray=\"4,2\" data-label=\"parallel ray\"/>\n    \n    <!-- Outgoing rays -->\n    <line class=\"ray\" x1=\"0\" y1=\"-20\" x2=\"180\" y2=\"-35\" stroke=\"#0066ff\" stroke-width=\"1\" stroke-dasharray=\"4,2\" data-label=\"θ₂ — refracted ray\"/>\n    <line class=\"ray\" x1=\"0\" y1=\"-10\" x2=\"180\" y2=\"-20\" stroke=\"#0066ff\" stroke-width=\"1\" data-label=\"θ₃ — refracted ray\"/>\n    \n    <!-- Labels -->\n    <text x=\"-100\" y=\"-35\" class=\"label\">θ₁</text>\n    <text x=\"100\" y=\"-40\" class=\"label\">θ₂</text>\n    <text x=\"-90\" y=\"15\" class=\"annotation\">optical axis</text>\n    <text x=\"-50\" y=\"-10\" class=\"label\">a</text>\n    <text x=\"50\" y=\"-15\" class=\"label\">b</text>\n  </g>\n  \n  <!-- Panel b) - Bottom diagram -->\n  <g transform=\"translate(216,200)\">\n    <!-- Optical axis -->\n    <line x1=\"-200\" y1=\"0\" x2=\"200\" y2=\"0\" stroke=\"#cc0000\" stroke-width=\"1\"/>\n    \n    <!-- Curved lens representation -->\n    <path d=\"M-40,-50 Q0,-55 40,-50\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n    <path d=\"M-40,50 Q0,55 40,50\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n    <line x1=\"-40\" y1=\"-50\" x2=\"-40\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\"/>\n    <line x1=\"40\" y1=\"-50\" x2=\"40\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\"/>\n    \n    <!-- Circle at center -->\n    <circle cx=\"0\" cy=\"0\" r=\"25\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n    <text x=\"-10\" y=\"5\" class=\"annotation\">α=0</text>\n    \n    <!-- Incoming rays from left -->\n    <line class=\"ray\" x1=\"-180\" y1=\"-25\" x2=\"-40\" y2=\"-15\" stroke=\"#0066ff\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-label=\"θ₃ — incident ray\"/>\n    <line class=\"ray\" x1=\"-180\" y1=\"0\" x2=\"-40\" y2=\"0\" stroke=\"#cc6600\" stroke-width=\"1\" data-label=\"optical axis ray\"/>\n    \n    <!-- Refracted rays inside lens -->\n    <line class=\"ray\" x1=\"-40\" y1=\"-15\" x2=\"0\" y2=\"-20\" stroke=\"#0066ff\" stroke-width=\"1\" data-label=\"θ₄ — internal ray\"/>\n    <line class=\"ray\" x1=\"0\" y1=\"-20\" x2=\"40\" y2=\"-10\" stroke=\"#0066ff\" stroke-width=\"1\" data-label=\"θ₅ — internal ray\"/>\n    \n    <!-- Outgoing rays to right -->\n    <line class=\"ray\" x1=\"40\" y1=\"-10\" x2=\"180\" y2=\"-30\" stroke=\"#0066ff\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-label=\"θ₆ — emergent ray\"/>\n    <line class=\"ray\" x1=\"40\" y1=\"0\" x2=\"180\" y2=\"0\" stroke=\"#cc6600\" stroke-width=\"1\" data-label=\"optical axis ray\"/>\n    \n    <!-- Labels -->\n    <text x=\"-110\" y=\"-20\" class=\"label\">θ₃</text>\n    <text x=\"-25\" y=\"-30\" class=\"label\">θ₄</text>\n    <text x=\"15\" y=\"-30\" class=\"label\">θ₅</text>\n    <text x=\"110\" y=\"-35\" class=\"label\">θ₆</text>\n    <text x=\"-110\" y=\"10\" class=\"label\">a</text>\n    <text x=\"110\" y=\"10\" class=\"label\">b</text>\n    \n    <!-- Annotations -->\n    <text x=\"-190\" y=\"-40\" class=\"annotation\" style=\"font-size:9px\">parallel to</text>\n    <text x=\"-190\" y=\"-30\" class=\"annotation\" style=\"font-size:9px\">optical axis</text>\n    <text x=\"60\" y=\"-60\" class=\"annotation\" style=\"font-size:9px\">parallel to</text>\n    <text x=\"60\" y=\"-50\" class=\"annotation\" style=\"font-size:9px\">optical axis</text>\n    <text x=\"140\" y=\"15\" class=\"axis-label\">α₂=0</text>\n    <text x=\"-60\" y=\"70\" class=\"annotation\" style=\"font-size:9px\">distances and angles</text>\n    <text x=\"-60\" y=\"80\" class=\"annotation\" style=\"font-size:9px\">distorted for clarity of</text>\n    <text x=\"-60\" y=\"90\" class=\"annotation\" style=\"font-size:9px\">labeling</text>\n  </g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const rays = document.querySelectorAll('.ray');\n  \n  let activeRay = null;\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n  rays.forEach(ray => {\n    ray.addEventListener('mouseenter', e => {\n      const label = e.target.getAttribute('data-label');\n      if (label) {\n        tooltip.textContent = label;\n        tooltip.style.opacity = '1';\n        activeRay = e.target;\n      }\n    });\n    \n    ray.addEventListener('mouseleave', () => {\n      tooltip.style.opacity = '0';\n      activeRay = null;\n    });\n    \n    ray.addEventListener('click', e => {\n      e.stopPropagation();\n      const label = e.target.getAttribute('data-label');\n      if (label) {\n        const [angle, desc] = label.split(' — ');\n        let body = '';\n        if (angle.startsWith('θ')) {\n          body = `This ray shows the ${desc} with angle ${angle}. In thin lens optics, rays are bent according to Snell's law at each interface. The angle of refraction depends on the refractive indices of the media and the angle of incidence.`;\n        } else if (desc === 'optical axis ray') {\n          body = 'Rays traveling along the optical axis pass through the lens without deviation. This is the principal axis of the optical system.';\n        }\n        showPopup(label, body);\n      }\n    });\n  });\n  \n  document.addEventListener('mousemove', e => {\n    if (activeRay) {\n      tooltip.style.left = (e.clientX + 12) + 'px';\n      tooltip.style.top = (e.clientY - 28) + 'px';\n    }\n  });\n\n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
