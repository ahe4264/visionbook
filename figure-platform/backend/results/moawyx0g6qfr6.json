  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody {\n    margin: 0;\n    padding: 12px;\n    background: #ffffff;\n    font-family: sans-serif;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 100vh;\n    box-sizing: border-box;\n}\n\n.container {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n}\n\n.panel-wrapper {\n    position: relative;\n}\n\n.panel-label {\n    position: absolute;\n    top: -20px;\n    left: 0;\n    font-size: 13px;\n    color: #000;\n}\n\n.panel {\n    width: 150px;\n    height: 120px;\n    position: relative;\n    cursor: pointer;\n    transition: transform 0.2s;\n}\n\n.panel:hover {\n    transform: scale(1.05);\n}\n\n.panel svg {\n    width: 100%;\n    height: 100%;\n}\n\n.arrow {\n    width: 30px;\n    height: 20px;\n    position: relative;\n}\n\n.arrow svg {\n    width: 100%;\n    height: 100%;\n}\n\n.tooltip {\n    position: fixed;\n    background: rgba(60,60,60,0.75);\n    backdrop-filter: blur(4px);\n    color: #fff;\n    font: 11px/1.4 sans-serif;\n    padding: 5px 8px;\n    border-radius: 5px;\n    pointer-events: none;\n    z-index: 100;\n    max-width: 200px;\n    display: none;\n}\n\n.popup {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: rgba(245,245,245,0.94);\n    backdrop-filter: blur(6px);\n    border-top: 1px solid rgba(0,0,0,0.1);\n    padding: 8px 12px;\n    font: 12px/1.5 sans-serif;\n    color: #333;\n    z-index: 101;\n    box-shadow: 0 -2px 12px rgba(0,0,0,0.08);\n    display: none;\n}\n\n.highlight {\n    filter: brightness(1.2);\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n    <div class=\"panel-wrapper\">\n        <div class=\"panel-label\">a)</div>\n        <div class=\"panel\" id=\"panel-a\">\n            <svg viewBox=\"0 0 150 120\">\n                <!-- 3D box -->\n                <path d=\"M 20 80 L 20 30 L 60 10 L 130 10 L 130 60 L 90 80 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                <path d=\"M 20 30 L 90 30 L 90 80\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                <path d=\"M 90 30 L 130 10\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                \n                <!-- Cyan curve -->\n                <path d=\"M 25 70 Q 40 35, 55 65 Q 70 95, 85 40\" fill=\"none\" stroke=\"#00CED1\" stroke-width=\"2\"/>\n                \n                <!-- Labels -->\n                <text x=\"10\" y=\"50\" font-size=\"11\" transform=\"rotate(-90 10 50)\" text-anchor=\"middle\">Output, y</text>\n                <text x=\"75\" y=\"95\" font-size=\"11\" text-anchor=\"middle\">Input, x</text>\n            </svg>\n        </div>\n    </div>\n    \n    <div class=\"arrow\" id=\"arrow-1\">\n        <svg viewBox=\"0 0 30 20\">\n            <path d=\"M 5 10 L 20 10 M 15 5 L 20 10 L 15 15\" fill=\"none\" stroke=\"#999\" stroke-width=\"1.5\"/>\n        </svg>\n    </div>\n    \n    <div class=\"panel-wrapper\">\n        <div class=\"panel-label\">b)</div>\n        <div class=\"panel\" id=\"panel-b\">\n            <svg viewBox=\"0 0 150 120\">\n                <!-- 2D rectangle -->\n                <rect x=\"30\" y=\"20\" width=\"90\" height=\"80\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                \n                <!-- Brown curve -->\n                <path d=\"M 35 70 L 45 35 L 55 65 L 65 40 L 75 75\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n                \n                <!-- Blue curve -->\n                <path d=\"M 75 55 L 85 35 L 95 45 L 105 30 L 115 60\" fill=\"none\" stroke=\"#4169E1\" stroke-width=\"2\"/>\n                \n                <!-- Labels -->\n                <text x=\"20\" y=\"60\" font-size=\"11\" transform=\"rotate(-90 20 60)\" text-anchor=\"middle\">Output, y'</text>\n                <text x=\"75\" y=\"110\" font-size=\"11\" text-anchor=\"middle\">Input, y</text>\n            </svg>\n        </div>\n    </div>\n    \n    <div class=\"arrow\" id=\"arrow-2\">\n        <svg viewBox=\"0 0 30 20\">\n            <path d=\"M 5 10 L 20 10 M 15 5 L 20 10 L 15 15\" fill=\"none\" stroke=\"#999\" stroke-width=\"1.5\"/>\n        </svg>\n    </div>\n    \n    <div class=\"panel-wrapper\">\n        <div class=\"panel-label\">c)</div>\n        <div class=\"panel\" id=\"panel-c\">\n            <svg viewBox=\"0 0 150 120\">\n                <!-- 3D box -->\n                <path d=\"M 20 80 L 20 30 L 60 10 L 130 10 L 130 60 L 90 80 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                <path d=\"M 20 30 L 90 30 L 90 80\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                <path d=\"M 90 30 L 130 10\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n                \n                <!-- Gray curve -->\n                <path d=\"M 25 65 L 35 45 L 45 55 L 55 40 L 65 60 L 75 45 L 85 55\" fill=\"none\" stroke=\"#696969\" stroke-width=\"2\"/>\n                \n                <!-- Red spike -->\n                <path d=\"M 75 55 L 75 25 L 75 55\" fill=\"none\" stroke=\"#DC143C\" stroke-width=\"2\"/>\n                \n                <!-- Labels -->\n                <text x=\"10\" y=\"50\" font-size=\"11\" transform=\"rotate(-90 10 50)\" text-anchor=\"middle\">Output, y'</text>\n                <text x=\"75\" y=\"95\" font-size=\"11\" text-anchor=\"middle\">Input, x</text>\n            </svg>\n        </div>\n    </div>\n</div>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\"></div>\n\n<script>\nconst tooltip = document.getElementById('tooltip');\nconst popup = document.getElementById('popup');\n\nconst panelData = {\n    'panel-a': {\n        hover: 'Initial input-output mapping',\n        click: 'Panel (a) shows the original function mapping from input x to output y. The cyan curve represents the transformation function in the input-output space.'\n    },\n    'panel-b': {\n        hover: 'Transformation process',\n        click: 'Panel (b) illustrates the intermediate transformation stage. The brown curve shows the input y being processed, while the blue curve represents the emerging output y\\'.'\n    },\n    'panel-c': {\n        hover: 'Final transformed mapping',\n        click: 'Panel (c) displays the final result with the transformed output y\\'. The gray curve shows the new mapping, with a distinctive red spike indicating a key feature of the transformation.'\n    }\n};\n\n// Hover handlers\ndocument.querySelectorAll('.panel').forEach(panel => {\n    panel.addEventListener('mouseenter', (e) => {\n        tooltip.textContent = panelData[panel.id].hover;\n        tooltip.style.display = 'block';\n        \n        // Highlight connected elements\n        if (panel.id === 'panel-a') {\n            document.getElementById('arrow-1').classList.add('highlight');\n            document.getElementById('panel-b').classList.add('highlight');\n        } else if (panel.id === 'panel-b') {\n            document.getElementById('arrow-2').classList.add('highlight');\n            document.getElementById('panel-c').classList.add('highlight');\n        }\n    });\n    \n    panel.addEventListener('mousemove', (e) => {\n        tooltip.style.left = (e.clientX + 10) + 'px';\n        tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    panel.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n        document.querySelectorAll('.highlight').forEach(el => el.classList.remove('highlight'));\n    });\n    \n    panel.addEventListener('click', () => {\n        popup.textContent = panelData[panel.id].click;\n        popup.style.display = 'block';\n    });\n});\n\n// Arrow hover\ndocument.querySelectorAll('.arrow').forEach(arrow => {\n    arrow.addEventListener('mouseenter', (e) => {\n        tooltip.textContent = 'Transformation flow';\n        tooltip.style.display = 'block';\n    });\n    \n    arrow.addEventListener('mousemove', (e) => {\n        tooltip.style.left = (e.clientX + 10) + 'px';\n        tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    arrow.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n    });\n});\n\n// Click outside or escape to close popup\ndocument.addEventListener('click', (e) => {\n    if (!e.target.closest('.panel') && popup.style.display === 'block') {\n        popup.style.display = 'none';\n    }\n});\n\ndocument.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n        popup.style.display = 'none';\n    }\n});\n</script>\n</body>\n</html>",
