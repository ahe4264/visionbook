  "filename": "figure_102",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 245 192\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"4\" markerHeight=\"4\" refX=\"3\" refY=\"2\" orient=\"auto\">\n      <path d=\"M0,0 L0,4 L4,2 z\" fill=\"#666\"/>\n    </marker>\n  </defs>\n  \n  <!-- Wall background -->\n  <rect x=\"8\" y=\"8\" width=\"50\" height=\"176\" fill=\"#e8e8e8\" stroke=\"#ccc\" stroke-width=\"1\"/>\n  \n  <!-- Pinhole panel -->\n  <rect x=\"90\" y=\"8\" width=\"20\" height=\"176\" fill=\"#2c3e50\" stroke=\"#1a252f\" stroke-width=\"1\"/>\n  <circle cx=\"100\" cy=\"96\" r=\"2\" fill=\"#fff\"/>\n  \n  <!-- Tree on right -->\n  <g id=\"tree\">\n    <rect x=\"180\" y=\"120\" width=\"12\" height=\"40\" fill=\"#8B4513\" rx=\"2\"/>\n    <circle cx=\"186\" cy=\"105\" r=\"20\" fill=\"#228B22\"/>\n    <circle cx=\"175\" cy=\"100\" r=\"15\" fill=\"#32CD32\"/>\n    <circle cx=\"197\" cy=\"100\" r=\"15\" fill=\"#32CD32\"/>\n    <circle cx=\"186\" cy=\"90\" r=\"18\" fill=\"#228B22\"/>\n  </g>\n  \n  <!-- Vase on left (inverted tree image) -->\n  <g id=\"vase\" transform=\"translate(33, 130) scale(1, -1) translate(-33, -130)\">\n    <rect x=\"27\" y=\"120\" width=\"12\" height=\"40\" fill=\"#D2691E\" rx=\"2\" opacity=\"0.7\"/>\n    <circle cx=\"33\" cy=\"105\" r=\"20\" fill=\"#90EE90\" opacity=\"0.7\"/>\n    <circle cx=\"22\" cy=\"100\" r=\"15\" fill=\"#98FB98\" opacity=\"0.7\"/>\n    <circle cx=\"44\" cy=\"100\" r=\"15\" fill=\"#98FB98\" opacity=\"0.7\"/>\n    <circle cx=\"33\" cy=\"90\" r=\"18\" fill=\"#90EE90\" opacity=\"0.7\"/>\n  </g>\n  \n  <!-- Light rays -->\n  <line id=\"ray1\" x1=\"175\" y1=\"85\" x2=\"100\" y2=\"96\" stroke=\"#228B22\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  <line id=\"ray2\" x1=\"186\" y1=\"125\" x2=\"100\" y2=\"96\" stroke=\"#228B22\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  <line id=\"ray3\" x1=\"197\" y1=\"105\" x2=\"100\" y2=\"96\" stroke=\"#228B22\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  \n  <line id=\"ray4\" x1=\"100\" y1=\"96\" x2=\"44\" y2=\"107\" stroke=\"#8B4513\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  <line id=\"ray5\" x1=\"100\" y1=\"96\" x2=\"33\" y2=\"67\" stroke=\"#8B4513\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  <line id=\"ray6\" x1=\"100\" y1=\"96\" x2=\"22\" y2=\"87\" stroke=\"#8B4513\" stroke-width=\"1.5\" opacity=\"0.6\" marker-end=\"url(#arr)\"/>\n  \n  <!-- Labels -->\n  <text x=\"33\" y=\"25\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#333\" text-anchor=\"middle\">Wall</text>\n  <text x=\"100\" y=\"25\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#333\" text-anchor=\"middle\">Pinhole</text>\n  <text x=\"12\" y=\"185\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#666\">(b)</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const elements = {\n    tree: document.getElementById('tree'),\n    vase: document.getElementById('vase'),\n    pinhole: svg.querySelector('circle[cx=\"100\"]'),\n    wall: svg.querySelector('rect[x=\"8\"]'),\n    rays: svg.querySelectorAll('line')\n  };\n  \n  const graph = {\n    'tree': { out: ['pinhole'], in: [], label: 'Tree', role: 'Light source object' },\n    'pinhole': { out: ['vase'], in: ['tree'], label: 'Pinhole', role: 'Aperture for light' },\n    'vase': { out: [], in: ['pinhole'], label: 'Projected image', role: 'Inverted tree projection' },\n    'wall': { out: [], in: [], label: 'Wall', role: 'Projection surface' }\n  };\n  \n  function showTooltip(text, x, y) {\n    tooltip.textContent = text;\n    tooltip.style.display = 'block';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.display = 'none';\n  }\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  // Tree interaction\n  elements.tree.addEventListener('mouseenter', () => {\n    elements.tree.style.opacity = '0.8';\n    document.querySelectorAll('#ray1, #ray2, #ray3').forEach(r => {\n      r.style.stroke = '#e07b30';\n      r.style.strokeWidth = '2.5';\n    });\n    showTooltip('Tree — light source');\n  });\n  \n  elements.tree.addEventListener('mouseleave', () => {\n    elements.tree.style.opacity = '1';\n    document.querySelectorAll('#ray1, #ray2, #ray3').forEach(r => {\n      r.style.stroke = '#228B22';\n      r.style.strokeWidth = '1.5';\n    });\n    hideTooltip();\n  });\n  \n  elements.tree.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Tree', 'The tree acts as the light source. Light rays from different points on the tree travel through the pinhole to create an inverted image on the wall.');\n  });\n  \n  // Vase interaction\n  elements.vase.addEventListener('mouseenter', () => {\n    elements.vase.style.opacity = '0.5';\n    showTooltip('Projected image — inverted');\n  });\n  \n  elements.vase.addEventListener('mouseleave', () => {\n    elements.vase.style.opacity = '1';\n    hideTooltip();\n  });\n  \n  elements.vase.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Projected Image', 'The inverted image of the tree appears on the wall. This inversion occurs because light rays cross at the pinhole, causing top rays to hit the bottom and vice versa.');\n  });\n  \n  // Pinhole interaction\n  elements.pinhole.addEventListener('mouseenter', () => {\n    elements.pinhole.setAttribute('r', '3');\n    elements.pinhole.style.fill = '#ffff00';\n    elements.rays.forEach(r => {\n      r.style.stroke = '#e07b30';\n      r.style.strokeWidth = '2.5';\n    });\n    showTooltip('Pinhole — aperture');\n  });\n  \n  elements.pinhole.addEventListener('mouseleave', () => {\n    elements.pinhole.setAttribute('r', '2');\n    elements.pinhole.style.fill = '#fff';\n    elements.rays.forEach((r, i) => {\n      r.style.stroke = i < 3 ? '#228B22' : '#8B4513';\n      r.style.strokeWidth = '1.5';\n    });\n    hideTooltip();\n  });\n  \n  elements.pinhole.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Pinhole', 'The small aperture restricts light rays to a single path from each point on the object, creating a sharp but dim inverted image. Smaller pinholes create sharper images.');\n    \n    // Animate light flow\n    elements.rays.forEach((ray, i) => {\n      const len = ray.getTotalLength();\n      ray.style.transition = 'none';\n      ray.style.strokeDasharray = len;\n      ray.style.strokeDashoffset = len;\n      ray.style.stroke = '#4a7ef5';\n      ray.style.strokeWidth = '2';\n      \n      setTimeout(() => {\n        ray.style.transition = 'stroke-dashoffset 0.6s ease';\n        ray.style.strokeDashoffset = '0';\n      }, i * 100);\n    });\n    \n    setTimeout(() => {\n      elements.rays.forEach((r, i) => {\n        r.style.stroke = i < 3 ? '#228B22' : '#8B4513';\n        r.style.strokeWidth = '1.5';\n        r.style.strokeDasharray = 'none';\n      });\n    }, 1500);\n  });\n  \n  // Wall interaction\n  elements.wall.addEventListener('mouseenter', () => {\n    elements.wall.style.fill = '#d8d8d8';\n    showTooltip('Wall — projection surface');\n  });\n  \n  elements.wall.addEventListener('mouseleave', () => {\n    elements.wall.style.fill = '#e8e8e8';\n    hideTooltip();\n  });\n  \n  elements.wall.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Projection Wall', 'The wall serves as the projection surface where the inverted image forms. The distance from the pinhole affects the image size—farther walls create larger images.');\n  });\n  \n} catch(e) {\n  console.error('Script error:', e);\n}\n</script>\n</body>\n</html>",
