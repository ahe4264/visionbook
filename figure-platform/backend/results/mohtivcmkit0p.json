  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 425 187\" id=\"svg\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Black lines from O to P points -->\n  <line x1=\"20\" y1=\"93\" x2=\"60\" y2=\"140\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"P1\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"60\" y2=\"110\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"P2\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"60\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"P3\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"100\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"P4\"/>\n  \n  <!-- Black lines from O to Q points -->\n  <line x1=\"20\" y1=\"93\" x2=\"210\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"Q1\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"210\" y2=\"110\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"Q2\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"210\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"Q3\"/>\n  <line x1=\"20\" y1=\"93\" x2=\"250\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\" data-from=\"O\" data-to=\"Q4\"/>\n  \n  <!-- Black lines extending to R points -->\n  <line x1=\"210\" y1=\"150\" x2=\"390\" y2=\"93\" stroke=\"#000\" stroke-width=\"1\" data-from=\"Q1\" data-to=\"R1\"/>\n  <line x1=\"210\" y1=\"110\" x2=\"325\" y2=\"75\" stroke=\"#000\" stroke-width=\"1\" data-from=\"Q2\" data-to=\"R2\"/>\n  <line x1=\"210\" y1=\"70\" x2=\"315\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" data-from=\"Q3\" data-to=\"R3\"/>\n  <line x1=\"250\" y1=\"50\" x2=\"320\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" data-from=\"Q4\" data-to=\"R4\"/>\n  \n  <!-- Red lines from P to Q -->\n  <line x1=\"60\" y1=\"140\" x2=\"210\" y2=\"150\" stroke=\"#ff0000\" stroke-width=\"1\" data-from=\"P1\" data-to=\"Q1\"/>\n  <line x1=\"60\" y1=\"110\" x2=\"210\" y2=\"110\" stroke=\"#ff0000\" stroke-width=\"1\" data-from=\"P2\" data-to=\"Q2\"/>\n  <line x1=\"60\" y1=\"80\" x2=\"210\" y2=\"70\" stroke=\"#ff0000\" stroke-width=\"1\" data-from=\"P3\" data-to=\"Q3\"/>\n  <line x1=\"100\" y1=\"50\" x2=\"250\" y2=\"50\" stroke=\"#ff0000\" stroke-width=\"1\" data-from=\"P4\" data-to=\"Q4\"/>\n  \n  <!-- Points -->\n  <circle cx=\"20\" cy=\"93\" r=\"3\" fill=\"#000\" data-id=\"O\" data-label=\"O — origin\"/>\n  <circle cx=\"60\" cy=\"140\" r=\"3\" fill=\"#000\" data-id=\"P1\" data-label=\"P₁ — point P1\"/>\n  <circle cx=\"60\" cy=\"110\" r=\"3\" fill=\"#000\" data-id=\"P2\" data-label=\"P₂ — point P2\"/>\n  <circle cx=\"60\" cy=\"80\" r=\"3\" fill=\"#000\" data-id=\"P3\" data-label=\"P₃ — point P3\"/>\n  <circle cx=\"100\" cy=\"50\" r=\"3\" fill=\"#000\" data-id=\"P4\" data-label=\"P₄ — point P4\"/>\n  <circle cx=\"210\" cy=\"150\" r=\"3\" fill=\"#000\" data-id=\"Q1\" data-label=\"Q₁ — point Q1\"/>\n  <circle cx=\"210\" cy=\"110\" r=\"3\" fill=\"#000\" data-id=\"Q2\" data-label=\"Q₂ — point Q2\"/>\n  <circle cx=\"210\" cy=\"70\" r=\"3\" fill=\"#000\" data-id=\"Q3\" data-label=\"Q₃ — point Q3\"/>\n  <circle cx=\"250\" cy=\"50\" r=\"3\" fill=\"#000\" data-id=\"Q4\" data-label=\"Q₄ — point Q4\"/>\n  <circle cx=\"390\" cy=\"93\" r=\"3\" fill=\"#000\" data-id=\"R1\" data-label=\"R₁ — point R1\"/>\n  <circle cx=\"325\" cy=\"75\" r=\"3\" fill=\"#000\" data-id=\"R2\" data-label=\"R₂ — point R2\"/>\n  <circle cx=\"315\" cy=\"40\" r=\"3\" fill=\"#000\" data-id=\"R3\" data-label=\"R₃ — point R3\"/>\n  <circle cx=\"320\" cy=\"30\" r=\"3\" fill=\"#000\" data-id=\"R4\" data-label=\"R₄ — point R4\"/>\n  \n  <!-- Labels -->\n  <text x=\"20\" y=\"88\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">O</text>\n  <text x=\"55\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">P₁</text>\n  <text x=\"55\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">P₂</text>\n  <text x=\"55\" y=\"75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">P₃</text>\n  <text x=\"100\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">P₄</text>\n  <text x=\"215\" y=\"165\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Q₁</text>\n  <text x=\"215\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Q₂</text>\n  <text x=\"215\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Q₃</text>\n  <text x=\"255\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Q₄</text>\n  <text x=\"405\" y=\"98\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">R₁→∞</text>\n  <text x=\"330\" y=\"70\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">R₂</text>\n  <text x=\"310\" y=\"35\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">R₃</text>\n  <text x=\"330\" y=\"25\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">R₄</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.getElementById('svg');\n  const tooltip = document.getElementById('tooltip');\n  const circles = svg.querySelectorAll('circle');\n  const lines = svg.querySelectorAll('line');\n  \n  // Graph connectivity\n  const graph = {\n    'O': { out: ['P1','P2','P3','P4','Q1','Q2','Q3','Q4'], in: [] },\n    'P1': { out: ['Q1'], in: ['O'] },\n    'P2': { out: ['Q2'], in: ['O'] },\n    'P3': { out: ['Q3'], in: ['O'] },\n    'P4': { out: ['Q4'], in: ['O'] },\n    'Q1': { out: ['R1'], in: ['O', 'P1'] },\n    'Q2': { out: ['R2'], in: ['O', 'P2'] },\n    'Q3': { out: ['R3'], in: ['O', 'P3'] },\n    'Q4': { out: ['R4'], in: ['O', 'P4'] },\n    'R1': { out: [], in: ['Q1'] },\n    'R2': { out: [], in: ['Q2'] },\n    'R3': { out: [], in: ['Q3'] },\n    'R4': { out: [], in: ['Q4'] }\n  };\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Show/hide popup\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Escape key and background click to hide popup\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { \n    if (e.target === svg || e.target.tagName === 'svg') hidePopup(); \n  });\n  \n  // Circle interactions\n  circles.forEach(c => {\n    c.style.cursor = 'pointer';\n    \n    c.addEventListener('mouseenter', e => {\n      e.stopPropagation();\n      const id = c.getAttribute('data-id');\n      const label = c.getAttribute('data-label');\n      \n      // Highlight node\n      c.style.strokeWidth = '2';\n      c.style.stroke = '#000';\n      c.style.fillOpacity = '0.8';\n      \n      // Highlight outgoing edges only\n      lines.forEach(l => {\n        if (l.getAttribute('data-from') === id) {\n          l.style.stroke = '#e07b30';\n          l.style.strokeWidth = '2';\n        }\n      });\n      \n      // Show tooltip\n      tooltip.textContent = label;\n      tooltip.style.display = 'block';\n    });\n    \n    c.addEventListener('mouseleave', () => {\n      c.style.strokeWidth = '0';\n      c.style.stroke = '';\n      c.style.fillOpacity = '1';\n      \n      // Reset edges\n      lines.forEach(l => {\n        if (l.getAttribute('stroke') === '#ff0000') {\n          l.style.stroke = '#ff0000';\n        } else {\n          l.style.stroke = '#000';\n        }\n        l.style.strokeWidth = '1';\n      });\n      \n      tooltip.style.display = 'none';\n    });\n    \n    c.addEventListener('click', e => {\n      e.stopPropagation();\n      const id = c.getAttribute('data-id');\n      let body = '';\n      \n      if (id === 'O') {\n        body = 'The origin point O is the starting point of this geometric construction. All primary lines emanate from this point to create the perspective framework.';\n      } else if (id.startsWith('P')) {\n        body = `Point ${id} is one of the primary construction points. The red line connects it to the corresponding Q point, establishing the perspective relationship.`;\n      } else if (id.startsWith('Q')) {\n        body = `Point ${id} is an intermediate point in the construction. It receives connections from both the origin O and the corresponding P point, then extends to the R point.`;\n      } else if (id.startsWith('R')) {\n        body = `Point ${id} represents the final position in this geometric sequence. ${id === 'R1' ? 'R₁ extends to infinity, suggesting a vanishing point in perspective drawing.' : 'It completes the perspective construction for this line.'}`;\n      }\n      \n      showPopup(`Point ${id}`, body);\n      \n      // Animate signal flow\n      animateFlow(id, e.shiftKey);\n    });\n  });\n  \n  // Line hover\n  lines.forEach(l => {\n    l.addEventListener('mouseenter', () => {\n      l.style.strokeWidth = '2';\n      if (l.getAttribute('stroke') === '#ff0000') {\n        l.style.stroke = '#ff3333';\n      } else {\n        l.style.stroke = '#333';\n      }\n    });\n    \n    l.addEventListener('mouseleave', () => {\n      l.style.strokeWidth = '1';\n      if (l.getAttribute('stroke') === '#ff0000') {\n        l.style.stroke = '#ff0000';\n      } else {\n        l.style.stroke = '#000';\n      }\n    });\n  });\n  \n  function animateFlow(startId, backward = false) {\n    // Reset all lines first\n    lines.forEach(l => {\n      l.style.transition = 'none';\n      l.style.strokeDasharray = '';\n      l.style.strokeDashoffset = '';\n    });\n    \n    if (backward) {\n      // Backward flow - animate incoming edges\n      const incoming = graph[startId].in;\n      const edges = Array.from(lines).filter(l => \n        incoming.includes(l.getAttribute('data-from')) && l.getAttribute('data-to') === startId\n      );\n      \n      animateEdges(edges, '#e05050', 0);\n    } else {\n      // Forward flow - animate outgoing edges\n      const outgoing = graph[startId].out;\n      const edges = Array.from(lines).filter(l => \n        l.getAttribute('data-from') === startId && outgoing.includes(l.getAttribute('data-to'))\n      );\n      \n      animateEdges(edges, '#4a7ef5', 0);\n      \n      // Pulse destination nodes\n      edges.forEach(e => {\n        const targetId = e.getAttribute('data-to');\n        const targetNode = svg.querySelector(`circle[data-id=\"${targetId}\"]`);\n        if (targetNode) {\n          setTimeout(() => {\n            targetNode.style.transformBox = 'fill-box';\n            targetNode.style.transformOrigin = 'center';\n            targetNode.style.transition = 'transform 0.15s ease';\n            targetNode.style.transform = 'scale(1.18)';\n            setTimeout(() => { targetNode.style.transform = 'scale(1)'; }, 200);\n          }, 350);\n        }\n      });\n    }\n    \n    // Restore original colors after animation\n    setTimeout(() => {\n      lines.forEach(l => {\n        l.style.transition = 'stroke 0.3s ease';\n        if (l.getAttribute('stroke') === '#ff0000') {\n          l.style.stroke = '#ff0000';\n        } else {\n          l.style.stroke = '#000';\n        }\n        l.style.strokeDasharray = '';\n        l.style.strokeDashoffset = '';\n      });\n    }, 1200);\n  }\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n} catch(e) {\n  console.error('Error:', e);\n}\n</script>\n</body>\n</html>",
