  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n    position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 489 121\">\n<defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n        <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n</defs>\n<g id=\"network\">\n    <text x=\"16\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">a)</text>\n    \n    <!-- Edges -->\n    <line data-edge=\"x-h1\" x1=\"60\" y1=\"60\" x2=\"129\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"x-h2\" x1=\"60\" y1=\"60\" x2=\"129\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"x-h3\" x1=\"60\" y1=\"60\" x2=\"129\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <line data-edge=\"h1-y\" x1=\"159\" y1=\"30\" x2=\"228\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"h2-y\" x1=\"159\" y1=\"60\" x2=\"228\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"h3-y\" x1=\"159\" y1=\"90\" x2=\"228\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <line data-edge=\"y-h4\" x1=\"258\" y1=\"60\" x2=\"327\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"y-h5\" x1=\"258\" y1=\"60\" x2=\"327\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"y-h6\" x1=\"258\" y1=\"60\" x2=\"327\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <line data-edge=\"h4-yp\" x1=\"357\" y1=\"30\" x2=\"426\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"h5-yp\" x1=\"357\" y1=\"60\" x2=\"426\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line data-edge=\"h6-yp\" x1=\"357\" y1=\"90\" x2=\"426\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <!-- Nodes -->\n    <circle data-node=\"x\" cx=\"60\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"60\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">x</text>\n    \n    <circle data-node=\"h1\" cx=\"144\" cy=\"30\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"144\" y=\"35\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h₁</text>\n    <path d=\"M136,30 Q140,26 144,30 T152,30\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"h2\" cx=\"144\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"144\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h₂</text>\n    <path d=\"M136,60 Q140,56 144,60 T152,60\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"h3\" cx=\"144\" cy=\"90\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"144\" y=\"95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h₃</text>\n    <path d=\"M136,90 Q140,86 144,90 T152,90\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"y\" cx=\"243\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"243\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">y</text>\n    \n    <circle data-node=\"h4\" cx=\"342\" cy=\"30\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"342\" y=\"35\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h′₁</text>\n    <path d=\"M334,30 Q338,26 342,30 T350,30\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"h5\" cx=\"342\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"342\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h′₂</text>\n    <path d=\"M334,60 Q338,56 342,60 T350,60\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"h6\" cx=\"342\" cy=\"90\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"342\" y=\"95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">h′₃</text>\n    <path d=\"M334,90 Q338,86 342,90 T350,90\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\" pointer-events=\"none\"/>\n    \n    <circle data-node=\"yp\" cx=\"441\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n    <text x=\"441\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\" pointer-events=\"none\">y′</text>\n</g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst graph = {\n    'x':  { out:['h1','h2','h3'], in:[],               label:'x',  role:'Input' },\n    'h1': { out:['y'],            in:['x'],             label:'h₁', role:'Hidden unit 1' },\n    'h2': { out:['y'],            in:['x'],             label:'h₂', role:'Hidden unit 2' },\n    'h3': { out:['y'],            in:['x'],             label:'h₃', role:'Hidden unit 3' },\n    'y':  { out:['h4','h5','h6'], in:['h1','h2','h3'], label:'y',  role:'Hidden layer' },\n    'h4': { out:['yp'],           in:['y'],             label:'h′₁', role:'Hidden unit 1' },\n    'h5': { out:['yp'],           in:['y'],             label:'h′₂', role:'Hidden unit 2' },\n    'h6': { out:['yp'],           in:['y'],             label:'h′₃', role:'Hidden unit 3' },\n    'yp': { out:[],               in:['h4','h5','h6'], label:'y′', role:'Output' }\n};\n\ndocument.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\nfunction showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\ndocument.querySelectorAll('[data-node]').forEach(node => {\n    const id = node.getAttribute('data-node');\n    const info = graph[id];\n    \n    node.addEventListener('mouseenter', () => {\n        node.setAttribute('stroke-width', '2.5');\n        node.style.fillOpacity = '0.9';\n        \n        graph[id].out.forEach(target => {\n            const edge = document.querySelector(`[data-edge=\"${id}-${target}\"]`);\n            if (edge) {\n                edge.style.stroke = '#e07b30';\n                edge.style.strokeWidth = '2';\n            }\n        });\n        \n        tooltip.textContent = `${info.label} — ${info.role}`;\n        tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', () => {\n        node.setAttribute('stroke-width', '1');\n        node.style.fillOpacity = '1';\n        \n        document.querySelectorAll('[data-edge]').forEach(edge => {\n            edge.style.stroke = '#000';\n            edge.style.strokeWidth = '1';\n        });\n        \n        tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n        e.stopPropagation();\n        const forward = !e.shiftKey;\n        \n        let body = `<b>${info.label}</b> — ${info.role}<br><br>`;\n        if (forward) {\n            body += `<b>Forward pass:</b><br>`;\n            if (info.out.length) {\n                body += `Sends signal to: ${info.out.map(n => graph[n].label).join(', ')}<br>`;\n            } else {\n                body += `Final output node<br>`;\n            }\n        } else {\n            body += `<b>Backward pass:</b><br>`;\n            if (info.in.length) {\n                body += `Receives gradients from: ${info.in.map(n => graph[n].label).join(', ')}<br>`;\n            } else {\n                body += `Initial input node<br>`;\n            }\n        }\n        \n        showPopup(`${info.label} — ${info.role}`, body);\n        \n        // Signal flow animation\n        animateSignalFlow(id, forward);\n    });\n});\n\nfunction animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n        edgeEls.forEach(e => {\n            const len = e.getTotalLength ? e.getTotalLength() : 200;\n            e.style.transition = 'none';\n            e.style.strokeDasharray = len;\n            e.style.strokeDashoffset = len;\n            e.style.stroke = color;\n            requestAnimationFrame(() => {\n                e.style.transition = 'stroke-dashoffset 0.6s ease';\n                e.style.strokeDashoffset = '0';\n            });\n        });\n    }, delay);\n}\n\nfunction pulseNode(nodeEl, delay) {\n    setTimeout(() => {\n        nodeEl.style.transformBox = 'fill-box';\n        nodeEl.style.transformOrigin = 'center';\n        nodeEl.style.transition = 'transform 0.15s ease';\n        nodeEl.style.transform = 'scale(1.18)';\n        setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n    }, delay);\n}\n\nfunction animateSignalFlow(startId, forward) {\n    const color = forward ? '#4a7ef5' : '#e05050';\n    const layers = forward ? \n        [['x'], ['h1','h2','h3'], ['y'], ['h4','h5','h6'], ['yp']] :\n        [['yp'], ['h4','h5','h6'], ['y'], ['h1','h2','h3'], ['x']];\n    \n    let activeLayer = -1;\n    for (let i = 0; i < layers.length; i++) {\n        if (layers[i].includes(startId)) {\n            activeLayer = i;\n            break;\n        }\n    }\n    \n    for (let i = activeLayer; i < layers.length - 1; i++) {\n        const delay = (i - activeLayer) * 650;\n        const edges = [];\n        \n        layers[i].forEach(nodeId => {\n            const targets = forward ? graph[nodeId].out : graph[nodeId].in;\n            targets.forEach(target => {\n                const edgeId = forward ? `${nodeId}-${target}` : `${target}-${nodeId}`;\n                const edge = document.querySelector(`[data-edge=\"${edgeId}\"]`);\n                if (edge) edges.push(edge);\n            });\n        });\n        \n        if (edges.length) animateEdges(edges, color, delay);\n        \n        layers[i + 1].forEach(nodeId => {\n            const nodeEl = document.querySelector(`[data-node=\"${nodeId}\"]`);\n            if (nodeEl) pulseNode(nodeEl, delay + 350);\n        });\n    }\n    \n    setTimeout(() => {\n        document.querySelectorAll('[data-edge]').forEach(edge => {\n            edge.style.transition = 'stroke 0.3s ease';\n            edge.style.stroke = '#000';\n            edge.style.strokeWidth = '1';\n            edge.style.strokeDasharray = '';\n            edge.style.strokeDashoffset = '';\n        });\n    }, (layers.length - activeLayer) * 650 + 1200);\n}\n\n// Draggable nodes\nlet dragNode = null, dragOffX = 0, dragOffY = 0;\n\nfunction svgPt(svg, e) {\n    const pt = svg.createSVGPoint();\n    pt.x = e.clientX; pt.y = e.clientY;\n    return pt.matrixTransform(svg.getScreenCTM().inverse());\n}\n\ndocument.querySelectorAll('[data-node]').forEach(nodeEl => {\n    nodeEl.addEventListener('mousedown', e => {\n        e.preventDefault(); e.stopPropagation();\n        const p = svgPt(svg, e);\n        dragOffX = p.x - parseFloat(nodeEl.getAttribute('cx'));\n        dragOffY = p.y - parseFloat(nodeEl.getAttribute('cy'));\n        dragNode = nodeEl;\n        nodeEl.style.cursor = 'grabbing';\n    });\n});\n\nsvg.addEventListener('mousemove', e => {\n    if (!dragNode) return;\n    const p = svgPt(svg, e);\n    const nx = p.x - dragOffX, ny = p.y - dragOffY;\n    dragNode.setAttribute('cx', nx); \n    dragNode.setAttribute('cy', ny);\n    \n    // Update connected edges\n    const nodeId = dragNode.getAttribute('data-node');\n    graph[nodeId].out.forEach(target => {\n        const edge = document.querySelector(`[data-edge=\"${nodeId}-${target}\"]`);\n        if (edge) {\n            edge.setAttribute('x1', nx);\n            edge.setAttribute('y1', ny);\n        }\n    });\n    graph[nodeId].in.forEach(source => {\n        const edge = document.querySelector(`[data-edge=\"${source}-${nodeId}\"]`);\n        if (edge) {\n            edge.setAttribute('x2', nx);\n            edge.setAttribute('y2', ny);\n        }\n    });\n    \n    // Update label and decoration\n    const text = dragNode.nextElementSibling;\n    if (text && text.tagName === 'text') {\n        text.setAttribute('x', nx);\n        text.setAttribute('y', ny + 5);\n    }\n    const decoration = text.nextElementSibling;\n    if (decoration && decoration.tagName === 'path') {\n        const d = decoration.getAttribute('d');\n        const newD = d.replace(/M\\d+/, `M${nx-8}`).replace(/Q\\d+,\\d+ \\d+/, `Q${nx-4},${ny-4} ${nx}`).replace(/T\\d+/, `T${nx+8}`);\n        decoration.setAttribute('d', newD);\n    }\n});\n\nsvg.addEventListener('mouseup', () => { \n    if (dragNode) dragNode.style.cursor = 'pointer';\n    dragNode = null; \n});\n\n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
