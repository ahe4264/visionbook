  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<div id=\"tooltip\"></div>\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n// Camera analysis: x-axis→right, y-axis→up, z-axis→out\n// elevation ~25°, azimuth ~-45°\n// camera.position.set(10, 8, 10)\n\nconst scene = new THREE.Scene();\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setClearColor(0xffffff, 1);\nrenderer.setPixelRatio(window.devicePixelRatio);\nrenderer.setSize(window.innerWidth, window.innerHeight);\ndocument.body.appendChild(renderer.domElement);\n\nconst aspect = window.innerWidth / window.innerHeight;\nconst d = 5;\nconst camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\ncamera.position.set(8, 5, 8);\ncamera.lookAt(0, 0, 0);\n\nscene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\nconst controls = new THREE.OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\n\n// Gray projection plane (left)\nconst planeGeo = new THREE.PlaneGeometry(3, 3);\nconst planeMat = new THREE.MeshBasicMaterial({ color: 0xcccccc, side: THREE.DoubleSide, transparent: true, opacity: 0.5 });\nconst plane = new THREE.Mesh(planeGeo, planeMat);\nplane.position.set(-3, 0, 0);\nplane.rotation.y = Math.PI / 2;\nscene.add(plane);\n\n// Green triangular projection area on XZ plane\nconst greenShape = new THREE.Shape();\ngreenShape.moveTo(0, 0);\ngreenShape.lineTo(3, 0);\ngreenShape.lineTo(1.5, -2);\ngreenShape.closePath();\nconst greenGeo = new THREE.ShapeGeometry(greenShape);\nconst greenMat = new THREE.MeshBasicMaterial({ color: 0x66cc66, side: THREE.DoubleSide, transparent: true, opacity: 0.7 });\nconst greenPlane = new THREE.Mesh(greenGeo, greenMat);\ngreenPlane.rotation.x = -Math.PI / 2;\ngreenPlane.position.y = -1.5;\nscene.add(greenPlane);\n\n// Blue triangular projection area (right)\nconst blueShape = new THREE.Shape();\nblueShape.moveTo(0, 0);\nblueShape.lineTo(3, 0);\nblueShape.lineTo(1.5, 2);\nblueShape.closePath();\nconst blueGeo = new THREE.ShapeGeometry(blueShape);\nconst blueMat = new THREE.MeshBasicMaterial({ color: 0x66ccff, side: THREE.DoubleSide, transparent: true, opacity: 0.7 });\nconst bluePlane = new THREE.Mesh(blueGeo, blueMat);\nbluePlane.position.set(1, -0.5, 0);\nbluePlane.rotation.y = -Math.PI / 4;\nscene.add(bluePlane);\n\n// Axes\nconst axesGroup = new THREE.Group();\n\n// X axis (red)\nconst xAxisGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(4, 0, 0)]);\nconst xAxisLine = new THREE.Line(xAxisGeo, new THREE.LineBasicMaterial({ color: 0xff0000 }));\naxesGroup.add(xAxisLine);\n\n// X axis arrow\nconst xArrowGeo = new THREE.ConeGeometry(0.15, 0.5, 4);\nconst xArrowMat = new THREE.MeshBasicMaterial({ color: 0xff0000 });\nconst xArrow = new THREE.Mesh(xArrowGeo, xArrowMat);\nxArrow.position.set(4, 0, 0);\nxArrow.rotation.z = -Math.PI / 2;\naxesGroup.add(xArrow);\n\n// Y axis (green)\nconst yAxisGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 3, 0)]);\nconst yAxisLine = new THREE.Line(yAxisGeo, new THREE.LineBasicMaterial({ color: 0x00aa00 }));\naxesGroup.add(yAxisLine);\n\n// Y axis arrow\nconst yArrowGeo = new THREE.ConeGeometry(0.15, 0.5, 4);\nconst yArrowMat = new THREE.MeshBasicMaterial({ color: 0x00aa00 });\nconst yArrow = new THREE.Mesh(yArrowGeo, yArrowMat);\nyArrow.position.set(0, 3, 0);\naxesGroup.add(yArrow);\n\n// Z axis (blue)\nconst zAxisGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0, 4)]);\nconst zAxisLine = new THREE.Line(zAxisGeo, new THREE.LineBasicMaterial({ color: 0x0000ff }));\naxesGroup.add(zAxisLine);\n\n// Z axis arrow\nconst zArrowGeo = new THREE.ConeGeometry(0.15, 0.5, 4);\nconst zArrowMat = new THREE.MeshBasicMaterial({ color: 0x0000ff });\nconst zArrow = new THREE.Mesh(zArrowGeo, zArrowMat);\nzArrow.position.set(0, 0, 4);\nzArrow.rotation.x = Math.PI / 2;\naxesGroup.add(zArrow);\n\nscene.add(axesGroup);\n\n// Points\nconst pointGeo = new THREE.SphereGeometry(0.12, 16, 16);\n\n// Point on gray plane (x)\nconst xPointMat = new THREE.MeshBasicMaterial({ color: 0xcc4444 });\nconst xPoint = new THREE.Mesh(pointGeo, xPointMat);\nxPoint.position.set(-3, 0.5, -0.8);\nscene.add(xPoint);\n\n// Point in 3D space (y)\nconst yPointMat = new THREE.MeshBasicMaterial({ color: 0xcc4444 });\nconst yPoint = new THREE.Mesh(pointGeo, yPointMat);\nyPoint.position.set(1.5, -0.5, 0);\nscene.add(yPoint);\n\n// Projection lines (dotted)\nconst dashedMat = new THREE.LineDashedMaterial({ color: 0x333333, dashSize: 0.1, gapSize: 0.1 });\n\n// From x to y\nconst proj1Geo = new THREE.BufferGeometry().setFromPoints([xPoint.position, yPoint.position]);\nconst proj1Line = new THREE.Line(proj1Geo, dashedMat);\nproj1Line.computeLineDistances();\nscene.add(proj1Line);\n\n// Labels using CSS3DRenderer would be ideal, but we'll use sprites\nconst loader = new THREE.FontLoader();\n\n// Text labels as sprites (simplified approach)\nfunction createTextSprite(text, position) {\n  const canvas = document.createElement('canvas');\n  const ctx = canvas.getContext('2d');\n  canvas.width = 64;\n  canvas.height = 32;\n  ctx.font = '14px sans-serif';\n  ctx.fillStyle = '#000';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText(text, 32, 16);\n  \n  const texture = new THREE.CanvasTexture(canvas);\n  const spriteMat = new THREE.SpriteMaterial({ map: texture });\n  const sprite = new THREE.Sprite(spriteMat);\n  sprite.scale.set(1, 0.5, 1);\n  sprite.position.copy(position);\n  return sprite;\n}\n\n// Add labels\nscene.add(createTextSprite('X', new THREE.Vector3(4.3, 0, 0)));\nscene.add(createTextSprite('Y', new THREE.Vector3(0, 3.3, 0)));\nscene.add(createTextSprite('Z', new THREE.Vector3(0, 0, 4.3)));\nscene.add(createTextSprite('x', new THREE.Vector3(-3.3, 0.5, -0.8)));\nscene.add(createTextSprite('y', new THREE.Vector3(1.5, -0.8, 0)));\nscene.add(createTextSprite('f', new THREE.Vector3(0, -0.3, 0)));\n\n// Raycaster for interactivity\nconst raycaster = new THREE.Raycaster();\nconst mouse = new THREE.Vector2();\nconst tooltip = document.getElementById('tooltip');\n\nfunction onMouseMove(event) {\n  mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n  mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n  \n  raycaster.setFromCamera(mouse, camera);\n  const intersects = raycaster.intersectObjects([xPoint, yPoint, plane, greenPlane, bluePlane]);\n  \n  if (intersects.length > 0) {\n    const obj = intersects[0].object;\n    let text = '';\n    if (obj === xPoint) text = 'x — projected point';\n    else if (obj === yPoint) text = 'y — 3D point';\n    else if (obj === plane) text = 'Projection plane';\n    else if (obj === greenPlane) text = 'XZ projection';\n    else if (obj === bluePlane) text = 'YZ projection';\n    \n    if (text) {\n      tooltip.style.display = 'block';\n      tooltip.textContent = text;\n      tooltip.style.left = (event.clientX + 12) + 'px';\n      tooltip.style.top = (event.clientY - 28) + 'px';\n    }\n  } else {\n    tooltip.style.display = 'none';\n  }\n}\n\nfunction onClick(event) {\n  raycaster.setFromCamera(mouse, camera);\n  const intersects = raycaster.intersectObjects([xPoint, yPoint, plane, greenPlane, bluePlane]);\n  \n  if (intersects.length > 0) {\n    const obj = intersects[0].object;\n    let title = '', body = '';\n    \n    if (obj === xPoint) {\n      title = 'Point x';\n      body = 'A point projected onto the 2D plane from 3D space. This represents the camera view transformation.';\n    } else if (obj === yPoint) {\n      title = 'Point y';\n      body = 'The original 3D point in world space. The projection shows how this point appears on the 2D image plane.';\n    } else if (obj === plane) {\n      title = 'Image Plane';\n      body = 'The 2D projection surface where 3D points are mapped. This represents the camera sensor or film plane.';\n    } else if (obj === greenPlane) {\n      title = 'XZ Projection Area';\n      body = 'The ground plane projection showing the horizontal field of view from the camera perspective.';\n    } else if (obj === bluePlane) {\n      title = 'YZ Projection Area';\n      body = 'The vertical projection plane showing the perspective transformation from 3D to 2D.';\n    }\n    \n    if (title) {\n      showPopup(title, body);\n    }\n  }\n}\n\ndocument.addEventListener('mousemove', onMouseMove);\ndocument.addEventListener('click', onClick);\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nrenderer.domElement.addEventListener('click', e => { \n  if (e.target === renderer.domElement) hidePopup(); \n});\n\n// Animation\nfunction animate() {\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene, camera);\n}\n\n// Resize handler\nwindow.addEventListener('resize', () => {\n  const a = window.innerWidth / window.innerHeight;\n  camera.left = -d * a; \n  camera.right = d * a; \n  camera.updateProjectionMatrix();\n  renderer.setSize(window.innerWidth, window.innerHeight);\n});\n\nanimate();\n\n} catch (e) {\n  console.error(e);\n}\n</script>\n</body>\n</html>",
