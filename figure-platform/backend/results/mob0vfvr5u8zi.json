  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { \n  margin: 0; \n  padding: 0; \n  width: 100%; \n  height: 100%; \n  overflow: hidden; \n  background: #fff; \n  font-family: sans-serif;\n}\n\nsvg {\n  width: 100%;\n  height: 100%;\n}\n\n.node {\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.node:hover {\n  stroke-width: 3;\n}\n\n.edge {\n  cursor: pointer;\n  transition: stroke-width 0.2s ease;\n}\n\n.edge:hover {\n  stroke-width: 2;\n}\n\n.tooltip {\n  position: fixed;\n  background: rgba(0,0,0,0.55);\n  color: #fff;\n  font: 11px/1.4 sans-serif;\n  padding: 5px 8px;\n  border-radius: 4px;\n  pointer-events: none;\n  z-index: 100;\n  max-width: 220px;\n  display: none;\n}\n\n.popup {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: rgba(245,245,245,0.95);\n  backdrop-filter: blur(6px);\n  border-top: 1px solid rgba(0,0,0,0.1);\n  padding: 8px 12px;\n  font: 12px/1.5 sans-serif;\n  color: #333;\n  z-index: 101;\n  display: none;\n}\n\n.annotation {\n  font: 11px sans-serif;\n  fill: #666;\n}\n</style>\n</head>\n<body>\n\n<svg viewBox=\"0 0 400 200\">\n  <defs>\n    <marker id=\"arrowhead\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges from input to hidden layer -->\n  <line class=\"edge\" x1=\"60\" y1=\"60\" x2=\"150\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x1 to hidden unit h1. Represents a weighted connection in the neural network.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"60\" x2=\"150\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x1 to hidden unit h2. Each connection has an associated weight parameter.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"60\" x2=\"150\" y2=\"100\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x1 to hidden unit h3. The weight determines the strength of this connection.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"60\" x2=\"150\" y2=\"130\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x1 to hidden unit h4. Part of the fully connected architecture.\"/>\n  \n  <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"150\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x2 to hidden unit h1. Each input connects to all hidden units.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"150\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x2 to hidden unit h2. Weighted connection in the network.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"150\" y2=\"100\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x2 to hidden unit h3. Direct horizontal connection.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"150\" y2=\"130\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x2 to hidden unit h4. Complete connectivity pattern.\"/>\n  \n  <line class=\"edge\" x1=\"60\" y1=\"140\" x2=\"150\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x3 to hidden unit h1. Final input to first hidden unit connection.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"140\" x2=\"150\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x3 to hidden unit h2. All inputs feed into each hidden unit.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"140\" x2=\"150\" y2=\"100\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x3 to hidden unit h3. Weighted connection pathway.\"/>\n  <line class=\"edge\" x1=\"60\" y1=\"140\" x2=\"150\" y2=\"130\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from input x3 to hidden unit h4. Complete input layer connectivity.\"/>\n  \n  <!-- Edges from hidden to output layer -->\n  <line class=\"edge\" x1=\"170\" y1=\"40\" x2=\"280\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h1 to output y1. Hidden layer processes information before output.\"/>\n  <line class=\"edge\" x1=\"170\" y1=\"40\" x2=\"280\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h1 to output y2. Each hidden unit contributes to all outputs.\"/>\n  \n  <line class=\"edge\" x1=\"170\" y1=\"70\" x2=\"280\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h2 to output y1. Weighted connection to first output.\"/>\n  <line class=\"edge\" x1=\"170\" y1=\"70\" x2=\"280\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h2 to output y2. Contributes to second output computation.\"/>\n  \n  <line class=\"edge\" x1=\"170\" y1=\"100\" x2=\"280\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h3 to output y1. Part of output computation pathway.\"/>\n  <line class=\"edge\" x1=\"170\" y1=\"100\" x2=\"280\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h3 to output y2. Hidden layer to output transformation.\"/>\n  \n  <line class=\"edge\" x1=\"170\" y1=\"130\" x2=\"280\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h4 to output y1. Final hidden unit contribution to first output.\"/>\n  <line class=\"edge\" x1=\"170\" y1=\"130\" x2=\"280\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrowhead)\" data-info=\"Connection from hidden unit h4 to output y2. Complete hidden to output connectivity.\"/>\n  \n  <!-- Input layer nodes -->\n  <circle class=\"node\" cx=\"60\" cy=\"60\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"2\" data-info=\"Input node x1. Represents the first input feature or variable to the neural network.\"/>\n  <text x=\"60\" y=\"65\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#000\" pointer-events=\"none\">x1</text>\n  \n  <circle class=\"node\" cx=\"60\" cy=\"100\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"2\" data-info=\"Input node x2. Represents the second input feature or variable to the neural network.\"/>\n  <text x=\"60\" y=\"105\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#000\" pointer-events=\"none\">x2</text>\n  \n  <circle class=\"node\" cx=\"60\" cy=\"140\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"2\" data-info=\"Input node x3. Represents the third input feature or variable to the neural network.\"/>\n  <text x=\"60\" y=\"145\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#000\" pointer-events=\"none\">x3</text>\n  \n  <!-- Hidden layer nodes -->\n  <circle class=\"node\" cx=\"150\" cy=\"40\" r=\"12\" fill=\"#D2B48C\" stroke=\"#8B7355\" stroke-width=\"2\" data-info=\"Hidden unit h1. Processes weighted inputs through an activation function. Part of the feature extraction layer.\"/>\n  <text x=\"150\" y=\"45\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#8B7355\" pointer-events=\"none\">h1</text>\n  \n  <circle class=\"node\" cx=\"150\" cy=\"70\" r=\"12\" fill=\"#D2B48C\" stroke=\"#8B7355\" stroke-width=\"2\" data-info=\"Hidden unit h2. Neuron that combines inputs and applies nonlinear transformation for feature learning.\"/>\n  <text x=\"150\" y=\"75\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#8B7355\" pointer-events=\"none\">h2</text>\n  \n  <circle class=\"node\" cx=\"150\" cy=\"100\" r=\"12\" fill=\"#D2B48C\" stroke=\"#8B7355\" stroke-width=\"2\" data-info=\"Hidden unit h3. Internal representation node that learns complex patterns from input data.\"/>\n  <text x=\"150\" y=\"105\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#8B7355\" pointer-events=\"none\">h3</text>\n  \n  <circle class=\"node\" cx=\"150\" cy=\"130\" r=\"12\" fill=\"#D2B48C\" stroke=\"#8B7355\" stroke-width=\"2\" data-info=\"Hidden unit h4. Final hidden neuron that contributes to the network's representational capacity.\"/>\n  <text x=\"150\" y=\"135\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#8B7355\" pointer-events=\"none\">h4</text>\n  \n  <!-- Output layer nodes -->\n  <circle class=\"node\" cx=\"280\" cy=\"80\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"2\" data-info=\"Output node y1. Represents the first output of the neural network, computed from weighted hidden layer activations.\"/>\n  <text x=\"280\" y=\"85\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#000\" pointer-events=\"none\">y1</text>\n  \n  <circle class=\"node\" cx=\"280\" cy=\"120\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"2\" data-info=\"Output node y2. Represents the second output of the neural network, the final prediction or classification result.\"/>\n  <text x=\"280\" y=\"125\" text-anchor=\"middle\" font=\"12px sans-serif\" fill=\"#000\" pointer-events=\"none\">y2</text>\n  \n  <!-- Layer labels -->\n  <text x=\"60\" y=\"25\" text-anchor=\"middle\" class=\"annotation\">Input layer</text>\n  <text x=\"150\" y=\"15\" text-anchor=\"middle\" class=\"annotation\">Hidden layer</text>\n  <text x=\"280\" y=\"25\" text-anchor=\"middle\" class=\"annotation\">Output layer</text>\n  \n  <!-- Annotations -->\n  <text x=\"105\" y=\"185\" class=\"annotation\">Weight</text>\n  <text x=\"220\" y=\"185\" class=\"annotation\">Neuron or</text>\n  <text x=\"220\" y=\"197\" class=\"annotation\">hidden unit</text>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const popup = document.getElementById('popup');\n  const nodes = document.querySelectorAll('.node');\n  const edges = document.querySelectorAll('.edge');\n  \n  // Tooltip functionality\n  function showTooltip(event, text) {\n    tooltip.textContent = text;\n    tooltip.style.display = 'block';\n    tooltip.style.left = (event.clientX + 10) + 'px';\n    tooltip.style.top = (event.clientY - 30) + 'px';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.display = 'none';\n  }\n  \n  // Popup functionality\n  function showPopup(text) {\n    popup.innerHTML = text + '<br><br><small>Click outside or press Escape to close</small>';\n    popup.style.display = 'block';\n  }\n  \n  function hidePopup() {\n    popup.style.display = 'none';\n  }\n  \n  // Add event listeners to nodes\n  nodes.forEach(node => {\n    const info = node.getAttribute('data-info');\n    \n    node.addEventListener('mouseenter', (e) => {\n      showTooltip(e, info);\n    });\n    \n    node.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    node.addEventListener('mouseleave', hideTooltip);\n    \n    node.addEventListener('click', (e) => {\n      e.stopPropagation();\n      showPopup(info);\n    });\n  });\n  \n  // Add event listeners to edges\n  edges.forEach(edge => {\n    const info = edge.getAttribute('data-info');\n    \n    edge.addEventListener('mouseenter', (e) => {\n      showTooltip(e, info);\n    });\n    \n    edge.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    edge.addEventListener('mouseleave', hideTooltip);\n    \n    edge.addEventListener('click', (e) => {\n      e.stopPropagation();\n      showPopup(info);\n    });\n  });\n  \n  // Close popup on outside click\n  document.addEventListener('click', (e) => {\n    if (!popup.contains(e.target)) {\n      hidePopup();\n    }\n  });\n  \n  // Close popup on Escape key\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      hidePopup();\n    }\n  });\n  \n} catch (error) {\n  console.error('Error in neural network diagram:', error);\n}\n</script>\n\n</body>\n</html>",
