  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { cursor:pointer; transition:stroke-width 0.15s ease, fill-opacity 0.15s ease; }\n.edge { transition:stroke 0.15s ease, stroke-width 0.15s ease; pointer-events:visibleStroke; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 156 59\">\n  <defs>\n    <marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges -->\n  <line class=\"edge\" x1=\"29\" y1=\"29.5\" x2=\"49\" y2=\"19.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"1\" data-to=\"2\"/>\n  <line class=\"edge\" x1=\"29\" y1=\"29.5\" x2=\"49\" y2=\"39.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"1\" data-to=\"3\"/>\n  <line class=\"edge\" x1=\"69\" y1=\"19.5\" x2=\"89\" y2=\"19.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"2\" data-to=\"4\"/>\n  <line class=\"edge\" x1=\"69\" y1=\"39.5\" x2=\"89\" y2=\"39.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"3\" data-to=\"5\"/>\n  <line class=\"edge\" x1=\"109\" y1=\"19.5\" x2=\"129\" y2=\"29.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"4\" data-to=\"6\"/>\n  <line class=\"edge\" x1=\"109\" y1=\"39.5\" x2=\"129\" y2=\"29.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"5\" data-to=\"6\"/>\n  <line class=\"edge\" x1=\"65\" y1=\"23\" x2=\"53\" y2=\"36\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"2\" data-to=\"3\"/>\n  <line class=\"edge\" x1=\"53\" y1=\"36\" x2=\"65\" y2=\"23\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-from=\"3\" data-to=\"2\"/>\n  \n  <!-- Nodes -->\n  <circle class=\"node\" cx=\"29\" cy=\"29.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"1\" data-label=\"Node 1\"/>\n  <circle class=\"node\" cx=\"59\" cy=\"19.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"2\" data-label=\"Node 2\"/>\n  <circle class=\"node\" cx=\"59\" cy=\"39.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"3\" data-label=\"Node 3\"/>\n  <circle class=\"node\" cx=\"99\" cy=\"19.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"4\" data-label=\"Node 4\"/>\n  <circle class=\"node\" cx=\"99\" cy=\"39.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"5\" data-label=\"Node 5\"/>\n  <circle class=\"node\" cx=\"129\" cy=\"29.5\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"6\" data-label=\"Node 6\"/>\n</svg>\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\n// Graph connectivity\nconst graph = {\n  '1': { out:['2','3'], in:[], label:'Node 1', role:'Input node' },\n  '2': { out:['3','4'], in:['1','3'], label:'Node 2', role:'Processing node' },\n  '3': { out:['2','5'], in:['1','2'], label:'Node 3', role:'Processing node' },\n  '4': { out:['6'], in:['2'], label:'Node 4', role:'Processing node' },\n  '5': { out:['6'], in:['3'], label:'Node 5', role:'Processing node' },\n  '6': { out:[], in:['4','5'], label:'Node 6', role:'Output node' }\n};\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n  if (tooltip.style.display === 'block') {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  }\n});\n\n// Node hover\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    \n    node.style.strokeWidth = '2.5';\n    node.style.fillOpacity = '0.9';\n    \n    // Highlight outgoing edges only\n    edges.forEach(edge => {\n      if (edge.getAttribute('data-from') === id) {\n        edge.style.stroke = '#e07b30';\n        edge.style.strokeWidth = '2';\n      }\n    });\n    \n    tooltip.textContent = `${info.label} — ${info.role}`;\n    tooltip.style.display = 'block';\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    node.style.strokeWidth = '1';\n    node.style.fillOpacity = '1';\n    \n    edges.forEach(edge => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n    });\n    \n    tooltip.style.display = 'none';\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    const isShift = e.shiftKey;\n    \n    showPopup(info.label, `${info.role}<br>Connections: ${info.out.length} out, ${info.in.length} in`);\n    \n    // Signal flow animation\n    animateSignalFlow(id, isShift);\n  });\n});\n\n// Edge hover\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2';\n    \n    const from = graph[edge.getAttribute('data-from')].label;\n    const to = graph[edge.getAttribute('data-to')].label;\n    tooltip.textContent = `${from} → ${to}`;\n    tooltip.style.display = 'block';\n  });\n  \n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1';\n    tooltip.style.display = 'none';\n  });\n});\n\n// Popup communication\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Signal flow animation\nfunction animateSignalFlow(startId, backward = false) {\n  const color = backward ? '#e05050' : '#4a7ef5';\n  \n  // Reset all edges\n  edges.forEach(e => {\n    e.style.stroke = '#000';\n    e.style.strokeWidth = '1';\n  });\n  \n  if (backward) {\n    // Backward pass: animate incoming edges\n    const incoming = Array.from(edges).filter(e => e.getAttribute('data-to') === startId);\n    animateEdges(incoming, color, 0);\n    \n    // Pulse source nodes\n    incoming.forEach(edge => {\n      const sourceId = edge.getAttribute('data-from');\n      const sourceNode = document.querySelector(`.node[data-id=\"${sourceId}\"]`);\n      pulseNode(sourceNode, 350);\n    });\n  } else {\n    // Forward pass: layer-by-layer\n    const visited = new Set();\n    const queue = [{id: startId, layer: 0}];\n    const layerEdges = [];\n    \n    while (queue.length > 0) {\n      const {id, layer} = queue.shift();\n      if (visited.has(id)) continue;\n      visited.add(id);\n      \n      if (!layerEdges[layer]) layerEdges[layer] = [];\n      \n      const outgoing = Array.from(edges).filter(e => e.getAttribute('data-from') === id);\n      layerEdges[layer].push(...outgoing);\n      \n      graph[id].out.forEach(nextId => {\n        queue.push({id: nextId, layer: layer + 1});\n      });\n    }\n    \n    // Animate each layer\n    layerEdges.forEach((edgeList, layer) => {\n      if (edgeList.length > 0) {\n        animateEdges(edgeList, color, layer * 650);\n        \n        // Pulse destination nodes\n        edgeList.forEach(edge => {\n          const destId = edge.getAttribute('data-to');\n          const destNode = document.querySelector(`.node[data-id=\"${destId}\"]`);\n          pulseNode(destNode, layer * 650 + 350);\n        });\n      }\n    });\n  }\n  \n  // Restore original colors\n  setTimeout(() => {\n    edges.forEach(e => {\n      e.style.stroke = '#000';\n      e.style.strokeWidth = '1';\n    });\n  }, 2500);\n}\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 50;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.6s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction pulseNode(node, delay) {\n  setTimeout(() => {\n    node.style.transformBox = 'fill-box';\n    node.style.transformOrigin = 'center';\n    node.style.transition = 'transform 0.15s ease';\n    node.style.transform = 'scale(1.18)';\n    setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n  }, delay);\n}\n\n} catch (err) {\n  console.error('Interactive figure error:', err);\n}\n</script>\n</body>\n</html>",
