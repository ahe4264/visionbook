  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); opacity:0; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 488 157\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Background container -->\n  <rect x=\"70\" y=\"30\" width=\"348\" height=\"97\" fill=\"#d9d9d9\" stroke=\"none\" rx=\"4\"/>\n  \n  <!-- Label at top -->\n  <text x=\"244\" y=\"20\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Transformer layer</text>\n  \n  <!-- Input grid -->\n  <g id=\"input-grid\">\n    <rect x=\"18\" y=\"58\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n    <line x1=\"18\" y1=\"66\" x2=\"60\" y2=\"66\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"18\" y1=\"74\" x2=\"60\" y2=\"74\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"18\" y1=\"82\" x2=\"60\" y2=\"82\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"18\" y1=\"90\" x2=\"60\" y2=\"90\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"26\" y1=\"58\" x2=\"26\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"34\" y1=\"58\" x2=\"34\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"42\" y1=\"58\" x2=\"42\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"51\" y1=\"58\" x2=\"51\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n  </g>\n  <text x=\"39\" y=\"115\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Input</text>\n  \n  <!-- Multi-head self-attention -->\n  <rect id=\"mhsa\" x=\"92\" y=\"58\" width=\"70\" height=\"42\" fill=\"#d77f6f\" stroke=\"#000\" stroke-width=\"1\" rx=\"2\"/>\n  <text x=\"127\" y=\"75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Multi-head</text>\n  <text x=\"127\" y=\"87\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">self-attention</text>\n  \n  <!-- Residual connection label -->\n  <text x=\"125\" y=\"48\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Residual connection</text>\n  \n  <!-- First LayerNorm -->\n  <g id=\"ln1\">\n    <rect x=\"192\" y=\"58\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"192\" y=\"67\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"192\" y=\"76\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"192\" y=\"85\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n  </g>\n  <text x=\"210\" y=\"110\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">LayerNorm</text>\n  <text x=\"210\" y=\"121\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">(× N)</text>\n  \n  <!-- Parallel neural networks -->\n  <g id=\"pnn\">\n    <rect x=\"258\" y=\"58\" width=\"36\" height=\"8\" fill=\"#b0b0b0\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"258\" y=\"67\" width=\"36\" height=\"8\" fill=\"#b0b0b0\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"258\" y=\"76\" width=\"36\" height=\"8\" fill=\"#b0b0b0\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"258\" y=\"85\" width=\"36\" height=\"8\" fill=\"#b0b0b0\" stroke=\"#000\" stroke-width=\"0.8\"/>\n  </g>\n  <text x=\"276\" y=\"110\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Parallel neural</text>\n  <text x=\"276\" y=\"121\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">networks (× N)</text>\n  \n  <!-- Second LayerNorm -->\n  <g id=\"ln2\">\n    <rect x=\"324\" y=\"58\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"324\" y=\"67\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"324\" y=\"76\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n    <rect x=\"324\" y=\"85\" width=\"36\" height=\"8\" fill=\"#619a9a\" stroke=\"#000\" stroke-width=\"0.8\"/>\n  </g>\n  <text x=\"342\" y=\"110\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">LayerNorm</text>\n  <text x=\"342\" y=\"121\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">(× N)</text>\n  \n  <!-- Residual connection label -->\n  <text x=\"322\" y=\"48\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Residual connection</text>\n  \n  <!-- Output grid -->\n  <g id=\"output-grid\">\n    <rect x=\"428\" y=\"58\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n    <line x1=\"428\" y1=\"66\" x2=\"470\" y2=\"66\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"428\" y1=\"74\" x2=\"470\" y2=\"74\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"428\" y1=\"82\" x2=\"470\" y2=\"82\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"428\" y1=\"90\" x2=\"470\" y2=\"90\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"436\" y1=\"58\" x2=\"436\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"444\" y1=\"58\" x2=\"444\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"452\" y1=\"58\" x2=\"452\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n    <line x1=\"461\" y1=\"58\" x2=\"461\" y2=\"100\" stroke=\"#000\" stroke-width=\"0.5\"/>\n  </g>\n  <text x=\"449\" y=\"115\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Output</text>\n  \n  <!-- Connections -->\n  <line id=\"e1\" x1=\"60\" y1=\"79\" x2=\"92\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line id=\"e2\" x1=\"162\" y1=\"79\" x2=\"192\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line id=\"e3\" x1=\"228\" y1=\"79\" x2=\"258\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line id=\"e4\" x1=\"294\" y1=\"79\" x2=\"324\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line id=\"e5\" x1=\"360\" y1=\"79\" x2=\"428\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <!-- Residual connections -->\n  <path id=\"res1\" d=\"M 72,79 Q 72,40 127,40 Q 182,40 182,79\" stroke=\"#000\" stroke-width=\"1\" fill=\"none\" marker-end=\"url(#arr)\"/>\n  <circle cx=\"172\" cy=\"79\" r=\"4\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"169\" y1=\"79\" x2=\"175\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"172\" y1=\"76\" x2=\"172\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <path id=\"res2\" d=\"M 238,79 Q 238,40 309,40 Q 380,40 380,79\" stroke=\"#000\" stroke-width=\"1\" fill=\"none\" marker-end=\"url(#arr)\"/>\n  <circle cx=\"370\" cy=\"79\" r=\"4\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"367\" y1=\"79\" x2=\"373\" y2=\"79\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"370\" y1=\"76\" x2=\"370\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\"/>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  \n  const graph = {\n    'input': { out:['mhsa'], in:[], label:'Input', role:'Data input grid' },\n    'mhsa': { out:['ln1'], in:['input'], label:'Multi-head self-attention', role:'Attention mechanism' },\n    'ln1': { out:['pnn'], in:['mhsa'], label:'LayerNorm', role:'Normalization layer' },\n    'pnn': { out:['ln2'], in:['ln1'], label:'Parallel neural networks', role:'Feed-forward networks' },\n    'ln2': { out:['output'], in:['pnn'], label:'LayerNorm', role:'Normalization layer' },\n    'output': { out:[], in:['ln2'], label:'Output', role:'Transformed output' }\n  };\n  \n  const elements = {\n    'input': document.getElementById('input-grid'),\n    'mhsa': document.getElementById('mhsa'),\n    'ln1': document.getElementById('ln1'),\n    'pnn': document.getElementById('pnn'),\n    'ln2': document.getElementById('ln2'),\n    'output': document.getElementById('output-grid')\n  };\n  \n  const edges = {\n    'input-mhsa': document.getElementById('e1'),\n    'mhsa-ln1': document.getElementById('e2'),\n    'ln1-pnn': document.getElementById('e3'),\n    'pnn-ln2': document.getElementById('e4'),\n    'ln2-output': document.getElementById('e5')\n  };\n  \n  function showTooltip(text) {\n    tooltip.textContent = text;\n    tooltip.style.opacity = '1';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.opacity = '0';\n  }\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  Object.entries(elements).forEach(([key, el]) => {\n    el.addEventListener('mouseenter', () => {\n      const node = graph[key];\n      showTooltip(`${node.label} — ${node.role}`);\n      el.style.opacity = '1';\n      \n      // Highlight outgoing edges\n      if (key === 'input') edges['input-mhsa'].style.stroke = '#e07b30';\n      if (key === 'mhsa') edges['mhsa-ln1'].style.stroke = '#e07b30';\n      if (key === 'ln1') edges['ln1-pnn'].style.stroke = '#e07b30';\n      if (key === 'pnn') edges['pnn-ln2'].style.stroke = '#e07b30';\n      if (key === 'ln2') edges['ln2-output'].style.stroke = '#e07b30';\n    });\n    \n    el.addEventListener('mouseleave', () => {\n      hideTooltip();\n      Object.values(edges).forEach(e => e.style.stroke = '#000');\n    });\n    \n    el.addEventListener('click', (e) => {\n      e.stopPropagation();\n      const node = graph[key];\n      showPopup(node.label, `${node.role}. This component processes the data through ${node.label.toLowerCase()} operations.`);\n      \n      // Animate signal flow\n      animateSignalFlow(key);\n    });\n  });\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.35s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  function pulseNode(el, delay) {\n    setTimeout(() => {\n      el.style.transformBox = 'fill-box';\n      el.style.transformOrigin = 'center';\n      el.style.transition = 'transform 0.15s ease';\n      el.style.transform = 'scale(1.18)';\n      setTimeout(() => { el.style.transform = 'scale(1)'; }, 200);\n    }, delay);\n  }\n  \n  function animateSignalFlow(startKey) {\n    const sequence = ['input', 'mhsa', 'ln1', 'pnn', 'ln2', 'output'];\n    const startIdx = sequence.indexOf(startKey);\n    \n    for (let i = startIdx; i < sequence.length - 1; i++) {\n      const delay = (i - startIdx) * 380;\n      const curr = sequence[i];\n      const next = sequence[i + 1];\n      const edgeKey = `${curr}-${next}`;\n      \n      if (edges[edgeKey]) {\n        animateEdges([edges[edgeKey]], '#4a7ef5', delay);\n        pulseNode(elements[next], delay + 350);\n      }\n    }\n    \n    // Reset after animation\n    setTimeout(() => {\n      Object.values(edges).forEach(e => {\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n      });\n    }, 2000);\n  }\n  \n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
