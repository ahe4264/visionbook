  "filename": "figure_104",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 256 126\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges -->\n  <g id=\"edges\">\n    <!-- x1 to h nodes -->\n    <line x1=\"40\" y1=\"35\" x2=\"100\" y2=\"25\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h1\" data-layer=\"0\"/>\n    <line x1=\"40\" y1=\"35\" x2=\"100\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h2\" data-layer=\"0\"/>\n    <line x1=\"40\" y1=\"35\" x2=\"100\" y2=\"101\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h3\" data-layer=\"0\"/>\n    \n    <!-- x2 to h nodes -->\n    <line x1=\"40\" y1=\"91\" x2=\"100\" y2=\"25\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h1\" data-layer=\"0\"/>\n    <line x1=\"40\" y1=\"91\" x2=\"100\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h2\" data-layer=\"0\"/>\n    <line x1=\"40\" y1=\"91\" x2=\"100\" y2=\"101\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h3\" data-layer=\"0\"/>\n    \n    <!-- h nodes to y -->\n    <line x1=\"156\" y1=\"25\" x2=\"216\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\" data-layer=\"1\"/>\n    <line x1=\"156\" y1=\"63\" x2=\"216\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\" data-layer=\"1\"/>\n    <line x1=\"156\" y1=\"101\" x2=\"216\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\" data-layer=\"1\"/>\n  </g>\n  \n  <!-- Nodes -->\n  <g id=\"nodes\">\n    <circle cx=\"40\" cy=\"35\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"x1\"/>\n    <text x=\"40\" y=\"39\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">x₁</text>\n    \n    <circle cx=\"40\" cy=\"91\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"x2\"/>\n    <text x=\"40\" y=\"95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">x₂</text>\n    \n    <circle cx=\"128\" cy=\"25\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h1\"/>\n    <text x=\"128\" y=\"29\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">h₁</text>\n    \n    <circle cx=\"128\" cy=\"63\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h2\"/>\n    <text x=\"128\" y=\"67\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">h₂</text>\n    \n    <circle cx=\"128\" cy=\"101\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h3\"/>\n    <text x=\"128\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">h₃</text>\n    \n    <circle cx=\"216\" cy=\"63\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"y\"/>\n    <text x=\"216\" y=\"67\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\">y</text>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  \n  const graph = {\n    'x1': { out:['h1','h2','h3'], in:[], label:'x₁', role:'Input 1' },\n    'x2': { out:['h1','h2','h3'], in:[], label:'x₂', role:'Input 2' },\n    'h1': { out:['y'], in:['x1','x2'], label:'h₁', role:'Hidden unit 1' },\n    'h2': { out:['y'], in:['x1','x2'], label:'h₂', role:'Hidden unit 2' },\n    'h3': { out:['y'], in:['x1','x2'], label:'h₃', role:'Hidden unit 3' },\n    'y':  { out:[], in:['h1','h2','h3'], label:'y', role:'Output' }\n  };\n  \n  // Show/hide popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Node interactions\n  document.querySelectorAll('circle').forEach(node => {\n    const nodeId = node.getAttribute('data-id');\n    const nodeData = graph[nodeId];\n    \n    node.addEventListener('mouseenter', function() {\n      // Highlight node\n      this.style.strokeWidth = '3';\n      this.style.fillOpacity = '0.9';\n      \n      // Highlight outgoing edges\n      document.querySelectorAll(`line[data-from=\"${nodeId}\"]`).forEach(edge => {\n        edge.style.stroke = '#e07b30';\n        edge.style.strokeWidth = '2';\n      });\n      \n      // Show tooltip\n      tooltip.textContent = `${nodeData.label} — ${nodeData.role}`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', function() {\n      // Reset node\n      this.style.strokeWidth = '1.5';\n      this.style.fillOpacity = '1';\n      \n      // Reset edges\n      document.querySelectorAll(`line[data-from=\"${nodeId}\"]`).forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      \n      // Hide tooltip\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', function(e) {\n      e.stopPropagation();\n      const isShift = e.shiftKey;\n      \n      // Show popup\n      const body = `<p><b>Type:</b> ${nodeData.role}</p>\n<p><b>Connections:</b><br>\nInputs from: ${nodeData.in.length > 0 ? nodeData.in.join(', ') : 'None'}<br>\nOutputs to: ${nodeData.out.length > 0 ? nodeData.out.join(', ') : 'None'}</p>\n<p>${isShift ? 'Shift+Click triggers backward pass animation (red).' : 'Click triggers forward pass animation (blue).'}</p>`;\n      \n      showPopup(nodeData.label + ' Node', body);\n      \n      // Animate signal flow\n      animateSignalFlow(nodeId, isShift);\n    });\n  });\n  \n  // Edge hover\n  document.querySelectorAll('line').forEach(edge => {\n    edge.addEventListener('mouseenter', function() {\n      this.style.stroke = '#e07b30';\n      this.style.strokeWidth = '2';\n      tooltip.textContent = `${this.getAttribute('data-from')} → ${this.getAttribute('data-to')}`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', function() {\n      this.style.stroke = '#000';\n      this.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n  });\n  \n  // Animate edges function\n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  // Pulse node function\n  function pulseNode(nodeEl, delay) {\n    setTimeout(() => {\n      nodeEl.style.transformBox = 'fill-box';\n      nodeEl.style.transformOrigin = 'center';\n      nodeEl.style.transition = 'transform 0.15s ease';\n      nodeEl.style.transform = 'scale(1.18)';\n      setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n    }, delay);\n  }\n  \n  // Signal flow animation\n  function animateSignalFlow(startNode, isBackward) {\n    const color = isBackward ? '#e05050' : '#4a7ef5';\n    \n    // Reset all edges first\n    document.querySelectorAll('line').forEach(e => {\n      e.style.strokeDasharray = 'none';\n      e.style.stroke = '#000';\n    });\n    \n    if (!isBackward) {\n      // Forward pass\n      // Layer 0: input to hidden\n      const layer0 = document.querySelectorAll('line[data-layer=\"0\"]');\n      animateEdges(layer0, color, 0);\n      \n      // Pulse hidden nodes\n      ['h1', 'h2', 'h3'].forEach(hid => {\n        const node = document.querySelector(`circle[data-id=\"${hid}\"]`);\n        pulseNode(node, 350);\n      });\n      \n      // Layer 1: hidden to output\n      const layer1 = document.querySelectorAll('line[data-layer=\"1\"]');\n      animateEdges(layer1, color, 650);\n      \n      // Pulse output node\n      const yNode = document.querySelector('circle[data-id=\"y\"]');\n      pulseNode(yNode, 1000);\n      \n      // Reset colors\n      setTimeout(() => {\n        document.querySelectorAll('line').forEach(e => {\n          e.style.stroke = '#000';\n          e.style.strokeDasharray = 'none';\n        });\n      }, 1800);\n    } else {\n      // Backward pass\n      // Start from output\n      const layer1 = document.querySelectorAll('line[data-layer=\"1\"]');\n      animateEdges(layer1, color, 0);\n      \n      // Pulse hidden nodes\n      ['h1', 'h2', 'h3'].forEach(hid => {\n        const node = document.querySelector(`circle[data-id=\"${hid}\"]`);\n        pulseNode(node, 350);\n      });\n      \n      // Back to inputs\n      const layer0 = document.querySelectorAll('line[data-layer=\"0\"]');\n      animateEdges(layer0, color, 650);\n      \n      // Pulse input nodes\n      ['x1', 'x2'].forEach(xid => {\n        const node = document.querySelector(`circle[data-id=\"${xid}\"]`);\n        pulseNode(node, 1000);\n      });\n      \n      // Reset colors\n      setTimeout(() => {\n        document.querySelectorAll('line').forEach(e => {\n          e.style.stroke = '#000';\n          e.style.strokeDasharray = 'none';\n        });\n      }, 1800);\n    }\n  }\n  \n  // Dismiss handlers\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n} catch (err) {\n  console.error('Error in interactive figure:', err);\n}\n</script>\n</body>\n</html>",
