  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 301 200\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n    <pattern id=\"grid1\" patternUnits=\"userSpaceOnUse\" width=\"4\" height=\"4\">\n      <rect x=\"0\" y=\"0\" width=\"2\" height=\"2\" fill=\"#666\"/>\n      <rect x=\"2\" y=\"2\" width=\"2\" height=\"2\" fill=\"#666\"/>\n    </pattern>\n    <pattern id=\"grid2\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\">\n      <circle cx=\"3\" cy=\"3\" r=\"1.5\" fill=\"#666\"/>\n    </pattern>\n    <pattern id=\"grid3\" patternUnits=\"userSpaceOnUse\" width=\"4\" height=\"4\">\n      <line x1=\"0\" y1=\"0\" x2=\"4\" y2=\"4\" stroke=\"#666\" stroke-width=\"1\"/>\n    </pattern>\n  </defs>\n  \n  <!-- Input image -->\n  <rect x=\"8\" y=\"75\" width=\"50\" height=\"50\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" data-id=\"input\"/>\n  <circle cx=\"33\" cy=\"100\" r=\"15\" fill=\"#333\" data-id=\"input\"/>\n  <text x=\"33\" y=\"140\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Input</text>\n  <text x=\"33\" y=\"152\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">image</text>\n  \n  <!-- Basis filter bank -->\n  <rect x=\"70\" y=\"30\" width=\"40\" height=\"40\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" rx=\"20\" data-id=\"filter1\"/>\n  <circle cx=\"90\" cy=\"50\" r=\"15\" fill=\"url(#grid1)\" data-id=\"filter1\"/>\n  \n  <rect x=\"70\" y=\"80\" width=\"40\" height=\"40\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" rx=\"20\" data-id=\"filter2\"/>\n  <circle cx=\"90\" cy=\"100\" r=\"15\" fill=\"url(#grid2)\" data-id=\"filter2\"/>\n  \n  <rect x=\"70\" y=\"130\" width=\"40\" height=\"40\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" rx=\"20\" data-id=\"filter3\"/>\n  <circle cx=\"90\" cy=\"150\" r=\"15\" fill=\"url(#grid3)\" data-id=\"filter3\"/>\n  \n  <rect x=\"74\" y=\"8\" width=\"32\" height=\"14\" fill=\"#eee\" stroke=\"#999\" stroke-width=\"1\"/>\n  <text x=\"90\" y=\"18\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Basis</text>\n  <text x=\"90\" y=\"182\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">filter</text>\n  <text x=\"90\" y=\"192\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">bank</text>\n  \n  <!-- Gain maps -->\n  <path d=\"M130 50 L160 50 L145 80 Z\" fill=\"#999\" stroke=\"#666\" stroke-width=\"1\" data-id=\"gain1\"/>\n  <path d=\"M130 100 L160 100 L145 120 L130 120 Z\" fill=\"#999\" stroke=\"#666\" stroke-width=\"1\" data-id=\"gain2\"/>\n  <path d=\"M130 150 L160 150 L145 120 Z\" fill=\"#999\" stroke=\"#666\" stroke-width=\"1\" data-id=\"gain3\"/>\n  \n  <rect x=\"130\" y=\"8\" width=\"30\" height=\"24\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"145\" y=\"18\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"9\" font-style=\"italic\" fill=\"#000\">g<tspan baseline-shift=\"sub\" font-size=\"7\">i</tspan>(t)</text>\n  <text x=\"145\" y=\"28\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Gain</text>\n  <text x=\"145\" y=\"182\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">maps</text>\n  \n  <!-- Summation -->\n  <circle cx=\"205\" cy=\"100\" r=\"20\" fill=\"#f0f0f0\" stroke=\"#000\" stroke-width=\"2\" data-id=\"sum\"/>\n  <text x=\"205\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"24\" fill=\"#000\">+</text>\n  \n  <!-- Output image -->\n  <rect x=\"243\" y=\"75\" width=\"50\" height=\"50\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" data-id=\"output\"/>\n  <circle cx=\"268\" cy=\"100\" r=\"15\" fill=\"#666\" data-id=\"output\"/>\n  <text x=\"268\" y=\"140\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Output</text>\n  <text x=\"268\" y=\"152\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">image</text>\n  \n  <!-- Edges -->\n  <line x1=\"58\" y1=\"100\" x2=\"70\" y2=\"50\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"input\" data-to=\"filter1\"/>\n  <line x1=\"58\" y1=\"100\" x2=\"70\" y2=\"100\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"input\" data-to=\"filter2\"/>\n  <line x1=\"58\" y1=\"100\" x2=\"70\" y2=\"150\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"input\" data-to=\"filter3\"/>\n  \n  <line x1=\"110\" y1=\"50\" x2=\"130\" y2=\"50\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"filter1\" data-to=\"gain1\"/>\n  <line x1=\"110\" y1=\"100\" x2=\"130\" y2=\"100\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"filter2\" data-to=\"gain2\"/>\n  <line x1=\"110\" y1=\"150\" x2=\"130\" y2=\"150\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"filter3\" data-to=\"gain3\"/>\n  \n  <line x1=\"160\" y1=\"65\" x2=\"185\" y2=\"85\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"gain1\" data-to=\"sum\"/>\n  <line x1=\"160\" y1=\"110\" x2=\"185\" y2=\"100\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"gain2\" data-to=\"sum\"/>\n  <line x1=\"160\" y1=\"135\" x2=\"185\" y2=\"115\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"gain3\" data-to=\"sum\"/>\n  \n  <line x1=\"225\" y1=\"100\" x2=\"243\" y2=\"100\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"sum\" data-to=\"output\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const elements = svg.querySelectorAll('[data-id]');\n  const edges = svg.querySelectorAll('line[data-from]');\n  \n  const graph = {\n    'input': { out:['filter1','filter2','filter3'], in:[], label:'Input image', role:'Starting image data' },\n    'filter1': { out:['gain1'], in:['input'], label:'Filter 1', role:'Basis filter pattern' },\n    'filter2': { out:['gain2'], in:['input'], label:'Filter 2', role:'Basis filter pattern' },\n    'filter3': { out:['gain3'], in:['input'], label:'Filter 3', role:'Basis filter pattern' },\n    'gain1': { out:['sum'], in:['filter1'], label:'Gain g₁(t)', role:'Gain map coefficient' },\n    'gain2': { out:['sum'], in:['filter2'], label:'Gain g₂(t)', role:'Gain map coefficient' },\n    'gain3': { out:['sum'], in:['filter3'], label:'Gain g₃(t)', role:'Gain map coefficient' },\n    'sum': { out:['output'], in:['gain1','gain2','gain3'], label:'Summation', role:'Combines weighted filters' },\n    'output': { out:[], in:['sum'], label:'Output image', role:'Transformed result' }\n  };\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  elements.forEach(el => {\n    const id = el.getAttribute('data-id');\n    const node = graph[id];\n    if (!node) return;\n    \n    el.style.cursor = 'pointer';\n    \n    el.addEventListener('mouseenter', () => {\n      el.style.strokeWidth = parseFloat(el.style.strokeWidth || el.getAttribute('stroke-width') || 1) + 1.5;\n      if (el.getAttribute('fill') && el.getAttribute('fill') !== 'none') {\n        el.style.fillOpacity = '0.8';\n      }\n      \n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tooltip.textContent = `${node.label} — ${node.role}`;\n      tooltip.style.display = 'block';\n    });\n    \n    el.addEventListener('mouseleave', () => {\n      el.style.strokeWidth = '';\n      el.style.fillOpacity = '';\n      \n      edges.forEach(edge => {\n        edge.style.stroke = '';\n        edge.style.strokeWidth = '';\n      });\n      \n      tooltip.style.display = 'none';\n    });\n    \n    el.addEventListener('click', e => {\n      e.stopPropagation();\n      \n      let body = '';\n      if (id === 'input') {\n        body = 'The input image is the source data that will be transformed by the filter bank. Each filter in the bank will process this image independently.';\n      } else if (id.startsWith('filter')) {\n        body = 'Each basis filter represents a different pattern or feature detector. The filter bank decomposes the input into multiple components based on these patterns.';\n      } else if (id.startsWith('gain')) {\n        body = 'Gain maps g_i(t) are time-varying coefficients that modulate the contribution of each filtered component. They control how much each filter response contributes to the final output.';\n      } else if (id === 'sum') {\n        body = 'The summation node combines all the weighted filter responses. This reconstruction step assembles the transformed image from the modulated components.';\n      } else if (id === 'output') {\n        body = 'The output image is the result of the filter bank processing. It represents the input transformed according to the patterns detected and the applied gain maps.';\n      }\n      \n      showPopup(node.label, body);\n      \n      // Animate signal flow\n      const layers = [\n        { ids: ['input'], delay: 0 },\n        { ids: ['filter1','filter2','filter3'], delay: 650 },\n        { ids: ['gain1','gain2','gain3'], delay: 1300 },\n        { ids: ['sum'], delay: 1950 },\n        { ids: ['output'], delay: 2600 }\n      ];\n      \n      edges.forEach(edge => {\n        edge.style.transition = 'none';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n      });\n      \n      layers.forEach(layer => {\n        const layerEdges = Array.from(edges).filter(edge => \n          layer.ids.includes(edge.getAttribute('data-from'))\n        );\n        \n        animateEdges(layerEdges, '#4a7ef5', layer.delay);\n        \n        layer.ids.forEach(nodeId => {\n          const nodeEl = svg.querySelector(`[data-id=\"${nodeId}\"]`);\n          if (nodeEl && nodeId !== id) {\n            setTimeout(() => {\n              nodeEl.style.transformBox = 'fill-box';\n              nodeEl.style.transformOrigin = 'center';\n              nodeEl.style.transition = 'transform 0.15s ease';\n              nodeEl.style.transform = 'scale(1.18)';\n              setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n            }, layer.delay + 350);\n          }\n        });\n      });\n      \n      setTimeout(() => {\n        edges.forEach(edge => {\n          edge.style.transition = 'stroke 0.3s ease';\n          edge.style.stroke = '#000';\n          edge.style.strokeDasharray = '';\n          edge.style.strokeDashoffset = '';\n        });\n      }, 3800);\n    });\n  });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
