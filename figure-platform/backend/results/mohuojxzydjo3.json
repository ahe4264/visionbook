  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { fill:#fff; stroke:#000; stroke-width:1; cursor:pointer; }\n.node:hover { stroke-width:2.5; fill-opacity:0.9; }\n.edge { fill:none; stroke:#000; stroke-width:1; }\n.edge.highlight { stroke:#e07b30; stroke-width:2; }\n.label { font:12px sans-serif; text-anchor:middle; pointer-events:none; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 247 159\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  <text x=\"16\" y=\"20\" class=\"label\" style=\"text-anchor:start\">a)</text>\n  \n  <!-- Edges -->\n  <line class=\"edge\" x1=\"35\" y1=\"79.5\" x2=\"65\" y2=\"40\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h1\"/>\n  <line class=\"edge\" x1=\"35\" y1=\"79.5\" x2=\"65\" y2=\"70\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h2\"/>\n  <line class=\"edge\" x1=\"35\" y1=\"79.5\" x2=\"65\" y2=\"100\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h3\"/>\n  <line class=\"edge\" x1=\"35\" y1=\"79.5\" x2=\"65\" y2=\"130\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h4\"/>\n  \n  <line class=\"edge\" x1=\"95\" y1=\"40\" x2=\"175\" y2=\"79.5\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"mu\"/>\n  <line class=\"edge\" x1=\"95\" y1=\"70\" x2=\"175\" y2=\"79.5\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"mu\"/>\n  <line class=\"edge\" x1=\"95\" y1=\"100\" x2=\"175\" y2=\"79.5\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"mu\"/>\n  <line class=\"edge\" x1=\"95\" y1=\"130\" x2=\"175\" y2=\"79.5\" marker-end=\"url(#arr)\" data-from=\"h4\" data-to=\"mu\"/>\n  \n  <!-- Nodes -->\n  <circle class=\"node\" cx=\"35\" cy=\"79.5\" r=\"15\" data-id=\"x\"/>\n  <text class=\"label\" x=\"35\" y=\"84\">x</text>\n  \n  <circle class=\"node\" cx=\"80\" cy=\"40\" r=\"15\" data-id=\"h1\"/>\n  <text class=\"label\" x=\"80\" y=\"44\">h₁</text>\n  \n  <circle class=\"node\" cx=\"80\" cy=\"70\" r=\"15\" data-id=\"h2\"/>\n  <text class=\"label\" x=\"80\" y=\"74\">h₂</text>\n  \n  <circle class=\"node\" cx=\"80\" cy=\"100\" r=\"15\" data-id=\"h3\"/>\n  <text class=\"label\" x=\"80\" y=\"104\">h₃</text>\n  \n  <circle class=\"node\" cx=\"80\" cy=\"130\" r=\"15\" data-id=\"h4\"/>\n  <text class=\"label\" x=\"80\" y=\"134\">h₄</text>\n  \n  <circle class=\"node\" cx=\"190\" cy=\"79.5\" r=\"15\" data-id=\"mu\"/>\n  <text class=\"label\" x=\"190\" y=\"84\">μ</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\nconst graph = {\n  'x':  { out:['h1','h2','h3','h4'], in:[],                    label:'x',  role:'Input node' },\n  'h1': { out:['mu'],                 in:['x'],                 label:'h₁', role:'Hidden unit 1' },\n  'h2': { out:['mu'],                 in:['x'],                 label:'h₂', role:'Hidden unit 2' },\n  'h3': { out:['mu'],                 in:['x'],                 label:'h₃', role:'Hidden unit 3' },\n  'h4': { out:['mu'],                 in:['x'],                 label:'h₄', role:'Hidden unit 4' },\n  'mu': { out:[],                     in:['h1','h2','h3','h4'], label:'μ',  role:'Output node' }\n};\n\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\nnodes.forEach(node => {\n  const id = node.dataset.id;\n  const info = graph[id];\n  \n  node.addEventListener('mouseenter', () => {\n    tooltip.textContent = `${info.label} — ${info.role}`;\n    tooltip.style.display = 'block';\n    \n    edges.forEach(edge => {\n      if (edge.dataset.from === id) {\n        edge.classList.add('highlight');\n      }\n    });\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    tooltip.style.display = 'none';\n    edges.forEach(edge => edge.classList.remove('highlight'));\n  });\n  \n  node.addEventListener('click', (e) => {\n    e.stopPropagation();\n    showPopup(info.label, info.role);\n    animateSignalFlow(e.shiftKey);\n  });\n});\n\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.6s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction pulseNode(nodeEl, delay) {\n  setTimeout(() => {\n    nodeEl.style.transformBox = 'fill-box';\n    nodeEl.style.transformOrigin = 'center';\n    nodeEl.style.transition = 'transform 0.15s ease';\n    nodeEl.style.transform = 'scale(1.18)';\n    setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n  }, delay);\n}\n\nfunction animateSignalFlow(backward) {\n  const color = backward ? '#e05050' : '#4a7ef5';\n  \n  if (!backward) {\n    // Forward pass\n    const layer0 = Array.from(edges).filter(e => e.dataset.from === 'x');\n    const layer1 = Array.from(edges).filter(e => ['h1','h2','h3','h4'].includes(e.dataset.from));\n    \n    animateEdges(layer0, color, 0);\n    nodes.forEach(n => {\n      if (['h1','h2','h3','h4'].includes(n.dataset.id)) pulseNode(n, 350);\n    });\n    \n    animateEdges(layer1, color, 650);\n    nodes.forEach(n => {\n      if (n.dataset.id === 'mu') pulseNode(n, 1000);\n    });\n    \n    setTimeout(() => {\n      edges.forEach(e => {\n        e.style.transition = 'stroke 0.3s ease';\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = 'none';\n      });\n    }, 1800);\n  } else {\n    // Backward pass\n    const layer0 = Array.from(edges).filter(e => e.dataset.to === 'mu');\n    const layer1 = Array.from(edges).filter(e => ['h1','h2','h3','h4'].includes(e.dataset.to));\n    \n    animateEdges(layer0, color, 0);\n    nodes.forEach(n => {\n      if (['h1','h2','h3','h4'].includes(n.dataset.id)) pulseNode(n, 350);\n    });\n    \n    animateEdges(layer1, color, 650);\n    nodes.forEach(n => {\n      if (n.dataset.id === 'x') pulseNode(n, 1000);\n    });\n    \n    setTimeout(() => {\n      edges.forEach(e => {\n        e.style.transition = 'stroke 0.3s ease';\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = 'none';\n      });\n    }, 1800);\n  }\n}\n\n} catch(err) { console.error(err); }\n</script>\n</body>\n</html>",
