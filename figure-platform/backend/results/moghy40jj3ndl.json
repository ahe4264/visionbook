  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; cursor:default; }\n.node { cursor:pointer; }\n.edge { pointer-events:visibleStroke; cursor:pointer; }\n.label { pointer-events:none; font:11px sans-serif; fill:#000; }\n.panel-label { font:11px sans-serif; fill:#000; font-weight:bold; }\n.matrix-cell { font:10px sans-serif; fill:#fff; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); opacity:0; transition:opacity 0.2s; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 227 206\">\n  <defs>\n    <marker id=\"arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n      <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel (a) - Pinhole camera diagram -->\n  <g id=\"panel-a\">\n    <text x=\"16\" y=\"18\" class=\"panel-label\">(a)</text>\n    \n    <!-- Scene -->\n    <rect x=\"16\" y=\"30\" width=\"80\" height=\"10\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"56\" y=\"25\" class=\"label\" text-anchor=\"middle\">Scene</text>\n    <text x=\"24\" y=\"37\" class=\"label\" font-size=\"9\">ℓ₀</text>\n    \n    <!-- Occluder -->\n    <rect x=\"16\" y=\"80\" width=\"80\" height=\"10\" fill=\"#000\"/>\n    <text x=\"56\" y=\"110\" class=\"label\" text-anchor=\"middle\">Occluder</text>\n    \n    <!-- Camera sensor -->\n    <rect x=\"16\" y=\"140\" width=\"80\" height=\"10\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"56\" y=\"167\" class=\"label\" text-anchor=\"middle\">Camera sensor</text>\n    <text x=\"24\" y=\"147\" class=\"label\" font-size=\"9\">ℓ₁</text>\n    \n    <!-- Pinhole -->\n    <circle cx=\"56\" cy=\"85\" r=\"3\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"75\" y=\"88\" class=\"label\">Pinhole</text>\n    \n    <!-- Light paths -->\n    <line class=\"edge\" x1=\"30\" y1=\"35\" x2=\"56\" y2=\"85\" stroke=\"#008000\" stroke-width=\"2\" data-label=\"Green light path\"/>\n    <line class=\"edge\" x1=\"56\" y1=\"85\" x2=\"82\" y2=\"145\" stroke=\"#008000\" stroke-width=\"2\" data-label=\"Green light path\"/>\n    \n    <line class=\"edge\" x1=\"82\" y1=\"35\" x2=\"56\" y2=\"85\" stroke=\"#ff0000\" stroke-width=\"2\" data-label=\"Red light path\"/>\n    <line class=\"edge\" x1=\"56\" y1=\"85\" x2=\"30\" y2=\"145\" stroke=\"#ff0000\" stroke-width=\"2\" data-label=\"Red light path\"/>\n  </g>\n  \n  <!-- Panel (b) - Matrices -->\n  <g id=\"panel-b\">\n    <text x=\"125\" y=\"18\" class=\"panel-label\">(b)</text>\n    \n    <!-- Matrix A -->\n    <rect x=\"125\" y=\"30\" width=\"86\" height=\"40\" fill=\"#000\"/>\n    <text x=\"168\" y=\"25\" class=\"label\" text-anchor=\"middle\">A</text>\n    <line x1=\"135\" y1=\"40\" x2=\"201\" y2=\"60\" stroke=\"#fff\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n    \n    <!-- Matrix A⁻¹ -->\n    <rect x=\"125\" y=\"83\" width=\"86\" height=\"40\" fill=\"#000\"/>\n    <text x=\"168\" y=\"138\" class=\"label\" text-anchor=\"middle\">A⁻¹</text>\n    <line x1=\"135\" y1=\"113\" x2=\"201\" y2=\"93\" stroke=\"#fff\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n    \n    <!-- Matrix B -->\n    <rect x=\"125\" y=\"136\" width=\"86\" height=\"40\" fill=\"#000\"/>\n    <text x=\"168\" y=\"191\" class=\"label\" text-anchor=\"middle\">B</text>\n    <line x1=\"135\" y1=\"146\" x2=\"201\" y2=\"166\" stroke=\"#fff\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n  </g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const edges = document.querySelectorAll('.edge');\n  const matrices = document.querySelectorAll('#panel-b rect');\n  \n  // Tooltip functionality\n  function showTooltip(text) {\n    tooltip.textContent = text;\n    tooltip.style.opacity = '1';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.opacity = '0';\n  }\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Edge interactions\n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', () => {\n      edge.style.strokeWidth = '3';\n      showTooltip(edge.dataset.label || 'Light path');\n    });\n    \n    edge.addEventListener('mouseleave', () => {\n      edge.style.strokeWidth = '2';\n      hideTooltip();\n    });\n    \n    edge.addEventListener('click', e => {\n      e.stopPropagation();\n      const color = edge.getAttribute('stroke');\n      const colorName = color === '#008000' ? 'Green' : 'Red';\n      showPopup(`${colorName} Light Path`, \n        `This ${colorName.toLowerCase()} ray travels from the scene through the pinhole to the camera sensor. In the pinhole camera model, light rays cross at the pinhole, causing the image to be inverted on the sensor.`);\n    });\n  });\n  \n  // Matrix interactions\n  matrices.forEach((matrix, i) => {\n    const labels = ['A', 'A⁻¹', 'B'];\n    const descriptions = [\n      'Matrix A represents the projection transformation from 3D world coordinates to 2D image coordinates.',\n      'Matrix A⁻¹ is the inverse transformation, mapping from image space back to world space.',\n      'Matrix B represents additional transformations such as camera calibration or distortion correction.'\n    ];\n    \n    matrix.style.cursor = 'pointer';\n    \n    matrix.addEventListener('mouseenter', () => {\n      matrix.style.strokeWidth = '2';\n      matrix.style.stroke = '#666';\n      showTooltip(`Matrix ${labels[i]}`);\n    });\n    \n    matrix.addEventListener('mouseleave', () => {\n      matrix.style.strokeWidth = '0';\n      matrix.style.stroke = 'none';\n      hideTooltip();\n    });\n    \n    matrix.addEventListener('click', e => {\n      e.stopPropagation();\n      showPopup(`Matrix ${labels[i]}`, descriptions[i]);\n    });\n  });\n  \n  // Pinhole interaction\n  const pinhole = document.querySelector('circle');\n  pinhole.style.cursor = 'pointer';\n  \n  pinhole.addEventListener('mouseenter', () => {\n    pinhole.style.strokeWidth = '2';\n    pinhole.style.fill = '#f0f0f0';\n    showTooltip('Pinhole aperture');\n  });\n  \n  pinhole.addEventListener('mouseleave', () => {\n    pinhole.style.strokeWidth = '1';\n    pinhole.style.fill = '#fff';\n    hideTooltip();\n  });\n  \n  pinhole.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Pinhole', \n      'The pinhole acts as the optical center where all light rays converge. Its small aperture creates a sharp image by allowing only a narrow cone of light from each point in the scene to reach the sensor.');\n    \n    // Animate light paths\n    edges.forEach(edge => {\n      const len = edge.getTotalLength();\n      edge.style.transition = 'none';\n      edge.style.strokeDasharray = len;\n      edge.style.strokeDashoffset = len;\n      \n      requestAnimationFrame(() => {\n        edge.style.transition = 'stroke-dashoffset 1s ease';\n        edge.style.strokeDashoffset = '0';\n      });\n    });\n  });\n  \n  // Scene/Sensor interaction\n  const rects = document.querySelectorAll('#panel-a rect[fill=\"none\"]');\n  rects.forEach((rect, i) => {\n    const labels = ['Scene', 'Camera sensor'];\n    const descriptions = [\n      'The scene contains the 3D objects being photographed. Light reflects from these objects toward the camera.',\n      'The camera sensor captures the inverted image formed by light passing through the pinhole. Each point on the sensor corresponds to a ray from the scene.'\n    ];\n    \n    rect.style.cursor = 'pointer';\n    \n    rect.addEventListener('mouseenter', () => {\n      rect.style.strokeWidth = '2';\n      showTooltip(labels[i]);\n    });\n    \n    rect.addEventListener('mouseleave', () => {\n      rect.style.strokeWidth = '1';\n      hideTooltip();\n    });\n    \n    rect.addEventListener('click', e => {\n      e.stopPropagation();\n      showPopup(labels[i], descriptions[i]);\n    });\n  });\n  \n  // Occluder interaction\n  const occluder = document.querySelector('#panel-a rect[fill=\"#000\"]');\n  occluder.style.cursor = 'pointer';\n  \n  occluder.addEventListener('mouseenter', () => {\n    occluder.style.fill = '#333';\n    showTooltip('Occluder');\n  });\n  \n  occluder.addEventListener('mouseleave', () => {\n    occluder.style.fill = '#000';\n    hideTooltip();\n  });\n  \n  occluder.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Occluder', \n      'The occluder blocks all light except what passes through the pinhole. This creates the fundamental principle of the pinhole camera: each point on the sensor receives light from only one direction in the scene.');\n  });\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { \n    if (e.key === 'Escape') hidePopup(); \n  });\n  \n  svg.addEventListener('click', e => { \n    if (e.target === svg || e.target.tagName === 'svg') hidePopup(); \n  });\n\n} catch(e) {\n  console.error('Error:', e);\n}\n</script>\n</body>\n</html>",
