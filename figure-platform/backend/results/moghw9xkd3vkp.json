  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 228 212\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#999\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel (a) - Camera diagram -->\n  <g id=\"panel-a\">\n    <!-- Scene bar at top -->\n    <rect x=\"28\" y=\"20\" width=\"80\" height=\"8\" fill=\"#f0f0f0\" stroke=\"#000\" stroke-width=\"1\" data-elem=\"scene\"/>\n    <text x=\"28\" y=\"15\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Scene</text>\n    \n    <!-- Camera sensor at bottom -->\n    <rect x=\"28\" y=\"160\" width=\"80\" height=\"8\" fill=\"#f0f0f0\" stroke=\"#000\" stroke-width=\"1\" data-elem=\"sensor\"/>\n    <text x=\"28\" y=\"185\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Camera sensor</text>\n    \n    <!-- Occluder bar -->\n    <rect x=\"15\" y=\"85\" width=\"50\" height=\"6\" fill=\"#000\" data-elem=\"occluder\"/>\n    <text x=\"15\" y=\"105\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Occluder</text>\n    \n    <!-- Pinhole -->\n    <circle cx=\"90\" cy=\"88\" r=\"3\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-elem=\"pinhole\"/>\n    <text x=\"102\" y=\"92\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Pinhole</text>\n    \n    <!-- Red path through pinhole -->\n    <path d=\"M 68 24 L 90 88 L 68 164\" stroke=\"#FF4500\" stroke-width=\"2\" fill=\"none\" data-path=\"red\"/>\n    \n    <!-- Green path to occluder -->\n    <path d=\"M 48 24 L 40 85\" stroke=\"#008000\" stroke-width=\"2\" fill=\"none\" data-path=\"green\"/>\n    \n    <!-- Labels for points -->\n    <text x=\"15\" y=\"30\" font-family=\"serif\" font-size=\"13\" fill=\"#000\" font-style=\"italic\">ξ<tspan font-size=\"9\" dy=\"2\">s</tspan></text>\n    <text x=\"15\" y=\"175\" font-family=\"serif\" font-size=\"13\" fill=\"#000\" font-style=\"italic\">ξ<tspan font-size=\"9\" dy=\"2\">c</tspan></text>\n    \n    <!-- (a) label -->\n    <text x=\"60\" y=\"200\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">(a)</text>\n  </g>\n  \n  <!-- Panel (b) - Matrices -->\n  <g id=\"panel-b\" transform=\"translate(130,0)\">\n    <!-- Matrix A -->\n    <g transform=\"translate(10,15)\">\n      <rect x=\"0\" y=\"0\" width=\"40\" height=\"40\" fill=\"#000\" data-matrix=\"A\"/>\n      <line x1=\"0\" y1=\"0\" x2=\"40\" y2=\"40\" stroke=\"#fff\" stroke-width=\"3\"/>\n      <text x=\"60\" y=\"25\" font-family=\"serif\" font-size=\"13\" fill=\"#000\" font-style=\"italic\">A</text>\n    </g>\n    \n    <!-- Matrix A^-1 -->\n    <g transform=\"translate(10,70)\">\n      <rect x=\"0\" y=\"0\" width=\"40\" height=\"40\" fill=\"#000\" data-matrix=\"A-inv\"/>\n      <line x1=\"40\" y1=\"0\" x2=\"0\" y2=\"40\" stroke=\"#fff\" stroke-width=\"3\"/>\n      <text x=\"60\" y=\"25\" font-family=\"serif\" font-size=\"13\" fill=\"#000\" font-style=\"italic\">A<tspan font-size=\"9\" baseline-shift=\"super\">-1</tspan></text>\n    </g>\n    \n    <!-- Matrix B -->\n    <g transform=\"translate(10,125)\">\n      <rect x=\"0\" y=\"0\" width=\"40\" height=\"40\" fill=\"#000\" data-matrix=\"B\"/>\n      <line x1=\"0\" y1=\"0\" x2=\"40\" y2=\"40\" stroke=\"#fff\" stroke-width=\"3\"/>\n      <text x=\"60\" y=\"25\" font-family=\"serif\" font-size=\"13\" fill=\"#000\" font-style=\"italic\">B</text>\n    </g>\n    \n    <!-- (b) label -->\n    <text x=\"25\" y=\"185\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">(b)</text>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  \n  const elements = {\n    scene: { label: 'Scene', desc: 'Object to be imaged' },\n    occluder: { label: 'Occluder', desc: 'Blocks light path' },\n    pinhole: { label: 'Pinhole', desc: 'Aperture for imaging' },\n    sensor: { label: 'Camera sensor', desc: 'Records the image' },\n    red: { label: 'Imaging path', desc: 'Through pinhole' },\n    green: { label: 'Blocked path', desc: 'Hits occluder' },\n    A: { label: 'Matrix A', desc: 'Transform matrix' },\n    'A-inv': { label: 'Matrix A⁻¹', desc: 'Inverse transform' },\n    B: { label: 'Matrix B', desc: 'Secondary transform' }\n  };\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Hover handlers\n  document.querySelectorAll('[data-elem], [data-path], [data-matrix]').forEach(el => {\n    el.addEventListener('mouseenter', e => {\n      const key = el.dataset.elem || el.dataset.path || el.dataset.matrix;\n      const info = elements[key];\n      if (info) {\n        tooltip.textContent = `${info.label} — ${info.desc}`;\n        tooltip.style.display = 'block';\n      }\n      \n      // Highlight element\n      if (el.tagName === 'rect' || el.tagName === 'circle') {\n        el.style.strokeWidth = parseFloat(el.getAttribute('stroke-width') || 1) + 1.5;\n      } else if (el.tagName === 'path') {\n        el.style.strokeWidth = parseFloat(el.getAttribute('stroke-width') || 1) + 1;\n      }\n    });\n    \n    el.addEventListener('mouseleave', e => {\n      tooltip.style.display = 'none';\n      // Reset stroke width\n      if (el.tagName === 'rect' || el.tagName === 'circle') {\n        el.style.strokeWidth = el.getAttribute('stroke-width') || 1;\n      } else if (el.tagName === 'path') {\n        el.style.strokeWidth = el.getAttribute('stroke-width') || 1;\n      }\n    });\n    \n    el.addEventListener('click', e => {\n      e.stopPropagation();\n      const key = el.dataset.elem || el.dataset.path || el.dataset.matrix;\n      const info = elements[key];\n      if (info) {\n        let body = '';\n        if (key === 'scene') {\n          body = 'The scene contains objects to be imaged by the pinhole camera. Light rays from the scene travel toward the camera sensor.';\n        } else if (key === 'pinhole') {\n          body = 'The pinhole acts as the aperture in a pinhole camera model. Only light rays passing through this point reach the sensor to form an inverted image.';\n        } else if (key === 'occluder') {\n          body = 'The occluder blocks certain light paths from reaching the sensor. This demonstrates how objects can cast shadows or block parts of the scene.';\n        } else if (key === 'sensor') {\n          body = 'The camera sensor captures the inverted image formed by light rays passing through the pinhole. Points ξc on the sensor correspond to scene points ξs.';\n        } else if (key === 'red') {\n          body = 'This path shows light successfully traveling from the scene through the pinhole to the sensor, forming the image.';\n        } else if (key === 'green') {\n          body = 'This path is blocked by the occluder and cannot reach the sensor, demonstrating occlusion in the imaging process.';\n        } else if (key === 'A') {\n          body = 'Matrix A represents a transformation in the imaging system, shown with a diagonal pattern indicating its structure.';\n        } else if (key === 'A-inv') {\n          body = 'The inverse matrix A⁻¹ reverses the transformation of matrix A, shown with an opposite diagonal pattern.';\n        } else if (key === 'B') {\n          body = 'Matrix B represents an additional transformation in the system, with its own diagonal structure.';\n        }\n        showPopup(info.label, body);\n      }\n    });\n  });\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Dismiss handlers\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n} catch(e) {\n  console.error('Interactive figure error:', e);\n}\n</script>\n</body>\n</html>",
