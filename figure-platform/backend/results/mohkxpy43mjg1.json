  "id": "mohkxpy43mjg1",
  "filename": "figure_99",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n        .node { cursor: pointer; }\n        .edge { pointer-events: stroke; cursor: pointer; }\n        #tooltip {\n            position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n            -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n            padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n            pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n            box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n        }\n    </style>\n</head>\n<body>\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 494 120\">\n        <defs>\n            <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n                <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n            </marker>\n        </defs>\n        \n        <!-- Panel label -->\n        <text x=\"8\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">a)</text>\n        \n        <!-- Edges -->\n        <g id=\"edges\">\n            <!-- x to h1, h2, h3 -->\n            <line class=\"edge\" x1=\"50\" y1=\"60\" x2=\"130\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h1\"/>\n            <line class=\"edge\" x1=\"50\" y1=\"60\" x2=\"130\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h2\"/>\n            <line class=\"edge\" x1=\"50\" y1=\"60\" x2=\"130\" y2=\"85\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h3\"/>\n            \n            <!-- h1, h2, h3 to y -->\n            <line class=\"edge\" x1=\"170\" y1=\"35\" x2=\"250\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\"/>\n            <line class=\"edge\" x1=\"170\" y1=\"60\" x2=\"250\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\"/>\n            <line class=\"edge\" x1=\"170\" y1=\"85\" x2=\"250\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\"/>\n            \n            <!-- y to h1', h2', h3' -->\n            <line class=\"edge\" x1=\"290\" y1=\"60\" x2=\"360\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h1p\"/>\n            <line class=\"edge\" x1=\"290\" y1=\"60\" x2=\"360\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h2p\"/>\n            <line class=\"edge\" x1=\"290\" y1=\"60\" x2=\"360\" y2=\"85\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h3p\"/>\n            \n            <!-- h1', h2', h3' to y' -->\n            <line class=\"edge\" x1=\"400\" y1=\"35\" x2=\"440\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h1p\" data-to=\"yp\"/>\n            <line class=\"edge\" x1=\"400\" y1=\"60\" x2=\"440\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h2p\" data-to=\"yp\"/>\n            <line class=\"edge\" x1=\"400\" y1=\"85\" x2=\"440\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h3p\" data-to=\"yp\"/>\n        </g>\n        \n        <!-- Nodes -->\n        <g id=\"nodes\">\n            <circle class=\"node\" id=\"x\" cx=\"50\" cy=\"60\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"50\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">x</text>\n            \n            <circle class=\"node\" id=\"h1\" cx=\"150\" cy=\"35\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"150\" y=\"40\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h₁</text>\n            \n            <circle class=\"node\" id=\"h2\" cx=\"150\" cy=\"60\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"150\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h₂</text>\n            \n            <circle class=\"node\" id=\"h3\" cx=\"150\" cy=\"85\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"150\" y=\"90\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h₃</text>\n            \n            <circle class=\"node\" id=\"y\" cx=\"270\" cy=\"60\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"270\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">y</text>\n            \n            <circle class=\"node\" id=\"h1p\" cx=\"380\" cy=\"35\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"380\" y=\"40\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h'₁</text>\n            \n            <circle class=\"node\" id=\"h2p\" cx=\"380\" cy=\"60\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"380\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h'₂</text>\n            \n            <circle class=\"node\" id=\"h3p\" cx=\"380\" cy=\"85\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"380\" y=\"90\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">h'₃</text>\n            \n            <circle class=\"node\" id=\"yp\" cx=\"460\" cy=\"60\" r=\"20\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"460\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#008080\" pointer-events=\"none\">y'</text>\n        </g>\n    </svg>\n    \n    <div id=\"tooltip\"></div>\n    \n    <script>\n    try {\n        const svg = document.querySelector('svg');\n        const tooltip = document.getElementById('tooltip');\n        const nodes = document.querySelectorAll('.node');\n        const edges = document.querySelectorAll('.edge');\n        \n        // Graph connectivity\n        const graph = {\n            'x':   { out:['h1','h2','h3'], in:[],                    label:'x',   role:'Input' },\n            'h1':  { out:['y'],            in:['x'],                  label:'h₁',  role:'Hidden unit 1' },\n            'h2':  { out:['y'],            in:['x'],                  label:'h₂',  role:'Hidden unit 2' },\n            'h3':  { out:['y'],            in:['x'],                  label:'h₃',  role:'Hidden unit 3' },\n            'y':   { out:['h1p','h2p','h3p'], in:['h1','h2','h3'],   label:'y',   role:'Hidden layer output' },\n            'h1p': { out:['yp'],           in:['y'],                  label:'h\\'₁', role:'Hidden unit 1\\'' },\n            'h2p': { out:['yp'],           in:['y'],                  label:'h\\'₂', role:'Hidden unit 2\\'' },\n            'h3p': { out:['yp'],           in:['y'],                  label:'h\\'₃', role:'Hidden unit 3\\'' },\n            'yp':  { out:[],               in:['h1p','h2p','h3p'],    label:'y\\'', role:'Output prediction' }\n        };\n        \n        // Tooltip follow cursor\n        document.addEventListener('mousemove', e => {\n            tooltip.style.left = (e.clientX + 12) + 'px';\n            tooltip.style.top = (e.clientY - 28) + 'px';\n        });\n        \n        // Show/hide popup\n        function showPopup(title, body) {\n            window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n        }\n        function hidePopup() {\n            window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n        }\n        \n        // Node hover\n        nodes.forEach(node => {\n            node.addEventListener('mouseenter', e => {\n                node.style.strokeWidth = '2.5';\n                node.style.fillOpacity = '0.95';\n                \n                const nodeId = node.id;\n                const nodeData = graph[nodeId];\n                \n                // Highlight outgoing edges\n                edges.forEach(edge => {\n                    if (edge.getAttribute('data-from') === nodeId) {\n                        edge.style.stroke = '#e07b30';\n                        edge.style.strokeWidth = '2';\n                    }\n                });\n                \n                // Show tooltip\n                tooltip.textContent = `${nodeData.label} — ${nodeData.role}`;\n                tooltip.style.display = 'block';\n            });\n            \n            node.addEventListener('mouseleave', e => {\n                node.style.strokeWidth = '1';\n                node.style.fillOpacity = '1';\n                \n                // Reset edges\n                edges.forEach(edge => {\n                    edge.style.stroke = '#000';\n                    edge.style.strokeWidth = '1';\n                });\n                \n                tooltip.style.display = 'none';\n            });\n            \n            // Node click\n            node.addEventListener('click', e => {\n                e.stopPropagation();\n                const nodeId = node.id;\n                const nodeData = graph[nodeId];\n                \n                showPopup(nodeData.label, `${nodeData.role}. Connects to: ${nodeData.out.length > 0 ? nodeData.out.join(', ') : 'none'}`);\n                \n                // Animate signal flow\n                animateSignalFlow(nodeId, e.shiftKey);\n            });\n        });\n        \n        // Edge hover\n        edges.forEach(edge => {\n            edge.addEventListener('mouseenter', e => {\n                edge.style.stroke = '#e07b30';\n                edge.style.strokeWidth = '2';\n                \n                const from = graph[edge.getAttribute('data-from')].label;\n                const to = graph[edge.getAttribute('data-to')].label;\n                tooltip.textContent = `${from} → ${to}`;\n                tooltip.style.display = 'block';\n            });\n            \n            edge.addEventListener('mouseleave', e => {\n                edge.style.stroke = '#000';\n                edge.style.strokeWidth = '1';\n                tooltip.style.display = 'none';\n            });\n        });\n        \n        // Animate edges function\n        function animateEdges(edgeEls, color, delay) {\n            setTimeout(() => {\n                edgeEls.forEach(e => {\n                    const len = e.getTotalLength ? e.getTotalLength() : 200;\n                    e.style.transition = 'none';\n                    e.style.strokeDasharray = len;\n                    e.style.strokeDashoffset = len;\n                    e.style.stroke = color;\n                    requestAnimationFrame(() => {\n                        e.style.transition = 'stroke-dashoffset 0.6s ease';\n                        e.style.strokeDashoffset = '0';\n                    });\n                });\n            }, delay);\n        }\n        \n        // Pulse node\n        function pulseNode(nodeEl, delay) {\n            setTimeout(() => {\n                nodeEl.style.transformBox = 'fill-box';\n                nodeEl.style.transformOrigin = 'center';\n                nodeEl.style.transition = 'transform 0.15s ease';\n                nodeEl.style.transform = 'scale(1.18)';\n                setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n            }, delay);\n        }\n        \n        // Signal flow animation\n        function animateSignalFlow(startNodeId, isBackward) {\n            const color = isBackward ? '#e05050' : '#4a7ef5';\n            \n            // Layer structure\n            const layers = [\n                ['x'],\n                ['h1', 'h2', 'h3'],\n                ['y'],\n                ['h1p', 'h2p', 'h3p'],\n                ['yp']\n            ];\n            \n            // Find start layer\n            let startLayer = -1;\n            for (let i = 0; i < layers.length; i++) {\n                if (layers[i].includes(startNodeId)) {\n                    startLayer = i;\n                    break;\n                }\n            }\n            \n            // Animate layers\n            for (let i = startLayer; i < layers.length - 1; i++) {\n                const delay = (i - startLayer) * 650;\n                const layerEdges = [];\n                \n                layers[i].forEach(nodeId => {\n                    edges.forEach(edge => {\n                        if (edge.getAttribute('data-from') === nodeId) {\n                            layerEdges.push(edge);\n                        }\n                    });\n                });\n                \n                animateEdges(layerEdges, color, delay);\n                \n                // Pulse destination nodes\n                layerEdges.forEach(edge => {\n                    const toNodeId = edge.getAttribute('data-to');\n                    const toNode = document.getElementById(toNodeId);\n                    if (toNode) {\n                        pulseNode(toNode, delay + 350);\n                    }\n                });\n            }\n            \n            // Reset after animation\n            setTimeout(() => {\n                edges.forEach(edge => {\n                    edge.style.stroke = '#000';\n                    edge.style.strokeDasharray = 'none';\n                    edge.style.strokeDashoffset = '0';\n                });\n            }, 3000);\n        }\n        \n        // Dismiss handlers\n        document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n        svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n        \n    } catch (err) {\n        console.error('Error:', err);\n    }\n    </script>\n</body>\n</html>",
