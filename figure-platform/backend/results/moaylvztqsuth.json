  "filename": "figure_14",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #fff; }\n        canvas { display: block; width: 100%; height: 100%; }\n        .tooltip {\n            position: fixed;\n            background: rgba(0,0,0,0.55);\n            color: #fff;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 8px;\n            border-radius: 4px;\n            pointer-events: none;\n            z-index: 100;\n            max-width: 200px;\n            display: none;\n        }\n        .popup {\n            position: fixed;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: rgba(245,245,245,0.94);\n            backdrop-filter: blur(6px);\n            border-top: 1px solid rgba(0,0,0,0.1);\n            padding: 8px 12px;\n            font: 12px/1.5 sans-serif;\n            color: #333;\n            z-index: 101;\n            box-shadow: 0 -2px 12px rgba(0,0,0,0.08);\n            display: none;\n        }\n        .hint {\n            position: fixed;\n            bottom: 10px;\n            left: 50%;\n            transform: translateX(-50%);\n            font: 10px sans-serif;\n            color: rgba(0,0,0,0.35);\n            pointer-events: none;\n            transition: opacity 1s;\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <div class=\"tooltip\" id=\"tooltip\"></div>\n    <div class=\"popup\" id=\"popup\"></div>\n    <div class=\"hint\" id=\"hint\">drag to rotate</div>\n\n    <script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n    <script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n    <script>\n        try {\n            // CAMERA ANALYSIS\n            // x-axis points: right\n            // y-axis points: up\n            // z-axis points: toward-viewer\n            // Elevation (degrees above horizon): 25°\n            // Azimuth (degrees, 0=front, 90=right, etc.): 30°\n            // Derived camera.position: set(15, 8, 12)\n\n            const scene = new THREE.Scene();\n            const canvas = document.getElementById('canvas');\n            const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });\n            renderer.setClearColor(0xffffff, 1);\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            \n            const aspect = window.innerWidth / window.innerHeight;\n            const camera = new THREE.PerspectiveCamera(25, aspect, 0.1, 1000);\n            camera.position.set(15, 8, 12);\n            camera.lookAt(0, 0, 0);\n            \n            // Lighting\n            scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n            \n            // Layer data\n            const layers = [\n                { label: 'Conv 224 × 224 × 3', width: 2.24, height: 2.24, depth: 0.03, x: -8 },\n                { label: 'Conv 224 × 224 × 64', width: 2.24, height: 2.24, depth: 0.64, x: -6 },\n                { label: 'MaxPool 112 × 112 × 64', width: 1.12, height: 1.12, depth: 0.64, x: -4 },\n                { label: 'Conv 112 × 112 × 128', width: 1.12, height: 1.12, depth: 1.28, x: -2 },\n                { label: 'MaxPool 56 × 56 × 128', width: 0.56, height: 0.56, depth: 1.28, x: 0 },\n                { label: 'Conv 56 × 56 × 256', width: 0.56, height: 0.56, depth: 2.56, x: 2 },\n                { label: 'MaxPool 28 × 28 × 256', width: 0.28, height: 0.28, depth: 2.56, x: 4 },\n                { label: 'Conv 28 × 28 × 512', width: 0.28, height: 0.28, depth: 5.12, x: 6 },\n                { label: 'MaxPool 14 × 14 × 512', width: 0.14, height: 0.14, depth: 5.12, x: 8 },\n                { label: 'Conv 14 × 14 × 512', width: 0.14, height: 0.14, depth: 5.12, x: 10 },\n                { label: 'MaxPool 7 × 7 × 512', width: 0.07, height: 0.07, depth: 5.12, x: 12 }\n            ];\n            \n            const denseLayers = [\n                { label: 'Flatten 25088', width: 0.3, height: 4, depth: 0.3, x: 14, y: 0 },\n                { label: 'Dense 4096', width: 0.3, height: 3.2, depth: 0.3, x: 15.5, y: 0.4 },\n                { label: 'Dense 4096', width: 0.3, height: 3.2, depth: 0.3, x: 17, y: 0.4 },\n                { label: 'Output 1000', width: 0.3, height: 2, depth: 0.3, x: 18.5, y: 1 }\n            ];\n            \n            // Create conv/pool layers\n            const layerMeshes = [];\n            layers.forEach((layer, i) => {\n                const geometry = new THREE.BoxGeometry(layer.depth, layer.height, layer.width);\n                const material = new THREE.MeshBasicMaterial({ \n                    color: 0x964B00, \n                    transparent: true, \n                    opacity: 0.85 \n                });\n                const mesh = new THREE.Mesh(geometry, material);\n                mesh.position.set(layer.x, 0, 0);\n                mesh.userData = layer;\n                scene.add(mesh);\n                layerMeshes.push(mesh);\n                \n                // Add edges\n                const edges = new THREE.EdgesGeometry(geometry);\n                const line = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({ color: 0x333333 }));\n                mesh.add(line);\n            });\n            \n            // Create dense layers\n            denseLayers.forEach((layer, i) => {\n                const geometry = new THREE.BoxGeometry(layer.depth, layer.height, layer.width);\n                const material = new THREE.MeshBasicMaterial({ \n                    color: 0x008080, \n                    transparent: true, \n                    opacity: 0.85 \n                });\n                const mesh = new THREE.Mesh(geometry, material);\n                mesh.position.set(layer.x, layer.y || 0, 0);\n                mesh.userData = layer;\n                scene.add(mesh);\n                layerMeshes.push(mesh);\n                \n                // Add edges\n                const edges = new THREE.EdgesGeometry(geometry);\n                const line = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({ color: 0x333333 }));\n                mesh.add(line);\n            });\n            \n            // Add labels using sprites\n            const labelSprites = [];\n            const allLayers = [...layers, ...denseLayers];\n            allLayers.forEach(layer => {\n                const canvas = document.createElement('canvas');\n                const context = canvas.getContext('2d');\n                canvas.width = 256;\n                canvas.height = 64;\n                context.font = '20px sans-serif';\n                context.fillStyle = 'black';\n                context.textAlign = 'center';\n                context.fillText(layer.label, 128, 40);\n                \n                const texture = new THREE.CanvasTexture(canvas);\n                const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n                const sprite = new THREE.Sprite(spriteMaterial);\n                sprite.scale.set(4, 1, 1);\n                sprite.position.set(layer.x, (layer.y || 0) + layer.height/2 + 0.8, 0);\n                scene.add(sprite);\n                labelSprites.push(sprite);\n            });\n            \n            // OrbitControls\n            const controls = new THREE.OrbitControls(camera, renderer.domElement);\n            controls.enableDamping = true;\n            controls.dampingFactor = 0.05;\n            \n            // Raycaster for interaction\n            const raycaster = new THREE.Raycaster();\n            const mouse = new THREE.Vector2();\n            \n            // Tooltip and popup elements\n            const tooltip = document.getElementById('tooltip');\n            const popup = document.getElementById('popup');\n            const hint = document.getElementById('hint');\n            \n            // Fade hint after 3 seconds\n            setTimeout(() => {\n                hint.style.opacity = '0';\n                setTimeout(() => hint.style.display = 'none', 1000);\n            }, 3000);\n            \n            // Layer descriptions\n            const descriptions = {\n                'Conv 224 × 224 × 3': 'Input layer: RGB image with 224×224 pixels and 3 color channels',\n                'Conv 224 × 224 × 64': 'First convolutional layer: 64 filters producing 224×224 feature maps',\n                'MaxPool 112 × 112 × 64': 'Max pooling reduces spatial dimensions to 112×112',\n                'Conv 112 × 112 × 128': 'Second convolutional layer: 128 filters',\n                'MaxPool 56 × 56 × 128': 'Further spatial reduction to 56×56',\n                'Conv 56 × 56 × 256': 'Third convolutional layer: 256 filters for deeper features',\n                'MaxPool 28 × 28 × 256': 'Pooling to 28×28 spatial dimensions',\n                'Conv 28 × 28 × 512': 'Fourth convolutional layer: 512 filters',\n                'MaxPool 14 × 14 × 512': 'Pooling to 14×14',\n                'Conv 14 × 14 × 512': 'Fifth convolutional layer: maintains 512 filters',\n                'MaxPool 7 × 7 × 512': 'Final pooling to 7×7 spatial dimensions',\n                'Flatten 25088': 'Flattens 7×7×512 = 25,088 values into a vector',\n                'Dense 4096': 'Fully connected layer with 4,096 neurons',\n                'Output 1000': 'Final output layer for 1,000 class classification'\n            };\n            \n            let hoveredMesh = null;\n            \n            function onMouseMove(event) {\n                mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n                mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n                \n                raycaster.setFromCamera(mouse, camera);\n                const intersects = raycaster.intersectObjects(layerMeshes);\n                \n                if (intersects.length > 0) {\n                    const mesh = intersects[0].object;\n                    if (hoveredMesh !== mesh) {\n                        if (hoveredMesh) {\n                            hoveredMesh.material.opacity = 0.85;\n                        }\n                        hoveredMesh = mesh;\n                        mesh.material.opacity = 1.0;\n                        \n                        tooltip.textContent = mesh.userData.label;\n                        tooltip.style.display = 'block';\n                    }\n                    \n                    tooltip.style.left = event.clientX + 10 + 'px';\n                    tooltip.style.top = event.clientY - 30 + 'px';\n                } else {\n                    if (hoveredMesh) {\n                        hoveredMesh.material.opacity = 0.85;\n                        hoveredMesh = null;\n                    }\n                    tooltip.style.display = 'none';\n                }\n            }\n            \n            function onClick(event) {\n                mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n                mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n                \n                raycaster.setFromCamera(mouse, camera);\n                const intersects = raycaster.intersectObjects(layerMeshes);\n                \n                if (intersects.length > 0) {\n                    const mesh = intersects[0].object;\n                    const desc = descriptions[mesh.userData.label];\n                    if (desc) {\n                        popup.innerHTML = `<strong>${mesh.userData.label}</strong><br>${desc}`;\n                        popup.style.display = 'block';\n                    }\n                } else {\n                    popup.style.display = 'none';\n                }\n            }\n            \n            window.addEventListener('mousemove', onMouseMove);\n            window.addEventListener('click', onClick);\n            \n            // Close popup on escape\n            window.addEventListener('keydown', (e) => {\n                if (e.key === 'Escape') {\n                    popup.style.display = 'none';\n                }\n            });\n            \n            // Resize handler\n            window.addEventListener('resize', () => {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            });\n            \n            // Animation loop\n            function animate() {\n                requestAnimationFrame(animate);\n                controls.update();\n                renderer.render(scene, camera);\n            }\n            animate();\n            \n        } catch (error) {\n            console.error('Error initializing 3D scene:', error);\n            // Fallback to static SVG if Three.js fails\n            document.body.innerHTML = `\n                <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 800 400\" preserveAspectRatio=\"xMidYMid meet\">\n                    <rect x=\"50\" y=\"100\" width=\"40\" height=\"200\" fill=\"#964B00\" stroke=\"#333\" />\n                    <text x=\"70\" y=\"90\" text-anchor=\"middle\" font-size=\"10\">Conv 224×224×3</text>\n                    <text x=\"400\" y=\"250\" text-anchor=\"middle\" font-size=\"12\">CNN Architecture (3D view failed to load)</text>\n                </svg>\n            `;\n        }\n    </script>\n</body>\n</html>",
