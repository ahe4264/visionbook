  "filename": "figure_26",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { \n  margin: 0; \n  padding: 0; \n  width: 100%; \n  height: 100%; \n  overflow: hidden; \n  background: #fff; \n  font-family: sans-serif;\n}\n\n.tooltip {\n  position: fixed;\n  background: rgba(0,0,0,0.55);\n  color: #fff;\n  font: 11px/1.4 sans-serif;\n  padding: 5px 8px;\n  border-radius: 4px;\n  pointer-events: none;\n  z-index: 100;\n  max-width: 220px;\n  display: none;\n}\n\n.popup {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: rgba(245,245,245,0.95);\n  backdrop-filter: blur(6px);\n  border-top: 1px solid rgba(0,0,0,0.1);\n  padding: 8px 12px;\n  font: 12px/1.5 sans-serif;\n  color: #333;\n  z-index: 101;\n  display: none;\n}\n\n.node {\n  fill: #fff;\n  stroke: #000;\n  stroke-width: 1;\n  cursor: pointer;\n}\n\n.node:hover {\n  stroke-width: 2;\n}\n\n.edge {\n  stroke: #000;\n  stroke-width: 1;\n  fill: none;\n  marker-end: url(#arrow);\n}\n\n.activation-symbol {\n  stroke: #008080;\n  stroke-width: 1.5;\n  fill: none;\n}\n\n.label {\n  font: 12px sans-serif;\n  text-anchor: middle;\n  dominant-baseline: central;\n  fill: #000;\n  pointer-events: none;\n}\n\n.section-label {\n  font: 11px sans-serif;\n  fill: #000;\n  pointer-events: none;\n}\n</style>\n</head>\n<body>\n\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 200\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Section label a) -->\n  <text x=\"15\" y=\"25\" class=\"section-label\">a)</text>\n  \n  <!-- Left network edges -->\n  <!-- x to h1 -->\n  <line x1=\"50\" y1=\"100\" x2=\"120\" y2=\"60\" class=\"edge\"/>\n  <!-- x to h2 -->\n  <line x1=\"50\" y1=\"100\" x2=\"120\" y2=\"100\" class=\"edge\"/>\n  <!-- x to h3 -->\n  <line x1=\"50\" y1=\"100\" x2=\"120\" y2=\"140\" class=\"edge\"/>\n  \n  <!-- h1 to y -->\n  <line x1=\"150\" y1=\"60\" x2=\"220\" y2=\"100\" class=\"edge\"/>\n  <!-- h2 to y -->\n  <line x1=\"150\" y1=\"100\" x2=\"220\" y2=\"100\" class=\"edge\"/>\n  <!-- h3 to y -->\n  <line x1=\"150\" y1=\"140\" x2=\"220\" y2=\"100\" class=\"edge\"/>\n  \n  <!-- Right network edges -->\n  <!-- y to h1' -->\n  <line x1=\"250\" y1=\"100\" x2=\"320\" y2=\"60\" class=\"edge\"/>\n  <!-- y to h2' -->\n  <line x1=\"250\" y1=\"100\" x2=\"320\" y2=\"100\" class=\"edge\"/>\n  <!-- y to h3' -->\n  <line x1=\"250\" y1=\"100\" x2=\"320\" y2=\"140\" class=\"edge\"/>\n  \n  <!-- h1' to y' -->\n  <line x1=\"350\" y1=\"60\" x2=\"420\" y2=\"100\" class=\"edge\"/>\n  <!-- h2' to y' -->\n  <line x1=\"350\" y1=\"100\" x2=\"420\" y2=\"100\" class=\"edge\"/>\n  <!-- h3' to y' -->\n  <line x1=\"350\" y1=\"140\" x2=\"420\" y2=\"100\" class=\"edge\"/>\n  \n  <!-- Left network nodes -->\n  <circle cx=\"50\" cy=\"100\" r=\"15\" class=\"node\" data-label=\"x\" data-desc=\"Input node x - receives initial data\"/>\n  <circle cx=\"135\" cy=\"60\" r=\"15\" class=\"node\" data-label=\"h₁\" data-desc=\"Hidden node h₁ - processes input with activation function\"/>\n  <circle cx=\"135\" cy=\"100\" r=\"15\" class=\"node\" data-label=\"h₂\" data-desc=\"Hidden node h₂ - processes input with activation function\"/>\n  <circle cx=\"135\" cy=\"140\" r=\"15\" class=\"node\" data-label=\"h₃\" data-desc=\"Hidden node h₃ - processes input with activation function\"/>\n  <circle cx=\"235\" cy=\"100\" r=\"15\" class=\"node\" data-label=\"y\" data-desc=\"Intermediate output y - result of first layer processing\"/>\n  \n  <!-- Right network nodes -->\n  <circle cx=\"335\" cy=\"60\" r=\"15\" class=\"node\" data-label=\"h₁'\" data-desc=\"Hidden node h₁' - second layer processing with activation function\"/>\n  <circle cx=\"335\" cy=\"100\" r=\"15\" class=\"node\" data-label=\"h₂'\" data-desc=\"Hidden node h₂' - second layer processing with activation function\"/>\n  <circle cx=\"335\" cy=\"140\" r=\"15\" class=\"node\" data-label=\"h₃'\" data-desc=\"Hidden node h₃' - second layer processing with activation function\"/>\n  <circle cx=\"450\" cy=\"100\" r=\"15\" class=\"node\" data-label=\"y'\" data-desc=\"Final output y' - result of complete network processing\"/>\n  \n  <!-- Activation symbols (teal squiggles) in hidden nodes -->\n  <!-- h1 -->\n  <path d=\"M127,60 Q130,57 133,60 Q136,63 139,60 Q142,57 145,60\" class=\"activation-symbol\"/>\n  <!-- h2 -->\n  <path d=\"M127,100 Q130,97 133,100 Q136,103 139,100 Q142,97 145,100\" class=\"activation-symbol\"/>\n  <!-- h3 -->\n  <path d=\"M127,140 Q130,137 133,140 Q136,143 139,140 Q142,137 145,140\" class=\"activation-symbol\"/>\n  <!-- h1' -->\n  <path d=\"M327,60 Q330,57 333,60 Q336,63 339,60 Q342,57 345,60\" class=\"activation-symbol\"/>\n  <!-- h2' -->\n  <path d=\"M327,100 Q330,97 333,100 Q336,103 339,100 Q342,97 345,100\" class=\"activation-symbol\"/>\n  <!-- h3' -->\n  <path d=\"M327,140 Q330,137 333,140 Q336,143 339,140 Q342,137 345,140\" class=\"activation-symbol\"/>\n  \n  <!-- Node labels -->\n  <text x=\"50\" y=\"100\" class=\"label\">x</text>\n  <text x=\"135\" y=\"60\" class=\"label\">h₁</text>\n  <text x=\"135\" y=\"100\" class=\"label\">h₂</text>\n  <text x=\"135\" y=\"140\" class=\"label\">h₃</text>\n  <text x=\"235\" y=\"100\" class=\"label\">y</text>\n  <text x=\"335\" y=\"60\" class=\"label\">h₁'</text>\n  <text x=\"335\" y=\"100\" class=\"label\">h₂'</text>\n  <text x=\"335\" y=\"140\" class=\"label\">h₃'</text>\n  <text x=\"450\" y=\"100\" class=\"label\">y'</text>\n</svg>\n\n<div id=\"tooltip\" class=\"tooltip\"></div>\n<div id=\"popup\" class=\"popup\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const popup = document.getElementById('popup');\n  const nodes = document.querySelectorAll('.node');\n  \n  function showTooltip(event, text) {\n    tooltip.textContent = text;\n    tooltip.style.display = 'block';\n    tooltip.style.left = (event.clientX + 10) + 'px';\n    tooltip.style.top = (event.clientY - 30) + 'px';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.display = 'none';\n  }\n  \n  function showPopup(content) {\n    popup.innerHTML = content;\n    popup.style.display = 'block';\n  }\n  \n  function hidePopup() {\n    popup.style.display = 'none';\n  }\n  \n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', (e) => {\n      const label = node.dataset.label;\n      showTooltip(e, label);\n    });\n    \n    node.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    node.addEventListener('mouseleave', hideTooltip);\n    \n    node.addEventListener('click', (e) => {\n      e.stopPropagation();\n      const label = node.dataset.label;\n      const desc = node.dataset.desc;\n      const content = `<strong>${label}</strong><br>${desc}`;\n      showPopup(content);\n    });\n  });\n  \n  document.addEventListener('click', (e) => {\n    if (!popup.contains(e.target)) {\n      hidePopup();\n    }\n  });\n  \n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      hidePopup();\n    }\n  });\n  \n} catch (error) {\n  console.error('Script error:', error);\n}\n</script>\n\n</body>\n</html>",
