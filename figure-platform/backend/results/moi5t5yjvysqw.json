  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n  #tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<div id=\"tooltip\"></div>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 400\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\">\n      <path d=\"M0,0 L0,5 L5,2.5 z\" fill=\"#999\"/>\n    </marker>\n  </defs>\n  \n  <!-- Labels -->\n  <text x=\"60\" y=\"25\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Input layer</text>\n  <text x=\"270\" y=\"25\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Hidden layer</text>\n  <text x=\"480\" y=\"25\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Output layer</text>\n  <text x=\"140\" y=\"280\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Weight</text>\n  <text x=\"290\" y=\"330\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#8B4513\">Neuron or</text>\n  <text x=\"285\" y=\"342\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#8B4513\">hidden unit</text>\n  \n  <!-- Input layer nodes -->\n  <circle cx=\"90\" cy=\"100\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"input\" data-node=\"x1\"/>\n  <text x=\"90\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">x₁</text>\n  \n  <circle cx=\"90\" cy=\"180\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"input\" data-node=\"x2\"/>\n  <text x=\"90\" y=\"185\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">x₂</text>\n  \n  <circle cx=\"90\" cy=\"260\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"input\" data-node=\"x3\"/>\n  <text x=\"90\" y=\"265\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">x₃</text>\n  \n  <!-- Hidden layer nodes -->\n  <circle cx=\"300\" cy=\"80\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"hidden\" data-node=\"h1\"/>\n  <text x=\"300\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">h₁</text>\n  \n  <circle cx=\"300\" cy=\"160\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"hidden\" data-node=\"h2\"/>\n  <text x=\"300\" y=\"165\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">h₂</text>\n  \n  <circle cx=\"300\" cy=\"240\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"hidden\" data-node=\"h3\"/>\n  <text x=\"300\" y=\"245\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">h₃</text>\n  \n  <circle cx=\"300\" cy=\"320\" r=\"30\" fill=\"#fff\" stroke=\"#8B4513\" stroke-width=\"1.5\" class=\"node\" data-layer=\"hidden\" data-node=\"h4\"/>\n  <text x=\"300\" y=\"325\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">h₄</text>\n  \n  <!-- Output layer nodes -->\n  <circle cx=\"510\" cy=\"140\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"output\" data-node=\"y1\"/>\n  <text x=\"510\" y=\"145\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">y₁</text>\n  \n  <circle cx=\"510\" cy=\"220\" r=\"30\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" class=\"node\" data-layer=\"output\" data-node=\"y2\"/>\n  <text x=\"510\" y=\"225\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">y₂</text>\n  \n  <!-- Edges from input to hidden layer -->\n  <line x1=\"120\" y1=\"100\" x2=\"265\" y2=\"80\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x1\" data-to=\"h1\"/>\n  <line x1=\"120\" y1=\"100\" x2=\"265\" y2=\"160\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x1\" data-to=\"h2\"/>\n  <line x1=\"120\" y1=\"100\" x2=\"265\" y2=\"240\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x1\" data-to=\"h3\"/>\n  <line x1=\"120\" y1=\"100\" x2=\"265\" y2=\"320\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x1\" data-to=\"h4\"/>\n  \n  <line x1=\"120\" y1=\"180\" x2=\"265\" y2=\"80\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x2\" data-to=\"h1\"/>\n  <line x1=\"120\" y1=\"180\" x2=\"265\" y2=\"160\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x2\" data-to=\"h2\"/>\n  <line x1=\"120\" y1=\"180\" x2=\"265\" y2=\"240\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x2\" data-to=\"h3\"/>\n  <line x1=\"120\" y1=\"180\" x2=\"265\" y2=\"320\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x2\" data-to=\"h4\"/>\n  \n  <line x1=\"120\" y1=\"260\" x2=\"265\" y2=\"80\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x3\" data-to=\"h1\"/>\n  <line x1=\"120\" y1=\"260\" x2=\"265\" y2=\"160\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x3\" data-to=\"h2\"/>\n  <line x1=\"120\" y1=\"260\" x2=\"265\" y2=\"240\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x3\" data-to=\"h3\"/>\n  <line x1=\"120\" y1=\"260\" x2=\"265\" y2=\"320\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x3\" data-to=\"h4\"/>\n  \n  <!-- Edges from hidden to output layer -->\n  <line x1=\"330\" y1=\"80\" x2=\"475\" y2=\"140\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h1\" data-to=\"y1\"/>\n  <line x1=\"330\" y1=\"80\" x2=\"475\" y2=\"220\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h1\" data-to=\"y2\"/>\n  \n  <line x1=\"330\" y1=\"160\" x2=\"475\" y2=\"140\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h2\" data-to=\"y1\"/>\n  <line x1=\"330\" y1=\"160\" x2=\"475\" y2=\"220\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h2\" data-to=\"y2\"/>\n  \n  <line x1=\"330\" y1=\"240\" x2=\"475\" y2=\"140\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h3\" data-to=\"y1\"/>\n  <line x1=\"330\" y1=\"240\" x2=\"475\" y2=\"220\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h3\" data-to=\"y2\"/>\n  \n  <line x1=\"330\" y1=\"320\" x2=\"475\" y2=\"140\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h4\" data-to=\"y1\"/>\n  <line x1=\"330\" y1=\"320\" x2=\"475\" y2=\"220\" stroke=\"#999\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"h4\" data-to=\"y2\"/>\n</svg>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const svg = document.querySelector('svg');\n  \n  function showPopup(title, body) { window.parent.postMessage({ type:'alex-popup', title, body }, '*'); }\n  function hidePopup() { window.parent.postMessage({ type:'alex-popup', title:null }, '*'); }\n  \n  document.addEventListener('keydown', e => { if(e.key==='Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if(e.target===svg||e.target.tagName==='svg') hidePopup(); });\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Hover effects for nodes\n  const nodes = document.querySelectorAll('.node');\n  nodes.forEach(node => {\n    node.style.cursor = 'pointer';\n    node.style.transition = 'stroke-width 0.2s ease';\n    \n    node.addEventListener('mouseenter', e => {\n      node.style.strokeWidth = '3';\n      const layer = node.dataset.layer;\n      const id = node.dataset.node;\n      let desc = '';\n      if(layer === 'input') desc = 'Input neuron - receives data features';\n      else if(layer === 'hidden') desc = 'Hidden neuron - processes inputs';\n      else if(layer === 'output') desc = 'Output neuron - produces predictions';\n      tooltip.textContent = `${id}: ${desc}`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      node.style.strokeWidth = '1.5';\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const layer = node.dataset.layer;\n      const id = node.dataset.node;\n      let title = '', body = '';\n      \n      if(layer === 'input') {\n        title = `Input Neuron ${id}`;\n        body = 'Input neurons receive raw data features from the dataset. Each input neuron represents one feature or dimension of the input data, passing its value forward to all neurons in the hidden layer through weighted connections.';\n      } else if(layer === 'hidden') {\n        title = `Hidden Neuron ${id}`;\n        body = 'Hidden neurons form the computational core of the network. They combine weighted inputs from the previous layer, apply an activation function, and extract complex patterns that help map inputs to outputs through learned representations.';\n      } else if(layer === 'output') {\n        title = `Output Neuron ${id}`;\n        body = 'Output neurons produce the final predictions or classifications. They aggregate the processed information from the hidden layer and generate the network\\'s response, which could be a class probability, regression value, or other prediction.';\n      }\n      \n      showPopup(title, body);\n    });\n  });\n  \n  // Hover effects for edges\n  const edges = document.querySelectorAll('.edge');\n  edges.forEach(edge => {\n    edge.style.cursor = 'pointer';\n    edge.style.transition = 'stroke-width 0.2s ease, stroke 0.2s ease';\n    \n    edge.addEventListener('mouseenter', e => {\n      edge.style.strokeWidth = '3';\n      edge.style.stroke = '#666';\n      const from = edge.dataset.from;\n      const to = edge.dataset.to;\n      tooltip.textContent = `Weight: ${from} → ${to}`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', e => {\n      edge.style.strokeWidth = '1.5';\n      edge.style.stroke = '#999';\n      tooltip.style.display = 'none';\n    });\n    \n    edge.addEventListener('click', e => {\n      e.stopPropagation();\n      const from = edge.dataset.from;\n      const to = edge.dataset.to;\n      showPopup(`Connection: ${from} → ${to}`, 'This weight determines how strongly the signal from the source neuron influences the target neuron. During training, these weights are adjusted through backpropagation to minimize prediction errors and improve network performance.');\n    });\n  });\n  \n  // Signal flow animation\n  let animating = false;\n  svg.addEventListener('click', e => {\n    if(e.target.classList.contains('node') || e.target.classList.contains('edge')) return;\n    if(animating) return;\n    \n    animating = true;\n    hidePopup();\n    \n    // Reset all colors\n    nodes.forEach(n => {\n      n.style.transition = 'fill 0.35s ease';\n      n.style.fill = '#fff';\n    });\n    edges.forEach(e => {\n      e.style.transition = 'stroke 0.35s ease';\n      e.style.stroke = '#999';\n    });\n    \n    // Animate signal flow through network\n    setTimeout(() => {\n      // Highlight input layer\n      document.querySelectorAll('[data-layer=\"input\"]').forEach(n => {\n        n.style.fill = '#c8e0ff';\n      });\n    }, 100);\n    \n    setTimeout(() => {\n      // Highlight edges from input to hidden\n      edges.forEach(e => {\n        if(e.dataset.from.startsWith('x')) {\n          e.style.stroke = '#4a90e2';\n        }\n      });\n    }, 500);\n    \n    setTimeout(() => {\n      // Highlight hidden layer\n      document.querySelectorAll('[data-layer=\"hidden\"]').forEach(n => {\n        n.style.fill = '#c8f0c8';\n      });\n    }, 900);\n    \n    setTimeout(() => {\n      // Highlight edges from hidden to output\n      edges.forEach(e => {\n        if(e.dataset.from.startsWith('h')) {\n          e.style.stroke = '#5cb85c';\n        }\n      });\n    }, 1300);\n    \n    setTimeout(() => {\n      // Highlight output layer\n      document.querySelectorAll('[data-layer=\"output\"]').forEach(n => {\n        n.style.fill = '#ffddaa';\n      });\n    }, 1700);\n    \n    // Reset after animation\n    setTimeout(() => {\n      nodes.forEach(n => {\n        n.style.fill = '#fff';\n      });\n      edges.forEach(e => {\n        e.style.stroke = '#999';\n      });\n      animating = false;\n    }, 2500);\n  });\n  \n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
