  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n    position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 463 107\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Label a) -->\n  <text x=\"8\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">a)</text>\n  \n  <!-- Input nodes -->\n  <circle class=\"node\" id=\"x1\" cx=\"45\" cy=\"30\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"45\" y=\"34\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">x₁</text>\n  \n  <circle class=\"node\" id=\"x2\" cx=\"45\" cy=\"75\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"45\" y=\"79\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">x₂</text>\n  \n  <!-- Hidden layer nodes -->\n  <circle class=\"node\" id=\"h1\" cx=\"120\" cy=\"20\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"120\" y=\"24\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">h₁</text>\n  \n  <circle class=\"node\" id=\"h2\" cx=\"120\" cy=\"53\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"120\" y=\"57\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">h₂</text>\n  \n  <circle class=\"node\" id=\"h3\" cx=\"120\" cy=\"86\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"120\" y=\"90\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">h₃</text>\n  \n  <!-- Output node -->\n  <circle class=\"node\" id=\"y\" cx=\"195\" cy=\"53\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"195\" y=\"57\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">y</text>\n  \n  <!-- Hidden layer nodes with activation -->\n  <circle class=\"node\" id=\"h1p\" cx=\"285\" cy=\"20\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"285\" y=\"24\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">h'₁</text>\n  <path d=\"M278,18 Q280,20 282,18 T286,20 T290,18 T292,20\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\"/>\n  \n  <circle class=\"node\" id=\"h2p\" cx=\"285\" cy=\"86\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"285\" y=\"90\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">h'₂</text>\n  <path d=\"M278,84 Q280,86 282,84 T286,86 T290,84 T292,86\" fill=\"none\" stroke=\"#008080\" stroke-width=\"1.5\"/>\n  \n  <!-- Final output node -->\n  <circle class=\"node\" id=\"yp\" cx=\"405\" cy=\"53\" r=\"12\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"405\" y=\"57\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"#000\">y'</text>\n  \n  <!-- Edges Layer 0 (input to hidden) -->\n  <line class=\"edge layer0\" data-from=\"x1\" data-to=\"h1\" x1=\"57\" y1=\"30\" x2=\"108\" y2=\"20\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer0\" data-from=\"x1\" data-to=\"h2\" x1=\"57\" y1=\"30\" x2=\"108\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer0\" data-from=\"x1\" data-to=\"h3\" x1=\"57\" y1=\"30\" x2=\"108\" y2=\"86\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer0\" data-from=\"x2\" data-to=\"h1\" x1=\"57\" y1=\"75\" x2=\"108\" y2=\"20\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer0\" data-from=\"x2\" data-to=\"h2\" x1=\"57\" y1=\"75\" x2=\"108\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer0\" data-from=\"x2\" data-to=\"h3\" x1=\"57\" y1=\"75\" x2=\"108\" y2=\"86\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- Edges Layer 1 (hidden to output) -->\n  <line class=\"edge layer1\" data-from=\"h1\" data-to=\"y\" x1=\"132\" y1=\"20\" x2=\"183\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer1\" data-from=\"h2\" data-to=\"y\" x1=\"132\" y1=\"53\" x2=\"183\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer1\" data-from=\"h3\" data-to=\"y\" x1=\"132\" y1=\"86\" x2=\"183\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- Edges Layer 2 (y to h') -->\n  <line class=\"edge layer2\" data-from=\"y\" data-to=\"h1p\" x1=\"207\" y1=\"53\" x2=\"273\" y2=\"20\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer2\" data-from=\"y\" data-to=\"h2p\" x1=\"207\" y1=\"53\" x2=\"273\" y2=\"86\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- Edges Layer 3 (h' to y') -->\n  <line class=\"edge layer3\" data-from=\"h1p\" data-to=\"yp\" x1=\"297\" y1=\"20\" x2=\"393\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line class=\"edge layer3\" data-from=\"h2p\" data-to=\"yp\" x1=\"297\" y1=\"86\" x2=\"393\" y2=\"53\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\n\n// Graph structure\nconst graph = {\n  'x1':  { out:['h1','h2','h3'], in:[],             label:'x₁',  role:'Input 1' },\n  'x2':  { out:['h1','h2','h3'], in:[],             label:'x₂',  role:'Input 2' },\n  'h1':  { out:['y'],            in:['x1','x2'],     label:'h₁',  role:'Hidden unit 1' },\n  'h2':  { out:['y'],            in:['x1','x2'],     label:'h₂',  role:'Hidden unit 2' },\n  'h3':  { out:['y'],            in:['x1','x2'],     label:'h₃',  role:'Hidden unit 3' },\n  'y':   { out:['h1p','h2p'],    in:['h1','h2','h3'], label:'y',   role:'Intermediate output' },\n  'h1p': { out:['yp'],           in:['y'],           label:'h\\'₁', role:'Activated hidden 1' },\n  'h2p': { out:['yp'],           in:['y'],           label:'h\\'₂', role:'Activated hidden 2' },\n  'yp':  { out:[],               in:['h1p','h2p'],   label:'y\\'',  role:'Final output' }\n};\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Node hover\ndocument.querySelectorAll('.node').forEach(node => {\n  node.style.cursor = 'pointer';\n  \n  node.addEventListener('mouseenter', e => {\n    const id = node.id;\n    node.setAttribute('stroke-width', '2.5');\n    node.style.fillOpacity = '0.9';\n    \n    // Highlight outgoing edges\n    document.querySelectorAll('.edge').forEach(edge => {\n      if (edge.getAttribute('data-from') === id) {\n        edge.setAttribute('stroke', '#e07b30');\n        edge.setAttribute('stroke-width', '2');\n      }\n    });\n    \n    // Show tooltip\n    const info = graph[id];\n    if (info) {\n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n    }\n  });\n  \n  node.addEventListener('mouseleave', e => {\n    node.setAttribute('stroke-width', '1');\n    node.style.fillOpacity = '1';\n    \n    // Reset edges\n    document.querySelectorAll('.edge').forEach(edge => {\n      edge.setAttribute('stroke', '#000');\n      edge.setAttribute('stroke-width', '1');\n    });\n    \n    tooltip.style.display = 'none';\n  });\n});\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Node click\ndocument.querySelectorAll('.node').forEach(node => {\n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.id;\n    const info = graph[id];\n    if (!info) return;\n    \n    let body = `<p><strong>Role:</strong> ${info.role}</p>`;\n    if (info.in.length > 0) {\n      body += `<p><strong>Inputs from:</strong> ${info.in.map(n => graph[n].label).join(', ')}</p>`;\n    }\n    if (info.out.length > 0) {\n      body += `<p><strong>Outputs to:</strong> ${info.out.map(n => graph[n].label).join(', ')}</p>`;\n    }\n    \n    showPopup(info.label, body);\n    \n    // Animate signal flow\n    const isBackward = e.shiftKey;\n    const color = isBackward ? '#e05050' : '#4a7ef5';\n    \n    // Reset all edges\n    document.querySelectorAll('.edge').forEach(edge => {\n      edge.style.transition = 'none';\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n    });\n    \n    // Animate edges by layer\n    function animateEdges(edgeEls, color, delay) {\n      setTimeout(() => {\n        edgeEls.forEach(e => {\n          const len = e.getTotalLength ? e.getTotalLength() : 200;\n          e.style.transition = 'none';\n          e.style.strokeDasharray = len;\n          e.style.strokeDashoffset = len;\n          e.style.stroke = color;\n          requestAnimationFrame(() => {\n            e.style.transition = 'stroke-dashoffset 0.35s ease';\n            e.style.strokeDashoffset = '0';\n          });\n        });\n      }, delay);\n    }\n    \n    // Animate layers\n    for (let i = 0; i <= 3; i++) {\n      const edges = document.querySelectorAll(`.layer${i}`);\n      animateEdges(edges, color, i * 380);\n    }\n    \n    // Pulse nodes as signal arrives\n    const nodesToPulse = ['h1','h2','h3','y','h1p','h2p','yp'];\n    const delays = [350, 350, 350, 730, 1110, 1110, 1490];\n    \n    nodesToPulse.forEach((nid, idx) => {\n      setTimeout(() => {\n        const n = document.getElementById(nid);\n        if (n) {\n          n.style.transformBox = 'fill-box';\n          n.style.transformOrigin = 'center';\n          n.style.transition = 'transform 0.15s ease';\n          n.style.transform = 'scale(1.18)';\n          setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n        }\n      }, delays[idx]);\n    });\n    \n    // Reset colors after animation\n    setTimeout(() => {\n      document.querySelectorAll('.edge').forEach(edge => {\n        edge.style.transition = 'stroke 0.3s ease';\n        edge.style.stroke = '#000';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n      });\n    }, 2000);\n  });\n});\n\n// Dismiss handlers\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Edge hover\ndocument.querySelectorAll('.edge').forEach(edge => {\n  edge.style.cursor = 'pointer';\n  edge.addEventListener('mouseenter', e => {\n    edge.setAttribute('stroke', '#e07b30');\n    edge.setAttribute('stroke-width', '2');\n  });\n  edge.addEventListener('mouseleave', e => {\n    edge.setAttribute('stroke', '#000');\n    edge.setAttribute('stroke-width', '1');\n  });\n});\n\n} catch(err) {\n  console.error('Runtime error:', err);\n}\n</script>\n</body>\n</html>",
