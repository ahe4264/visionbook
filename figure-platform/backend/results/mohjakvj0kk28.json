  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n    position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 143 60\">\n<defs>\n    <marker id=\"arr\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n        <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#000\"/>\n    </marker>\n</defs>\n\n<!-- Nodes -->\n<circle id=\"n1\" cx=\"20\" cy=\"30\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n2\" cx=\"50\" cy=\"15\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n3\" cx=\"50\" cy=\"45\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n4\" cx=\"80\" cy=\"15\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n5\" cx=\"80\" cy=\"45\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n6\" cx=\"93\" cy=\"30\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n<circle id=\"n7\" cx=\"123\" cy=\"30\" r=\"10\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" style=\"cursor:pointer\"/>\n\n<!-- Edges -->\n<line id=\"e1\" x1=\"30\" y1=\"30\" x2=\"40\" y2=\"20\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e2\" x1=\"30\" y1=\"30\" x2=\"40\" y2=\"40\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e3\" x1=\"60\" y1=\"15\" x2=\"70\" y2=\"15\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e4\" x1=\"60\" y1=\"45\" x2=\"70\" y2=\"45\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e5\" x1=\"90\" y1=\"20\" x2=\"88\" y2=\"25\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e6\" x1=\"90\" y1=\"40\" x2=\"88\" y2=\"35\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n<line id=\"e7\" x1=\"103\" y1=\"30\" x2=\"113\" y2=\"30\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\"/>\n\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('circle');\nconst edges = document.querySelectorAll('line');\n\n// Graph connectivity\nconst graph = {\n    'n1': { out:['n2','n3'], in:[], label:'Node 1' },\n    'n2': { out:['n4'], in:['n1'], label:'Node 2' },\n    'n3': { out:['n5'], in:['n1'], label:'Node 3' },\n    'n4': { out:['n6'], in:['n2'], label:'Node 4' },\n    'n5': { out:['n6'], in:['n3'], label:'Node 5' },\n    'n6': { out:['n7'], in:['n4','n5'], label:'Node 6' },\n    'n7': { out:[], in:['n6'], label:'Node 7' }\n};\n\n// Edge mapping\nconst edgeMap = {\n    'n1-n2': 'e1',\n    'n1-n3': 'e2',\n    'n2-n4': 'e3',\n    'n3-n5': 'e4',\n    'n4-n6': 'e5',\n    'n5-n6': 'e6',\n    'n6-n7': 'e7'\n};\n\n// Hover effect for nodes\nnodes.forEach(node => {\n    node.addEventListener('mouseenter', e => {\n        node.style.strokeWidth = '2.5';\n        node.style.fillOpacity = '0.95';\n        \n        const nodeId = node.id;\n        const nodeData = graph[nodeId];\n        \n        // Highlight outgoing edges\n        nodeData.out.forEach(targetId => {\n            const edgeKey = `${nodeId}-${targetId}`;\n            const edge = document.getElementById(edgeMap[edgeKey]);\n            if (edge) {\n                edge.style.stroke = '#e07b30';\n                edge.style.strokeWidth = '2';\n            }\n        });\n        \n        tooltip.textContent = nodeData.label;\n        tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n        node.style.strokeWidth = '1';\n        node.style.fillOpacity = '1';\n        \n        edges.forEach(edge => {\n            edge.style.stroke = '#000';\n            edge.style.strokeWidth = '1';\n        });\n        \n        tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n        e.stopPropagation();\n        const nodeData = graph[node.id];\n        showPopup(nodeData.label, `Connected to ${nodeData.out.length} downstream nodes and receives from ${nodeData.in.length} upstream nodes.`);\n        animateSignalFlow(node.id, e.shiftKey);\n    });\n});\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Popup functions\nfunction showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Dismiss popup\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Signal flow animation\nfunction animateSignalFlow(startNodeId, backward = false) {\n    // Reset all edges\n    edges.forEach(e => {\n        e.style.transition = 'none';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n    });\n    \n    const color = backward ? '#e05050' : '#4a7ef5';\n    const layers = getLayersFromNode(startNodeId, backward);\n    \n    layers.forEach((layer, i) => {\n        animateEdges(layer.edges, color, i * 650);\n        \n        layer.nodes.forEach(nodeId => {\n            setTimeout(() => {\n                const node = document.getElementById(nodeId);\n                node.style.transformBox = 'fill-box';\n                node.style.transformOrigin = 'center';\n                node.style.transition = 'transform 0.15s ease';\n                node.style.transform = 'scale(1.18)';\n                setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n            }, i * 650 + 350);\n        });\n    });\n    \n    // Reset colors after animation\n    setTimeout(() => {\n        edges.forEach(e => {\n            e.style.transition = 'stroke 0.3s ease';\n            e.style.stroke = '#000';\n            e.style.strokeDasharray = '';\n            e.style.strokeDashoffset = '';\n        });\n    }, layers.length * 650 + 1200);\n}\n\nfunction getLayersFromNode(startId, backward) {\n    const layers = [];\n    let currentLayer = [startId];\n    const visited = new Set([startId]);\n    \n    while (currentLayer.length > 0) {\n        const layerEdges = [];\n        const nextLayer = [];\n        \n        currentLayer.forEach(nodeId => {\n            const connections = backward ? graph[nodeId].in : graph[nodeId].out;\n            connections.forEach(targetId => {\n                if (!visited.has(targetId)) {\n                    visited.add(targetId);\n                    nextLayer.push(targetId);\n                    const edgeKey = backward ? `${targetId}-${nodeId}` : `${nodeId}-${targetId}`;\n                    const edge = document.getElementById(edgeMap[edgeKey]);\n                    if (edge) layerEdges.push(edge);\n                }\n            });\n        });\n        \n        if (layerEdges.length > 0) {\n            layers.push({ edges: layerEdges, nodes: nextLayer });\n        }\n        currentLayer = nextLayer;\n    }\n    \n    return layers;\n}\n\nfunction animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n        edgeEls.forEach(e => {\n            const len = e.getTotalLength ? e.getTotalLength() : 50;\n            e.style.transition = 'none';\n            e.style.strokeDasharray = len;\n            e.style.strokeDashoffset = len;\n            e.style.stroke = color;\n            requestAnimationFrame(() => {\n                e.style.transition = 'stroke-dashoffset 0.6s ease';\n                e.style.strokeDashoffset = '0';\n            });\n        });\n    }, delay);\n}\n\n} catch (e) {\n    console.error('Runtime error:', e);\n}\n</script>\n</body>\n</html>",
