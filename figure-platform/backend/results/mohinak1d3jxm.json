  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 148 56\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges -->\n  <line x1=\"24\" y1=\"12\" x2=\"56\" y2=\"12\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n1\" data-to=\"n2\"/>\n  <line x1=\"56\" y1=\"12\" x2=\"74\" y2=\"28\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n2\" data-to=\"n3\"/>\n  <line x1=\"56\" y1=\"12\" x2=\"92\" y2=\"12\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n2\" data-to=\"n4\"/>\n  <line x1=\"74\" y1=\"28\" x2=\"92\" y2=\"44\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n3\" data-to=\"n5\"/>\n  <line x1=\"92\" y1=\"12\" x2=\"124\" y2=\"12\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n4\" data-to=\"n6\"/>\n  <line x1=\"92\" y1=\"44\" x2=\"56\" y2=\"44\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n5\" data-to=\"n7\"/>\n  <line x1=\"56\" y1=\"44\" x2=\"24\" y2=\"44\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n7\" data-to=\"n8\"/>\n  <line x1=\"74\" y1=\"28\" x2=\"56\" y2=\"44\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"n3\" data-to=\"n7\"/>\n  \n  <!-- Nodes -->\n  <circle cx=\"24\" cy=\"12\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n1\" data-label=\"Node 1\"/>\n  <circle cx=\"56\" cy=\"12\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n2\" data-label=\"Node 2\"/>\n  <circle cx=\"74\" cy=\"28\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n3\" data-label=\"Node 3\"/>\n  <circle cx=\"92\" cy=\"12\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n4\" data-label=\"Node 4\"/>\n  <circle cx=\"124\" cy=\"12\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n6\" data-label=\"Node 6\"/>\n  <circle cx=\"92\" cy=\"44\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n5\" data-label=\"Node 5\"/>\n  <circle cx=\"56\" cy=\"44\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n7\" data-label=\"Node 7\"/>\n  <circle cx=\"24\" cy=\"44\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-id=\"n8\" data-label=\"Node 8\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const nodes = svg.querySelectorAll('circle');\n  const edges = svg.querySelectorAll('line');\n  \n  // Graph connectivity\n  const graph = {\n    'n1': { out:['n2'], in:[], label:'Node 1' },\n    'n2': { out:['n3','n4'], in:['n1'], label:'Node 2' },\n    'n3': { out:['n5','n7'], in:['n2'], label:'Node 3' },\n    'n4': { out:['n6'], in:['n2'], label:'Node 4' },\n    'n5': { out:['n7'], in:['n3'], label:'Node 5' },\n    'n6': { out:[], in:['n4'], label:'Node 6' },\n    'n7': { out:['n8'], in:['n3','n5'], label:'Node 7' },\n    'n8': { out:[], in:['n7'], label:'Node 8' }\n  };\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Reset highlights\n  function resetHighlights() {\n    nodes.forEach(n => {\n      n.style.strokeWidth = '1';\n      n.style.fillOpacity = '1';\n    });\n    edges.forEach(e => {\n      e.style.stroke = '#000';\n      e.style.strokeWidth = '1';\n    });\n  }\n  \n  // Node hover\n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', e => {\n      resetHighlights();\n      node.style.strokeWidth = '2.5';\n      node.style.fillOpacity = '0.9';\n      \n      const nodeId = node.dataset.id;\n      const nodeData = graph[nodeId];\n      \n      // Highlight only outgoing edges\n      edges.forEach(edge => {\n        if (edge.dataset.from === nodeId) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tooltip.textContent = nodeData.label;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', () => {\n      resetHighlights();\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const nodeData = graph[node.dataset.id];\n      showPopup(nodeData.label, `Outgoing connections: ${nodeData.out.length > 0 ? nodeData.out.map(id => graph[id].label).join(', ') : 'None'}\\nIncoming connections: ${nodeData.in.length > 0 ? nodeData.in.map(id => graph[id].label).join(', ') : 'None'}`);\n      \n      // Animate signal flow\n      animateSignalFlow(e.shiftKey);\n    });\n  });\n  \n  // Edge hover\n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', () => {\n      edge.style.stroke = '#e07b30';\n      edge.style.strokeWidth = '2';\n      tooltip.textContent = `${graph[edge.dataset.from].label} → ${graph[edge.dataset.to].label}`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', () => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n  });\n  \n  // Animate edges function\n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 50;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  // Pulse node\n  function pulseNode(nodeEl, delay) {\n    setTimeout(() => {\n      nodeEl.style.transformBox = 'fill-box';\n      nodeEl.style.transformOrigin = 'center';\n      nodeEl.style.transition = 'transform 0.15s ease';\n      nodeEl.style.transform = 'scale(1.18)';\n      setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n    }, delay);\n  }\n  \n  // Signal flow animation\n  function animateSignalFlow(backward) {\n    const color = backward ? '#e05050' : '#4a7ef5';\n    \n    // Group edges by layer\n    const layer0 = []; // from n1\n    const layer1 = []; // from n2\n    const layer2 = []; // from n3, n4\n    const layer3 = []; // from n5, n7\n    \n    edges.forEach(e => {\n      if (e.dataset.from === 'n1') layer0.push(e);\n      else if (e.dataset.from === 'n2') layer1.push(e);\n      else if (e.dataset.from === 'n3' || e.dataset.from === 'n4') layer2.push(e);\n      else if (e.dataset.from === 'n5' || e.dataset.from === 'n7') layer3.push(e);\n    });\n    \n    // Animate layers\n    animateEdges(layer0, color, 0);\n    animateEdges(layer1, color, 650);\n    animateEdges(layer2, color, 1300);\n    animateEdges(layer3, color, 1950);\n    \n    // Pulse destination nodes\n    nodes.forEach(n => {\n      if (n.dataset.id === 'n2') pulseNode(n, 350);\n      else if (n.dataset.id === 'n3' || n.dataset.id === 'n4') pulseNode(n, 1000);\n      else if (n.dataset.id === 'n5' || n.dataset.id === 'n6' || n.dataset.id === 'n7') pulseNode(n, 1650);\n      else if (n.dataset.id === 'n8') pulseNode(n, 2300);\n    });\n    \n    // Reset after animation\n    setTimeout(() => {\n      edges.forEach(e => {\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n      });\n    }, 3200);\n  }\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Wire up dismiss\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n} catch (err) {\n  console.error('Interactive figure error:', err);\n}\n</script>\n</body>\n</html>",
