  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 487 126\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  <g id=\"network\">\n    <!-- Edges from x to hidden layer -->\n    <line class=\"edge\" x1=\"45\" y1=\"63\" x2=\"120\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h1\"/>\n    <line class=\"edge\" x1=\"45\" y1=\"63\" x2=\"120\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h2\"/>\n    <line class=\"edge\" x1=\"45\" y1=\"63\" x2=\"120\" y2=\"96\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h3\"/>\n    \n    <!-- Edges from hidden layer to y -->\n    <line class=\"edge\" x1=\"145\" y1=\"30\" x2=\"220\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\"/>\n    <line class=\"edge\" x1=\"145\" y1=\"63\" x2=\"220\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\"/>\n    <line class=\"edge\" x1=\"145\" y1=\"96\" x2=\"220\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\"/>\n    \n    <!-- Edges from y to hidden layer prime -->\n    <line class=\"edge\" x1=\"245\" y1=\"63\" x2=\"320\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h1p\"/>\n    <line class=\"edge\" x1=\"245\" y1=\"63\" x2=\"320\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h2p\"/>\n    <line class=\"edge\" x1=\"245\" y1=\"63\" x2=\"320\" y2=\"96\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"y\" data-to=\"h3p\"/>\n    \n    <!-- Edges from hidden layer prime to y' -->\n    <line class=\"edge\" x1=\"345\" y1=\"30\" x2=\"420\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h1p\" data-to=\"yp\"/>\n    <line class=\"edge\" x1=\"345\" y1=\"63\" x2=\"420\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h2p\" data-to=\"yp\"/>\n    <line class=\"edge\" x1=\"345\" y1=\"96\" x2=\"420\" y2=\"63\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"h3p\" data-to=\"yp\"/>\n    \n    <!-- Nodes -->\n    <circle class=\"node\" cx=\"45\" cy=\"63\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"x\"/>\n    <circle class=\"node\" cx=\"133\" cy=\"30\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h1\"/>\n    <circle class=\"node\" cx=\"133\" cy=\"63\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h2\"/>\n    <circle class=\"node\" cx=\"133\" cy=\"96\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h3\"/>\n    <circle class=\"node\" cx=\"233\" cy=\"63\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"y\"/>\n    <circle class=\"node\" cx=\"333\" cy=\"30\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h1p\"/>\n    <circle class=\"node\" cx=\"333\" cy=\"63\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h2p\"/>\n    <circle class=\"node\" cx=\"333\" cy=\"96\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h3p\"/>\n    <circle class=\"node\" cx=\"433\" cy=\"63\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"yp\"/>\n    \n    <!-- Teal squiggles for hidden nodes -->\n    <polyline points=\"127,30 130,26 133,30 136,26 139,30\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    <polyline points=\"127,63 130,59 133,63 136,59 139,63\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    <polyline points=\"127,96 130,92 133,96 136,92 139,96\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    <polyline points=\"327,30 330,26 333,30 336,26 339,30\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    <polyline points=\"327,63 330,59 333,63 336,59 339,63\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    <polyline points=\"327,96 330,92 333,96 336,92 339,96\" fill=\"none\" stroke=\"#20b2aa\" stroke-width=\"2\" pointer-events=\"none\"/>\n    \n    <!-- Labels -->\n    <text x=\"45\" y=\"68\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">x</text>\n    <text x=\"133\" y=\"35\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h₁</text>\n    <text x=\"133\" y=\"68\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h₂</text>\n    <text x=\"133\" y=\"101\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h₃</text>\n    <text x=\"233\" y=\"68\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">y</text>\n    <text x=\"333\" y=\"35\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h'₁</text>\n    <text x=\"333\" y=\"68\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h'₂</text>\n    <text x=\"333\" y=\"101\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">h'₃</text>\n    <text x=\"433\" y=\"68\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" pointer-events=\"none\">y'</text>\n    \n    <!-- Label a) -->\n    <text x=\"14\" y=\"20\" font-size=\"12\" font-family=\"sans-serif\">a)</text>\n  </g>\n</svg>\n<div id=\"tooltip\"></div>\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const nodes = document.querySelectorAll('.node');\n  const edges = document.querySelectorAll('.edge');\n  \n  const graph = {\n    'x':   { out:['h1','h2','h3'], in:[],                    label:'x',   role:'Input' },\n    'h1':  { out:['y'],             in:['x'],                 label:'h₁',  role:'Hidden unit 1' },\n    'h2':  { out:['y'],             in:['x'],                 label:'h₂',  role:'Hidden unit 2' },\n    'h3':  { out:['y'],             in:['x'],                 label:'h₃',  role:'Hidden unit 3' },\n    'y':   { out:['h1p','h2p','h3p'], in:['h1','h2','h3'],    label:'y',   role:'Bottleneck' },\n    'h1p': { out:['yp'],            in:['y'],                 label:'h\\'₁', role:'Hidden unit 1\\'' },\n    'h2p': { out:['yp'],            in:['y'],                 label:'h\\'₂', role:'Hidden unit 2\\'' },\n    'h3p': { out:['yp'],            in:['y'],                 label:'h\\'₃', role:'Hidden unit 3\\'' },\n    'yp':  { out:[],                in:['h1p','h2p','h3p'],   label:'y\\'', role:'Output' }\n  };\n  \n  // Show/hide popup\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Tooltip tracking\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Node interactions\n  nodes.forEach(node => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    \n    node.addEventListener('mouseenter', e => {\n      node.style.strokeWidth = '3';\n      node.style.fillOpacity = '0.9';\n      \n      // Highlight outgoing edges\n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      node.style.strokeWidth = '1.5';\n      node.style.fillOpacity = '1';\n      \n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      \n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const body = `Node ${info.label} serves as ${info.role.toLowerCase()} in the network. ` +\n                   (info.out.length > 0 ? `It connects to: ${info.out.map(n => graph[n].label).join(', ')}.` : 'It is the final output.') +\n                   (info.in.length > 0 ? ` It receives input from: ${info.in.map(n => graph[n].label).join(', ')}.` : '');\n      showPopup(`${info.label} — ${info.role}`, body);\n      \n      // Animate signal flow\n      const isBackward = e.shiftKey;\n      const color = isBackward ? '#e05050' : '#4a7ef5';\n      \n      // Reset all edges\n      edges.forEach(e => {\n        e.style.transition = 'none';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n      });\n      \n      if (isBackward) {\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'h1p' || e.getAttribute('data-from') === 'h2p' || e.getAttribute('data-from') === 'h3p'), color, 0);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'y'), color, 650);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'h1' || e.getAttribute('data-from') === 'h2' || e.getAttribute('data-from') === 'h3'), color, 1300);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'x'), color, 1950);\n      } else {\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'x'), color, 0);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'h1' || e.getAttribute('data-from') === 'h2' || e.getAttribute('data-from') === 'h3'), color, 650);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'y'), color, 1300);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'h1p' || e.getAttribute('data-from') === 'h2p' || e.getAttribute('data-from') === 'h3p'), color, 1950);\n      }\n      \n      // Pulse destination nodes\n      const pulseTiming = isBackward ? \n        { yp: 350, h1p: 1000, h2p: 1000, h3p: 1000, y: 1650, h1: 2300, h2: 2300, h3: 2300, x: 2950 } :\n        { h1: 350, h2: 350, h3: 350, y: 1000, h1p: 1650, h2p: 1650, h3p: 1650, yp: 2300 };\n      \n      Object.entries(pulseTiming).forEach(([nodeId, delay]) => {\n        setTimeout(() => {\n          const n = document.querySelector(`[data-id=\"${nodeId}\"]`);\n          n.style.transformBox = 'fill-box';\n          n.style.transformOrigin = 'center';\n          n.style.transition = 'transform 0.15s ease';\n          n.style.transform = 'scale(1.18)';\n          setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n        }, delay);\n      });\n      \n      setTimeout(() => {\n        edges.forEach(e => {\n          e.style.stroke = '#000';\n          e.style.strokeWidth = '1';\n          e.style.strokeDasharray = '';\n          e.style.strokeDashoffset = '';\n        });\n      }, 3200);\n    });\n  });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  // Dismiss handlers\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n} catch (err) {\n  console.error('Script error:', err);\n}\n</script>\n</body>\n</html>",
