  "filename": "figure_76",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#container { width:100%; height:100%; display:grid; grid-template-columns:1fr 1fr 1fr; padding:8px; box-sizing:border-box; }\n.panel { position:relative; overflow:hidden; }\n.label { position:absolute; top:5px; left:5px; font:12px sans-serif; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <div class=\"panel\" id=\"panelA\">\n    <span class=\"label\">a)</span>\n  </div>\n  <div class=\"panel\" id=\"panelB\">\n    <span class=\"label\">b)</span>\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 163 186\">\n      <g transform=\"translate(30,20)\">\n        <!-- Axes -->\n        <line x1=\"0\" y1=\"130\" x2=\"120\" y2=\"130\" stroke=\"#000\" stroke-width=\"1\"/>\n        <line x1=\"0\" y1=\"130\" x2=\"0\" y2=\"10\" stroke=\"#000\" stroke-width=\"1\"/>\n        \n        <!-- Axis labels -->\n        <text x=\"60\" y=\"148\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">Input, y</text>\n        <text x=\"-10\" y=\"70\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\" transform=\"rotate(-90 -10 70)\">Output, y'</text>\n        \n        <!-- V-shaped line -->\n        <path class=\"line-gray\" d=\"M10,30 L40,110 L60,70 L80,90 L100,40\" fill=\"none\" stroke=\"#808080\" stroke-width=\"2\"/>\n        \n        <!-- Orange overlay segments -->\n        <path class=\"line-orange\" d=\"M60,70 L70,85\" fill=\"none\" stroke=\"#e2725b\" stroke-width=\"2\"/>\n        <path class=\"line-orange\" d=\"M85,75 L95,50\" fill=\"none\" stroke=\"#e2725b\" stroke-width=\"2\"/>\n      </g>\n    </svg>\n  </div>\n  <div class=\"panel\" id=\"panelC\">\n    <span class=\"label\">c)</span>\n  </div>\n</div>\n<div id=\"tooltip\"></div>\n\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n  // Panel A - 3D visualization\n  // x-axis→right, y-axis→up, z-axis→forward\n  // elevation ~30°, azimuth ~60°\n  // camera.position.set(8,5,6)\n  \n  const panelA = document.getElementById('panelA');\n  const canvasA = document.createElement('canvas');\n  panelA.appendChild(canvasA);\n  \n  const sceneA = new THREE.Scene();\n  const rendererA = new THREE.WebGLRenderer({ canvas: canvasA, antialias: true });\n  rendererA.setClearColor(0xffffff, 1);\n  rendererA.setPixelRatio(window.devicePixelRatio);\n  \n  const aspectA = panelA.offsetWidth / panelA.offsetHeight;\n  const dA = 6;\n  const cameraA = new THREE.OrthographicCamera(-dA*aspectA, dA*aspectA, dA, -dA, 0.1, 1000);\n  cameraA.position.set(8, 5, 6);\n  cameraA.lookAt(0, 0, 0);\n  \n  sceneA.add(new THREE.AmbientLight(0xffffff, 1.0));\n  \n  // Create wireframe cube\n  const cubeGeom = new THREE.BoxGeometry(4, 4, 4);\n  const edges = new THREE.EdgesGeometry(cubeGeom);\n  const cubeLine = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({color: 0x333333}));\n  sceneA.add(cubeLine);\n  \n  // Create 3D diagonal path\n  const pathMat = new THREE.LineBasicMaterial({ color: 0x85cac2, linewidth: 3 });\n  const pathPoints = [];\n  pathPoints.push(new THREE.Vector3(-2, -2, -2));\n  pathPoints.push(new THREE.Vector3(-1, 0, -1));\n  pathPoints.push(new THREE.Vector3(0, 1, 0));\n  pathPoints.push(new THREE.Vector3(1, 0, 1));\n  pathPoints.push(new THREE.Vector3(2, 2, 2));\n  const pathGeom = new THREE.BufferGeometry().setFromPoints(pathPoints);\n  const pathLine = new THREE.Line(pathGeom, pathMat);\n  sceneA.add(pathLine);\n  \n  // Axes labels\n  const axisHelper = new THREE.Group();\n  sceneA.add(axisHelper);\n  \n  // Panel C - 3D visualization\n  // x-axis→right, y-axis→up, z-axis→forward\n  // elevation ~30°, azimuth ~120°\n  // camera.position.set(-8,5,6)\n  \n  const panelC = document.getElementById('panelC');\n  const canvasC = document.createElement('canvas');\n  panelC.appendChild(canvasC);\n  \n  const sceneC = new THREE.Scene();\n  const rendererC = new THREE.WebGLRenderer({ canvas: canvasC, antialias: true });\n  rendererC.setClearColor(0xffffff, 1);\n  rendererC.setPixelRatio(window.devicePixelRatio);\n  \n  const aspectC = panelC.offsetWidth / panelC.offsetHeight;\n  const dC = 6;\n  const cameraC = new THREE.OrthographicCamera(-dC*aspectC, dC*aspectC, dC, -dC, 0.1, 1000);\n  cameraC.position.set(-8, 5, 6);\n  cameraC.lookAt(0, 0, 0);\n  \n  sceneC.add(new THREE.AmbientLight(0xffffff, 1.0));\n  \n  // Create wireframe cube for panel C\n  const cubeLine2 = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({color: 0x333333}));\n  sceneC.add(cubeLine2);\n  \n  // Create oscillating 3D path\n  const oscMat = new THREE.LineBasicMaterial({ color: 0x808080, linewidth: 2 });\n  const oscPoints = [];\n  for(let i = 0; i <= 20; i++) {\n    const t = (i/20) * 4 - 2;\n    const x = t;\n    const y = Math.sin(t * 3) * 1.5;\n    const z = t;\n    oscPoints.push(new THREE.Vector3(x, y, z));\n  }\n  const oscGeom = new THREE.BufferGeometry().setFromPoints(oscPoints);\n  const oscLine = new THREE.Line(oscGeom, oscMat);\n  sceneC.add(oscLine);\n  \n  // Orange overlay segments\n  const orangeMat = new THREE.LineBasicMaterial({ color: 0xe2725b, linewidth: 2 });\n  const seg1Points = [];\n  for(let i = 8; i <= 12; i++) {\n    const t = (i/20) * 4 - 2;\n    const x = t;\n    const y = Math.sin(t * 3) * 1.5;\n    const z = t;\n    seg1Points.push(new THREE.Vector3(x, y, z));\n  }\n  const seg1Geom = new THREE.BufferGeometry().setFromPoints(seg1Points);\n  const seg1Line = new THREE.Line(seg1Geom, orangeMat);\n  sceneC.add(seg1Line);\n  \n  const seg2Points = [];\n  for(let i = 15; i <= 18; i++) {\n    const t = (i/20) * 4 - 2;\n    const x = t;\n    const y = Math.sin(t * 3) * 1.5;\n    const z = t;\n    seg2Points.push(new THREE.Vector3(x, y, z));\n  }\n  const seg2Geom = new THREE.BufferGeometry().setFromPoints(seg2Points);\n  const seg2Line = new THREE.Line(seg2Geom, orangeMat);\n  sceneC.add(seg2Line);\n  \n  // Resize handler\n  function onResize() {\n    const wA = panelA.offsetWidth;\n    const hA = panelA.offsetHeight;\n    rendererA.setSize(wA, hA);\n    const aA = wA / hA;\n    cameraA.left = -dA*aA; cameraA.right = dA*aA;\n    cameraA.updateProjectionMatrix();\n    \n    const wC = panelC.offsetWidth;\n    const hC = panelC.offsetHeight;\n    rendererC.setSize(wC, hC);\n    const aC = wC / hC;\n    cameraC.left = -dC*aC; cameraC.right = dC*aC;\n    cameraC.updateProjectionMatrix();\n  }\n  \n  window.addEventListener('resize', onResize);\n  onResize();\n  \n  // Animation loop\n  function animate() {\n    requestAnimationFrame(animate);\n    rendererA.render(sceneA, cameraA);\n    rendererC.render(sceneC, cameraC);\n  }\n  animate();\n  \n  // Tooltip handling\n  const tooltip = document.getElementById('tooltip');\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // SVG interactivity for panel B\n  const svg = panelB.querySelector('svg');\n  const lines = svg.querySelectorAll('path');\n  \n  lines.forEach(line => {\n    line.addEventListener('mouseenter', e => {\n      line.style.strokeWidth = '3';\n      tooltip.textContent = line.classList.contains('line-orange') ? 'Overlay segment' : '2D projection';\n      tooltip.style.display = 'block';\n    });\n    line.addEventListener('mouseleave', e => {\n      line.style.strokeWidth = '2';\n      tooltip.style.display = 'none';\n    });\n    line.addEventListener('click', e => {\n      e.stopPropagation();\n      const title = line.classList.contains('line-orange') ? 'Overlay Segment' : '2D Projection';\n      const body = line.classList.contains('line-orange') ? \n        'This orange segment represents a specific portion of the transformed data.' : \n        'This gray line shows the 2D projection of the 3D path from panel a).';\n      showPopup(title, body);\n    });\n  });\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  // 3D canvas interaction\n  canvasA.addEventListener('click', e => {\n    showPopup('3D Path Visualization', 'This shows a diagonal path through 3D space, representing the original data trajectory.');\n  });\n  \n  canvasC.addEventListener('click', e => {\n    showPopup('Oscillating 3D Path', 'The transformed data creates an oscillating pattern when mapped back to 3D space.');\n  });\n  \n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
