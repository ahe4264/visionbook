{
  "id": "mob4u2tnql5no",
  "filename": "figure_40",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Vector Spaces and Coordinate Axes</title>\n    <style>\n        html, body { \n            margin: 0; \n            padding: 0; \n            width: 100%; \n            height: 100%; \n            overflow: hidden; \n            background: #fff; \n            font-family: sans-serif;\n        }\n        \n        .container {\n            width: 100%;\n            height: 100%;\n            display: grid;\n            grid-template-columns: 1fr 1fr 1fr;\n            gap: 8px;\n            padding: 8px;\n            box-sizing: border-box;\n        }\n        \n        .panel {\n            position: relative;\n            border: none;\n            background: #fff;\n        }\n        \n        .panel-label {\n            position: absolute;\n            top: 5px;\n            left: 5px;\n            font-size: 12px;\n            font-weight: bold;\n            color: #000;\n            z-index: 10;\n        }\n        \n        .panel svg {\n            width: 100%;\n            height: 100%;\n        }\n        \n        .panel canvas {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n        \n        .axis-line {\n            transition: all 0.15s ease;\n        }\n        \n        .axis-line:hover {\n            stroke-width: 3;\n        }\n        \n        .tooltip {\n            position: fixed;\n            background: rgba(22,22,22,0.88);\n            backdrop-filter: blur(6px);\n            color: #f0f0f0;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 9px;\n            border-radius: 5px;\n            border: 1px solid rgba(255,255,255,0.1);\n            pointer-events: none;\n            z-index: 100;\n            max-width: 240px;\n            opacity: 0;\n            transition: opacity 0.15s ease;\n        }\n        \n        .popup {\n            position: fixed;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: rgba(246,246,246,0.97);\n            backdrop-filter: blur(8px);\n            border-top: 1px solid rgba(0,0,0,0.07);\n            padding: 10px 14px;\n            font: 12px/1.6 sans-serif;\n            color: #1a1a1a;\n            z-index: 101;\n            transform: translateY(100%);\n            transition: transform 0.3s ease;\n        }\n        \n        .popup.visible {\n            transform: translateY(0);\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <!-- Panel a) - 1D -->\n        <div class=\"panel\" id=\"panel-a\">\n            <div class=\"panel-label\">a)</div>\n            <svg viewBox=\"0 0 150 120\">\n                <defs>\n                    <marker id=\"arrow1d\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n                        <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#000\"/>\n                    </marker>\n                </defs>\n                <line x1=\"20\" y1=\"60\" x2=\"120\" y2=\"60\" stroke=\"#000\" stroke-width=\"2\" \n                      marker-end=\"url(#arrow1d)\" class=\"axis-line\" data-axis=\"x1\"/>\n                <circle cx=\"50\" cy=\"60\" r=\"2\" fill=\"#53C1A9\"/>\n                <text x=\"125\" y=\"65\" font-size=\"12\" fill=\"#000\">x₁</text>\n            </svg>\n        </div>\n        \n        <!-- Panel b) - 2D -->\n        <div class=\"panel\" id=\"panel-b\">\n            <div class=\"panel-label\">b)</div>\n            <svg viewBox=\"0 0 150 120\">\n                <defs>\n                    <marker id=\"arrow2d-h\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n                        <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#EA8B7F\"/>\n                    </marker>\n                    <marker id=\"arrow2d-v\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n                        <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#53C1A9\"/>\n                    </marker>\n                </defs>\n                <line x1=\"20\" y1=\"60\" x2=\"120\" y2=\"60\" stroke=\"#EA8B7F\" stroke-width=\"2\" \n                      marker-end=\"url(#arrow2d-h)\" class=\"axis-line\" data-axis=\"x1\"/>\n                <line x1=\"60\" y1=\"100\" x2=\"60\" y2=\"20\" stroke=\"#53C1A9\" stroke-width=\"2\" \n                      marker-end=\"url(#arrow2d-v)\" class=\"axis-line\" data-axis=\"x2\"/>\n                <text x=\"125\" y=\"65\" font-size=\"12\" fill=\"#000\">x₁</text>\n                <text x=\"65\" y=\"15\" font-size=\"12\" fill=\"#000\">x₂</text>\n            </svg>\n        </div>\n        \n        <!-- Panel c) - 3D -->\n        <div class=\"panel\" id=\"panel-c\">\n            <div class=\"panel-label\">c)</div>\n            <canvas id=\"canvas3d\"></canvas>\n        </div>\n    </div>\n    \n    <div class=\"tooltip\" id=\"tooltip\"></div>\n    <div class=\"popup\" id=\"popup\">\n        <div id=\"popup-content\"></div>\n        <div style=\"margin-top:8px; font-size:11px; color:#666;\">Press Escape or click outside to close</div>\n    </div>\n\n    <script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n    <script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n    \n    <script>\n        try {\n            // Tooltip functionality\n            const tooltip = document.getElementById('tooltip');\n            const popup = document.getElementById('popup');\n            const popupContent = document.getElementById('popup-content');\n            \n            function showTooltip(event, text) {\n                tooltip.textContent = text;\n                tooltip.style.left = (event.clientX + 10) + 'px';\n                tooltip.style.top = (event.clientY - 10) + 'px';\n                tooltip.style.opacity = '1';\n            }\n            \n            function hideTooltip() {\n                tooltip.style.opacity = '0';\n            }\n            \n            function showPopup(content) {\n                popupContent.innerHTML = content;\n                popup.classList.add('visible');\n            }\n            \n            function hidePopup() {\n                popup.classList.remove('visible');\n            }\n            \n            // 2D panel interactions\n            document.querySelectorAll('.axis-line').forEach(line => {\n                line.addEventListener('mouseenter', (e) => {\n                    const axis = e.target.dataset.axis;\n                    const dimText = axis === 'x1' ? '1D' : axis === 'x2' ? '2D' : '3D';\n                    showTooltip(e, `${axis} axis — ${dimText} coordinate space`);\n                });\n                \n                line.addEventListener('mouseleave', hideTooltip);\n                \n                line.addEventListener('click', (e) => {\n                    const axis = e.target.dataset.axis;\n                    let content = '';\n                    \n                    if (axis === 'x1') {\n                        content = `<strong>1D Vector Space</strong><br/>\n                        The x₁ axis represents a one-dimensional vector space (ℝ¹). Points on this line can be described by a single coordinate value. This is the simplest vector space, where vectors are just scalars with direction.`;\n                    } else if (axis === 'x2') {\n                        content = `<strong>2D Vector Space</strong><br/>\n                        The x₁-x₂ coordinate system represents a two-dimensional vector space (ℝ²). Any point in this plane requires two coordinates (x₁, x₂). This forms the foundation for 2D geometry and linear algebra operations like matrix multiplication.`;\n                    }\n                    \n                    showPopup(content);\n                });\n            });\n            \n            // 3D Panel Setup\n            const canvas3d = document.getElementById('canvas3d');\n            const scene = new THREE.Scene();\n            \n            // x-axis→right, y-axis→up, z-axis→out\n            // elevation ~30°, azimuth ~45°\n            // camera.position.set(8,6,8)\n            \n            const renderer = new THREE.WebGLRenderer({ canvas: canvas3d, antialias: true });\n            renderer.setClearColor(0xffffff, 1);\n            renderer.setPixelRatio(window.devicePixelRatio);\n            \n            function resize3D() {\n                const rect = canvas3d.getBoundingClientRect();\n                const width = rect.width;\n                const height = rect.height;\n                \n                const aspect = width / height;\n                const d = 4;\n                camera.left = -d * aspect;\n                camera.right = d * aspect;\n                camera.top = d;\n                camera.bottom = -d;\n                camera.updateProjectionMatrix();\n                \n                renderer.setSize(width, height, false);\n            }\n            \n            const aspect = canvas3d.offsetWidth / canvas3d.offsetHeight;\n            const d = 4;\n            const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n            camera.position.set(8, 6, 8);\n            camera.lookAt(0, 0, 0);\n            \n            scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n            \n            // Create coordinate axes with labels\n            const axisLength = 3;\n            \n            // x₁ axis (red/orange)\n            const x1Geometry = new THREE.BufferGeometry().setFromPoints([\n                new THREE.Vector3(0, 0, 0),\n                new THREE.Vector3(axisLength, 0, 0)\n            ]);\n            const x1Line = new THREE.Line(x1Geometry, new THREE.LineBasicMaterial({ color: 0x000000, linewidth: 2 }));\n            scene.add(x1Line);\n            \n            // x₂ axis (teal)\n            const x2Geometry = new THREE.BufferGeometry().setFromPoints([\n                new THREE.Vector3(0, 0, 0),\n                new THREE.Vector3(0, axisLength, 0)\n            ]);\n            const x2Line = new THREE.Line(x2Geometry, new THREE.LineBasicMaterial({ color: 0x000000, linewidth: 2 }));\n            scene.add(x2Line);\n            \n            // x₃ axis (vertical)\n            const x3Geometry = new THREE.BufferGeometry().setFromPoints([\n                new THREE.Vector3(0, 0, 0),\n                new THREE.Vector3(0, 0, axisLength)\n            ]);\n            const x3Line = new THREE.Line(x3Geometry, new THREE.LineBasicMaterial({ color: 0x000000, linewidth: 2 }));\n            scene.add(x3Line);\n            \n            // x₁-x₂ plane (orange/red)\n            const planeX1X2 = new THREE.PlaneGeometry(3, 3);\n            const materialX1X2 = new THREE.MeshBasicMaterial({ \n                color: 0xEA8B7F, \n                transparent: true, \n                opacity: 0.5,\n                side: THREE.DoubleSide \n            });\n            const meshX1X2 = new THREE.Mesh(planeX1X2, materialX1X2);\n            meshX1X2.position.set(1.5, 1.5, 0);\n            scene.add(meshX1X2);\n            \n            // x₂-x₃ plane (teal)\n            const planeX2X3 = new THREE.PlaneGeometry(3, 3);\n            const materialX2X3 = new THREE.MeshBasicMaterial({ \n                color: 0x53C1A9, \n                transparent: true, \n                opacity: 0.5,\n                side: THREE.DoubleSide \n            });\n            const meshX2X3 = new THREE.Mesh(planeX2X3, materialX2X3);\n            meshX2X3.rotation.y = Math.PI / 2;\n            meshX2X3.position.set(0, 1.5, 1.5);\n            scene.add(meshX2X3);\n            \n            // Diagonal line\n            const diagGeometry = new THREE.BufferGeometry().setFromPoints([\n                new THREE.Vector3(0, 0, 0),\n                new THREE.Vector3(2, 2, 2)\n            ]);\n            const diagLine = new THREE.Line(diagGeometry, new THREE.LineBasicMaterial({ \n                color: 0x000000, \n                linewidth: 2,\n                linecap: 'round'\n            }));\n            scene.add(diagLine);\n            \n            // Add OrbitControls for interaction\n            const controls = new THREE.OrbitControls(camera, canvas3d);\n            controls.enableDamping = true;\n            controls.dampingFactor = 0.05;\n            controls.enableZoom = true;\n            controls.enablePan = false;\n            \n            function animate() {\n                requestAnimationFrame(animate);\n                controls.update();\n                renderer.render(scene, camera);\n            }\n            \n            // Initial setup and start animation\n            resize3D();\n            animate();\n            \n            // 3D panel click handler\n            canvas3d.addEventListener('click', () => {\n                showPopup(`<strong>3D Vector Space</strong><br/>\n                The x₁-x₂-x₃ coordinate system represents a three-dimensional vector space (ℝ³). Any point requires three coordinates (x₁, x₂, x₃). The colored planes show the x₁-x₂ plane (orange) and x₂-x₃ plane (teal). The black diagonal line demonstrates a vector extending through 3D space. You can drag to rotate the view.`);\n            });\n            \n            // Resize handler\n            window.addEventListener('resize', resize3D);\n            \n            // Popup close handlers\n            document.addEventListener('keydown', (e) => {\n                if (e.key === 'Escape') {\n                    hidePopup();\n                }\n            });\n            \n            document.addEventListener('click', (e) => {\n                if (!popup.contains(e.target) && !e.target.closest('.axis-line') && e.target !== canvas3d) {\n                    hidePopup();\n                }\n            });\n            \n        } catch (error) {\n            console.error('Error initializing interactive figure:', error);\n            document.body.innerHTML = '<div style=\"padding:20px;color:#999;\">Error loading interactive content</div>';\n        }\n    </script>\n</body>\n</html>",
