  "filename": "figure_22",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        html, body { \n            margin: 0; \n            padding: 0; \n            width: 100%; \n            height: 100%; \n            overflow: hidden; \n            background: #fff; \n            font-family: sans-serif;\n        }\n        \n        .tooltip {\n            position: fixed;\n            background: rgba(0,0,0,0.55);\n            color: #fff;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 8px;\n            border-radius: 4px;\n            pointer-events: none;\n            z-index: 100;\n            max-width: 220px;\n            opacity: 0;\n            transition: opacity 0.2s;\n        }\n        \n        .popup {\n            position: fixed;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: rgba(245,245,245,0.95);\n            backdrop-filter: blur(6px);\n            border-top: 1px solid rgba(0,0,0,0.1);\n            padding: 8px 12px;\n            font: 12px/1.5 sans-serif;\n            color: #333;\n            z-index: 101;\n            transform: translateY(100%);\n            transition: transform 0.3s ease;\n        }\n        \n        .popup.show {\n            transform: translateY(0);\n        }\n        \n        .node {\n            cursor: pointer;\n            transition: stroke-width 0.2s, fill 0.2s;\n        }\n        \n        .node:hover {\n            stroke-width: 2;\n            fill: #f0f0f0;\n        }\n        \n        .edge {\n            cursor: pointer;\n            transition: stroke-width 0.2s;\n        }\n        \n        .edge:hover {\n            stroke-width: 2;\n        }\n    </style>\n</head>\n<body>\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 400 200\">\n        <defs>\n            <marker id=\"arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"3\" orient=\"auto\" markerUnits=\"strokeWidth\">\n                <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000000\"/>\n            </marker>\n        </defs>\n        \n        <!-- Edges from input to hidden layer -->\n        <line class=\"edge\" x1=\"60\" y1=\"50\" x2=\"160\" y2=\"50\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₁ to h₁\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"50\" x2=\"160\" y2=\"100\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₁ to h₂\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"50\" x2=\"160\" y2=\"150\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₁ to h₃\"/>\n        \n        <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"160\" y2=\"50\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₂ to h₁\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"160\" y2=\"100\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₂ to h₂\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"100\" x2=\"160\" y2=\"150\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₂ to h₃\"/>\n        \n        <line class=\"edge\" x1=\"60\" y1=\"150\" x2=\"160\" y2=\"50\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₃ to h₁\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"150\" x2=\"160\" y2=\"100\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₃ to h₂\"/>\n        <line class=\"edge\" x1=\"60\" y1=\"150\" x2=\"160\" y2=\"150\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from x₃ to h₃\"/>\n        \n        <!-- Edges from hidden to output layer -->\n        <line class=\"edge\" x1=\"180\" y1=\"50\" x2=\"280\" y2=\"75\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₁ to y₁\"/>\n        <line class=\"edge\" x1=\"180\" y1=\"50\" x2=\"280\" y2=\"125\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₁ to y₂\"/>\n        \n        <line class=\"edge\" x1=\"180\" y1=\"100\" x2=\"280\" y2=\"75\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₂ to y₁\"/>\n        <line class=\"edge\" x1=\"180\" y1=\"100\" x2=\"280\" y2=\"125\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₂ to y₂\"/>\n        \n        <line class=\"edge\" x1=\"180\" y1=\"150\" x2=\"280\" y2=\"75\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₃ to y₁\"/>\n        <line class=\"edge\" x1=\"180\" y1=\"150\" x2=\"280\" y2=\"125\" stroke=\"#000000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" data-info=\"Connection from h₃ to y₂\"/>\n        \n        <!-- Input layer nodes -->\n        <circle class=\"node\" cx=\"50\" cy=\"50\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Input node x₁: Receives input features or data\"/>\n        <circle class=\"node\" cx=\"50\" cy=\"100\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Input node x₂: Receives input features or data\"/>\n        <circle class=\"node\" cx=\"50\" cy=\"150\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Input node x₃: Receives input features or data\"/>\n        \n        <!-- Hidden layer nodes -->\n        <circle class=\"node\" cx=\"170\" cy=\"50\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Hidden node h₁: Processes weighted inputs through activation function\"/>\n        <circle class=\"node\" cx=\"170\" cy=\"100\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Hidden node h₂: Processes weighted inputs through activation function\"/>\n        <circle class=\"node\" cx=\"170\" cy=\"150\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Hidden node h₃: Processes weighted inputs through activation function\"/>\n        \n        <!-- Output layer nodes -->\n        <circle class=\"node\" cx=\"290\" cy=\"75\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Output node y₁: Produces final network output or prediction\"/>\n        <circle class=\"node\" cx=\"290\" cy=\"125\" r=\"10\" fill=\"#ffffff\" stroke=\"#000000\" stroke-width=\"1\" data-info=\"Output node y₂: Produces final network output or prediction\"/>\n        \n        <!-- Node labels -->\n        <text x=\"50\" y=\"56\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">x₁</text>\n        <text x=\"50\" y=\"106\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">x₂</text>\n        <text x=\"50\" y=\"156\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">x₃</text>\n        \n        <text x=\"170\" y=\"56\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">h₁</text>\n        <text x=\"170\" y=\"106\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">h₂</text>\n        <text x=\"170\" y=\"156\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">h₃</text>\n        \n        <text x=\"290\" y=\"81\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">y₁</text>\n        <text x=\"290\" y=\"131\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11px\" fill=\"#000000\" pointer-events=\"none\">y₂</text>\n    </svg>\n    \n    <div class=\"tooltip\" id=\"tooltip\"></div>\n    <div class=\"popup\" id=\"popup\">\n        <div id=\"popup-content\"></div>\n    </div>\n    \n    <script>\n        try {\n            const tooltip = document.getElementById('tooltip');\n            const popup = document.getElementById('popup');\n            const popupContent = document.getElementById('popup-content');\n            \n            let activeElement = null;\n            \n            // Tooltip functionality\n            function showTooltip(event, text) {\n                tooltip.textContent = text;\n                tooltip.style.left = (event.clientX + 10) + 'px';\n                tooltip.style.top = (event.clientY - 30) + 'px';\n                tooltip.style.opacity = '1';\n            }\n            \n            function hideTooltip() {\n                tooltip.style.opacity = '0';\n            }\n            \n            // Popup functionality\n            function showPopup(element) {\n                if (activeElement === element) {\n                    hidePopup();\n                    return;\n                }\n                \n                activeElement = element;\n                const info = element.getAttribute('data-info');\n                const isNode = element.classList.contains('node');\n                const isEdge = element.classList.contains('edge');\n                \n                let content = '';\n                if (isNode) {\n                    const label = element.parentElement.querySelector('text[x=\"' + element.getAttribute('cx') + '\"]')?.textContent || 'Node';\n                    content = `\n                        <h4 style=\"margin:0 0 8px 0; font-size:14px;\">${label}</h4>\n                        <p style=\"margin:0;\">${info}</p>\n                    `;\n                } else if (isEdge) {\n                    content = `\n                        <h4 style=\"margin:0 0 8px 0; font-size:14px;\">Neural Connection</h4>\n                        <p style=\"margin:0;\">${info}</p>\n                        <p style=\"margin:8px 0 0 0; font-size:11px; color:#666;\">Each connection has an associated weight that determines the strength of the signal transmission.</p>\n                    `;\n                }\n                \n                popupContent.innerHTML = content;\n                popup.classList.add('show');\n            }\n            \n            function hidePopup() {\n                popup.classList.remove('show');\n                activeElement = null;\n            }\n            \n            // Event listeners\n            document.querySelectorAll('.node, .edge').forEach(element => {\n                element.addEventListener('mouseenter', (e) => {\n                    showTooltip(e, element.getAttribute('data-info'));\n                });\n                \n                element.addEventListener('mouseleave', hideTooltip);\n                \n                element.addEventListener('mousemove', (e) => {\n                    if (tooltip.style.opacity === '1') {\n                        tooltip.style.left = (e.clientX + 10) + 'px';\n                        tooltip.style.top = (e.clientY - 30) + 'px';\n                    }\n                });\n                \n                element.addEventListener('click', (e) => {\n                    e.stopPropagation();\n                    showPopup(element);\n                });\n            });\n            \n            // Close popup when clicking outside\n            document.addEventListener('click', (e) => {\n                if (!popup.contains(e.target)) {\n                    hidePopup();\n                }\n            });\n            \n            // Close popup with Escape key\n            document.addEventListener('keydown', (e) => {\n                if (e.key === 'Escape') {\n                    hidePopup();\n                }\n            });\n            \n        } catch (error) {\n            console.error('Script error:', error);\n        }\n    </script>\n</body>\n</html>",
