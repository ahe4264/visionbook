  "filename": "figure_11",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { \n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n\n<div id=\"tooltip\"></div>\n\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n  // Camera analysis: x-axis→right, y-axis→up, z-axis→out\n  // elevation ~35°, azimuth ~45°\n  // camera.position.set(8,6,8)\n\n  const scene = new THREE.Scene();\n  \n  const renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setClearColor(0xffffff, 1);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  document.body.appendChild(renderer.domElement);\n\n  const aspect = window.innerWidth / window.innerHeight;\n  const d = 6;\n  const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n  camera.position.set(8, 6, 8);\n  camera.lookAt(0, 0, 0);\n\n  scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.05;\n\n  // Ground grid\n  const gridHelper = new THREE.GridHelper(10, 10, 0xcccccc, 0xeeeeee);\n  gridHelper.rotation.x = Math.PI / 2;\n  gridHelper.position.y = -3;\n  scene.add(gridHelper);\n\n  // Axes\n  const axesGroup = new THREE.Group();\n  \n  // X-axis (n to n+1)\n  const xAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-4, -3, 0),\n    new THREE.Vector3(4, -3, 0)\n  ]);\n  axesGroup.add(new THREE.Line(xAxis, new THREE.LineBasicMaterial({ color: 0x000000 })));\n  \n  // Y-axis (m to m+1)\n  const yAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, -3, -4),\n    new THREE.Vector3(0, -3, 4)\n  ]);\n  axesGroup.add(new THREE.Line(yAxis, new THREE.LineBasicMaterial({ color: 0x000000 })));\n  \n  // Z-axis\n  const zAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, -3, 0),\n    new THREE.Vector3(0, 3, 0)\n  ]);\n  axesGroup.add(new THREE.Line(zAxis, new THREE.LineBasicMaterial({ color: 0x000000 })));\n  \n  scene.add(axesGroup);\n\n  // Grid points data\n  const points = [\n    { pos: [-3, -3, -3], label: 'in[n,m]' },\n    { pos: [3, -3, -3], label: 'in[n+1,m]' },\n    { pos: [-3, -3, 3], label: 'in[n,m+1]' },\n    { pos: [3, -3, 3], label: 'in[n+1,m+1]' },\n    { pos: [-3, 1, -3], label: 'out(n,m)' },\n    { pos: [3, 0.5, -3], label: 'out(n+1,m)' },\n    { pos: [-3, 2, 3], label: 'out(n,m+1)' },\n    { pos: [3, 1.5, 3], label: 'out(n+1,m+1)' }\n  ];\n\n  // Create points\n  const pointsGroup = new THREE.Group();\n  const pointMeshes = [];\n  \n  points.forEach((pt, i) => {\n    const geometry = new THREE.SphereGeometry(0.1, 16, 16);\n    const material = new THREE.MeshBasicMaterial({ color: 0x000000 });\n    const sphere = new THREE.Mesh(geometry, material);\n    sphere.position.set(...pt.pos);\n    sphere.userData = { label: pt.label, index: i };\n    pointsGroup.add(sphere);\n    pointMeshes.push(sphere);\n    \n    // Vertical lines for corner points\n    if (i < 4) {\n      const vertLine = new THREE.BufferGeometry().setFromPoints([\n        new THREE.Vector3(...pt.pos),\n        new THREE.Vector3(pt.pos[0], points[i+4].pos[1], pt.pos[2])\n      ]);\n      pointsGroup.add(new THREE.Line(vertLine, new THREE.LineBasicMaterial({ color: 0x999999 })));\n    }\n  });\n\n  scene.add(pointsGroup);\n\n  // Bilinear interpolation plane\n  const planeGeometry = new THREE.BufferGeometry();\n  const vertices = new Float32Array([\n    -3, 1, -3,   // out(n,m)\n    3, 0.5, -3,  // out(n+1,m)\n    3, 1.5, 3,   // out(n+1,m+1)\n    -3, 2, 3     // out(n,m+1)\n  ]);\n  const indices = new Uint16Array([0, 1, 2, 0, 2, 3]);\n  planeGeometry.setAttribute('position', new THREE.BufferAttribute(vertices, 3));\n  planeGeometry.setIndex(new THREE.BufferAttribute(indices, 1));\n  \n  const planeMaterial = new THREE.MeshBasicMaterial({ \n    color: 0x00ff00, \n    transparent: true, \n    opacity: 0.5,\n    side: THREE.DoubleSide \n  });\n  const plane = new THREE.Mesh(planeGeometry, planeMaterial);\n  scene.add(plane);\n\n  // (a, b) point\n  const abGeometry = new THREE.SphereGeometry(0.15, 16, 16);\n  const abMaterial = new THREE.MeshBasicMaterial({ color: 0xff0000 });\n  const abPoint = new THREE.Mesh(abGeometry, abMaterial);\n  abPoint.position.set(0.5, 1.2, 0.5);\n  abPoint.userData = { label: '(a, b)' };\n  scene.add(abPoint);\n\n  // Projection line\n  const projLine = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0.5, -3, 0.5),\n    new THREE.Vector3(0.5, 1.2, 0.5)\n  ]);\n  const projLineMesh = new THREE.Line(projLine, new THREE.LineBasicMaterial({ \n    color: 0xff0000, \n    linewidth: 1,\n    transparent: true,\n    opacity: 0.5\n  }));\n  scene.add(projLineMesh);\n\n  // Add labels (using sprites)\n  function createTextSprite(text, position) {\n    const canvas = document.createElement('canvas');\n    canvas.width = 256;\n    canvas.height = 64;\n    const context = canvas.getContext('2d');\n    context.font = '24px sans-serif';\n    context.fillStyle = '#000000';\n    context.textAlign = 'center';\n    context.textBaseline = 'middle';\n    context.fillText(text, 128, 32);\n    \n    const texture = new THREE.CanvasTexture(canvas);\n    const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n    const sprite = new THREE.Sprite(spriteMaterial);\n    sprite.position.set(...position);\n    sprite.scale.set(2, 0.5, 1);\n    return sprite;\n  }\n\n  // Add axis labels\n  scene.add(createTextSprite('n', [-4.5, -3.5, 0]));\n  scene.add(createTextSprite('n+1', [4.5, -3.5, 0]));\n  scene.add(createTextSprite('m', [0, -3.5, -4.5]));\n  scene.add(createTextSprite('m+1', [0, -3.5, 4.5]));\n  scene.add(createTextSprite('(b) Bilinear interpolation', [0, -4.5, 0]));\n\n  // Raycaster for interaction\n  const raycaster = new THREE.Raycaster();\n  const mouse = new THREE.Vector2();\n  const tooltip = document.getElementById('tooltip');\n\n  function onMouseMove(event) {\n    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    \n    const intersects = raycaster.intersectObjects([...pointMeshes, abPoint, plane]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      if (obj.userData.label) {\n        tooltip.style.display = 'block';\n        tooltip.textContent = obj.userData.label;\n        tooltip.style.left = (event.clientX + 12) + 'px';\n        tooltip.style.top = (event.clientY - 28) + 'px';\n      } else if (obj === plane) {\n        tooltip.style.display = 'block';\n        tooltip.textContent = 'Bilinear interpolation plane';\n        tooltip.style.left = (event.clientX + 12) + 'px';\n        tooltip.style.top = (event.clientY - 28) + 'px';\n      }\n    } else {\n      tooltip.style.display = 'none';\n    }\n  }\n\n  function onClick(event) {\n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([...pointMeshes, abPoint, plane]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      if (obj.userData.label) {\n        showPopup(obj.userData.label, 'Grid point in the bilinear interpolation space');\n      } else if (obj === plane) {\n        showPopup('Interpolation Plane', 'The green plane shows the bilinear interpolation surface formed by the four corner output values');\n      } else if (obj === abPoint) {\n        showPopup('Point (a, b)', 'The interpolated point at coordinates (a, b) on the bilinear surface');\n      }\n    }\n  }\n\n  document.addEventListener('mousemove', onMouseMove);\n  renderer.domElement.addEventListener('click', onClick);\n\n  // Popup messaging\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n\n  document.addEventListener('keydown', e => { \n    if (e.key === 'Escape') hidePopup(); \n  });\n\n  renderer.domElement.addEventListener('click', e => {\n    if (!raycaster.intersectObjects([...pointMeshes, abPoint, plane]).length) {\n      hidePopup();\n    }\n  });\n\n  // Resize handler\n  window.addEventListener('resize', () => {\n    const a = window.innerWidth / window.innerHeight;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n  });\n\n  // Animation loop\n  function animate() {\n    requestAnimationFrame(animate);\n    controls.update();\n    renderer.render(scene, camera);\n  }\n  \n  animate();\n\n} catch(e) {\n  console.error('Error:', e);\n}\n</script>\n\n</body>\n</html>",
