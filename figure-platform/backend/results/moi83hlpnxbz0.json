  "filename": "figure_108",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n  #tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<div id=\"tooltip\"></div>\n<script>\ntry {\n  // Camera analysis from blueprint\n  // x-axis→right, y-axis→up/back, z-axis→up/right\n  // elevation ~30°, azimuth ~45°\n  // camera.position.set(1,1,1)\n\n  // Three.js setup\n  const scene = new THREE.Scene();\n  \n  const renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setClearColor(0xffffff, 1);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  document.body.appendChild(renderer.domElement);\n\n  const aspect = window.innerWidth / window.innerHeight;\n  const d = 5;\n  const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n  camera.position.set(5, 4, 5);\n  camera.lookAt(0, 0, 0);\n\n  scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.05;\n\n  // Gray plane (left)\n  const grayPlaneGeo = new THREE.BufferGeometry();\n  const grayVerts = new Float32Array([\n    -3, -2, -2,\n    -3, 3, -2,\n    -3, 3, 2,\n    -3, -2, 2\n  ]);\n  grayPlaneGeo.setAttribute('position', new THREE.BufferAttribute(grayVerts, 3));\n  grayPlaneGeo.setIndex([0,1,2, 0,2,3]);\n  const grayPlaneMat = new THREE.MeshBasicMaterial({ color: 0xdddddd, side: THREE.DoubleSide, transparent: true, opacity: 0.3 });\n  const grayPlane = new THREE.Mesh(grayPlaneGeo, grayPlaneMat);\n  scene.add(grayPlane);\n\n  // Gray plane edges\n  const grayEdges = new THREE.LineSegments(\n    new THREE.EdgesGeometry(grayPlaneGeo),\n    new THREE.LineBasicMaterial({ color: 0x666666 })\n  );\n  scene.add(grayEdges);\n\n  // Light blue plane (right top)\n  const bluePlaneGeo = new THREE.BufferGeometry();\n  const blueVerts = new Float32Array([\n    0, 0, 0,\n    3, 0, 0,\n    3, 0, 2.5,\n    0, 0, 2.5\n  ]);\n  bluePlaneGeo.setAttribute('position', new THREE.BufferAttribute(blueVerts, 3));\n  bluePlaneGeo.setIndex([0,1,2, 0,2,3]);\n  const bluePlaneMat = new THREE.MeshBasicMaterial({ color: 0x87ceeb, side: THREE.DoubleSide, transparent: true, opacity: 0.5 });\n  const bluePlane = new THREE.Mesh(bluePlaneGeo, bluePlaneMat);\n  scene.add(bluePlane);\n\n  // Green plane (right bottom)\n  const greenPlaneGeo = new THREE.BufferGeometry();\n  const greenVerts = new Float32Array([\n    0, 0, 0,\n    3, -2.5, 0,\n    3, 0, 0,\n    0, 0, 0\n  ]);\n  greenPlaneGeo.setAttribute('position', new THREE.BufferAttribute(greenVerts, 3));\n  greenPlaneGeo.setIndex([0,1,2]);\n  const greenPlaneMat = new THREE.MeshBasicMaterial({ color: 0x90ee90, side: THREE.DoubleSide, transparent: true, opacity: 0.5 });\n  const greenPlane = new THREE.Mesh(greenPlaneGeo, greenPlaneMat);\n  scene.add(greenPlane);\n\n  // Coordinate axes\n  const axisLength = 3.5;\n  \n  // X axis (horizontal right)\n  const xAxisGeo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(axisLength, 0, 0)\n  ]);\n  const xAxis = new THREE.Line(xAxisGeo, new THREE.LineBasicMaterial({ color: 0x000000 }));\n  scene.add(xAxis);\n\n  // Y axis (horizontal left/back)\n  const yAxisGeo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(0, -axisLength, 0)\n  ]);\n  const yAxis = new THREE.Line(yAxisGeo, new THREE.LineBasicMaterial({ color: 0x000000 }));\n  scene.add(yAxis);\n\n  // Z axis (vertical)\n  const zAxisGeo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(0, 0, axisLength)\n  ]);\n  const zAxis = new THREE.Line(zAxisGeo, new THREE.LineBasicMaterial({ color: 0x000000 }));\n  scene.add(zAxis);\n\n  // Arrow heads\n  const coneGeo = new THREE.ConeGeometry(0.1, 0.3, 8);\n  \n  const xArrow = new THREE.Mesh(coneGeo, new THREE.MeshBasicMaterial({ color: 0x000000 }));\n  xArrow.position.set(axisLength, 0, 0);\n  xArrow.rotation.z = -Math.PI / 2;\n  scene.add(xArrow);\n\n  const yArrow = new THREE.Mesh(coneGeo, new THREE.MeshBasicMaterial({ color: 0x000000 }));\n  yArrow.position.set(0, -axisLength, 0);\n  yArrow.rotation.x = Math.PI / 2;\n  scene.add(yArrow);\n\n  const zArrow = new THREE.Mesh(coneGeo, new THREE.MeshBasicMaterial({ color: 0x000000 }));\n  zArrow.position.set(0, 0, axisLength);\n  scene.add(zArrow);\n\n  // Projection line from origin to f\n  const projLineGeo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(1, 0.5, 1.2)\n  ]);\n  const projLine = new THREE.Line(projLineGeo, new THREE.LineBasicMaterial({ color: 0x000000 }));\n  scene.add(projLine);\n\n  // Arrow on projection line\n  const projArrow = new THREE.Mesh(coneGeo, new THREE.MeshBasicMaterial({ color: 0x000000 }));\n  projArrow.position.set(1, 0.5, 1.2);\n  projArrow.lookAt(0, 0, 0);\n  projArrow.rotateX(Math.PI);\n  scene.add(projArrow);\n\n  // Brown node on gray plane\n  const brownNodeGeo = new THREE.SphereGeometry(0.15, 16, 16);\n  const brownNode = new THREE.Mesh(brownNodeGeo, new THREE.MeshBasicMaterial({ color: 0x8b4513 }));\n  brownNode.position.set(-3, 0.8, 0.8);\n  brownNode.userData = { name: 'Point on projection plane', desc: 'This point represents the 2D projection of the 3D point f onto the gray plane.' };\n  scene.add(brownNode);\n\n  // Red node on green plane\n  const redNodeGeo = new THREE.SphereGeometry(0.15, 16, 16);\n  const redNode = new THREE.Mesh(redNodeGeo, new THREE.MeshBasicMaterial({ color: 0xd32f2f }));\n  redNode.position.set(1.5, -0.75, 0);\n  redNode.userData = { name: 'Point on XY plane', desc: 'This point shows the projection of f onto the green XY plane at Z=0.' };\n  scene.add(redNode);\n\n  // Dotted lines\n  const dashedMat = new THREE.LineDashedMaterial({ color: 0x666666, dashSize: 0.1, gapSize: 0.05 });\n\n  // From brown to origin\n  const dotted1Geo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-3, 0.8, 0.8),\n    new THREE.Vector3(0, 0, 0)\n  ]);\n  const dotted1 = new THREE.Line(dotted1Geo, dashedMat);\n  dotted1.computeLineDistances();\n  scene.add(dotted1);\n\n  // From f to red\n  const dotted2Geo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(1, 0.5, 1.2),\n    new THREE.Vector3(1.5, -0.75, 0)\n  ]);\n  const dotted2 = new THREE.Line(dotted2Geo, dashedMat);\n  dotted2.computeLineDistances();\n  scene.add(dotted2);\n\n  // Text labels using sprites\n  function createTextSprite(text, position) {\n    const canvas = document.createElement('canvas');\n    const ctx = canvas.getContext('2d');\n    canvas.width = 64;\n    canvas.height = 64;\n    ctx.font = '32px Arial';\n    ctx.fillStyle = 'black';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(text, 32, 32);\n    \n    const texture = new THREE.CanvasTexture(canvas);\n    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture }));\n    sprite.position.copy(position);\n    sprite.scale.set(0.5, 0.5, 1);\n    return sprite;\n  }\n\n  scene.add(createTextSprite('X', new THREE.Vector3(axisLength + 0.3, 0, 0)));\n  scene.add(createTextSprite('Y', new THREE.Vector3(0, -axisLength - 0.3, 0)));\n  scene.add(createTextSprite('Z', new THREE.Vector3(0, 0, axisLength + 0.3)));\n  scene.add(createTextSprite('f', new THREE.Vector3(1.2, 0.7, 1.4)));\n  scene.add(createTextSprite('x', new THREE.Vector3(-2.8, 1.2, 0.6)));\n  scene.add(createTextSprite('y', new THREE.Vector3(-2.8, 0.4, 1.2)));\n\n  // Raycaster for interaction\n  const raycaster = new THREE.Raycaster();\n  const mouse = new THREE.Vector2();\n  const tooltip = document.getElementById('tooltip');\n\n  function onMouseMove(event) {\n    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([brownNode, redNode]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      if (obj.userData.name) {\n        tooltip.textContent = obj.userData.name;\n        tooltip.style.display = 'block';\n        tooltip.style.left = (event.clientX + 12) + 'px';\n        tooltip.style.top = (event.clientY - 28) + 'px';\n        renderer.domElement.style.cursor = 'pointer';\n      }\n    } else {\n      tooltip.style.display = 'none';\n      renderer.domElement.style.cursor = 'default';\n    }\n  }\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n\n  function onClick(event) {\n    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([brownNode, redNode, grayPlane, bluePlane, greenPlane]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      if (obj === brownNode || obj === redNode) {\n        showPopup(obj.userData.name, obj.userData.desc);\n      } else if (obj === grayPlane) {\n        showPopup('Projection Plane', 'This gray plane represents the 2D projection surface where 3D points are mapped. The projection preserves relative positions while reducing dimensionality.');\n      } else if (obj === bluePlane) {\n        showPopup('XZ Plane', 'The light blue plane shows the XZ coordinate plane. Points on this plane have constant Y values and help visualize the vertical component of 3D positions.');\n      } else if (obj === greenPlane) {\n        showPopup('XY Plane', 'The green plane represents the XY coordinate plane at Z=0. This is the horizontal ground plane where vertical information is collapsed.');\n      }\n    } else {\n      hidePopup();\n    }\n  }\n\n  renderer.domElement.addEventListener('mousemove', onMouseMove);\n  renderer.domElement.addEventListener('click', onClick);\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n\n  // Animation\n  function animate() {\n    requestAnimationFrame(animate);\n    controls.update();\n    renderer.render(scene, camera);\n  }\n\n  animate();\n\n  // Resize handler\n  window.addEventListener('resize', () => {\n    const a = window.innerWidth / window.innerHeight;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n  });\n\n} catch(e) {\n  console.error('Error:', e);\n  document.body.innerHTML = '<div style=\"padding:20px;color:red;\">Error loading visualization</div>';\n}\n</script>\n</body>\n</html>",
