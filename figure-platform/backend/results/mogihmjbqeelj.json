 data-label=\"⊕\"/>\n<text x=\"296\" y=\"154\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">⊕</text>\n\n<circle cx=\"300\" cy=\"180\" r=\"7\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"circle9\" data-label=\"⊕\"/>\n<text x=\"296\" y=\"184\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">⊕</text>\n</g>\n\n<!-- Arrows -->\n<g id=\"edges\">\n<line x1=\"60\" y1=\"30\" x2=\"130\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B0\" data-to=\"b00\"/>\n<line x1=\"60\" y1=\"60\" x2=\"130\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B1\" data-to=\"b01\"/>\n<line x1=\"60\" y1=\"90\" x2=\"130\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"Bk\" data-to=\"b0k\"/>\n\n<line x1=\"130\" y1=\"120\" x2=\"160\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B0_2\" data-to=\"b10\"/>\n<line x1=\"110\" y1=\"150\" x2=\"160\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B1_2\" data-to=\"b1k-1\"/>\n<line x1=\"110\" y1=\"180\" x2=\"160\" y2=\"180\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"Bk_2\" data-to=\"b1k\"/>\n\n<line x1=\"170\" y1=\"30\" x2=\"250\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b00\" data-to=\"B0_3\"/>\n<line x1=\"170\" y1=\"60\" x2=\"250\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b01\" data-to=\"B1_3\"/>\n<line x1=\"170\" y1=\"90\" x2=\"250\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b0k\" data-to=\"Bk_3\"/>\n\n<line x1=\"200\" y1=\"120\" x2=\"250\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b10\" data-to=\"B0_4\"/>\n<line x1=\"200\" y1=\"150\" x2=\"250\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b1k-1\" data-to=\"B1_4\"/>\n<line x1=\"200\" y1=\"180\" x2=\"250\" y2=\"180\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"b1k\" data-to=\"Bk_4\"/>\n\n<line x1=\"270\" y1=\"30\" x2=\"293\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B0_3\" data-to=\"circle4\"/>\n<line x1=\"270\" y1=\"60\" x2=\"293\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B1_3\" data-to=\"circle5\"/>\n<line x1=\"270\" y1=\"90\" x2=\"293\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"Bk_3\" data-to=\"circle6\"/>\n\n<line x1=\"270\" y1=\"120\" x2=\"293\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B0_4\" data-to=\"circle7\"/>\n<line x1=\"270\" y1=\"150\" x2=\"293\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"B1_4\" data-to=\"circle8\"/>\n<line x1=\"270\" y1=\"180\" x2=\"293\" y2=\"180\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"Bk_4\" data-to=\"circle9\"/>\n\n<line x1=\"307\" y1=\"30\" x2=\"420\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle4\" data-to=\"output\"/>\n<line x1=\"307\" y1=\"60\" x2=\"420\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle5\" data-to=\"output\"/>\n<line x1=\"307\" y1=\"90\" x2=\"420\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle6\" data-to=\"output\"/>\n\n<line x1=\"307\" y1=\"120\" x2=\"420\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle7\" data-to=\"output\"/>\n<line x1=\"307\" y1=\"150\" x2=\"420\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle8\" data-to=\"output\"/>\n<line x1=\"307\" y1=\"180\" x2=\"420\" y2=\"180\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"circle9\" data-to=\"output\"/>\n\n<text x=\"430\" y=\"35\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">ℓ</text>\n\n<line x1=\"200\" y1=\"202\" x2=\"240\" y2=\"202\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"D\" data-to=\"U\"/>\n<line x1=\"255\" y1=\"202\" x2=\"280\" y2=\"202\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"U\" data-to=\"L3\"/>\n</g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst edges = document.querySelectorAll('.edge');\nconst nodes = document.querySelectorAll('.node');\n\n// Graph connectivity\nconst graph = {\n  't': { out:[], in:[], label:'ℓ', role:'Input value' },\n  'B0': { out:['b00'], in:[], label:'B₀', role:'Block 0' },\n  'B1': { out:['b01'], in:[], label:'B₁', role:'Block 1' },\n  'Bk': { out:['b0k'], in:[], label:'Bₖ', role:'Block k' },\n  'L': { out:[], in:[], label:'L', role:'Layer' },\n  'circle1': { out:[], in:[], label:'⊕', role:'Addition operator' },\n  'B0_2': { out:['b10'], in:[], label:'B₀', role:'Block 0' },\n  'B1_2': { out:['b1k-1'], in:[], label:'B₁', role:'Block 1' },\n  'Bk_2': { out:['b1k'], in:[], label:'Bₖ', role:'Block k' },\n  'L2': { out:[], in:[], label:'L', role:'Layer' },\n  'circle2': { out:[], in:[], label:'⊖', role:'Subtraction operator' },\n  'D': { out:['U'], in:[], label:'D', role:'Data block' },\n  'U': { out:['L3'], in:['D'], label:'U', role:'Unit' },\n  'circle3': { out:[], in:[], label:'⊖', role:'Subtraction operator' },\n  'L3': { out:[], in:['U'], label:'L', role:'Layer' },\n  'B0_3': { out:['circle4'], in:['b00'], label:'B₀', role:'Block 0' },\n  'B1_3': { out:['circle5'], in:['b01'], label:'B₁', role:'Block 1' },\n  'Bk_3': { out:['circle6'], in:['b0k'], label:'Bₖ', role:'Block k' },\n  'B0_4': { out:['circle7'], in:['b10'], label:'B₀', role:'Block 0' },\n  'B1_4': { out:['circle8'], in:['b1k-1'], label:'B₁', role:'Block 1' },\n  'Bk_4': { out:['circle9'], in:['b1k'], label:'Bₖ', role:'Block k' },\n  'circle4': { out:['output'], in:['B0_3'], label:'⊕', role:'Addition operator' },\n  'circle5': { out:['output'], in:['B1_3'], label:'⊕', role:'Addition operator' },\n  'circle6': { out:['output'], in:['Bk_3'], label:'⊕', role:'Addition operator' },\n  'circle7': { out:['output'], in:['B0_4'], label:'⊕', role:'Addition operator' },\n  'circle8': { out:['output'], in:['B1_4'], label:'⊕', role:'Addition operator' },\n  'circle9': { out:['output'], in:['Bk_4'], label:'⊕', role:'Addition operator' }\n};\n\n// Hover effects\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n      \n      node.style.strokeWidth = '2.5';\n      if (node.tagName === 'circle') {\n        node.style.fillOpacity = '0.9';\n      }\n      \n      // Highlight outgoing edges\n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n    }\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    tooltip.style.display = 'none';\n    node.style.strokeWidth = '1';\n    node.style.fillOpacity = '1';\n    \n    edges.forEach(edge => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n    });\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      showPopup(info.label, `${info.role}. Connected to ${info.out.length} downstream and ${info.in.length} upstream nodes.`);\n    }\n  });\n});\n\n// Edge hover\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2';\n  });\n  \n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1';\n  });\n});\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Dismiss handlers\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') hidePopup();\n});\n\nsvg.addEventListener('click', e => {\n  if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n});\n\n} catch(err) {\n  console.error('Runtime error:', err);\n}\n</script>\n</body>\n</html>",
