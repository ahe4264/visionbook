  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { cursor:pointer; }\n.edge { pointer-events:stroke; cursor:pointer; }\n.label { pointer-events:none; font:11px sans-serif; text-anchor:middle; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 124 164\">\n<defs>\n<marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n<path d=\"M0,0 L6,3 L0,6\" fill=\"none\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n</marker>\n</defs>\n\n<!-- Input nodes -->\n<circle cx=\"20\" cy=\"20\" r=\"10\" fill=\"#cccccc\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"x1\"/>\n<text x=\"20\" y=\"24\" class=\"label\">x₁</text>\n\n<circle cx=\"20\" cy=\"45\" r=\"10\" fill=\"#cccccc\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"x2\"/>\n<text x=\"20\" y=\"49\" class=\"label\">x₂</text>\n\n<circle cx=\"20\" cy=\"70\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"x3\"/>\n<text x=\"20\" y=\"74\" class=\"label\">x₃</text>\n\n<!-- Weight boxes -->\n<rect x=\"45\" y=\"15\" width=\"18\" height=\"10\" fill=\"none\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"w1\"/>\n<text x=\"54\" y=\"22\" class=\"label\" style=\"font-size:10px\">w₁</text>\n\n<rect x=\"45\" y=\"40\" width=\"18\" height=\"10\" fill=\"none\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"w2\"/>\n<text x=\"54\" y=\"47\" class=\"label\" style=\"font-size:10px\">w₂</text>\n\n<rect x=\"45\" y=\"65\" width=\"18\" height=\"10\" fill=\"none\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"w3\"/>\n<text x=\"54\" y=\"72\" class=\"label\" style=\"font-size:10px\">w₃</text>\n\n<!-- Multiplication symbols -->\n<g transform=\"translate(75,20)\">\n<line x1=\"-3\" y1=\"-3\" x2=\"3\" y2=\"3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n<line x1=\"-3\" y1=\"3\" x2=\"3\" y2=\"-3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n</g>\n<g transform=\"translate(75,45)\">\n<line x1=\"-3\" y1=\"-3\" x2=\"3\" y2=\"3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n<line x1=\"-3\" y1=\"3\" x2=\"3\" y2=\"-3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n</g>\n<g transform=\"translate(75,70)\">\n<line x1=\"-3\" y1=\"-3\" x2=\"3\" y2=\"3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n<line x1=\"-3\" y1=\"3\" x2=\"3\" y2=\"-3\" stroke=\"#d36b6b\" stroke-width=\"1\"/>\n</g>\n\n<!-- Output nodes -->\n<circle cx=\"104\" cy=\"20\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z1\"/>\n<text x=\"104\" y=\"24\" class=\"label\">z₁</text>\n\n<circle cx=\"104\" cy=\"45\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z2\"/>\n<text x=\"104\" y=\"49\" class=\"label\">z₂</text>\n\n<circle cx=\"104\" cy=\"70\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z3\"/>\n<text x=\"104\" y=\"74\" class=\"label\">z₃</text>\n\n<circle cx=\"104\" cy=\"95\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z4\"/>\n<text x=\"104\" y=\"99\" class=\"label\">z₄</text>\n\n<circle cx=\"104\" cy=\"120\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z5\"/>\n<text x=\"104\" y=\"124\" class=\"label\">z₅</text>\n\n<circle cx=\"104\" cy=\"145\" r=\"10\" fill=\"#ffffff\" stroke=\"#666\" stroke-width=\"1\" class=\"node\" data-id=\"z6\"/>\n<text x=\"104\" y=\"149\" class=\"label\">z₆</text>\n\n<!-- Edges -->\n<line x1=\"30\" y1=\"20\" x2=\"45\" y2=\"20\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x1\" data-to=\"w1\"/>\n<line x1=\"30\" y1=\"45\" x2=\"45\" y2=\"45\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x2\" data-to=\"w2\"/>\n<line x1=\"30\" y1=\"70\" x2=\"45\" y2=\"70\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"x3\" data-to=\"w3\"/>\n\n<line x1=\"63\" y1=\"20\" x2=\"72\" y2=\"20\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"w1\" data-to=\"mult1\"/>\n<line x1=\"63\" y1=\"45\" x2=\"72\" y2=\"45\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"w2\" data-to=\"mult2\"/>\n<line x1=\"63\" y1=\"70\" x2=\"72\" y2=\"70\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"w3\" data-to=\"mult3\"/>\n\n<line x1=\"78\" y1=\"20\" x2=\"94\" y2=\"20\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"mult1\" data-to=\"z1\"/>\n<line x1=\"78\" y1=\"45\" x2=\"94\" y2=\"45\" stroke=\"#d36b6b\" stroke-width=\"1\" marker-end=\"url(#arr)\" class=\"edge\" data-from=\"mult2\" data-to=\"z2\"/>\n\n<!-- Label a) -->\n<text x=\"8\" y=\"156\" style=\"font:11px sans-serif\">a)</text>\n\n</svg>\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\nconst graph = {\n  'x1': { out: ['w1'], in: [], label: 'x₁', role: 'Input 1 (active)' },\n  'x2': { out: ['w2'], in: [], label: 'x₂', role: 'Input 2 (active)' },\n  'x3': { out: ['w3'], in: [], label: 'x₃', role: 'Input 3 (inactive)' },\n  'w1': { out: ['mult1'], in: ['x1'], label: 'w₁', role: 'Weight 1' },\n  'w2': { out: ['mult2'], in: ['x2'], label: 'w₂', role: 'Weight 2' },\n  'w3': { out: ['mult3'], in: ['x3'], label: 'w₃', role: 'Weight 3' },\n  'mult1': { out: ['z1'], in: ['w1'], label: '×', role: 'Multiply operation' },\n  'mult2': { out: ['z2'], in: ['w2'], label: '×', role: 'Multiply operation' },\n  'mult3': { out: [], in: ['w3'], label: '×', role: 'Multiply operation' },\n  'z1': { out: [], in: ['mult1'], label: 'z₁', role: 'Output 1' },\n  'z2': { out: [], in: ['mult2'], label: 'z₂', role: 'Output 2' },\n  'z3': { out: [], in: [], label: 'z₃', role: 'Output 3' },\n  'z4': { out: [], in: [], label: 'z₄', role: 'Output 4' },\n  'z5': { out: [], in: [], label: 'z₅', role: 'Output 5' },\n  'z6': { out: [], in: [], label: 'z₆', role: 'Output 6' }\n};\n\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n      node.style.strokeWidth = '2.5';\n      \n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n    }\n  });\n\n  node.addEventListener('mouseleave', () => {\n    tooltip.style.display = 'none';\n    node.style.strokeWidth = '1';\n    edges.forEach(edge => {\n      edge.style.stroke = '#d36b6b';\n      edge.style.strokeWidth = '1';\n    });\n  });\n\n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      showPopup(info.label, `${info.role}. ${info.out.length > 0 ? 'Connects to: ' + info.out.join(', ') : 'No outgoing connections.'}`);\n      animateForwardPass(id);\n    }\n  });\n});\n\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2';\n  });\n\n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = '#d36b6b';\n    edge.style.strokeWidth = '1';\n  });\n});\n\nfunction animateForwardPass(startId) {\n  const visited = new Set();\n  const queue = [[startId, 0]];\n  \n  while (queue.length > 0) {\n    const [nodeId, layer] = queue.shift();\n    if (visited.has(nodeId)) continue;\n    visited.add(nodeId);\n    \n    const outEdges = [];\n    edges.forEach(edge => {\n      if (edge.getAttribute('data-from') === nodeId) {\n        outEdges.push(edge);\n        const toId = edge.getAttribute('data-to');\n        if (toId && !visited.has(toId)) {\n          queue.push([toId, layer + 1]);\n        }\n      }\n    });\n    \n    animateEdges(outEdges, '#4a7ef5', layer * 380);\n  }\n  \n  setTimeout(() => {\n    edges.forEach(edge => {\n      edge.style.stroke = '#d36b6b';\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n    });\n  }, 1500);\n}\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.35s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n} catch (err) {\n  console.error('Error in interactive figure:', err);\n}\n</script>\n</body>\n</html>",
