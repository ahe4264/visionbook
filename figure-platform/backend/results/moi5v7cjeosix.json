  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n  #tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 333\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#333\"/>\n    </marker>\n  </defs>\n  \n  <!-- Input layer nodes -->\n  <circle cx=\"120\" cy=\"83\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"x1\" data-layer=\"input\"/>\n  <text x=\"120\" y=\"88\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">x₁</text>\n  \n  <circle cx=\"120\" cy=\"166\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"x2\" data-layer=\"input\"/>\n  <text x=\"120\" y=\"171\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">x₂</text>\n  \n  <circle cx=\"120\" cy=\"249\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"x3\" data-layer=\"input\"/>\n  <text x=\"120\" y=\"254\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">x₃</text>\n  \n  <!-- Hidden layer nodes -->\n  <circle cx=\"300\" cy=\"62\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"h1\" data-layer=\"hidden\"/>\n  <text x=\"300\" y=\"67\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">h₁</text>\n  \n  <circle cx=\"300\" cy=\"135\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"h2\" data-layer=\"hidden\"/>\n  <text x=\"300\" y=\"140\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">h₂</text>\n  \n  <circle cx=\"300\" cy=\"208\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"h3\" data-layer=\"hidden\"/>\n  <text x=\"300\" y=\"213\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">h₃</text>\n  \n  <circle cx=\"300\" cy=\"281\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"h4\" data-layer=\"hidden\"/>\n  <text x=\"300\" y=\"286\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">h₄</text>\n  \n  <!-- Output layer nodes -->\n  <circle cx=\"480\" cy=\"125\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"y1\" data-layer=\"output\"/>\n  <text x=\"480\" y=\"130\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">y₁</text>\n  \n  <circle cx=\"480\" cy=\"208\" r=\"27\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-node=\"y2\" data-layer=\"output\"/>\n  <text x=\"480\" y=\"213\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">y₂</text>\n  \n  <!-- Edges from input to hidden layer -->\n  <line x1=\"147\" y1=\"83\" x2=\"267\" y2=\"62\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x1-h1\"/>\n  <line x1=\"147\" y1=\"83\" x2=\"267\" y2=\"135\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x1-h2\"/>\n  <line x1=\"147\" y1=\"83\" x2=\"267\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x1-h3\"/>\n  <line x1=\"147\" y1=\"83\" x2=\"267\" y2=\"281\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x1-h4\"/>\n  \n  <line x1=\"147\" y1=\"166\" x2=\"267\" y2=\"62\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x2-h1\"/>\n  <line x1=\"147\" y1=\"166\" x2=\"267\" y2=\"135\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x2-h2\"/>\n  <line x1=\"147\" y1=\"166\" x2=\"267\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x2-h3\"/>\n  <line x1=\"147\" y1=\"166\" x2=\"267\" y2=\"281\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x2-h4\"/>\n  \n  <line x1=\"147\" y1=\"249\" x2=\"267\" y2=\"62\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x3-h1\"/>\n  <line x1=\"147\" y1=\"249\" x2=\"267\" y2=\"135\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x3-h2\"/>\n  <line x1=\"147\" y1=\"249\" x2=\"267\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x3-h3\"/>\n  <line x1=\"147\" y1=\"249\" x2=\"267\" y2=\"281\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x3-h4\"/>\n  \n  <!-- Edges from hidden to output layer -->\n  <line x1=\"327\" y1=\"62\" x2=\"447\" y2=\"125\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h1-y1\"/>\n  <line x1=\"327\" y1=\"62\" x2=\"447\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h1-y2\"/>\n  \n  <line x1=\"327\" y1=\"135\" x2=\"447\" y2=\"125\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h2-y1\"/>\n  <line x1=\"327\" y1=\"135\" x2=\"447\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h2-y2\"/>\n  \n  <line x1=\"327\" y1=\"208\" x2=\"447\" y2=\"125\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h3-y1\"/>\n  <line x1=\"327\" y1=\"208\" x2=\"447\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h3-y2\"/>\n  \n  <line x1=\"327\" y1=\"281\" x2=\"447\" y2=\"125\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h4-y1\"/>\n  <line x1=\"327\" y1=\"281\" x2=\"447\" y2=\"208\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h4-y2\"/>\n  \n  <!-- Labels -->\n  <text x=\"120\" y=\"35\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">Input layer</text>\n  <text x=\"300\" y=\"35\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">Hidden layer</text>\n  <text x=\"480\" y=\"35\" text-anchor=\"middle\" font-size=\"11\" fill=\"#000\">Output layer</text>\n  \n  <!-- Annotations -->\n  <path d=\"M 60 210 Q 50 190, 60 170\" fill=\"none\" stroke=\"#0000FF\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <text x=\"30\" y=\"195\" font-size=\"11\" fill=\"#0000FF\">Weight</text>\n  \n  <text x=\"300\" y=\"310\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">Neuron or</text>\n  <text x=\"300\" y=\"322\" text-anchor=\"middle\" font-size=\"11\" fill=\"#8B4513\">hidden unit</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const svg = document.querySelector('svg');\n  \n  function showPopup(title, body) { \n    window.parent.postMessage({ type:'alex-popup', title, body }, '*'); \n  }\n  \n  function hidePopup() { \n    window.parent.postMessage({ type:'alex-popup', title:null }, '*'); \n  }\n  \n  document.addEventListener('keydown', e => { \n    if(e.key==='Escape') hidePopup(); \n  });\n  \n  svg.addEventListener('click', e => { \n    if(e.target===svg||e.target.tagName==='svg') hidePopup(); \n  });\n  \n  // Hover effects\n  const nodes = document.querySelectorAll('[data-node]');\n  const edges = document.querySelectorAll('[data-edge]');\n  \n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', e => {\n      node.style.strokeWidth = '2.5';\n      const nodeName = node.getAttribute('data-node');\n      const layer = node.getAttribute('data-layer');\n      let desc = '';\n      if(layer === 'input') desc = 'Input feature';\n      else if(layer === 'hidden') desc = 'Hidden unit for feature extraction';\n      else if(layer === 'output') desc = 'Output prediction';\n      tooltip.textContent = `${nodeName}: ${desc}`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      node.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const nodeName = node.getAttribute('data-node');\n      const layer = node.getAttribute('data-layer');\n      let body = '';\n      if(layer === 'input') {\n        body = 'Input nodes receive the raw feature values from your data. Each input node represents one feature or dimension of your input data.';\n      } else if(layer === 'hidden') {\n        body = 'Hidden nodes combine weighted inputs from the previous layer and apply an activation function. They learn to extract useful features from the raw inputs through training.';\n      } else if(layer === 'output') {\n        body = 'Output nodes produce the final predictions of the network. They combine the features learned by the hidden layer to make the final classification or regression output.';\n      }\n      showPopup(`Node ${nodeName}`, body);\n    });\n  });\n  \n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', e => {\n      edge.style.strokeWidth = '2.5';\n      const edgeName = edge.getAttribute('data-edge');\n      tooltip.textContent = `Connection ${edgeName}: Weight parameter`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', e => {\n      edge.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n    \n    edge.addEventListener('click', e => {\n      e.stopPropagation();\n      showPopup('Neural Network Connection', 'Each connection has a weight parameter that is learned during training. The weight determines how strongly the input from one node influences the next node. Positive weights amplify the signal, while negative weights diminish it.');\n    });\n  });\n  \n  document.addEventListener('mousemove', e => { \n    tooltip.style.left = (e.clientX+12)+'px'; \n    tooltip.style.top = (e.clientY-28)+'px'; \n  });\n  \n  // Forward propagation animation\n  svg.addEventListener('click', e => {\n    if(e.target === svg || e.target.tagName === 'svg') {\n      // Reset all colors\n      nodes.forEach(n => {\n        n.style.transition = 'fill 0.35s ease';\n        n.style.fill = '#fff';\n      });\n      edges.forEach(e => {\n        e.style.transition = 'stroke 0.35s ease';\n        e.style.stroke = '#000';\n      });\n      \n      // Animate forward propagation\n      setTimeout(() => {\n        // Highlight input layer\n        document.querySelectorAll('[data-layer=\"input\"]').forEach(n => {\n          n.style.fill = '#c8e0ff';\n        });\n      }, 100);\n      \n      setTimeout(() => {\n        // Highlight edges from input to hidden\n        document.querySelectorAll('[data-edge^=\"x\"]').forEach(e => {\n          e.style.stroke = '#4a90e2';\n        });\n      }, 500);\n      \n      setTimeout(() => {\n        // Highlight hidden layer\n        document.querySelectorAll('[data-layer=\"hidden\"]').forEach(n => {\n          n.style.fill = '#c8f0c8';\n        });\n      }, 900);\n      \n      setTimeout(() => {\n        // Highlight edges from hidden to output\n        document.querySelectorAll('[data-edge^=\"h\"]').forEach(e => {\n          e.style.stroke = '#5cb85c';\n        });\n      }, 1300);\n      \n      setTimeout(() => {\n        // Highlight output layer\n        document.querySelectorAll('[data-layer=\"output\"]').forEach(n => {\n          n.style.fill = '#ffd4d4';\n        });\n      }, 1700);\n      \n      // Reset after animation\n      setTimeout(() => {\n        nodes.forEach(n => n.style.fill = '#fff');\n        edges.forEach(e => e.style.stroke = '#000');\n      }, 2500);\n    }\n  });\n  \n} catch(err) {\n  console.error('Runtime error:', err);\n}\n</script>\n</body>\n</html>",
