  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { cursor:pointer; transition:stroke-width 0.2s, fill-opacity 0.2s; }\n.edge { transition:stroke 0.2s, stroke-width 0.2s; pointer-events:stroke; }\n.label { font:12px sans-serif; pointer-events:none; user-select:none; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 152 97\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges -->\n  <line class=\"edge\" id=\"e-x-z\" x1=\"30\" y1=\"30\" x2=\"52\" y2=\"38\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" id=\"e-x-h\" x1=\"30\" y1=\"30\" x2=\"52\" y2=\"59\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" id=\"e-y-z\" x1=\"122\" y1=\"30\" x2=\"100\" y2=\"38\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" id=\"e-y-h\" x1=\"122\" y1=\"30\" x2=\"100\" y2=\"59\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" id=\"e-z-h\" x1=\"70\" y1=\"44\" x2=\"76\" y2=\"53\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" stroke-dasharray=\"2,2\"/>\n  <line class=\"edge\" id=\"e-h-z\" x1=\"82\" y1=\"53\" x2=\"88\" y2=\"44\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" stroke-dasharray=\"2,2\"/>\n  \n  <!-- Dotted extensions -->\n  <line x1=\"30\" y1=\"42\" x2=\"30\" y2=\"67\" stroke=\"#000\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>\n  <circle cx=\"30\" cy=\"67\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"122\" y1=\"42\" x2=\"122\" y2=\"67\" stroke=\"#000\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>\n  <circle cx=\"122\" cy=\"67\" r=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- Nodes -->\n  <circle class=\"node\" id=\"n-x\" cx=\"30\" cy=\"30\" r=\"8\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <circle class=\"node\" id=\"n-y\" cx=\"122\" cy=\"30\" r=\"8\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n  <circle class=\"node\" id=\"n-z\" cx=\"66\" cy=\"48.5\" r=\"16\" fill=\"#ddd\" stroke=\"#000\" stroke-width=\"1\"/>\n  <circle class=\"node\" id=\"n-h\" cx=\"86\" cy=\"48.5\" r=\"16\" fill=\"#ddd\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- Labels -->\n  <text class=\"label\" x=\"30\" y=\"16\" text-anchor=\"middle\">x</text>\n  <text class=\"label\" x=\"122\" y=\"16\" text-anchor=\"middle\">y</text>\n  <text class=\"label\" x=\"66\" y=\"53\" text-anchor=\"middle\">z</text>\n  <text class=\"label\" x=\"86\" y=\"53\" text-anchor=\"middle\">h</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\n\n// Graph structure\nconst graph = {\n  'x': { out:['z','h'], in:[], label:'x', role:'Input node' },\n  'y': { out:['z','h'], in:[], label:'y', role:'Input node' },\n  'z': { out:['h'], in:['x','y','h'], label:'z', role:'Processing node' },\n  'h': { out:['z'], in:['x','y','z'], label:'h', role:'Processing node' }\n};\n\n// Node elements\nconst nodes = {\n  x: document.getElementById('n-x'),\n  y: document.getElementById('n-y'),\n  z: document.getElementById('n-z'),\n  h: document.getElementById('n-h')\n};\n\n// Edge elements mapped by source\nconst edgesBySource = {\n  x: [document.getElementById('e-x-z'), document.getElementById('e-x-h')],\n  y: [document.getElementById('e-y-z'), document.getElementById('e-y-h')],\n  z: [document.getElementById('e-z-h')],\n  h: [document.getElementById('e-h-z')]\n};\n\n// Tooltip\ndocument.addEventListener('mousemove', e => {\n  if (tooltip.style.display === 'block') {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  }\n});\n\n// Node hover\nObject.entries(nodes).forEach(([key, node]) => {\n  node.addEventListener('mouseenter', () => {\n    node.style.strokeWidth = '2.5';\n    node.style.fillOpacity = '0.9';\n    \n    // Highlight outgoing edges\n    const edges = edgesBySource[key] || [];\n    edges.forEach(e => {\n      e.style.stroke = '#e07b30';\n      e.style.strokeWidth = '2';\n    });\n    \n    tooltip.textContent = `${graph[key].label} — ${graph[key].role}`;\n    tooltip.style.display = 'block';\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    node.style.strokeWidth = '1';\n    node.style.fillOpacity = '1';\n    \n    const edges = edgesBySource[key] || [];\n    edges.forEach(e => {\n      e.style.stroke = '#000';\n      e.style.strokeWidth = '1';\n    });\n    \n    tooltip.style.display = 'none';\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup(graph[key].label, `Node ${graph[key].label} is a ${graph[key].role}. It receives input from: ${graph[key].in.join(', ') || 'none'}. It sends output to: ${graph[key].out.join(', ') || 'none'}.`);\n    animateFlow(key, e.shiftKey);\n  });\n});\n\n// Edge hover\ndocument.querySelectorAll('.edge').forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2';\n  });\n  \n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1';\n  });\n});\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Dismiss handlers\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Flow animation\nfunction animateFlow(startNode, backward) {\n  const color = backward ? '#e05050' : '#4a7ef5';\n  \n  // Reset all edges\n  document.querySelectorAll('.edge').forEach(e => {\n    e.style.transition = 'none';\n    e.style.strokeDasharray = '';\n    e.style.strokeDashoffset = '';\n  });\n  \n  if (backward) {\n    // Backward pass - not implemented for this simple network\n    return;\n  }\n  \n  // Forward pass\n  if (startNode === 'x' || startNode === 'y') {\n    // Layer 0: edges from input nodes\n    animateEdges(edgesBySource[startNode], color, 0);\n    \n    // Pulse destination nodes\n    if (startNode === 'x') {\n      pulseNode(nodes.z, 350);\n      pulseNode(nodes.h, 350);\n    } else {\n      pulseNode(nodes.z, 350);\n      pulseNode(nodes.h, 350);\n    }\n  } else if (startNode === 'z') {\n    animateEdges(edgesBySource.z, color, 0);\n    pulseNode(nodes.h, 350);\n  } else if (startNode === 'h') {\n    animateEdges(edgesBySource.h, color, 0);\n    pulseNode(nodes.z, 350);\n  }\n  \n  // Reset after animation\n  setTimeout(() => {\n    document.querySelectorAll('.edge').forEach(e => {\n      e.style.transition = 'stroke 0.3s';\n      e.style.stroke = '#000';\n      e.style.strokeDasharray = '';\n      e.style.strokeDashoffset = '';\n    });\n  }, 1200);\n}\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.6s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction pulseNode(node, delay) {\n  setTimeout(() => {\n    node.style.transformBox = 'fill-box';\n    node.style.transformOrigin = 'center';\n    node.style.transition = 'transform 0.15s ease';\n    node.style.transform = 'scale(1.18)';\n    setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n  }, delay);\n}\n\n} catch(err) {\n  console.error('Interactive figure error:', err);\n}\n</script>\n</body>\n</html>",
