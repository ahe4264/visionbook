  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n    position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 432 71\">\n  <g id=\"panel-a\" transform=\"translate(8,8)\">\n    <line x1=\"40\" y1=\"10\" x2=\"40\" y2=\"45\" stroke=\"#000\" stroke-width=\"1\"/>\n    <circle cx=\"40\" cy=\"15\" r=\"1\" fill=\"#000\"/>\n    <text x=\"40\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">(a)</text>\n  </g>\n  \n  <g id=\"panel-b\" transform=\"translate(94,8)\">\n    <line x1=\"40\" y1=\"10\" x2=\"40\" y2=\"45\" stroke=\"#000\" stroke-width=\"1\"/>\n    <path d=\"M25,15 L55,15 M25,20 L55,20 M25,25 L55,25 M25,30 L55,30\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <path d=\"M25,15 L25,30 M55,15 L55,30\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <text x=\"40\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">(b)</text>\n  </g>\n  \n  <g id=\"panel-c\" transform=\"translate(180,8)\">\n    <line x1=\"40\" y1=\"10\" x2=\"40\" y2=\"45\" stroke=\"#000\" stroke-width=\"1\"/>\n    <path d=\"M30,15 L50,15 M25,20 L55,20 M25,25 L55,25 M30,30 L50,30\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <path d=\"M30,15 L25,20 L25,25 L30,30 M50,15 L55,20 L55,25 L50,30\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <text x=\"40\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">(c)</text>\n  </g>\n  \n  <g id=\"panel-d\" transform=\"translate(266,8)\">\n    <line x1=\"40\" y1=\"10\" x2=\"40\" y2=\"45\" stroke=\"#000\" stroke-width=\"1\"/>\n    <path d=\"M35,15 L45,15 M30,18 L50,18 M28,21 L52,21 M28,24 L52,24 M28,27 L52,27 M30,30 L50,30 M35,33 L45,33\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <path d=\"M35,15 L30,18 L28,21 L28,27 L30,30 L35,33 M45,15 L50,18 L52,21 L52,27 L50,30 L45,33\" \n          stroke=\"#0000FF\" stroke-width=\"1\" stroke-dasharray=\"2,2\" fill=\"none\"/>\n    <text x=\"40\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">(d)</text>\n  </g>\n  \n  <g id=\"panel-e\" transform=\"translate(352,8)\">\n    <line x1=\"40\" y1=\"10\" x2=\"40\" y2=\"45\" stroke=\"#000\" stroke-width=\"1\"/>\n    <line x1=\"20\" y1=\"22\" x2=\"60\" y2=\"22\" stroke=\"#0000FF\" stroke-width=\"3\"/>\n    <line x1=\"20\" y1=\"26\" x2=\"60\" y2=\"26\" stroke=\"#0000FF\" stroke-width=\"3\"/>\n    <text x=\"40\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">(e)</text>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const panels = document.querySelectorAll('g[id^=\"panel-\"]');\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n  \n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.tagName === 'svg') hidePopup();\n  });\n  \n  panels.forEach(panel => {\n    const panelId = panel.id.replace('panel-', '');\n    const shapes = panel.querySelectorAll('path, line:not(:first-child), circle');\n    \n    shapes.forEach(shape => {\n      shape.style.cursor = 'pointer';\n      \n      shape.addEventListener('mouseenter', e => {\n        tooltip.textContent = `Panel (${panelId}) - Geometric element`;\n        tooltip.style.display = 'block';\n        \n        if (shape.tagName === 'path') {\n          shape.style.strokeWidth = '2';\n          shape.style.strokeOpacity = '0.8';\n        } else if (shape.tagName === 'line' && shape.getAttribute('stroke') === '#0000FF') {\n          shape.style.strokeWidth = '4';\n        } else if (shape.tagName === 'circle') {\n          shape.style.r = '2';\n        }\n      });\n      \n      shape.addEventListener('mouseleave', e => {\n        tooltip.style.display = 'none';\n        \n        if (shape.tagName === 'path') {\n          shape.style.strokeWidth = '1';\n          shape.style.strokeOpacity = '1';\n        } else if (shape.tagName === 'line' && shape.getAttribute('stroke') === '#0000FF') {\n          shape.style.strokeWidth = '3';\n        } else if (shape.tagName === 'circle') {\n          shape.style.r = '1';\n        }\n      });\n      \n      shape.addEventListener('click', e => {\n        e.stopPropagation();\n        let description = '';\n        \n        switch(panelId) {\n          case 'a':\n            description = 'Initial state showing a vertical line with a single point. This represents the starting configuration before transformation.';\n            break;\n          case 'b':\n            description = 'First transformation showing horizontal dashed lines creating a rectangular pattern. The shape begins to expand from the central axis.';\n            break;\n          case 'c':\n            description = 'Symmetric expansion with tapered edges. The dashed lines form a diamond-like shape centered on the vertical axis.';\n            break;\n          case 'd':\n            description = 'Further evolution showing a more complex elliptical pattern. The shape reaches maximum expansion with curved boundaries.';\n            break;\n          case 'e':\n            description = 'Final state with bold horizontal lines. The transformation completes with solid, emphasized linear elements.';\n            break;\n        }\n        \n        showPopup(`Panel (${panelId})`, description);\n      });\n    });\n    \n    panel.addEventListener('click', e => {\n      if (e.target === panel || e.target.tagName === 'text' || e.target.tagName === 'line' && e.target.getAttribute('stroke') === '#000') {\n        e.stopPropagation();\n        let description = '';\n        \n        switch(panelId) {\n          case 'a':\n            description = 'Initial state showing a vertical line with a single point. This represents the starting configuration before transformation.';\n            break;\n          case 'b':\n            description = 'First transformation showing horizontal dashed lines creating a rectangular pattern. The shape begins to expand from the central axis.';\n            break;\n          case 'c':\n            description = 'Symmetric expansion with tapered edges. The dashed lines form a diamond-like shape centered on the vertical axis.';\n            break;\n          case 'd':\n            description = 'Further evolution showing a more complex elliptical pattern. The shape reaches maximum expansion with curved boundaries.';\n            break;\n          case 'e':\n            description = 'Final state with bold horizontal lines. The transformation completes with solid, emphasized linear elements.';\n            break;\n        }\n        \n        showPopup(`Panel (${panelId})`, description);\n      }\n    });\n  });\n  \n} catch(err) {\n  console.error('Interactive error:', err);\n}\n</script>\n</body>\n</html>",
