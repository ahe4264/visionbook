  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<div id=\"tooltip\"></div>\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n// Camera analysis from image:\n// x-axis→right, y-axis→up, z-axis→towards viewer\n// elevation ~30°, azimuth ~45°\n// camera.position.set(10,8,10)\n\n// Scene setup\nconst scene = new THREE.Scene();\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setClearColor(0xffffff, 1);\nrenderer.setPixelRatio(window.devicePixelRatio);\nrenderer.setSize(window.innerWidth, window.innerHeight);\ndocument.body.appendChild(renderer.domElement);\n\n// Orthographic camera\nconst aspect = window.innerWidth / window.innerHeight;\nconst d = 6;\nconst camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\ncamera.position.set(8, 6, 8);\ncamera.lookAt(0, 0, 0);\n\n// Ambient light only\nscene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\n// Controls\nconst controls = new THREE.OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\n\n// Create coordinate axes\nconst axisLength = 4;\nconst axisWidth = 2;\n\n// Z-axis (horizontal)\nconst zAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(0, 0, axisLength)\n]);\nconst zLine = new THREE.Line(zAxis, new THREE.LineBasicMaterial({color: 0x000000}));\nscene.add(zLine);\n\n// X-axis (diagonal right)\nconst xAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(axisLength*0.7, 0, -axisLength*0.7)\n]);\nconst xLine = new THREE.Line(xAxis, new THREE.LineBasicMaterial({color: 0x000000}));\nscene.add(xLine);\n\n// Y-axis (vertical)\nconst yAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, 0),\n    new THREE.Vector3(0, axisLength, 0)\n]);\nconst yLine = new THREE.Line(yAxis, new THREE.LineBasicMaterial({color: 0x000000}));\nscene.add(yLine);\n\n// Axis arrowheads\nconst arrSize = 0.2;\nconst arrGeom = new THREE.ConeGeometry(arrSize/2, arrSize, 4);\nconst arrMat = new THREE.MeshBasicMaterial({color: 0x000000});\n\nconst zArr = new THREE.Mesh(arrGeom, arrMat);\nzArr.position.set(0, 0, axisLength);\nzArr.rotation.x = Math.PI/2;\nscene.add(zArr);\n\nconst xArr = new THREE.Mesh(arrGeom, arrMat);\nxArr.position.set(axisLength*0.7, 0, -axisLength*0.7);\nxArr.rotation.z = -Math.PI/4;\nxArr.rotation.y = Math.PI/2;\nscene.add(xArr);\n\nconst yArr = new THREE.Mesh(arrGeom, arrMat);\nyArr.position.set(0, axisLength, 0);\nscene.add(yArr);\n\n// Projection plane (left gray plane)\nconst projPlaneGeom = new THREE.PlaneGeometry(2, 2);\nconst projPlaneMat = new THREE.MeshBasicMaterial({color: 0xcccccc, side: THREE.DoubleSide, transparent: true, opacity: 0.8});\nconst projPlane = new THREE.Mesh(projPlaneGeom, projPlaneMat);\nprojPlane.position.set(-2, 0, 0);\nprojPlane.rotation.y = Math.PI/2;\nscene.add(projPlane);\n\n// Projection plane edges\nconst projEdges = new THREE.EdgesGeometry(projPlaneGeom);\nconst projEdgeLines = new THREE.LineSegments(projEdges, new THREE.LineBasicMaterial({color: 0x333333}));\nprojEdgeLines.position.copy(projPlane.position);\nprojEdgeLines.rotation.copy(projPlane.rotation);\nscene.add(projEdgeLines);\n\n// Virtual camera plane (right transparent plane)\nconst virtPlaneGeom = new THREE.PlaneGeometry(2, 2);\nconst virtPlaneMat = new THREE.MeshBasicMaterial({color: 0xdddddd, side: THREE.DoubleSide, transparent: true, opacity: 0.4});\nconst virtPlane = new THREE.Mesh(virtPlaneGeom, virtPlaneMat);\nvirtPlane.position.set(2, 0, 0);\nvirtPlane.rotation.y = Math.PI/2;\nscene.add(virtPlane);\n\n// Virtual plane edges\nconst virtEdges = new THREE.EdgesGeometry(virtPlaneGeom);\nconst virtEdgeLines = new THREE.LineSegments(virtEdges, new THREE.LineBasicMaterial({color: 0x555555}));\nvirtEdgeLines.position.copy(virtPlane.position);\nvirtEdgeLines.rotation.copy(virtPlane.rotation);\nscene.add(virtEdgeLines);\n\n// Point P (world coordinate)\nconst pGeom = new THREE.SphereGeometry(0.15);\nconst pMat = new THREE.MeshBasicMaterial({color: 0x00cccc});\nconst pointP = new THREE.Mesh(pGeom, pMat);\npointP.position.set(3.5, 1, -1);\nscene.add(pointP);\n\n// Point p on projection plane\nconst smallPGeom = new THREE.SphereGeometry(0.1);\nconst smallPMat = new THREE.MeshBasicMaterial({color: 0x00cccc});\nconst pointSmallP = new THREE.Mesh(smallPGeom, smallPMat);\npointSmallP.position.set(-2, 0.57, -0.57);\nscene.add(pointSmallP);\n\n// Origin point (pinhole)\nconst originGeom = new THREE.SphereGeometry(0.08);\nconst originMat = new THREE.MeshBasicMaterial({color: 0x000000});\nconst origin = new THREE.Mesh(originGeom, originMat);\norigin.position.set(0, 0, 0);\nscene.add(origin);\n\n// Projection lines (red)\nconst projLine1Geom = new THREE.BufferGeometry().setFromPoints([\n    pointP.position,\n    origin.position\n]);\nconst projLine1 = new THREE.Line(projLine1Geom, new THREE.LineBasicMaterial({color: 0xff0000}));\nscene.add(projLine1);\n\nconst projLine2Geom = new THREE.BufferGeometry().setFromPoints([\n    origin.position,\n    pointSmallP.position\n]);\nconst projLine2 = new THREE.Line(projLine2Geom, new THREE.LineBasicMaterial({color: 0xff0000}));\nscene.add(projLine2);\n\n// Text labels using sprites\nfunction createTextSprite(text, fontSize = 20) {\n    const canvas = document.createElement('canvas');\n    const context = canvas.getContext('2d');\n    canvas.width = 256;\n    canvas.height = 64;\n    \n    context.font = fontSize + 'px Arial';\n    context.fillStyle = 'black';\n    context.textAlign = 'center';\n    context.fillText(text, 128, 32);\n    \n    const texture = new THREE.CanvasTexture(canvas);\n    const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n    const sprite = new THREE.Sprite(spriteMaterial);\n    sprite.scale.set(2, 0.5, 1);\n    return sprite;\n}\n\n// Add labels\nconst labelP = createTextSprite('P', 18);\nlabelP.position.set(3.5, 1.5, -1);\nscene.add(labelP);\n\nconst labelSmallP = createTextSprite('p', 18);\nlabelSmallP.position.set(-2, 0.9, -0.57);\nscene.add(labelSmallP);\n\nconst labelZ = createTextSprite('Z', 18);\nlabelZ.position.set(0.3, -0.3, axisLength + 0.5);\nscene.add(labelZ);\n\nconst labelXY = createTextSprite('X, x', 18);\nlabelXY.position.set(axisLength*0.7 + 0.5, -0.3, -axisLength*0.7 - 0.5);\nscene.add(labelXY);\n\nconst labelYY = createTextSprite('Y, y', 18);\nlabelYY.position.set(-0.5, axisLength + 0.3, 0);\nscene.add(labelYY);\n\nconst labelOrigin = createTextSprite('(0,0,0)', 14);\nlabelOrigin.position.set(-0.5, -0.5, 0.5);\nscene.add(labelOrigin);\n\nconst labelPinhole = createTextSprite('Pinhole', 16);\nlabelPinhole.position.set(0.5, -0.7, 0);\nscene.add(labelPinhole);\n\nconst labelWorld = createTextSprite('World coordinates', 16);\nlabelWorld.position.set(-0.5, axisLength - 0.5, 0);\nscene.add(labelWorld);\n\nconst labelProj = createTextSprite('Projection plane', 16);\nlabelProj.position.set(-2, -1.5, 0);\nscene.add(labelProj);\n\nconst labelVirt = createTextSprite('Virtual camera plane', 16);\nlabelVirt.position.set(2, -1.5, 0);\nscene.add(labelVirt);\n\nconst label_a = createTextSprite('(a)', 16);\nlabel_a.position.set(-3.5, -2.5, 2);\nscene.add(label_a);\n\n// Resize handler\nwindow.addEventListener('resize', () => {\n    const a = window.innerWidth / window.innerHeight;\n    camera.left = -d*a; \n    camera.right = d*a; \n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n});\n\n// Tooltip functionality\nconst tooltip = document.getElementById('tooltip');\nconst raycaster = new THREE.Raycaster();\nconst mouse = new THREE.Vector2();\n\ndocument.addEventListener('mousemove', e => {\n    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;\n    \n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Interactivity\nconst interactiveObjects = [\n    {obj: pointP, name: 'Point P', desc: 'World coordinate point in 3D space'},\n    {obj: pointSmallP, name: 'Point p', desc: 'Projection of P onto the image plane'},\n    {obj: origin, name: 'Pinhole (Origin)', desc: 'Center of projection at (0,0,0)'},\n    {obj: projPlane, name: 'Projection Plane', desc: 'Image plane where 3D points are projected'},\n    {obj: virtPlane, name: 'Virtual Camera Plane', desc: 'Virtual plane showing the camera view'}\n];\n\nlet hoveredObject = null;\n\n// Popup functions\nfunction showPopup(title, body) { \n    window.parent.postMessage({ type:'alex-popup', title, body }, '*'); \n}\nfunction hidePopup() { \n    window.parent.postMessage({ type:'alex-popup', title:null }, '*'); \n}\n\n// Click handler for popups\nrenderer.domElement.addEventListener('click', e => {\n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects(interactiveObjects.map(o => o.obj));\n    \n    if (intersects.length > 0) {\n        const clickedObj = interactiveObjects.find(o => o.obj === intersects[0].object);\n        if (clickedObj) {\n            if (clickedObj.name === 'Point P') {\n                showPopup('Point P', 'This represents a 3D point in world coordinates. In the pinhole camera model, light rays from this point pass through the pinhole and project onto the image plane, creating point p.');\n            } else if (clickedObj.name === 'Point p') {\n                showPopup('Point p', 'This is the 2D projection of point P on the image plane. The pinhole camera model shows how 3D world points map to 2D image coordinates through perspective projection.');\n            } else if (clickedObj.name === 'Pinhole (Origin)') {\n                showPopup('Pinhole', 'The pinhole acts as the center of projection. All light rays from 3D points pass through this single point before reaching the image plane, creating an inverted image.');\n            } else if (clickedObj.name === 'Projection Plane') {\n                showPopup('Projection Plane', 'The physical image plane where the inverted image forms. In a real camera, this would be where the film or sensor is placed.');\n            } else if (clickedObj.name === 'Virtual Camera Plane') {\n                showPopup('Virtual Camera Plane', 'A virtual plane in front of the pinhole that shows the non-inverted view. This mathematical convenience simplifies camera calculations.');\n            }\n            \n            // Animate projection\n            animateProjection();\n        }\n    } else {\n        hidePopup();\n    }\n});\n\n// Projection animation\nfunction animateProjection() {\n    projLine1.material.color = new THREE.Color(0xff6666);\n    projLine2.material.color = new THREE.Color(0xff6666);\n    projLine1.material.linewidth = 3;\n    projLine2.material.linewidth = 3;\n    \n    setTimeout(() => {\n        pointSmallP.material.color = new THREE.Color(0x66ffff);\n        pointP.material.color = new THREE.Color(0x66ffff);\n    }, 300);\n    \n    setTimeout(() => {\n        projLine1.material.color = new THREE.Color(0xff0000);\n        projLine2.material.color = new THREE.Color(0xff0000);\n        projLine1.material.linewidth = 1;\n        projLine2.material.linewidth = 1;\n        pointSmallP.material.color = new THREE.Color(0x00cccc);\n        pointP.material.color = new THREE.Color(0x00cccc);\n    }, 1200);\n}\n\n// Escape key handler\ndocument.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n});\n\n// Render loop\nfunction animate() {\n    requestAnimationFrame(animate);\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects(interactiveObjects.map(o => o.obj));\n    \n    if (intersects.length > 0) {\n        const hovered = interactiveObjects.find(o => o.obj === intersects[0].object);\n        if (hovered && hoveredObject !== hovered) {\n            hoveredObject = hovered;\n            tooltip.style.display = 'block';\n            tooltip.textContent = hovered.name + ' • ' + hovered.desc;\n            renderer.domElement.style.cursor = 'pointer';\n        }\n    } else {\n        if (hoveredObject) {\n            hoveredObject = null;\n            tooltip.style.display = 'none';\n            renderer.domElement.style.cursor = 'default';\n        }\n    }\n    \n    controls.update();\n    renderer.render(scene, camera);\n}\n\nanimate();\n\n} catch(e) {\n    console.error('Error in 3D scene:', e);\n    document.body.innerHTML = '<div style=\"padding:20px\">Error loading 3D scene</div>';\n}\n</script>\n</body>\n</html>",
