  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.filter { fill:#add8e6; stroke:#333; stroke-width:0.5; }\n.feature { fill:#ffe4e1; stroke:#333; stroke-width:0.5; }\n.grid-line { stroke:#666; stroke-width:0.3; }\n.label { font:11px sans-serif; fill:#000; }\n.dim-label { font:10px sans-serif; fill:#333; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 305 129\">\n  <!-- Filters (left) -->\n  <g id=\"filters\" transform=\"translate(25,30)\">\n    <!-- Stack of filter cubes -->\n    <g>\n      <!-- Back filter -->\n      <rect class=\"filter\" x=\"10\" y=\"10\" width=\"40\" height=\"40\"/>\n      <g class=\"grid-lines\">\n        <line class=\"grid-line\" x1=\"20\" y1=\"10\" x2=\"20\" y2=\"50\"/>\n        <line class=\"grid-line\" x1=\"30\" y1=\"10\" x2=\"30\" y2=\"50\"/>\n        <line class=\"grid-line\" x1=\"40\" y1=\"10\" x2=\"40\" y2=\"50\"/>\n        <line class=\"grid-line\" x1=\"10\" y1=\"20\" x2=\"50\" y2=\"20\"/>\n        <line class=\"grid-line\" x1=\"10\" y1=\"30\" x2=\"50\" y2=\"30\"/>\n        <line class=\"grid-line\" x1=\"10\" y1=\"40\" x2=\"50\" y2=\"40\"/>\n      </g>\n      <!-- Front filter -->\n      <rect class=\"filter\" x=\"0\" y=\"20\" width=\"40\" height=\"40\"/>\n      <g class=\"grid-lines\">\n        <line class=\"grid-line\" x1=\"10\" y1=\"20\" x2=\"10\" y2=\"60\"/>\n        <line class=\"grid-line\" x1=\"20\" y1=\"20\" x2=\"20\" y2=\"60\"/>\n        <line class=\"grid-line\" x1=\"30\" y1=\"20\" x2=\"30\" y2=\"60\"/>\n        <line class=\"grid-line\" x1=\"0\" y1=\"30\" x2=\"40\" y2=\"30\"/>\n        <line class=\"grid-line\" x1=\"0\" y1=\"40\" x2=\"40\" y2=\"40\"/>\n        <line class=\"grid-line\" x1=\"0\" y1=\"50\" x2=\"40\" y2=\"50\"/>\n      </g>\n      <!-- Depth lines -->\n      <line stroke=\"#333\" stroke-width=\"0.5\" x1=\"0\" y1=\"20\" x2=\"10\" y2=\"10\"/>\n      <line stroke=\"#333\" stroke-width=\"0.5\" x1=\"40\" y1=\"20\" x2=\"50\" y2=\"10\"/>\n      <line stroke=\"#333\" stroke-width=\"0.5\" x1=\"0\" y1=\"60\" x2=\"10\" y2=\"50\"/>\n      <line stroke=\"#333\" stroke-width=\"0.5\" x1=\"40\" y1=\"60\" x2=\"50\" y2=\"50\"/>\n    </g>\n    <!-- Labels -->\n    <text class=\"label\" x=\"20\" y=\"0\">w</text>\n    <text class=\"dim-label\" x=\"0\" y=\"75\">C<tspan dy=\"3\" font-size=\"8\">in</tspan></text>\n    <text class=\"dim-label\" x=\"-10\" y=\"40\" text-anchor=\"end\">C<tspan dy=\"3\" font-size=\"8\">out</tspan></text>\n    <text class=\"dim-label\" x=\"20\" y=\"90\" text-anchor=\"middle\">filters</text>\n    <text class=\"dim-label\" x=\"20\" y=\"-15\" text-anchor=\"middle\">K</text>\n    <text class=\"dim-label\" x=\"-15\" y=\"65\" text-anchor=\"middle\" transform=\"rotate(-90,-15,65)\">K</text>\n  </g>\n\n  <!-- Plus sign -->\n  <text class=\"label\" x=\"85\" y=\"60\" font-size=\"18\" text-anchor=\"middle\">+</text>\n\n  <!-- Input feature map (middle) -->\n  <g id=\"input\" transform=\"translate(110,25)\">\n    <rect class=\"feature\" x=\"0\" y=\"0\" width=\"60\" height=\"60\"/>\n    <g class=\"grid-lines\">\n      <line class=\"grid-line\" x1=\"12\" y1=\"0\" x2=\"12\" y2=\"60\"/>\n      <line class=\"grid-line\" x1=\"24\" y1=\"0\" x2=\"24\" y2=\"60\"/>\n      <line class=\"grid-line\" x1=\"36\" y1=\"0\" x2=\"36\" y2=\"60\"/>\n      <line class=\"grid-line\" x1=\"48\" y1=\"0\" x2=\"48\" y2=\"60\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"12\" x2=\"60\" y2=\"12\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"24\" x2=\"60\" y2=\"24\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"36\" x2=\"60\" y2=\"36\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"48\" x2=\"60\" y2=\"48\"/>\n    </g>\n    <text class=\"label\" x=\"30\" y=\"-5\" text-anchor=\"middle\">x<tspan dy=\"3\" font-size=\"8\">in</tspan></text>\n    <text class=\"dim-label\" x=\"30\" y=\"75\" text-anchor=\"middle\">M</text>\n    <text class=\"dim-label\" x=\"-5\" y=\"30\" text-anchor=\"end\">C<tspan dy=\"3\" font-size=\"8\">in</tspan></text>\n  </g>\n\n  <!-- Equals sign -->\n  <text class=\"label\" x=\"190\" y=\"60\" font-size=\"18\" text-anchor=\"middle\">=</text>\n\n  <!-- Output feature map (right) -->\n  <g id=\"output\" transform=\"translate(210,25)\">\n    <rect class=\"feature\" x=\"0\" y=\"0\" width=\"70\" height=\"70\"/>\n    <g class=\"grid-lines\">\n      <line class=\"grid-line\" x1=\"14\" y1=\"0\" x2=\"14\" y2=\"70\"/>\n      <line class=\"grid-line\" x1=\"28\" y1=\"0\" x2=\"28\" y2=\"70\"/>\n      <line class=\"grid-line\" x1=\"42\" y1=\"0\" x2=\"42\" y2=\"70\"/>\n      <line class=\"grid-line\" x1=\"56\" y1=\"0\" x2=\"56\" y2=\"70\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"14\" x2=\"70\" y2=\"14\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"28\" x2=\"70\" y2=\"28\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"42\" x2=\"70\" y2=\"42\"/>\n      <line class=\"grid-line\" x1=\"0\" y1=\"56\" x2=\"70\" y2=\"56\"/>\n    </g>\n    <text class=\"label\" x=\"35\" y=\"-5\" text-anchor=\"middle\">x<tspan dy=\"3\" font-size=\"8\">out</tspan></text>\n    <text class=\"dim-label\" x=\"35\" y=\"85\" text-anchor=\"middle\">N</text>\n    <text class=\"dim-label\" x=\"85\" y=\"35\">C<tspan dy=\"3\" font-size=\"8\">out</tspan></text>\n  </g>\n</svg>\n<div class=\"tooltip\" id=\"tt\"></div>\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tt = document.getElementById('tt');\nconst filters = document.getElementById('filters');\nconst input = document.getElementById('input');\nconst output = document.getElementById('output');\n\n// Connectivity\nconst elements = {\n  'filters': { label: 'Convolutional Filters', desc: 'C_out filters of size K×K×C_in', next: ['output'] },\n  'input': { label: 'Input Feature Map', desc: 'Size: M×M×C_in channels', next: ['output'] },\n  'output': { label: 'Output Feature Map', desc: 'Size: N×N×C_out channels', next: [] }\n};\n\n// Tooltip tracking\ndocument.addEventListener('mousemove', e => {\n  if (tt.style.display === 'block') {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  }\n});\n\n// Hover handlers\nfunction addHover(el, key) {\n  el.addEventListener('mouseenter', () => {\n    el.style.opacity = '0.85';\n    const data = elements[key];\n    tt.innerHTML = `${data.label} — ${data.desc}`;\n    tt.style.display = 'block';\n  });\n  \n  el.addEventListener('mouseleave', () => {\n    el.style.opacity = '1';\n    tt.style.display = 'none';\n  });\n  \n  el.addEventListener('click', e => {\n    e.stopPropagation();\n    const data = elements[key];\n    showPopup(data.label, `<p>${data.desc}</p><p>In convolution, ${key === 'filters' ? 'these filters slide across the input feature map' : key === 'input' ? 'this is convolved with the filters' : 'this is the result of the convolution operation'}.</p>`);\n  });\n}\n\naddHover(filters, 'filters');\naddHover(input, 'input');\naddHover(output, 'output');\n\n// Popup communication\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
