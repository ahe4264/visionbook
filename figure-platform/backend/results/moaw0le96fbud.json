{
  "id": "moaw0le96fbud",
  "filename": "figure_5",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        body, html {\n            margin: 0;\n            padding: 0;\n            background: #ffffff;\n            font-family: sans-serif;\n            font-size: 12px;\n            overflow: hidden;\n            width: 100%;\n            height: 100%;\n        }\n        \n        #container {\n            padding: 12px;\n            width: calc(100% - 24px);\n            height: calc(100% - 24px);\n            position: relative;\n        }\n        \n        svg {\n            width: 100%;\n            height: 100%;\n        }\n        \n        .nn-block {\n            fill: #4db5b5;\n            stroke: #333;\n            stroke-width: 1;\n            cursor: pointer;\n            transition: all 0.2s;\n        }\n        \n        .nn-block:hover {\n            fill: #5cc5c5;\n            stroke-width: 2;\n        }\n        \n        .arrow {\n            stroke: #333;\n            stroke-width: 1;\n            fill: none;\n            marker-end: url(#arrowhead);\n        }\n        \n        .loop-arrow {\n            stroke: #d00;\n            stroke-width: 1;\n            fill: none;\n            marker-end: url(#arrowhead-red);\n        }\n        \n        .label {\n            font-size: 11px;\n            fill: #000;\n            font-family: sans-serif;\n        }\n        \n        .word-label {\n            font-size: 11px;\n            fill: #000;\n            text-anchor: middle;\n            font-family: sans-serif;\n        }\n        \n        .side-label {\n            font-size: 11px;\n            fill: #000;\n            text-anchor: end;\n            font-family: sans-serif;\n        }\n        \n        .tooltip {\n            position: fixed;\n            background: #111;\n            color: #fff;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 8px;\n            border-radius: 4px;\n            pointer-events: none;\n            z-index: 100;\n            max-width: 200px;\n            display: none;\n        }\n        \n        .popup {\n            position: fixed;\n            background: #fff;\n            border: 1px solid #ddd;\n            border-radius: 6px;\n            padding: 10px 12px;\n            font: 12px/1.5 sans-serif;\n            color: #222;\n            z-index: 101;\n            box-shadow: 0 2px 12px rgba(0,0,0,0.15);\n            max-width: 220px;\n            display: none;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"container\">\n        <svg viewBox=\"0 0 700 200\" preserveAspectRatio=\"xMidYMid meet\">\n            <defs>\n                <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" \n                        refX=\"9\" refY=\"3.5\" orient=\"auto\">\n                    <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#333\"/>\n                </marker>\n                <marker id=\"arrowhead-red\" markerWidth=\"10\" markerHeight=\"7\" \n                        refX=\"9\" refY=\"3.5\" orient=\"auto\">\n                    <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#d00\"/>\n                </marker>\n            </defs>\n            \n            <!-- Side labels -->\n            <text x=\"80\" y=\"30\" class=\"side-label\">Outputs</text>\n            <text x=\"80\" y=\"90\" class=\"side-label\">Identical neural</text>\n            <text x=\"80\" y=\"102\" class=\"side-label\">networks</text>\n            <text x=\"80\" y=\"155\" class=\"side-label\">Word</text>\n            <text x=\"80\" y=\"167\" class=\"side-label\">embeddings</text>\n            \n            <!-- Neural network blocks and connections -->\n            <g id=\"nn-sequence\">\n                <!-- Block 1 -->\n                <rect x=\"120\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"1\"/>\n                <path d=\"M150 180 L150 120\" class=\"arrow\"/>\n                <path d=\"M150 60 L150 20\" class=\"arrow\"/>\n                <path d=\"M180 80 Q200 80 200 100 Q200 120 180 120 L180 115\" class=\"loop-arrow\"/>\n                <text x=\"150\" y=\"195\" class=\"word-label\">It</text>\n                \n                <!-- Block 2 -->\n                <rect x=\"220\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"2\"/>\n                <path d=\"M250 180 L250 120\" class=\"arrow\"/>\n                <path d=\"M250 60 L250 20\" class=\"arrow\"/>\n                <path d=\"M280 80 Q300 80 300 100 Q300 120 280 120 L280 115\" class=\"loop-arrow\"/>\n                <path d=\"M180 90 L220 90\" class=\"arrow\"/>\n                <text x=\"250\" y=\"195\" class=\"word-label\">takes</text>\n                \n                <!-- Block 3 -->\n                <rect x=\"320\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"3\"/>\n                <path d=\"M350 180 L350 120\" class=\"arrow\"/>\n                <path d=\"M350 60 L350 20\" class=\"arrow\"/>\n                <path d=\"M380 80 Q400 80 400 100 Q400 120 380 120 L380 115\" class=\"loop-arrow\"/>\n                <path d=\"M280 90 L320 90\" class=\"arrow\"/>\n                <text x=\"350\" y=\"195\" class=\"word-label\">great</text>\n                \n                <!-- Block 4 -->\n                <rect x=\"420\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"4\"/>\n                <path d=\"M450 180 L450 120\" class=\"arrow\"/>\n                <path d=\"M450 60 L450 20\" class=\"arrow\"/>\n                <path d=\"M480 80 Q500 80 500 100 Q500 120 480 120 L480 115\" class=\"loop-arrow\"/>\n                <path d=\"M380 90 L420 90\" class=\"arrow\"/>\n                <text x=\"450\" y=\"195\" class=\"word-label\">personal</text>\n                \n                <!-- Block 5 -->\n                <rect x=\"520\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"5\"/>\n                <path d=\"M550 180 L550 120\" class=\"arrow\"/>\n                <path d=\"M550 60 L550 20\" class=\"arrow\"/>\n                <path d=\"M580 80 Q600 80 600 100 Q600 120 580 120 L580 115\" class=\"loop-arrow\"/>\n                <path d=\"M480 90 L520 90\" class=\"arrow\"/>\n                <text x=\"550\" y=\"195\" class=\"word-label\">courage</text>\n                \n                <!-- Block 6 -->\n                <rect x=\"620\" y=\"60\" width=\"60\" height=\"60\" class=\"nn-block\" data-block=\"6\"/>\n                <path d=\"M650 180 L650 120\" class=\"arrow\"/>\n                <path d=\"M650 60 L650 20\" class=\"arrow\"/>\n                <path d=\"M580 90 L620 90\" class=\"arrow\"/>\n                <text x=\"650\" y=\"195\" class=\"word-label\">to</text>\n            </g>\n        </svg>\n    </div>\n    \n    <div id=\"tooltip\" class=\"tooltip\"></div>\n    <div id=\"popup\" class=\"popup\"></div>\n    \n    <script>\n        const tooltip = document.getElementById('tooltip');\n        const popup = document.getElementById('popup');\n        const blocks = document.querySelectorAll('.nn-block');\n        \n        // Tooltip functionality\n        blocks.forEach(block => {\n            block.addEventListener('mouseenter', function(e) {\n                const blockNum = this.getAttribute('data-block');\n                const word = this.parentElement.querySelector(`text[x=\"${parseInt(this.getAttribute('x')) + 30}\"]`).textContent;\n                tooltip.textContent = `Processing word \"${word}\" through shared RNN weights`;\n                tooltip.style.display = 'block';\n            });\n            \n            block.addEventListener('mousemove', function(e) {\n                tooltip.style.left = (e.clientX + 10) + 'px';\n                tooltip.style.top = (e.clientY - 30) + 'px';\n            });\n            \n            block.addEventListener('mouseleave', function() {\n                tooltip.style.display = 'none';\n            });\n            \n            // Popup functionality\n            block.addEventListener('click', function(e) {\n                const blockNum = this.getAttribute('data-block');\n                const rect = this.getBoundingClientRect();\n                \n                popup.innerHTML = `\n                    <strong>Recurrent Neural Network</strong><br>\n                    This block shares the same weights as all other blocks. \n                    The red loop allows information from previous words to influence \n                    the processing of the current word, creating memory across the sequence.\n                `;\n                \n                popup.style.display = 'block';\n                popup.style.left = (rect.left + rect.width/2 - 110) + 'px';\n                popup.style.top = (rect.top - 80) + 'px';\n                \n                e.stopPropagation();\n            });\n        });\n        \n        // Close popup on click outside or escape\n        document.addEventListener('click', function() {\n            popup.style.display = 'none';\n        });\n        \n        document.addEventListener('keydown', function(e) {\n            if (e.key === 'Escape') {\n                popup.style.display = 'none';\n            }\n        });\n        \n        popup.addEventListener('click', function(e) {\n            e.stopPropagation();\n        });\n    </script>\n</body>\n</html>",
