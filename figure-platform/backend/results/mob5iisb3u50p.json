  "filename": "figure_48",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { cursor: default; }\n.node { transition: all 0.15s ease; cursor: pointer; }\n.edge { transition: all 0.15s ease; cursor: pointer; }\n.node:hover { stroke-width: 2.5px; }\n.edge:hover { stroke-width: 2px; stroke: #e07b30; }\n.panel-label { font: bold 14px sans-serif; fill: #000; }\n.node-label { font: 12px sans-serif; fill: #000; text-anchor: middle; dominant-baseline: central; pointer-events: none; }\n.edge-label { font: 10px sans-serif; fill: #d2691e; text-anchor: middle; dominant-baseline: central; pointer-events: none; }\n.tooltip { position: fixed; background: rgba(22,22,22,0.88); backdrop-filter: blur(6px); color: #f0f0f0; font: 11px/1.4 sans-serif; padding: 5px 9px; border-radius: 5px; border: 1px solid rgba(255,255,255,0.1); pointer-events: none; z-index: 100; max-width: 240px; display: none; }\n.popup { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(246,246,246,0.97); backdrop-filter: blur(8px); border-top: 1px solid rgba(0,0,0,0.07); padding: 10px 14px; font: 12px/1.6 sans-serif; color: #1a1a1a; z-index: 101; display: none; }\n</style>\n</head>\n<body>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\">\n  <div id=\"popup-content\"></div>\n  <div style=\"margin-top:8px; font-size:10px; color:#666;\">Press Escape to close</div>\n</div>\n\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 495 162\">\n  <defs>\n    <marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n\n  <!-- Panel a) -->\n  <text x=\"18\" y=\"25\" class=\"panel-label\">a)</text>\n  \n  <!-- Panel a) nodes -->\n  <circle cx=\"50\" cy=\"45\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"a-x\" data-panel=\"a\"/>\n  <text x=\"50\" y=\"45\" class=\"node-label\">x</text>\n  \n  <circle cx=\"120\" cy=\"25\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"a-h1\" data-panel=\"a\"/>\n  <text x=\"120\" y=\"25\" class=\"node-label\">h₁</text>\n  \n  <circle cx=\"120\" cy=\"55\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"a-h2\" data-panel=\"a\"/>\n  <text x=\"120\" y=\"55\" class=\"node-label\">h₂</text>\n  \n  <circle cx=\"120\" cy=\"85\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"a-h3\" data-panel=\"a\"/>\n  <text x=\"120\" y=\"85\" class=\"node-label\">h₃</text>\n  \n  <circle cx=\"190\" cy=\"55\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"a-y\" data-panel=\"a\"/>\n  <text x=\"190\" y=\"55\" class=\"node-label\">y</text>\n\n  <!-- Panel a) edges with weight labels -->\n  <line x1=\"62\" y1=\"40\" x2=\"108\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-x\" data-to=\"a-h1\" data-panel=\"a\"/>\n  <text x=\"85\" y=\"32\" class=\"edge-label\">θ₁</text>\n  \n  <line x1=\"62\" y1=\"50\" x2=\"108\" y2=\"55\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-x\" data-to=\"a-h2\" data-panel=\"a\"/>\n  <text x=\"85\" y=\"55\" class=\"edge-label\">θ₂</text>\n  \n  <line x1=\"62\" y1=\"60\" x2=\"108\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-x\" data-to=\"a-h3\" data-panel=\"a\"/>\n  <text x=\"85\" y=\"73\" class=\"edge-label\">θ₃</text>\n\n  <line x1=\"132\" y1=\"30\" x2=\"178\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-h1\" data-to=\"a-y\" data-panel=\"a\"/>\n  <text x=\"155\" y=\"37\" class=\"edge-label\">φ₁</text>\n  \n  <line x1=\"132\" y1=\"55\" x2=\"178\" y2=\"55\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-h2\" data-to=\"a-y\" data-panel=\"a\"/>\n  <text x=\"155\" y=\"52\" class=\"edge-label\">φ₂</text>\n  \n  <line x1=\"132\" y1=\"80\" x2=\"178\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"a-h3\" data-to=\"a-y\" data-panel=\"a\"/>\n  <text x=\"155\" y=\"73\" class=\"edge-label\">φ₃</text>\n\n  <!-- Panel b) -->\n  <text x=\"268\" y=\"25\" class=\"panel-label\">b)</text>\n  \n  <!-- Panel b) nodes -->\n  <circle cx=\"300\" cy=\"55\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"b-x\" data-panel=\"b\"/>\n  <text x=\"300\" y=\"55\" class=\"node-label\">x</text>\n  \n  <circle cx=\"370\" cy=\"35\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"b-h1\" data-panel=\"b\"/>\n  <text x=\"370\" y=\"35\" class=\"node-label\">h₁</text>\n  \n  <circle cx=\"370\" cy=\"55\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"b-h2\" data-panel=\"b\"/>\n  <text x=\"370\" y=\"55\" class=\"node-label\">h₂</text>\n  \n  <circle cx=\"370\" cy=\"75\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"b-h3\" data-panel=\"b\"/>\n  <text x=\"370\" y=\"75\" class=\"node-label\">h₃</text>\n  \n  <circle cx=\"440\" cy=\"55\" r=\"12\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-id=\"b-y\" data-panel=\"b\"/>\n  <text x=\"440\" y=\"55\" class=\"node-label\">y</text>\n\n  <!-- Panel b) edges without weight labels -->\n  <line x1=\"312\" y1=\"50\" x2=\"358\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-x\" data-to=\"b-h1\" data-panel=\"b\"/>\n  <line x1=\"312\" y1=\"55\" x2=\"358\" y2=\"55\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-x\" data-to=\"b-h2\" data-panel=\"b\"/>\n  <line x1=\"312\" y1=\"60\" x2=\"358\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-x\" data-to=\"b-h3\" data-panel=\"b\"/>\n\n  <line x1=\"382\" y1=\"40\" x2=\"428\" y2=\"50\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-h1\" data-to=\"b-y\" data-panel=\"b\"/>\n  <line x1=\"382\" y1=\"55\" x2=\"428\" y2=\"55\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-h2\" data-to=\"b-y\" data-panel=\"b\"/>\n  <line x1=\"382\" y1=\"70\" x2=\"428\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-from=\"b-h3\" data-to=\"b-y\" data-panel=\"b\"/>\n</svg>\n\n<script>\ntry {\n  const graph = {\n    'a-x': { out: ['a-h1', 'a-h2', 'a-h3'], label: 'Input node x', desc: 'Input layer that receives the initial data and distributes it to hidden units with learned weights θ₁, θ₂, θ₃.' },\n    'a-h1': { out: ['a-y'], in: ['a-x'], label: 'Hidden unit h₁', desc: 'First hidden unit that processes input x with weight θ₁ and outputs to y with weight φ₁.' },\n    'a-h2': { out: ['a-y'], in: ['a-x'], label: 'Hidden unit h₂', desc: 'Second hidden unit that processes input x with weight θ₂ and outputs to y with weight φ₂.' },\n    'a-h3': { out: ['a-y'], in: ['a-x'], label: 'Hidden unit h₃', desc: 'Third hidden unit that processes input x with weight θ₃ and outputs to y with weight φ₃.' },\n    'a-y': { in: ['a-h1', 'a-h2', 'a-h3'], label: 'Output node y', desc: 'Output layer that combines signals from all hidden units using weights φ₁, φ₂, φ₃ to produce final result.' },\n    'b-x': { out: ['b-h1', 'b-h2', 'b-h3'], label: 'Input node x', desc: 'Input layer that distributes data to hidden units in the simplified network representation.' },\n    'b-h1': { out: ['b-y'], in: ['b-x'], label: 'Hidden unit h₁', desc: 'First hidden unit in the simplified network without explicit weight labels.' },\n    'b-h2': { out: ['b-y'], in: ['b-x'], label: 'Hidden unit h₂', desc: 'Second hidden unit in the simplified network without explicit weight labels.' },\n    'b-h3': { out: ['b-y'], in: ['b-x'], label: 'Hidden unit h₃', desc: 'Third hidden unit in the simplified network without explicit weight labels.' },\n    'b-y': { in: ['b-h1', 'b-h2', 'b-h3'], label: 'Output node y', desc: 'Output layer that combines hidden unit outputs in the simplified representation.' }\n  };\n\n  const tooltip = document.getElementById('tooltip');\n  const popup = document.getElementById('popup');\n  const popupContent = document.getElementById('popup-content');\n\n  function showTooltip(e, text) {\n    tooltip.textContent = text;\n    tooltip.style.display = 'block';\n    tooltip.style.left = (e.clientX + 10) + 'px';\n    tooltip.style.top = (e.clientY + 10) + 'px';\n  }\n\n  function hideTooltip() {\n    tooltip.style.display = 'none';\n  }\n\n  function showPopup(nodeId) {\n    const nodeInfo = graph[nodeId];\n    if (!nodeInfo) return;\n    \n    popupContent.innerHTML = `\n      <div style=\"font-weight:bold; margin-bottom:6px;\">${nodeInfo.label}</div>\n      <div>${nodeInfo.desc}</div>\n    `;\n    popup.style.display = 'block';\n  }\n\n  function hidePopup() {\n    popup.style.display = 'none';\n  }\n\n  function highlightConnectedEdges(nodeId, highlight) {\n    const nodeInfo = graph[nodeId];\n    if (!nodeInfo) return;\n\n    const connectedEdges = [];\n    \n    if (nodeInfo.out) {\n      nodeInfo.out.forEach(targetId => {\n        const edge = document.querySelector(`[data-from=\"${nodeId}\"][data-to=\"${targetId}\"]`);\n        if (edge) connectedEdges.push(edge);\n      });\n    }\n    \n    if (nodeInfo.in) {\n      nodeInfo.in.forEach(sourceId => {\n        const edge = document.querySelector(`[data-from=\"${sourceId}\"][data-to=\"${nodeId}\"]`);\n        if (edge) connectedEdges.push(edge);\n      });\n    }\n\n    connectedEdges.forEach(edge => {\n      if (highlight) {\n        edge.style.stroke = '#e07b30';\n        edge.style.strokeWidth = '2px';\n      } else {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1px';\n      }\n    });\n  }\n\n  function animateSignalFlow(nodeId) {\n    const nodeInfo = graph[nodeId];\n    if (!nodeInfo || !nodeInfo.out) return;\n\n    // Reset all edges first\n    document.querySelectorAll('.edge').forEach(edge => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1px';\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n    });\n\n    // Animate outgoing edges\n    nodeInfo.out.forEach((targetId, index) => {\n      const edge = document.querySelector(`[data-from=\"${nodeId}\"][data-to=\"${targetId}\"]`);\n      if (!edge) return;\n\n      setTimeout(() => {\n        const edgeLength = Math.sqrt(\n          Math.pow(edge.x2.baseVal.value - edge.x1.baseVal.value, 2) +\n          Math.pow(edge.y2.baseVal.value - edge.y1.baseVal.value, 2)\n        );\n\n        edge.style.strokeDasharray = edgeLength;\n        edge.style.strokeDashoffset = edgeLength;\n        edge.style.transition = 'stroke-dashoffset 0.4s ease';\n        edge.style.stroke = '#4a7ef5';\n        edge.style.strokeWidth = '2px';\n\n        requestAnimationFrame(() => {\n          edge.style.strokeDashoffset = '0';\n        });\n\n        // Pulse target node\n        setTimeout(() => {\n          const targetNode = document.querySelector(`[data-id=\"${targetId}\"]`);\n          if (targetNode) {\n            targetNode.style.transform = 'scale(1.15)';\n            setTimeout(() => {\n              targetNode.style.transform = 'scale(1)';\n            }, 200);\n          }\n        }, 400);\n\n      }, index * 100);\n    });\n\n    // Reset after animation completes\n    setTimeout(() => {\n      document.querySelectorAll('.edge').forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1px';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n        edge.style.transition = 'all 0.15s ease';\n      });\n    }, 1500);\n  }\n\n  // Node interactions\n  document.querySelectorAll('.node').forEach(node => {\n    node.addEventListener('mouseenter', (e) => {\n      const nodeId = node.getAttribute('data-id');\n      const nodeInfo = graph[nodeId];\n      if (nodeInfo) {\n        showTooltip(e, nodeInfo.label);\n        highlightConnectedEdges(nodeId, true);\n      }\n    });\n\n    node.addEventListener('mouseleave', () => {\n      hideTooltip();\n      const nodeId = node.getAttribute('data-id');\n      highlightConnectedEdges(nodeId, false);\n    });\n\n    node.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY + 10) + 'px';\n    });\n\n    node.addEventListener('click', () => {\n      const nodeId = node.getAttribute('data-id');\n      showPopup(nodeId);\n      animateSignalFlow(nodeId);\n    });\n  });\n\n  // Edge interactions\n  document.querySelectorAll('.edge').forEach(edge => {\n    edge.addEventListener('mouseenter', (e) => {\n      const from = edge.getAttribute('data-from');\n      const to = edge.getAttribute('data-to');\n      const fromInfo = graph[from];\n      const toInfo = graph[to];\n      if (fromInfo && toInfo) {\n        showTooltip(e, `${fromInfo.label} → ${toInfo.label}`);\n      }\n    });\n\n    edge.addEventListener('mouseleave', () => {\n      hideTooltip();\n    });\n\n    edge.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY + 10) + 'px';\n    });\n  });\n\n  // Close popup handlers\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      hidePopup();\n    }\n  });\n\n  document.addEventListener('click', (e) => {\n    if (!popup.contains(e.target) && !e.target.classList.contains('node')) {\n      hidePopup();\n    }\n  });\n\n} catch (error) {\n  console.error('Error in neural network diagram:', error);\n}\n</script>\n\n</body>\n</html>",
