  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { fill:#fff; stroke:#000; stroke-width:1.5px; cursor:pointer; }\n.edge { fill:none; stroke:#000; stroke-width:1px; }\n.label { font:12px sans-serif; text-anchor:middle; pointer-events:none; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 260 144\">\n<defs>\n<marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n<path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n</marker>\n</defs>\n<g id=\"edges\">\n<line class=\"edge\" x1=\"60\" y1=\"42\" x2=\"110\" y2=\"32\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h1\"/>\n<line class=\"edge\" x1=\"60\" y1=\"42\" x2=\"110\" y2=\"72\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h2\"/>\n<line class=\"edge\" x1=\"60\" y1=\"42\" x2=\"110\" y2=\"112\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"h3\"/>\n<line class=\"edge\" x1=\"60\" y1=\"102\" x2=\"110\" y2=\"32\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h1\"/>\n<line class=\"edge\" x1=\"60\" y1=\"102\" x2=\"110\" y2=\"72\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h2\"/>\n<line class=\"edge\" x1=\"60\" y1=\"102\" x2=\"110\" y2=\"112\" marker-end=\"url(#arr)\" data-from=\"x2\" data-to=\"h3\"/>\n<line class=\"edge\" x1=\"140\" y1=\"32\" x2=\"190\" y2=\"72\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\"/>\n<line class=\"edge\" x1=\"140\" y1=\"72\" x2=\"190\" y2=\"72\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\"/>\n<line class=\"edge\" x1=\"140\" y1=\"112\" x2=\"190\" y2=\"72\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\"/>\n</g>\n<g id=\"nodes\">\n<circle class=\"node\" cx=\"45\" cy=\"42\" r=\"15\" data-id=\"x1\"/>\n<text class=\"label\" x=\"45\" y=\"47\">x₁</text>\n<circle class=\"node\" cx=\"45\" cy=\"102\" r=\"15\" data-id=\"x2\"/>\n<text class=\"label\" x=\"45\" y=\"107\">x₂</text>\n<circle class=\"node\" cx=\"125\" cy=\"32\" r=\"15\" data-id=\"h1\"/>\n<text class=\"label\" x=\"125\" y=\"37\">h₁</text>\n<circle class=\"node\" cx=\"125\" cy=\"72\" r=\"15\" data-id=\"h2\"/>\n<text class=\"label\" x=\"125\" y=\"77\">h₂</text>\n<circle class=\"node\" cx=\"125\" cy=\"112\" r=\"15\" data-id=\"h3\"/>\n<text class=\"label\" x=\"125\" y=\"117\">h₃</text>\n<circle class=\"node\" cx=\"215\" cy=\"72\" r=\"15\" data-id=\"y\"/>\n<text class=\"label\" x=\"215\" y=\"77\">y</text>\n</g>\n</svg>\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\nconst graph = {\n  'x1': { out:['h1','h2','h3'], in:[], label:'x₁', role:'Input 1' },\n  'x2': { out:['h1','h2','h3'], in:[], label:'x₂', role:'Input 2' },\n  'h1': { out:['y'], in:['x1','x2'], label:'h₁', role:'Hidden unit 1' },\n  'h2': { out:['y'], in:['x1','x2'], label:'h₂', role:'Hidden unit 2' },\n  'h3': { out:['y'], in:['x1','x2'], label:'h₃', role:'Hidden unit 3' },\n  'y': { out:[], in:['h1','h2','h3'], label:'y', role:'Output' }\n};\n\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    node.style.strokeWidth = '3px';\n    node.style.fillOpacity = '0.9';\n    \n    edges.forEach(edge => {\n      if (edge.getAttribute('data-from') === id) {\n        edge.style.stroke = '#e07b30';\n        edge.style.strokeWidth = '2px';\n      }\n    });\n    \n    tooltip.textContent = `${info.label} — ${info.role}`;\n    tooltip.style.display = 'block';\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    node.style.strokeWidth = '1.5px';\n    node.style.fillOpacity = '1';\n    edges.forEach(edge => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1px';\n    });\n    tooltip.style.display = 'none';\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    const body = `This is ${info.label}, a ${info.role.toLowerCase()}. It has ${info.in.length} incoming connections and ${info.out.length} outgoing connections.`;\n    showPopup(info.role, body);\n    \n    // Animate signal flow\n    const isBackward = e.shiftKey;\n    const color = isBackward ? '#e05050' : '#4a7ef5';\n    \n    if (!isBackward) {\n      // Forward pass\n      animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'x1' || e.getAttribute('data-from') === 'x2'), color, 0);\n      animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from').startsWith('h')), color, 650);\n      \n      // Pulse hidden nodes\n      setTimeout(() => {\n        ['h1','h2','h3'].forEach(hid => {\n          const n = document.querySelector(`[data-id=\"${hid}\"]`);\n          n.style.transformBox = 'fill-box';\n          n.style.transformOrigin = 'center';\n          n.style.transition = 'transform 0.15s ease';\n          n.style.transform = 'scale(1.18)';\n          setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n        });\n      }, 350);\n      \n      // Pulse output\n      setTimeout(() => {\n        const n = document.querySelector('[data-id=\"y\"]');\n        n.style.transformBox = 'fill-box';\n        n.style.transformOrigin = 'center';\n        n.style.transition = 'transform 0.15s ease';\n        n.style.transform = 'scale(1.18)';\n        setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n      }, 1000);\n    }\n    \n    setTimeout(() => {\n      edges.forEach(e => {\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n      });\n    }, 2000);\n  });\n});\n\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2px';\n  });\n  \n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1px';\n  });\n});\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.6s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
