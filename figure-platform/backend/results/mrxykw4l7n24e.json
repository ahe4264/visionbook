  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Figure</title>\n\n  <!-- Blocking CDN scripts — no async/defer; must be ready before body <script> runs -->\n  <script src=\"https://cdn.jsdelivr.net/npm/@svgdotjs/svg.js@3/dist/svg.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n\n  <style>\n    /* ── Reset ───────────────────────────────────────────────────────────── */\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    /* ── Figure mount point ──────────────────────────────────────────────── */\n    #container {\n      position: absolute;\n      inset: 0;\n      transition: top 0.16s ease;\n    }\n\n    /* ── Control panel (mirrors base_scene_new.html #ui) ─────────────────── */\n    #ui {\n      position: absolute;\n      left: 6px;\n      bottom: 6px;\n      display: flex;\n      flex-direction: column;\n      gap: 3px;\n      font-family: sans-serif;\n      font-size: 11px;\n      max-width: 190px;\n      max-height: 34%;\n      background: transparent;\n      border: 0;\n      box-shadow: none;\n      opacity: 0.88;\n      transform: none;\n      transition: opacity 0.16s ease;\n      z-index: 10;\n    }\n\n    #ui:hover,\n    #ui:focus-within {\n      opacity: 1;\n    }\n\n    #ui button {\n      padding: 4px 10px;\n      cursor: pointer;\n      border: 1px solid #aaa;\n      background: #f5f5f5;\n      border-radius: 4px;\n    }\n\n    #ui button:hover {\n      background: #e0e0e0;\n    }\n\n    #ui button.active {\n      background: #c8e6ff;\n      border-color: #5aabf0;\n    }\n\n    #ui label {\n      display: flex;\n      flex-direction: column;\n      gap: 2px;\n      text-shadow: 0 1px 2px #fff;\n    }\n\n    #ui input[type=range] {\n      width: 86px;\n    }\n\n    /* ── Hover tooltip ───────────────────────────────────────────────────── */\n    #figTooltip {\n      position: fixed;\n      left: 0;\n      top: 0;\n      display: none;\n      max-width: 210px;\n      padding: 4px 8px;\n      border-radius: 4px;\n      background: rgba(0, 0, 0, 0.58);\n      color: #fff;\n      font: 11px/1.35 sans-serif;\n      pointer-events: none;\n      white-space: normal;\n      z-index: 20;\n    }\n  </style>\n</head>\n\n<body>\n  <div id=\"container\"></div>\n  <div id=\"figTooltip\"></div>\n  <div id=\"ui\">\n    <!-- @FIGURE_UI_BEGIN -->\n<label>Input Frequency (u₀): <output id=\"inputFrequencyVal\">3</output><input id=\"inputFrequencyInput\" type=\"range\" min=\"1\" max=\"16\" step=\"1\" value=\"3\" oninput=\"document.getElementById('inputFrequencyVal').value=this.value;update_inputFrequency(+this.value)\"></label><label><input id=\"filterTypeInput\" type=\"checkbox\" onchange=\"toggle_filterType(this.checked)\"> Filter Mode</label>\n<!-- @FIGURE_UI_END -->\n  </div>\n\n  <!-- Error overlay: shown if CDN fails or JS throws before rendering -->\n  <div id=\"err-overlay\" style=\"display:none;position:fixed;inset:0;background:#fff;z-index:999;\n       flex-direction:column;align-items:center;justify-content:center;\n       font-family:sans-serif;font-size:13px;color:#555;gap:10px;\">\n    <span id=\"err-msg\">⚠ Figure failed to load</span>\n    <button onclick=\"location.reload()\" style=\"padding:5px 14px;border:1px solid #aaa;\n        border-radius:5px;background:#f5f5f5;cursor:pointer;font-size:12px;\">↻ Reload</button>\n  </div>\n\n  <script>\n    /* ── Error overlay ───────────────────────────────────────────────────── */\n    var _rendered = false;\n    var _errOverlay = document.getElementById('err-overlay');\n    window.__markRendered = function () { _rendered = true; _errOverlay.style.display = 'none'; };\n    window.addEventListener('error', function (e) {\n      if (!_rendered) {\n        document.getElementById('err-msg').textContent = '⚠ ' + (e.message || 'Figure failed to load');\n        _errOverlay.style.display = 'flex';\n      }\n    });\n    setTimeout(function () { if (!_rendered) { _errOverlay.style.display = 'flex'; } }, 12000);\n\n    /* ── Tooltip + popup helpers ─────────────────────────────────────────── */\n    var _tooltip = document.getElementById('figTooltip');\n\n    function showPopup(title, body) {\n      window.parent.postMessage({ type: 'alex-popup', title: title, body: body }, '*');\n    }\n    function hidePopup() {\n      window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n    }\n    function showTooltip(text, event) {\n      if (!_tooltip || !text) return;\n      _tooltip.textContent = text;\n      _tooltip.style.display = 'block';\n      _moveTooltip(event);\n    }\n    function _moveTooltip(event) {\n      if (!_tooltip || _tooltip.style.display === 'none') return;\n      var pad = 12;\n      var x = Math.min(event.clientX + pad, window.innerWidth - (_tooltip.offsetWidth || 100) - pad);\n      var y = Math.max(pad, event.clientY - (_tooltip.offsetHeight || 40) - pad);\n      _tooltip.style.left = x + 'px';\n      _tooltip.style.top = y + 'px';\n    }\n    function hideTooltip() {\n      if (_tooltip) _tooltip.style.display = 'none';\n    }\n    document.addEventListener('mousemove', function (e) { _moveTooltip(e); });\n\n    /* ── Resize event ────────────────────────────────────────────────────── */\n    new ResizeObserver(function () {\n      var rect = document.getElementById('container').getBoundingClientRect();\n      document.dispatchEvent(new CustomEvent('fig-resize', {\n        detail: { width: rect.width, height: rect.height }\n      }));\n    }).observe(document.getElementById('container'));\n\n    /* ── Keyboard dismiss ────────────────────────────────────────────────── */\n    window.addEventListener('keydown', function (e) {\n      if (e.key === 'Escape') { hidePopup(); hideTooltip(); }\n    });\n\n    // @FIGURE_CODE_BEGIN\nvar draw = SVG().addTo(document.getElementById('container')).size('100%', '100%');\nvar W = 765, H = 360;\ndraw.viewbox(0, 0, W, H);\n\nvar state = { u0: 3, highPass: false, explored: false };\n\nvar formula = draw.group();\nvar demo = draw.group().hide();\n\nfunction addText(parent, x, y, txt, opts) {\n  opts = opts || {};\n  return parent.text(txt)\n    .font({\n      family: opts.family || 'Times New Roman, Times, serif',\n      size: opts.size || 34,\n      style: opts.style || 'italic',\n      weight: opts.weight || 'normal',\n      anchor: opts.anchor || 'start'\n    })\n    .fill(opts.fill || '#000')\n    .move(x, y);\n}\n\nfunction makeArrow(parent, x1, y1, x2, y2) {\n  parent.line(x1, y1, x2, y2).stroke({ color: '#000', width: 1.35 });\n  parent.polygon([[x2, y2], [x2 - 7, y2 - 3.5], [x2 - 7, y2 + 3.5]]).fill('#000');\n}\n\nfunction renderStaticFormula() {\n  formula.clear();\n\n  addText(formula, -2, 32, 'exp', { size: 32, style: 'normal' });\n  addText(formula, 58, 26, '(', { size: 43, style: 'normal' });\n  addText(formula, 80, 31, '2πj', { size: 32 });\n  addText(formula, 140, 18, 'u₀ n', { size: 19 });\n  formula.line(134, 48, 190, 48).stroke({ color: '#000', width: 1.1 });\n  addText(formula, 154, 50, 'N', { size: 20 });\n  addText(formula, 196, 26, ')', { size: 43, style: 'normal' });\n\n  makeArrow(formula, 230, 47, 270, 47);\n\n  formula.rect(90, 90).move(295, 1).fill('#fff').stroke({ color: '#000', width: 1.2 });\n  addText(formula, 318, 31, 'H', { size: 32, weight: 'bold' });\n  addText(formula, 354, 31, '[u]', { size: 32 });\n\n  makeArrow(formula, 385, 47, 425, 47);\n\n  addText(formula, 444, 31, '|H[u₀]|', { size: 32, weight: 'bold' });\n  addText(formula, 565, 32, 'exp', { size: 32, style: 'normal' });\n  addText(formula, 626, 26, '(', { size: 43, style: 'normal' });\n  addText(formula, 648, 31, '2πj', { size: 32 });\n  addText(formula, 708, 18, 'u₀ n', { size: 19 });\n  formula.line(702, 48, 758, 48).stroke({ color: '#000', width: 1.1 });\n  addText(formula, 722, 50, 'N', { size: 20 });\n  addText(formula, 766, 31, '+ j∠H[u]', { size: 32 });\n\n  formula.children().forEach(function (el) {\n    el.on('mousemove', function (e) {\n      showTooltip('A complex exponential enters an LTI system and exits at the same frequency, scaled by |H[u₀]| and shifted by ∠H[u₀].', e);\n    }).on('mouseleave', hideTooltip).on('click', function () {\n      showPopup('Complex exponential eigenfunction', 'For an LTI system, a complex exponential is an eigenfunction: the output has the same frequency as the input. The transfer function H[u] only changes the amplitude and phase at that frequency.');\n    }).css('cursor', 'pointer');\n  });\n}\n\nfunction gain(u) {\n  if (state.highPass) return 0.12 + 0.88 * (1 - Math.exp(-(u / 7.2) * (u / 7.2)));\n  return 0.12 + 0.88 * Math.exp(-(u / 7.2) * (u / 7.2));\n}\n\nfunction phase(u) {\n  return state.highPass ? -0.16 * u + 0.9 : -0.105 * u;\n}\n\nfunction pathWave(x0, y0, w, amp, cycles, ph) {\n  var pts = [];\n  for (var i = 0; i <= 240; i++) {\n    var t = i / 240;\n    var x = x0 + t * w;\n    var y = y0 - amp * Math.cos(2 * Math.PI * cycles * t + ph);\n    pts.push([x, y]);\n  }\n  return pts;\n}\n\nfunction polyPath(pts) {\n  return 'M' + pts.map(function (p) { return p[0].toFixed(2) + ',' + p[1].toFixed(2); }).join('L');\n}\n\nfunction drawAxes(g, x, y, w, h, label) {\n  g.rect(w, h).move(x, y).fill('#fff').stroke({ color: '#d9d9d9', width: 1 });\n  g.line(x, y + h / 2, x + w, y + h / 2).stroke({ color: '#bdbdbd', width: 0.8 });\n  g.line(x, y, x, y + h).stroke({ color: '#bdbdbd', width: 0.8 });\n  g.text(label).font({ family: 'sans-serif', size: 12, weight: 'bold' }).fill('#333').move(x + 6, y + 4);\n}\n\nfunction renderDemo() {\n  demo.clear();\n  var u = state.u0;\n  var gval = gain(u);\n  var pval = phase(u);\n\n  demo.opacity(state.explored ? 1 : 0);\n\n  var top = 116;\n  var leftX = 34, midX = 284, rightX = 528;\n  var pw = 190, ph = 86;\n\n  drawAxes(demo, leftX, top, pw, ph, 'input: exp(2πju₀n/N)');\n  drawAxes(demo, midX, top, 190, ph, state.highPass ? 'H[u]: high-pass' : 'H[u]: low-pass');\n  drawAxes(demo, rightX, top, 200, ph, 'output: same frequency');\n\n  var c1 = top + ph / 2;\n  var inPts = pathWave(leftX + 8, c1, pw - 16, 30, u / 2.7, 0);\n  var inPath = demo.path(polyPath(inPts)).fill('none').stroke({ color: '#2b6cb0', width: 2.4 });\n\n  var mx = midX + 20, my = top + 12, mw = 150, mh = 56;\n  var respPts = [];\n  for (var k = 0; k <= 120; k++) {\n    var uu = 16 * k / 120;\n    var x = mx + (uu / 16) * mw;\n    var y = my + mh - gain(uu) * mh;\n    respPts.push([x, y]);\n  }\n  demo.path(polyPath(respPts)).fill('none').stroke({ color: '#222', width: 2.2 });\n  var markerX = mx + (u / 16) * mw;\n  demo.line(markerX, my - 2, markerX, my + mh + 3).stroke({ color: '#d9480f', width: 1.6, dasharray: '4,3' });\n  demo.circle(7).center(markerX, my + mh - gval * mh).fill('#d9480f');\n  demo.text('u₀').font({ family: 'Times New Roman, Times, serif', size: 13, style: 'italic' }).fill('#d9480f').center(markerX, my + mh + 14);\n\n  var c3 = top + ph / 2;\n  var refPts = pathWave(rightX + 8, c3, 200 - 16, 30, u / 2.7, 0);\n  demo.path(polyPath(refPts)).fill('none').stroke({ color: '#2b6cb0', width: 1.7, opacity: 0.28 });\n  var outPts = pathWave(rightX + 8, c3, 200 - 16, 30 * gval, u / 2.7, pval);\n  demo.path(polyPath(outPts)).fill('none').stroke({ color: '#e67e22', width: 2.8 });\n\n  makeArrow(demo, 232, top + 43, 272, top + 43);\n  makeArrow(demo, 484, top + 43, 518, top + 43);\n\n  var info = demo.group();\n  info.rect(505, 58).move(130, 238).fill('#ffffff').stroke({ color: '#e1e1e1', width: 1 });\n  info.text('Selected frequency u₀ = ' + u + '  →  gain |H[u₀]| ≈ ' + gval.toFixed(2) + ', phase ∠H[u₀] ≈ ' + pval.toFixed(2) + ' rad')\n    .font({ family: 'sans-serif', size: 15 }).fill('#111').move(146, 250);\n  info.text('The orange output keeps the same number of cycles as the blue input; only its height and horizontal shift change.')\n    .font({ family: 'sans-serif', size: 12 }).fill('#444').move(146, 274);\n\n  [inPath].forEach(function (el) {\n    el.on('mousemove', function (e) { showTooltip('Input complex exponential: changing u₀ changes the number of cycles, not the LTI rule.', e); })\n      .on('mouseleave', hideTooltip).css('cursor', 'pointer');\n  });\n  demo.children().forEach(function (el) {\n    el.on('click', function () {\n      showPopup('Frequency-by-frequency action', 'The vertical marker samples H[u] at the chosen input frequency u₀. The output remains at u₀ while its amplitude becomes |H[u₀]| times the input and its phase is shifted by ∠H[u₀].');\n    }).css('cursor', 'pointer');\n  });\n}\n\nfunction revealDemo() {\n  if (!state.explored) {\n    state.explored = true;\n    demo.show();\n    demo.animate(180).opacity(1);\n  }\n}\n\nfunction update_inputFrequency(v) {\n  state.u0 = v;\n  revealDemo();\n  renderDemo();\n}\n\nfunction toggle_filterType(on) {\n  state.highPass = !!on;\n  revealDemo();\n  renderDemo();\n  var mode = state.highPass ? 'High-pass' : 'Low-pass';\n  showPopup(mode + ' filter mode', mode + ' mode changes the shape of H[u]. Frequencies whose marker lands high on the response curve pass strongly; frequencies whose marker lands low are attenuated, but their frequency is not changed.');\n}\n\nrenderStaticFormula();\nrenderDemo();\nwindow.__markRendered();\n// @FIGURE_CODE_END\n  </script>\n</body>\n\n</html>",
