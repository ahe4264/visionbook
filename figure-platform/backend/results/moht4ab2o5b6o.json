  "id": "moht4ab2o5b6o",
  "filename": "figure_103",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n.container { width:100%; height:100%; display:grid; grid-template-columns:1fr 1fr; }\n.panel { position:relative; }\n.label { position:absolute; bottom:10px; left:50%; transform:translateX(-50%); font:11px sans-serif; color:#333; }\ncanvas { display:block; }\n.tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"panel\" id=\"panelA\">\n    <canvas id=\"canvasA\"></canvas>\n    <div class=\"label\">(a)</div>\n  </div>\n  <div class=\"panel\" id=\"panelB\">\n    <canvas id=\"canvasB\"></canvas>\n    <div class=\"label\">(b)</div>\n  </div>\n</div>\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n\n// Panel A: x-axis→right, y-axis→up, z-axis→out\n// elevation ~20°, azimuth ~-30°\n// camera.position.set(5,3,8)\n\nfunction createPanelA() {\n  const canvas = document.getElementById('canvasA');\n  const scene = new THREE.Scene();\n  \n  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\n  renderer.setClearColor(0xffffff, 1);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  \n  const aspect = canvas.clientWidth / canvas.clientHeight;\n  const d = 4;\n  const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n  camera.position.set(5, 3, 8);\n  camera.lookAt(0, 0, 0);\n  \n  scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n  \n  // Grid plane\n  const gridGeo = new THREE.PlaneGeometry(6, 4);\n  const edges = new THREE.EdgesGeometry(gridGeo);\n  const gridLines = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({color: 0x4488ff}));\n  gridLines.rotation.x = -Math.PI/2;\n  gridLines.position.y = -1;\n  scene.add(gridLines);\n  \n  // Add grid subdivisions\n  const gridHelper = new THREE.Group();\n  const blueMat = new THREE.LineBasicMaterial({color: 0x4488ff});\n  const redMat = new THREE.LineBasicMaterial({color: 0xff4444});\n  \n  // Blue lines parallel to x\n  for(let z = -1.5; z <= 1.5; z += 1) {\n    const geom = new THREE.BufferGeometry().setFromPoints([\n      new THREE.Vector3(-3, -1, z),\n      new THREE.Vector3(3, -1, z)\n    ]);\n    gridHelper.add(new THREE.Line(geom, blueMat));\n  }\n  \n  // Red lines parallel to z  \n  for(let x = -2; x <= 2; x += 1) {\n    const geom = new THREE.BufferGeometry().setFromPoints([\n      new THREE.Vector3(x, -1, -2),\n      new THREE.Vector3(x, -1, 2)\n    ]);\n    gridHelper.add(new THREE.Line(geom, redMat));\n  }\n  scene.add(gridHelper);\n  \n  // Triangle wall\n  const triPoints = [\n    new THREE.Vector3(-2, -1, 0),\n    new THREE.Vector3(-2, 2, 0),\n    new THREE.Vector3(0, -1, 0)\n  ];\n  const triGeo = new THREE.BufferGeometry().setFromPoints([...triPoints, triPoints[0]]);\n  const triLine = new THREE.Line(triGeo, new THREE.LineBasicMaterial({color: 0x000000}));\n  scene.add(triLine);\n  \n  // Coordinate axes\n  const axesGroup = new THREE.Group();\n  \n  // X axis (green)\n  const xAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2.5, -1, 0),\n    new THREE.Vector3(-1.5, -1, 0)\n  ]);\n  axesGroup.add(new THREE.Line(xAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-1.5, -1, 0), new THREE.Vector3(1, 0, 0), 0x44cc44);\n  \n  // Y axis (green)\n  const yAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2.5, -1, 0),\n    new THREE.Vector3(-2.5, 0, 0)\n  ]);\n  axesGroup.add(new THREE.Line(yAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-2.5, 0, 0), new THREE.Vector3(0, 1, 0), 0x44cc44);\n  \n  // Z axis (green)\n  const zAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2.5, -1, 0),\n    new THREE.Vector3(-2.5, -1, 1)\n  ]);\n  axesGroup.add(new THREE.Line(zAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-2.5, -1, 1), new THREE.Vector3(0, 0, 1), 0x44cc44);\n  \n  scene.add(axesGroup);\n  \n  // Vector v (red)\n  const vStart = new THREE.Vector3(0, -1, 0);\n  const vEnd = new THREE.Vector3(-0.5, 1.2, 0);\n  const vGeo = new THREE.BufferGeometry().setFromPoints([vStart, vEnd]);\n  const vLine = new THREE.Line(vGeo, new THREE.LineBasicMaterial({color: 0xff0000, linewidth: 2}));\n  scene.add(vLine);\n  addArrowhead(scene, vEnd, new THREE.Vector3(-0.5, 1, 0).normalize(), 0xff0000);\n  \n  // Vector v' (red projection)\n  const vPrimeEnd = new THREE.Vector3(0.8, -1, 0);\n  const vPrimeGeo = new THREE.BufferGeometry().setFromPoints([vStart, vPrimeEnd]);\n  const vPrimeLine = new THREE.Line(vPrimeGeo, new THREE.LineBasicMaterial({color: 0xff0000, linewidth: 2}));\n  scene.add(vPrimeLine);\n  addArrowhead(scene, vPrimeEnd, new THREE.Vector3(1, 0, 0), 0xff0000);\n  \n  // Dashed projection line\n  const dashGeo = new THREE.BufferGeometry().setFromPoints([vEnd, vPrimeEnd]);\n  const dashLine = new THREE.Line(dashGeo, new THREE.LineDashedMaterial({\n    color: 0x666666,\n    dashSize: 0.1,\n    gapSize: 0.1\n  }));\n  dashLine.computeLineDistances();\n  scene.add(dashLine);\n  \n  // Labels\n  const labelV = createTextSprite('v', {x: -0.6, y: 1.3, z: 0});\n  const labelVPrime = createTextSprite(\"v'\", {x: 0.9, y: -0.8, z: 0});\n  scene.add(labelV);\n  scene.add(labelVPrime);\n  \n  function render() {\n    renderer.render(scene, camera);\n  }\n  \n  function resize() {\n    const w = canvas.clientWidth;\n    const h = canvas.clientHeight;\n    renderer.setSize(w, h);\n    const a = w / h;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    render();\n  }\n  \n  resize();\n  window.addEventListener('resize', resize);\n  \n  // Interactivity\n  const raycaster = new THREE.Raycaster();\n  raycaster.params.Line.threshold = 0.1;\n  const mouse = new THREE.Vector2();\n  \n  canvas.addEventListener('mousemove', (e) => {\n    const rect = canvas.getBoundingClientRect();\n    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\n    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([vLine, vPrimeLine]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      obj.material.linewidth = 3;\n      \n      const tt = document.getElementById('tooltip');\n      tt.style.display = 'block';\n      tt.textContent = obj === vLine ? 'v — original vector' : \"v' — projection\";\n      tt.style.left = (e.clientX + 12) + 'px';\n      tt.style.top = (e.clientY - 28) + 'px';\n    } else {\n      vLine.material.linewidth = 2;\n      vPrimeLine.material.linewidth = 2;\n      document.getElementById('tooltip').style.display = 'none';\n    }\n    render();\n  });\n  \n  canvas.addEventListener('click', (e) => {\n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([vLine, vPrimeLine]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      const title = obj === vLine ? 'Vector v' : \"Vector v'\";\n      const body = obj === vLine ? \n        'Original vector in 3D space. Projects onto the horizontal plane.' :\n        'Projection of v onto the plane. Represents the component parallel to the surface.';\n      showPopup(title, body);\n    }\n  });\n  \n  canvas.addEventListener('mouseleave', () => {\n    document.getElementById('tooltip').style.display = 'none';\n  });\n}\n\n// Panel B: x-axis→right, y-axis→up, z-axis→out  \n// elevation ~25°, azimuth ~-45°\n// camera.position.set(6,4,6)\n\nfunction createPanelB() {\n  const canvas = document.getElementById('canvasB');\n  const scene = new THREE.Scene();\n  \n  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\n  renderer.setClearColor(0xffffff, 1);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  \n  const aspect = canvas.clientWidth / canvas.clientHeight;\n  const d = 4;\n  const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n  camera.position.set(6, 4, 6);\n  camera.lookAt(0, 0, 0);\n  \n  scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n  \n  // Multiple grid planes\n  const planeGroup = new THREE.Group();\n  \n  // Bottom plane\n  const bottomGrid = new THREE.GridHelper(6, 6, 0xff4444, 0x4488ff);\n  bottomGrid.position.y = -1;\n  planeGroup.add(bottomGrid);\n  \n  // Middle plane\n  const midGrid = new THREE.GridHelper(6, 6, 0xff4444, 0x4488ff);\n  midGrid.position.y = 0.5;\n  midGrid.material.opacity = 0.3;\n  midGrid.material.transparent = true;\n  planeGroup.add(midGrid);\n  \n  // Top plane\n  const topGrid = new THREE.GridHelper(6, 6, 0xff4444, 0x4488ff);\n  topGrid.position.y = 2;\n  topGrid.material.opacity = 0.2;\n  topGrid.material.transparent = true;\n  planeGroup.add(topGrid);\n  \n  scene.add(planeGroup);\n  \n  // Triangle wall\n  const triPoints = [\n    new THREE.Vector3(-1.5, -1, -1),\n    new THREE.Vector3(-1.5, 2.5, -1),\n    new THREE.Vector3(0.5, -1, -1)\n  ];\n  const triGeo = new THREE.BufferGeometry().setFromPoints([...triPoints, triPoints[0]]);\n  const triLine = new THREE.Line(triGeo, new THREE.LineBasicMaterial({color: 0x000000}));\n  scene.add(triLine);\n  \n  // Coordinate axes\n  const axesGroup = new THREE.Group();\n  \n  // X axis (green)\n  const xAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2, -1, -1),\n    new THREE.Vector3(-1, -1, -1)\n  ]);\n  axesGroup.add(new THREE.Line(xAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-1, -1, -1), new THREE.Vector3(1, 0, 0), 0x44cc44);\n  \n  // Y axis (green)\n  const yAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2, -1, -1),\n    new THREE.Vector3(-2, 0, -1)\n  ]);\n  axesGroup.add(new THREE.Line(yAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-2, 0, -1), new THREE.Vector3(0, 1, 0), 0x44cc44);\n  \n  // Z axis (green)\n  const zAxis = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2, -1, -1),\n    new THREE.Vector3(-2, -1, 0)\n  ]);\n  axesGroup.add(new THREE.Line(zAxis, new THREE.LineBasicMaterial({color: 0x44cc44})));\n  addArrowhead(axesGroup, new THREE.Vector3(-2, -1, 0), new THREE.Vector3(0, 0, 1), 0x44cc44);\n  \n  scene.add(axesGroup);\n  \n  // Vector v (red)\n  const vStart = new THREE.Vector3(0, -1, -1);\n  const vEnd = new THREE.Vector3(-0.3, 1.8, -1);\n  const vGeo = new THREE.BufferGeometry().setFromPoints([vStart, vEnd]);\n  const vLine = new THREE.Line(vGeo, new THREE.LineBasicMaterial({color: 0xff0000, linewidth: 2}));\n  scene.add(vLine);\n  addArrowhead(scene, vEnd, new THREE.Vector3(-0.3, 1, 0).normalize(), 0xff0000);\n  \n  // Vector v' (red) - now in 3D\n  const vPrimeEnd = new THREE.Vector3(1, -1, 1.5);\n  const vPrimeGeo = new THREE.BufferGeometry().setFromPoints([vStart, vPrimeEnd]);\n  const vPrimeLine = new THREE.Line(vPrimeGeo, new THREE.LineBasicMaterial({color: 0xff0000, linewidth: 2}));\n  scene.add(vPrimeLine);\n  addArrowhead(scene, vPrimeEnd, new THREE.Vector3(0.5, 0, 0.8).normalize(), 0xff0000);\n  \n  // Component lines\n  const comp1 = new THREE.BufferGeometry().setFromPoints([vEnd, new THREE.Vector3(0.3, 1.8, 0.5)]);\n  const comp1Line = new THREE.Line(comp1, new THREE.LineDashedMaterial({\n    color: 0x666666,\n    dashSize: 0.1,\n    gapSize: 0.1\n  }));\n  comp1Line.computeLineDistances();\n  scene.add(comp1Line);\n  \n  const comp2 = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0.3, 1.8, 0.5),\n    vPrimeEnd\n  ]);\n  const comp2Line = new THREE.Line(comp2, new THREE.LineDashedMaterial({\n    color: 0x666666,\n    dashSize: 0.1,\n    gapSize: 0.1\n  }));\n  comp2Line.computeLineDistances();\n  scene.add(comp2Line);\n  \n  // Labels\n  const labelV = createTextSprite('v', {x: -0.4, y: 1.9, z: -1});\n  const labelVPrime = createTextSprite(\"v'\", {x: 1.1, y: -0.8, z: 1.6});\n  scene.add(labelV);\n  scene.add(labelVPrime);\n  \n  function render() {\n    renderer.render(scene, camera);\n  }\n  \n  function resize() {\n    const w = canvas.clientWidth;\n    const h = canvas.clientHeight;\n    renderer.setSize(w, h);\n    const a = w / h;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    render();\n  }\n  \n  resize();\n  window.addEventListener('resize', resize);\n  \n  // Interactivity\n  const raycaster = new THREE.Raycaster();\n  raycaster.params.Line.threshold = 0.1;\n  const mouse = new THREE.Vector2();\n  \n  canvas.addEventListener('mousemove', (e) => {\n    const rect = canvas.getBoundingClientRect();\n    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\n    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([vLine, vPrimeLine]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      obj.material.linewidth = 3;\n      \n      const tt = document.getElementById('tooltip');\n      tt.style.display = 'block';\n      tt.textContent = obj === vLine ? 'v — vector in plane' : \"v' — transformed vector\";\n      tt.style.left = (e.clientX + 12) + 'px';\n      tt.style.top = (e.clientY - 28) + 'px';\n    } else {\n      vLine.material.linewidth = 2;\n      vPrimeLine.material.linewidth = 2;\n      document.getElementById('tooltip').style.display = 'none';\n    }\n    render();\n  });\n  \n  canvas.addEventListener('click', (e) => {\n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([vLine, vPrimeLine]);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      const title = obj === vLine ? 'Vector v' : \"Vector v'\";\n      const body = obj === vLine ? \n        'Original vector constrained to the vertical plane. Shows 2D component.' :\n        'Transformed vector extending into 3D space. Demonstrates decomposition across multiple planes.';\n      showPopup(title, body);\n    }\n  });\n  \n  canvas.addEventListener('mouseleave', () => {\n    document.getElementById('tooltip').style.display = 'none';\n  });\n}\n\n// Helper functions\nfunction addArrowhead(parent, pos, dir, color) {\n  const cone = new THREE.ConeGeometry(0.15, 0.3, 4);\n  const mat = new THREE.MeshBasicMaterial({ color });\n  const arrow = new THREE.Mesh(cone, mat);\n  arrow.position.copy(pos);\n  arrow.lookAt(pos.clone().add(dir));\n  arrow.rotateX(Math.PI / 2);\n  parent.add(arrow);\n}\n\nfunction createTextSprite(text, pos) {\n  const canvas = document.createElement('canvas');\n  const ctx = canvas.getContext('2d');\n  canvas.width = 64;\n  canvas.height = 32;\n  \n  ctx.fillStyle = '#333';\n  ctx.font = '16px sans-serif';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText(text, 32, 16);\n  \n  const texture = new THREE.CanvasTexture(canvas);\n  const mat = new THREE.SpriteMaterial({ map: texture });\n  const sprite = new THREE.Sprite(mat);\n  sprite.position.set(pos.x, pos.y, pos.z);\n  sprite.scale.set(0.8, 0.4, 1);\n  \n  return sprite;\n}\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\ndocument.addEventListener('click', e => {\n  if (e.target.tagName === 'BODY' || e.target.classList.contains('container')) hidePopup();\n});\n\ndocument.addEventListener('mousemove', e => {\n  const tt = document.getElementById('tooltip');\n  if (tt.style.display === 'block') {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  }\n});\n\n// Initialize panels\ncreatePanelA();\ncreatePanelB();\n\n} catch (e) {\n  console.error('Error:', e);\n}\n</script>\n</body>\n</html>",
