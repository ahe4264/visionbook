  "filename": "figure_2",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody {\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    font-family: Arial, sans-serif;\n    overflow: hidden;\n}\n\n.container {\n    display: flex;\n    justify-content: space-around;\n    align-items: center;\n    height: 100vh;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\n.panel {\n    position: relative;\n    cursor: pointer;\n}\n\n.label {\n    position: absolute;\n    top: -25px;\n    left: 0;\n    font-size: 12px;\n    color: #333;\n}\n\nsvg {\n    display: block;\n}\n\n.axis-label {\n    font-size: 11px;\n    fill: #333;\n}\n\n.plane {\n    cursor: pointer;\n}\n\n.plane:hover {\n    opacity: 0.8;\n}\n\n#tooltip {\n    position: fixed;\n    background: rgba(60,60,60,0.75);\n    backdrop-filter: blur(4px);\n    color: #fff;\n    font: 11px/1.4 sans-serif;\n    padding: 5px 8px;\n    border-radius: 5px;\n    pointer-events: none;\n    z-index: 100;\n    max-width: 200px;\n    display: none;\n}\n\n#popup {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: rgba(245,245,245,0.94);\n    backdrop-filter: blur(6px);\n    border-top: 1px solid rgba(0,0,0,0.1);\n    padding: 8px 12px;\n    font: 12px/1.5 sans-serif;\n    color: #333;\n    z-index: 101;\n    box-shadow: 0 -2px 12px rgba(0,0,0,0.08);\n    display: none;\n}\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n    <!-- Panel a) 1D -->\n    <div class=\"panel\" data-panel=\"a\">\n        <span class=\"label\">a)</span>\n        <svg width=\"150\" height=\"80\">\n            <line x1=\"20\" y1=\"40\" x2=\"130\" y2=\"40\" stroke=\"#000\" stroke-width=\"1.5\" data-axis=\"x1\"/>\n            <line x1=\"125\" y1=\"38\" x2=\"130\" y2=\"40\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            <line x1=\"125\" y1=\"42\" x2=\"130\" y2=\"40\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            <circle cx=\"75\" cy=\"40\" r=\"2\" fill=\"#000\"/>\n            <text x=\"135\" y=\"45\" class=\"axis-label\">x₁</text>\n        </svg>\n    </div>\n\n    <!-- Panel b) 2D -->\n    <div class=\"panel\" data-panel=\"b\">\n        <span class=\"label\">b)</span>\n        <svg width=\"150\" height=\"150\">\n            <!-- x1 axis -->\n            <line x1=\"20\" y1=\"75\" x2=\"130\" y2=\"75\" stroke=\"#000\" stroke-width=\"1.5\" data-axis=\"x1\"/>\n            <line x1=\"125\" y1=\"73\" x2=\"130\" y2=\"75\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            <line x1=\"125\" y1=\"77\" x2=\"130\" y2=\"75\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            \n            <!-- x2 axis -->\n            <line x1=\"75\" y1=\"130\" x2=\"75\" y2=\"20\" stroke=\"#00b4d8\" stroke-width=\"1.5\" data-axis=\"x2\"/>\n            <line x1=\"73\" y1=\"25\" x2=\"75\" y2=\"20\" stroke=\"#00b4d8\" stroke-width=\"1.5\"/>\n            <line x1=\"77\" y1=\"25\" x2=\"75\" y2=\"20\" stroke=\"#00b4d8\" stroke-width=\"1.5\"/>\n            \n            <circle cx=\"75\" cy=\"75\" r=\"2\" fill=\"#ff0000\"/>\n            <text x=\"135\" y=\"80\" class=\"axis-label\">x₁</text>\n            <text x=\"80\" y=\"15\" class=\"axis-label\" fill=\"#00b4d8\">x₂</text>\n        </svg>\n    </div>\n\n    <!-- Panel c) 3D -->\n    <div class=\"panel\" data-panel=\"c\">\n        <span class=\"label\">c)</span>\n        <svg width=\"200\" height=\"150\">\n            <!-- Back plane (grey) -->\n            <path d=\"M 80 50 L 80 110 L 120 130 L 120 70 Z\" fill=\"#d0d0d0\" stroke=\"#999\" stroke-width=\"0.5\" class=\"plane\" data-plane=\"back\"/>\n            \n            <!-- x1 axis -->\n            <line x1=\"30\" y1=\"90\" x2=\"150\" y2=\"90\" stroke=\"#000\" stroke-width=\"1.5\" data-axis=\"x1\"/>\n            <line x1=\"145\" y1=\"88\" x2=\"150\" y2=\"90\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            <line x1=\"145\" y1=\"92\" x2=\"150\" y2=\"90\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            \n            <!-- x3 axis (diagonal) -->\n            <line x1=\"80\" y1=\"90\" x2=\"120\" y2=\"70\" stroke=\"#666\" stroke-width=\"1.5\" stroke-dasharray=\"2,2\" data-axis=\"x3\"/>\n            \n            <!-- Front plane (cyan) -->\n            <path d=\"M 80 50 L 80 110 L 100 120 L 100 60 Z\" fill=\"#00d4d4\" fill-opacity=\"0.5\" stroke=\"#00b4d8\" stroke-width=\"0.5\" class=\"plane\" data-plane=\"front\"/>\n            \n            <!-- x2 axis -->\n            <line x1=\"80\" y1=\"130\" x2=\"80\" y2=\"30\" stroke=\"#00b4d8\" stroke-width=\"1.5\" data-axis=\"x2\"/>\n            <line x1=\"78\" y1=\"35\" x2=\"80\" y2=\"30\" stroke=\"#00b4d8\" stroke-width=\"1.5\"/>\n            <line x1=\"82\" y1=\"35\" x2=\"80\" y2=\"30\" stroke=\"#00b4d8\" stroke-width=\"1.5\"/>\n            \n            <!-- Orange triangle -->\n            <path d=\"M 80 90 L 150 90 L 120 70 Z\" fill=\"#ff7f50\" fill-opacity=\"0.7\" stroke=\"#ff6347\" stroke-width=\"0.5\" class=\"plane\" data-plane=\"triangle\"/>\n            \n            <circle cx=\"80\" cy=\"90\" r=\"2\" fill=\"#ff0000\"/>\n            <text x=\"155\" y=\"95\" class=\"axis-label\">x₁</text>\n            <text x=\"85\" y=\"25\" class=\"axis-label\" fill=\"#00b4d8\">x₂</text>\n            <text x=\"125\" y=\"65\" class=\"axis-label\" fill=\"#666\">x₃</text>\n        </svg>\n    </div>\n</div>\n\n<div id=\"tooltip\"></div>\n<div id=\"popup\"></div>\n\n<script>\nconst tooltip = document.getElementById('tooltip');\nconst popup = document.getElementById('popup');\n\nconst info = {\n    'a': {\n        title: '1D Space',\n        axes: {\n            'x1': 'The x₁ axis represents a single dimension. Points can only move left or right along this line.'\n        },\n        panel: 'In one dimension, every point is determined by a single coordinate value.'\n    },\n    'b': {\n        title: '2D Space',\n        axes: {\n            'x1': 'The horizontal x₁ axis is the first dimension.',\n            'x2': 'The vertical x₂ axis is the second dimension, perpendicular to x₁.'\n        },\n        panel: 'In two dimensions, points are located using two coordinates (x₁, x₂). The red point shows the origin where both axes meet.'\n    },\n    'c': {\n        title: '3D Space',\n        axes: {\n            'x1': 'The horizontal x₁ axis extends left to right.',\n            'x2': 'The vertical x₂ axis extends up and down.',\n            'x3': 'The diagonal x₃ axis extends into the page, creating depth.'\n        },\n        planes: {\n            'back': 'The grey plane represents the x₂-x₃ plane at x₁ = 0.',\n            'front': 'The cyan plane represents the x₁-x₂ plane at x₃ = 0.',\n            'triangle': 'The orange triangle shows a slice through 3D space.'\n        },\n        panel: 'In three dimensions, points need three coordinates (x₁, x₂, x₃). The visualization uses perspective to show depth on a 2D surface.'\n    }\n};\n\n// Tooltip functionality\ndocument.querySelectorAll('[data-axis], [data-plane]').forEach(el => {\n    el.addEventListener('mouseenter', e => {\n        const panel = e.target.closest('[data-panel]').dataset.panel;\n        const type = e.target.dataset.axis ? 'axes' : 'planes';\n        const key = e.target.dataset.axis || e.target.dataset.plane;\n        \n        if (info[panel][type] && info[panel][type][key]) {\n            tooltip.textContent = info[panel][type][key];\n            tooltip.style.display = 'block';\n        }\n    });\n    \n    el.addEventListener('mousemove', e => {\n        tooltip.style.left = e.clientX + 10 + 'px';\n        tooltip.style.top = e.clientY - 25 + 'px';\n    });\n    \n    el.addEventListener('mouseleave', () => {\n        tooltip.style.display = 'none';\n    });\n});\n\n// Popup functionality\ndocument.querySelectorAll('.panel').forEach(panel => {\n    panel.addEventListener('click', e => {\n        if (e.target.closest('[data-axis], [data-plane]')) return;\n        \n        const panelId = panel.dataset.panel;\n        popup.innerHTML = `<strong>${info[panelId].title}:</strong> ${info[panelId].panel}`;\n        popup.style.display = 'block';\n    });\n});\n\n// Dismiss popup\ndocument.addEventListener('click', e => {\n    if (!e.target.closest('.panel') && !e.target.closest('#popup')) {\n        popup.style.display = 'none';\n    }\n});\n\ndocument.addEventListener('keydown', e => {\n    if (e.key === 'Escape') {\n        popup.style.display = 'none';\n    }\n});\n</script>\n\n</body>\n</html>",
