  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { fill:#fff; stroke:#000; stroke-width:1; cursor:pointer; }\n.node:hover { stroke-width:2.5; fill-opacity:0.9; }\n.edge { fill:none; stroke:#000; stroke-width:1; }\n.edge.highlight { stroke:#e07b30; stroke-width:2; }\n.nodelabel { font:11px sans-serif; text-anchor:middle; pointer-events:none; }\n.edgelabel { font:10px sans-serif; text-anchor:middle; pointer-events:none; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 473 104\">\n<defs>\n<marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n<path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n</marker>\n</defs>\n<g id=\"nodes\">\n<circle cx=\"29\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"x1\"/>\n<circle cx=\"79\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi0\"/>\n<circle cx=\"129\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi1\"/>\n<circle cx=\"179\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi2\"/>\n<circle cx=\"229\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi3\"/>\n<circle cx=\"279\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi4\"/>\n<circle cx=\"329\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi5\"/>\n<circle cx=\"379\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"phi6\"/>\n<circle cx=\"444\" cy=\"20\" r=\"12\" class=\"node\" data-id=\"x2\"/>\n<circle cx=\"79\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi0\"/>\n<circle cx=\"129\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi1\"/>\n<circle cx=\"179\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi2\"/>\n<circle cx=\"229\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi3\"/>\n<circle cx=\"279\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi4\"/>\n<circle cx=\"329\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi5\"/>\n<circle cx=\"379\" cy=\"84\" r=\"12\" class=\"node\" data-id=\"dphi6\"/>\n</g>\n<g id=\"edges\">\n<line x1=\"41\" y1=\"20\" x2=\"67\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"x1\" data-to=\"phi0\"/>\n<line x1=\"91\" y1=\"20\" x2=\"117\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi0\" data-to=\"phi1\"/>\n<line x1=\"141\" y1=\"20\" x2=\"167\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi1\" data-to=\"phi2\"/>\n<line x1=\"191\" y1=\"20\" x2=\"217\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi2\" data-to=\"phi3\"/>\n<line x1=\"241\" y1=\"20\" x2=\"267\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi3\" data-to=\"phi4\"/>\n<line x1=\"291\" y1=\"20\" x2=\"317\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi4\" data-to=\"phi5\"/>\n<line x1=\"341\" y1=\"20\" x2=\"367\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi5\" data-to=\"phi6\"/>\n<line x1=\"391\" y1=\"20\" x2=\"432\" y2=\"20\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi6\" data-to=\"x2\"/>\n<line x1=\"79\" y1=\"32\" x2=\"79\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi0\" data-to=\"dphi0\"/>\n<line x1=\"129\" y1=\"32\" x2=\"129\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi1\" data-to=\"dphi1\"/>\n<line x1=\"179\" y1=\"32\" x2=\"179\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi2\" data-to=\"dphi2\"/>\n<line x1=\"229\" y1=\"32\" x2=\"229\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi3\" data-to=\"dphi3\"/>\n<line x1=\"279\" y1=\"32\" x2=\"279\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi4\" data-to=\"dphi4\"/>\n<line x1=\"329\" y1=\"32\" x2=\"329\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi5\" data-to=\"dphi5\"/>\n<line x1=\"379\" y1=\"32\" x2=\"379\" y2=\"72\" class=\"edge\" marker-end=\"url(#arr)\" data-from=\"phi6\" data-to=\"dphi6\"/>\n</g>\n<g id=\"labels\">\n<text x=\"29\" y=\"24\" class=\"nodelabel\">x₁</text>\n<text x=\"79\" y=\"24\" class=\"nodelabel\">φ₀</text>\n<text x=\"129\" y=\"24\" class=\"nodelabel\">φ₁</text>\n<text x=\"179\" y=\"24\" class=\"nodelabel\">φ₂</text>\n<text x=\"229\" y=\"24\" class=\"nodelabel\">φ₃</text>\n<text x=\"279\" y=\"24\" class=\"nodelabel\">φ₄</text>\n<text x=\"329\" y=\"24\" class=\"nodelabel\">φ₅</text>\n<text x=\"379\" y=\"24\" class=\"nodelabel\">φ₆</text>\n<text x=\"444\" y=\"24\" class=\"nodelabel\">x₂</text>\n<text x=\"79\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₀</text>\n<text x=\"129\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₁</text>\n<text x=\"179\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₂</text>\n<text x=\"229\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₃</text>\n<text x=\"279\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₄</text>\n<text x=\"329\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₅</text>\n<text x=\"379\" y=\"84\" class=\"nodelabel\" style=\"font-size:9px\">∂L/∂φ₆</text>\n<text x=\"54\" y=\"16\" class=\"edgelabel\">∂φ₀/∂x₁</text>\n<text x=\"104\" y=\"16\" class=\"edgelabel\">∂φ₁/∂φ₀</text>\n<text x=\"154\" y=\"16\" class=\"edgelabel\">∂φ₂/∂φ₁</text>\n<text x=\"204\" y=\"16\" class=\"edgelabel\">∂φ₃/∂φ₂</text>\n<text x=\"254\" y=\"16\" class=\"edgelabel\">∂φ₄/∂φ₃</text>\n<text x=\"304\" y=\"16\" class=\"edgelabel\">∂φ₅/∂φ₄</text>\n<text x=\"354\" y=\"16\" class=\"edgelabel\">∂φ₆/∂φ₅</text>\n<text x=\"411\" y=\"16\" class=\"edgelabel\">∂x₂/∂φ₆</text>\n<text x=\"89\" y=\"52\" class=\"edgelabel\">∂L/∂φ₀</text>\n<text x=\"139\" y=\"52\" class=\"edgelabel\">∂L/∂φ₁</text>\n<text x=\"189\" y=\"52\" class=\"edgelabel\">∂L/∂φ₂</text>\n<text x=\"239\" y=\"52\" class=\"edgelabel\">∂L/∂φ₃</text>\n<text x=\"289\" y=\"52\" class=\"edgelabel\">∂L/∂φ₄</text>\n<text x=\"339\" y=\"52\" class=\"edgelabel\">∂L/∂φ₅</text>\n<text x=\"389\" y=\"52\" class=\"edgelabel\">∂L/∂φ₆</text>\n<text x=\"15\" y=\"96\" class=\"nodelabel\" style=\"font-size:10px\">a)</text>\n</g>\n</svg>\n<div id=\"tooltip\"></div>\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\nconst graph = {\n  'x1': { out:['phi0'], in:[], label:'x₁', role:'Input variable' },\n  'phi0': { out:['phi1','dphi0'], in:['x1'], label:'φ₀', role:'Hidden state 0' },\n  'phi1': { out:['phi2','dphi1'], in:['phi0'], label:'φ₁', role:'Hidden state 1' },\n  'phi2': { out:['phi3','dphi2'], in:['phi1'], label:'φ₂', role:'Hidden state 2' },\n  'phi3': { out:['phi4','dphi3'], in:['phi2'], label:'φ₃', role:'Hidden state 3' },\n  'phi4': { out:['phi5','dphi4'], in:['phi3'], label:'φ₄', role:'Hidden state 4' },\n  'phi5': { out:['phi6','dphi5'], in:['phi4'], label:'φ₅', role:'Hidden state 5' },\n  'phi6': { out:['x2','dphi6'], in:['phi5'], label:'φ₆', role:'Hidden state 6' },\n  'x2': { out:[], in:['phi6'], label:'x₂', role:'Output variable' },\n  'dphi0': { out:[], in:['phi0'], label:'∂L/∂φ₀', role:'Gradient' },\n  'dphi1': { out:[], in:['phi1'], label:'∂L/∂φ₁', role:'Gradient' },\n  'dphi2': { out:[], in:['phi2'], label:'∂L/∂φ₂', role:'Gradient' },\n  'dphi3': { out:[], in:['phi3'], label:'∂L/∂φ₃', role:'Gradient' },\n  'dphi4': { out:[], in:['phi4'], label:'∂L/∂φ₄', role:'Gradient' },\n  'dphi5': { out:[], in:['phi5'], label:'∂L/∂φ₅', role:'Gradient' },\n  'dphi6': { out:[], in:['phi6'], label:'∂L/∂φ₆', role:'Gradient' }\n};\n\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', () => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n      \n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.classList.add('highlight');\n        }\n      });\n    }\n  });\n  \n  node.addEventListener('mouseleave', () => {\n    tooltip.style.display = 'none';\n    edges.forEach(edge => edge.classList.remove('highlight'));\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    if (info) {\n      const body = `This is ${info.label}, a ${info.role.toLowerCase()} in the computational graph. ` +\n        (info.out.length > 0 ? `It connects to: ${info.out.join(', ')}.` : 'This is a terminal node.') +\n        (info.in.length > 0 ? ` It receives input from: ${info.in.join(', ')}.` : '');\n      showPopup(info.label + ' — ' + info.role, body);\n      animateFlow(id);\n    }\n  });\n});\n\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.classList.add('highlight');\n    const from = edge.getAttribute('data-from');\n    const to = edge.getAttribute('data-to');\n    const fromInfo = graph[from];\n    const toInfo = graph[to];\n    if (fromInfo && toInfo) {\n      tooltip.textContent = `${fromInfo.label} → ${toInfo.label}`;\n      tooltip.style.display = 'block';\n    }\n  });\n  \n  edge.addEventListener('mouseleave', () => {\n    edge.classList.remove('highlight');\n    tooltip.style.display = 'none';\n  });\n});\n\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.35s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction animateFlow(startId) {\n  const layers = [\n    ['x1'], ['phi0'], ['phi1'], ['phi2'], ['phi3'], ['phi4'], ['phi5'], ['phi6'], ['x2']\n  ];\n  \n  edges.forEach(e => {\n    e.style.transition = 'none';\n    e.style.strokeDasharray = '';\n    e.style.strokeDashoffset = '';\n    e.style.stroke = '#000';\n  });\n  \n  layers.forEach((layer, i) => {\n    const layerEdges = [];\n    layer.forEach(nodeId => {\n      const info = graph[nodeId];\n      if (info && info.out.length > 0) {\n        edges.forEach(e => {\n          if (e.getAttribute('data-from') === nodeId) {\n            layerEdges.push(e);\n          }\n        });\n      }\n    });\n    \n    if (layerEdges.length > 0) {\n      animateEdges(layerEdges, '#4a7ef5', i * 380);\n      \n      layerEdges.forEach(edge => {\n        const toId = edge.getAttribute('data-to');\n        const toNode = document.querySelector(`.node[data-id=\"${toId}\"]`);\n        if (toNode) {\n          setTimeout(() => {\n            toNode.style.transformBox = 'fill-box';\n            toNode.style.transformOrigin = 'center';\n            toNode.style.transition = 'transform 0.15s ease';\n            toNode.style.transform = 'scale(1.18)';\n            setTimeout(() => { toNode.style.transform = 'scale(1)'; }, 200);\n          }, i * 380 + 350);\n        }\n      });\n    }\n  });\n  \n  setTimeout(() => {\n    edges.forEach(e => {\n      e.style.transition = 'stroke 0.3s ease';\n      e.style.stroke = '#000';\n      e.style.strokeDasharray = '';\n      e.style.strokeDashoffset = '';\n    });\n  }, layers.length * 380 + 600);\n}\n\n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
