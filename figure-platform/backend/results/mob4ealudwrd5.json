  "filename": "figure_37",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { cursor:pointer; transition:all 0.15s ease; }\n.edge { transition:all 0.15s ease; }\n.tooltip { position:fixed; background:rgba(22,22,22,0.88); backdrop-filter:blur(6px); color:#f0f0f0; font:11px/1.4 sans-serif; padding:5px 9px; border-radius:5px; border:1px solid rgba(255,255,255,0.1); pointer-events:none; z-index:100; max-width:240px; display:none; }\n.popup { position:fixed; bottom:0; left:0; right:0; background:rgba(246,246,246,0.97); backdrop-filter:blur(8px); border-top:1px solid rgba(0,0,0,0.07); padding:10px 14px; font:12px/1.6 sans-serif; color:#1a1a1a; z-index:101; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 264 164\">\n<defs>\n<marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\" markerUnits=\"strokeWidth\">\n<path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n</marker>\n</defs>\n\n<!-- Edges -->\n<line class=\"edge\" id=\"edge-x1-h1\" x1=\"40\" y1=\"60\" x2=\"120\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-x1-h2\" x1=\"40\" y1=\"60\" x2=\"120\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-x1-h3\" x1=\"40\" y1=\"60\" x2=\"120\" y2=\"124\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-x2-h1\" x1=\"40\" y1=\"104\" x2=\"120\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-x2-h2\" x1=\"40\" y1=\"104\" x2=\"120\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-x2-h3\" x1=\"40\" y1=\"104\" x2=\"120\" y2=\"124\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-h1-y\" x1=\"120\" y1=\"40\" x2=\"200\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-h2-y\" x1=\"120\" y1=\"82\" x2=\"200\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n<line class=\"edge\" id=\"edge-h3-y\" x1=\"120\" y1=\"124\" x2=\"200\" y2=\"82\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n\n<!-- Nodes -->\n<g class=\"node\" id=\"node-x1\" data-edges=\"edge-x1-h1,edge-x1-h2,edge-x1-h3\">\n<circle cx=\"40\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"40\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">x₁</text>\n</g>\n\n<g class=\"node\" id=\"node-x2\" data-edges=\"edge-x2-h1,edge-x2-h2,edge-x2-h3\">\n<circle cx=\"40\" cy=\"104\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"40\" y=\"109\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">x₂</text>\n</g>\n\n<g class=\"node\" id=\"node-h1\" data-edges=\"edge-x1-h1,edge-x2-h1,edge-h1-y\">\n<circle cx=\"120\" cy=\"40\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"120\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₁</text>\n</g>\n\n<g class=\"node\" id=\"node-h2\" data-edges=\"edge-x1-h2,edge-x2-h2,edge-h2-y\">\n<circle cx=\"120\" cy=\"82\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"120\" y=\"87\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₂</text>\n</g>\n\n<g class=\"node\" id=\"node-h3\" data-edges=\"edge-x1-h3,edge-x2-h3,edge-h3-y\">\n<circle cx=\"120\" cy=\"124\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"120\" y=\"129\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₃</text>\n</g>\n\n<g class=\"node\" id=\"node-y\" data-edges=\"edge-h1-y,edge-h2-y,edge-h3-y\">\n<circle cx=\"200\" cy=\"82\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n<text x=\"200\" y=\"87\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">y</text>\n</g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\">\n<div id=\"popup-content\"></div>\n<div style=\"margin-top:8px; font-size:11px; color:#666;\">Press Escape or click outside to close</div>\n</div>\n\n<script>\ntry {\nconst graph = {\n  'x1': { \n    out: ['h1','h2','h3'], \n    label: 'Input Node x₁', \n    desc: 'First input feature. Receives external data and propagates it to all hidden layer neurons. In the forward pass, this value is multiplied by connection weights and passed through activation functions in the hidden layer.'\n  },\n  'x2': { \n    out: ['h1','h2','h3'], \n    label: 'Input Node x₂', \n    desc: 'Second input feature. Works alongside x₁ to provide the network with input data. Each hidden neuron receives weighted combinations of both x₁ and x₂.'\n  },\n  'h1': { \n    out: ['y'], \n    in: ['x1','x2'],\n    label: 'Hidden Node h₁', \n    desc: 'First hidden layer neuron. Computes a weighted sum of inputs x₁ and x₂, applies an activation function (e.g., ReLU, sigmoid), and passes the result to the output layer. Learns to detect specific patterns in the input data.'\n  },\n  'h2': { \n    out: ['y'], \n    in: ['x1','x2'],\n    label: 'Hidden Node h₂', \n    desc: 'Second hidden layer neuron. Like h₁, it processes inputs through learned weights and activation functions. Each hidden neuron learns different feature representations that contribute to the final output.'\n  },\n  'h3': { \n    out: ['y'], \n    in: ['x1','x2'],\n    label: 'Hidden Node h₃', \n    desc: 'Third hidden layer neuron. Provides additional representational capacity to the network. The combination of multiple hidden neurons allows the network to learn complex, non-linear mappings from inputs to output.'\n  },\n  'y': { \n    out: [], \n    in: ['h1','h2','h3'],\n    label: 'Output Node y', \n    desc: 'Output neuron that produces the final network prediction. Receives weighted inputs from all hidden layer neurons h₁, h₂, h₃, applies a final activation function, and outputs the result for classification or regression tasks.'\n  }\n};\n\nconst tooltip = document.getElementById('tooltip');\nconst popup = document.getElementById('popup');\nconst popupContent = document.getElementById('popup-content');\n\n// Hover effects\ndocument.querySelectorAll('.node').forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    const nodeId = node.id.split('-')[1];\n    const circle = node.querySelector('circle');\n    circle.style.strokeWidth = '2.5px';\n    circle.style.fill = '#f8f8f8';\n    \n    // Highlight connected edges\n    const edgeIds = node.dataset.edges.split(',');\n    edgeIds.forEach(edgeId => {\n      const edge = document.getElementById(edgeId);\n      if (edge) {\n        edge.style.stroke = '#e07b30';\n        edge.style.strokeWidth = '2px';\n      }\n    });\n    \n    // Show tooltip\n    tooltip.textContent = graph[nodeId].label;\n    tooltip.style.display = 'block';\n  });\n  \n  node.addEventListener('mouseleave', e => {\n    const circle = node.querySelector('circle');\n    circle.style.strokeWidth = '1px';\n    circle.style.fill = '#fff';\n    \n    // Reset connected edges\n    const edgeIds = node.dataset.edges.split(',');\n    edgeIds.forEach(edgeId => {\n      const edge = document.getElementById(edgeId);\n      if (edge) {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1px';\n      }\n    });\n    \n    tooltip.style.display = 'none';\n  });\n  \n  node.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 10) + 'px';\n    tooltip.style.top = (e.clientY - 10) + 'px';\n  });\n});\n\n// Edge hover effects\ndocument.querySelectorAll('.edge').forEach(edge => {\n  edge.addEventListener('mouseenter', e => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2px';\n    \n    const edgeId = edge.id;\n    const parts = edgeId.split('-');\n    const from = parts[1];\n    const to = parts[2];\n    \n    tooltip.textContent = `${from} → ${to} — Signal flow connection`;\n    tooltip.style.display = 'block';\n  });\n  \n  edge.addEventListener('mouseleave', e => {\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1px';\n    tooltip.style.display = 'none';\n  });\n  \n  edge.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 10) + 'px';\n    tooltip.style.top = (e.clientY - 10) + 'px';\n  });\n});\n\n// Click effects - forward pass animation\ndocument.querySelectorAll('.node').forEach(node => {\n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const nodeId = node.id.split('-')[1];\n    \n    // Show popup\n    popupContent.innerHTML = `<strong>${graph[nodeId].label}</strong><br>${graph[nodeId].desc}`;\n    popup.style.display = 'block';\n    \n    // Animate forward pass from this node\n    animateForwardPass(nodeId);\n  });\n});\n\nfunction animateForwardPass(startNodeId) {\n  // Reset all edges first\n  document.querySelectorAll('.edge').forEach(edge => {\n    edge.style.strokeDasharray = '';\n    edge.style.strokeDashoffset = '';\n    edge.style.stroke = '#000';\n    edge.style.strokeWidth = '1px';\n  });\n  \n  // Find outgoing edges from start node\n  const outgoing = graph[startNodeId].out || [];\n  if (outgoing.length === 0) return;\n  \n  // Animate first layer\n  outgoing.forEach((targetId, index) => {\n    setTimeout(() => {\n      const edgeId = `edge-${startNodeId}-${targetId}`;\n      const edge = document.getElementById(edgeId);\n      if (edge) {\n        const length = Math.sqrt(\n          Math.pow(edge.getAttribute('x2') - edge.getAttribute('x1'), 2) +\n          Math.pow(edge.getAttribute('y2') - edge.getAttribute('y1'), 2)\n        );\n        \n        edge.style.strokeDasharray = length;\n        edge.style.strokeDashoffset = length;\n        edge.style.stroke = '#4a7ef5';\n        edge.style.strokeWidth = '2px';\n        edge.style.transition = 'stroke-dashoffset 0.4s ease';\n        \n        requestAnimationFrame(() => {\n          edge.style.strokeDashoffset = '0';\n        });\n        \n        // Pulse target node after animation\n        setTimeout(() => {\n          const targetNode = document.getElementById(`node-${targetId}`);\n          if (targetNode) {\n            targetNode.style.transform = 'scale(1.15)';\n            setTimeout(() => {\n              targetNode.style.transform = 'scale(1)';\n              \n              // Continue cascade if target has outgoing connections\n              const nextOutgoing = graph[targetId].out || [];\n              if (nextOutgoing.length > 0) {\n                animateFromNode(targetId);\n              }\n            }, 150);\n          }\n        }, 400);\n      }\n    }, index * 100);\n  });\n}\n\nfunction animateFromNode(nodeId) {\n  const outgoing = graph[nodeId].out || [];\n  outgoing.forEach((targetId, index) => {\n    setTimeout(() => {\n      const edgeId = `edge-${nodeId}-${targetId}`;\n      const edge = document.getElementById(edgeId);\n      if (edge) {\n        const length = Math.sqrt(\n          Math.pow(edge.getAttribute('x2') - edge.getAttribute('x1'), 2) +\n          Math.pow(edge.getAttribute('y2') - edge.getAttribute('y1'), 2)\n        );\n        \n        edge.style.strokeDasharray = length;\n        edge.style.strokeDashoffset = length;\n        edge.style.stroke = '#4a7ef5';\n        edge.style.strokeWidth = '2px';\n        edge.style.transition = 'stroke-dashoffset 0.4s ease';\n        \n        requestAnimationFrame(() => {\n          edge.style.strokeDashoffset = '0';\n        });\n        \n        setTimeout(() => {\n          const targetNode = document.getElementById(`node-${targetId}`);\n          if (targetNode) {\n            targetNode.style.transform = 'scale(1.15)';\n            setTimeout(() => {\n              targetNode.style.transform = 'scale(1)';\n            }, 150);\n          }\n        }, 400);\n      }\n    }, index * 100);\n  });\n  \n  // Reset after full cascade\n  setTimeout(() => {\n    document.querySelectorAll('.edge').forEach(edge => {\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1px';\n      edge.style.transition = 'all 0.15s ease';\n    });\n  }, 1500);\n}\n\n// Close popup\ndocument.addEventListener('click', e => {\n  if (!popup.contains(e.target)) {\n    popup.style.display = 'none';\n  }\n});\n\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') {\n    popup.style.display = 'none';\n  }\n});\n\n} catch (error) {\n  console.error('Interactive figure error:', error);\n}\n</script>\n</body>\n</html>",
