  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25);\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 497 167\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel a) -->\n  <text x=\"8\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">a)</text>\n  \n  <!-- Neural network nodes -->\n  <circle cx=\"40\" cy=\"83\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"x\"/>\n  <circle cx=\"120\" cy=\"35\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"h1\"/>\n  <circle cx=\"120\" cy=\"70\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"h2\"/>\n  <circle cx=\"120\" cy=\"105\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"h3\"/>\n  <circle cx=\"120\" cy=\"140\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"h4\"/>\n  <circle cx=\"200\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"y1\"/>\n  <circle cx=\"200\" cy=\"115\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-node=\"y2\"/>\n  \n  <!-- Node labels -->\n  <text x=\"40\" y=\"88\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">x</text>\n  <text x=\"120\" y=\"40\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">h₁</text>\n  <text x=\"120\" y=\"75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">h₂</text>\n  <text x=\"120\" y=\"110\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">h₃</text>\n  <text x=\"120\" y=\"145\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">h₄</text>\n  <text x=\"200\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">y₁</text>\n  <text x=\"200\" y=\"120\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">y₂</text>\n  \n  <!-- Edges -->\n  <line x1=\"55\" y1=\"83\" x2=\"105\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x-h1\"/>\n  <line x1=\"55\" y1=\"83\" x2=\"105\" y2=\"70\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x-h2\"/>\n  <line x1=\"55\" y1=\"83\" x2=\"105\" y2=\"105\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x-h3\"/>\n  <line x1=\"55\" y1=\"83\" x2=\"105\" y2=\"140\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"x-h4\"/>\n  \n  <line x1=\"135\" y1=\"35\" x2=\"185\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h1-y1\"/>\n  <line x1=\"135\" y1=\"35\" x2=\"185\" y2=\"115\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h1-y2\"/>\n  <line x1=\"135\" y1=\"70\" x2=\"185\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h2-y1\"/>\n  <line x1=\"135\" y1=\"70\" x2=\"185\" y2=\"115\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h2-y2\"/>\n  <line x1=\"135\" y1=\"105\" x2=\"185\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h3-y1\"/>\n  <line x1=\"135\" y1=\"105\" x2=\"185\" y2=\"115\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h3-y2\"/>\n  <line x1=\"135\" y1=\"140\" x2=\"185\" y2=\"60\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h4-y1\"/>\n  <line x1=\"135\" y1=\"140\" x2=\"185\" y2=\"115\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-edge=\"h4-y2\"/>\n  \n  <!-- Panel b) -->\n  <text x=\"250\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">b)</text>\n  \n  <!-- Plot axes -->\n  <line x1=\"280\" y1=\"140\" x2=\"470\" y2=\"140\" stroke=\"#000\" stroke-width=\"1\"/>\n  <line x1=\"280\" y1=\"140\" x2=\"280\" y2=\"30\" stroke=\"#000\" stroke-width=\"1\"/>\n  \n  <!-- X axis ticks and labels -->\n  <line x1=\"280\" y1=\"140\" x2=\"280\" y2=\"143\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"280\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">0</text>\n  <line x1=\"327.5\" y1=\"140\" x2=\"327.5\" y2=\"143\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"327.5\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">0.5</text>\n  <line x1=\"375\" y1=\"140\" x2=\"375\" y2=\"143\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"375\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">1.0</text>\n  <line x1=\"422.5\" y1=\"140\" x2=\"422.5\" y2=\"143\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"422.5\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">1.5</text>\n  <line x1=\"470\" y1=\"140\" x2=\"470\" y2=\"143\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"470\" y=\"155\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">2.0</text>\n  \n  <!-- Y axis ticks and labels -->\n  <line x1=\"277\" y1=\"140\" x2=\"280\" y2=\"140\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"270\" y=\"143\" text-anchor=\"end\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">0</text>\n  <line x1=\"277\" y1=\"107.5\" x2=\"280\" y2=\"107.5\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"270\" y=\"110.5\" text-anchor=\"end\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">0.5</text>\n  <line x1=\"277\" y1=\"75\" x2=\"280\" y2=\"75\" stroke=\"#000\" stroke-width=\"1\"/>\n  <text x=\"270\" y=\"78\" text-anchor=\"end\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">1.0</text>\n  \n  <!-- Grid lines -->\n  <line x1=\"280\" y1=\"107.5\" x2=\"470\" y2=\"107.5\" stroke=\"#ddd\" stroke-width=\"0.5\" stroke-dasharray=\"2,2\"/>\n  <line x1=\"280\" y1=\"75\" x2=\"470\" y2=\"75\" stroke=\"#ddd\" stroke-width=\"0.5\" stroke-dasharray=\"2,2\"/>\n  <line x1=\"327.5\" y1=\"30\" x2=\"327.5\" y2=\"140\" stroke=\"#ddd\" stroke-width=\"0.5\" stroke-dasharray=\"2,2\"/>\n  <line x1=\"375\" y1=\"30\" x2=\"375\" y2=\"140\" stroke=\"#ddd\" stroke-width=\"0.5\" stroke-dasharray=\"2,2\"/>\n  <line x1=\"422.5\" y1=\"30\" x2=\"422.5\" y2=\"140\" stroke=\"#ddd\" stroke-width=\"0.5\" stroke-dasharray=\"2,2\"/>\n  \n  <!-- Axis labels -->\n  <text x=\"375\" y=\"165\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Input, x</text>\n  <text x=\"258\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" transform=\"rotate(-90 258 85)\">Output, y</text>\n  \n  <!-- Data lines -->\n  <polyline points=\"280,140 327.5,107.5 375,118 422.5,96 470,124\" \n            fill=\"none\" stroke=\"#1f77b4\" stroke-width=\"2\" data-series=\"y1\"/>\n  <polyline points=\"280,107.5 327.5,118 375,96 422.5,124 470,102\" \n            fill=\"none\" stroke=\"#ff7f0e\" stroke-width=\"2\" data-series=\"y2\"/>\n  \n  <!-- Legend -->\n  <line x1=\"300\" y1=\"50\" x2=\"320\" y2=\"50\" stroke=\"#1f77b4\" stroke-width=\"2\"/>\n  <text x=\"325\" y=\"53\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">y₁</text>\n  <line x1=\"300\" y1=\"65\" x2=\"320\" y2=\"65\" stroke=\"#ff7f0e\" stroke-width=\"2\"/>\n  <text x=\"325\" y=\"68\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">y₂</text>\n</svg>\n\n<div class=\"tooltip\" id=\"tt\" style=\"display:none\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tt = document.getElementById('tt');\n  \n  // Graph connectivity\n  const graph = {\n    'x':  { out:['h1','h2','h3','h4'], in:[],          label:'x',  role:'Input' },\n    'h1': { out:['y1','y2'],           in:['x'],        label:'h₁', role:'Hidden unit 1' },\n    'h2': { out:['y1','y2'],           in:['x'],        label:'h₂', role:'Hidden unit 2' },\n    'h3': { out:['y1','y2'],           in:['x'],        label:'h₃', role:'Hidden unit 3' },\n    'h4': { out:['y1','y2'],           in:['x'],        label:'h₄', role:'Hidden unit 4' },\n    'y1': { out:[],                    in:['h1','h2','h3','h4'], label:'y₁', role:'Output 1' },\n    'y2': { out:[],                    in:['h1','h2','h3','h4'], label:'y₂', role:'Output 2' }\n  };\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tt.style.left = (e.clientX + 12) + 'px';\n    tt.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Show/hide popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Node interactions\n  const nodes = svg.querySelectorAll('[data-node]');\n  const edges = svg.querySelectorAll('[data-edge]');\n  \n  nodes.forEach(node => {\n    const nodeId = node.dataset.node;\n    const nodeInfo = graph[nodeId];\n    \n    node.addEventListener('mouseenter', () => {\n      node.style.strokeWidth = '2.5';\n      node.style.fillOpacity = '0.9';\n      \n      // Highlight outgoing edges\n      edges.forEach(edge => {\n        if (edge.dataset.edge.startsWith(nodeId + '-')) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tt.textContent = `${nodeInfo.label} — ${nodeInfo.role}`;\n      tt.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', () => {\n      node.style.strokeWidth = '1.5';\n      node.style.fillOpacity = '1';\n      \n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      \n      tt.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const title = `${nodeInfo.label} — ${nodeInfo.role}`;\n      const body = `Connections: ${nodeInfo.out.length} outgoing, ${nodeInfo.in.length} incoming`;\n      showPopup(title, body);\n      \n      // Animate signal flow\n      const isBackward = e.shiftKey;\n      const color = isBackward ? '#e05050' : '#4a7ef5';\n      \n      // Reset all edges\n      edges.forEach(e => {\n        e.style.stroke = '#000';\n        e.style.strokeDasharray = '';\n        e.style.strokeDashoffset = '';\n      });\n      \n      if (!isBackward) {\n        // Forward pass\n        animateEdges(Array.from(edges).filter(e => e.dataset.edge.startsWith('x-')), color, 0);\n        animateEdges(Array.from(edges).filter(e => e.dataset.edge.startsWith('h')), color, 650);\n        \n        // Pulse hidden nodes\n        setTimeout(() => {\n          ['h1','h2','h3','h4'].forEach(id => {\n            const n = svg.querySelector(`[data-node=\"${id}\"]`);\n            n.style.transformBox = 'fill-box';\n            n.style.transformOrigin = 'center';\n            n.style.transition = 'transform 0.15s ease';\n            n.style.transform = 'scale(1.18)';\n            setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n          });\n        }, 350);\n        \n        // Pulse output nodes\n        setTimeout(() => {\n          ['y1','y2'].forEach(id => {\n            const n = svg.querySelector(`[data-node=\"${id}\"]`);\n            n.style.transformBox = 'fill-box';\n            n.style.transformOrigin = 'center';\n            n.style.transition = 'transform 0.15s ease';\n            n.style.transform = 'scale(1.18)';\n            setTimeout(() => { n.style.transform = 'scale(1)'; }, 200);\n          });\n        }, 1000);\n      }\n      \n      // Reset after animation\n      setTimeout(() => {\n        edges.forEach(e => {\n          e.style.transition = 'stroke 0.3s ease';\n          e.style.stroke = '#000';\n          e.style.strokeDasharray = '';\n          e.style.strokeDashoffset = '';\n        });\n      }, 2000);\n    });\n  });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  // Data series hover\n  const series = svg.querySelectorAll('[data-series]');\n  series.forEach(line => {\n    line.addEventListener('mouseenter', () => {\n      line.style.strokeWidth = '3';\n      tt.textContent = line.dataset.series;\n      tt.style.display = 'block';\n    });\n    line.addEventListener('mouseleave', () => {\n      line.style.strokeWidth = '2';\n      tt.style.display = 'none';\n    });\n  });\n  \n  // Dismiss popup\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n} catch (e) {\n  console.error('Error:', e);\n}\n</script>\n</body>\n</html>",
