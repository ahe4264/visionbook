  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.tensor { fill:none; stroke:#000; stroke-width:1; }\n.tensor-face { fill:#f0f0f0; stroke:#000; stroke-width:1; }\n.tensor-lines { stroke:#666; stroke-width:0.5; fill:none; }\n.label { font:11px sans-serif; fill:#000; }\n.arrow-path { fill:none; stroke:#000; stroke-width:1; }\n.filter-box { fill:#e8e8e8; stroke:#000; stroke-width:1; rx:3; }\n.filter-text { font:10px sans-serif; fill:#000; text-anchor:middle; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 320 140\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n    <pattern id=\"hatch\" patternUnits=\"userSpaceOnUse\" width=\"4\" height=\"4\" patternTransform=\"rotate(45)\">\n      <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"4\" stroke=\"#999\" stroke-width=\"0.5\"/>\n    </pattern>\n  </defs>\n  \n  <!-- Input tensor (left) -->\n  <g id=\"input-tensor\" transform=\"translate(40,45)\">\n    <!-- Back face -->\n    <path class=\"tensor-face\" d=\"M0,20 L30,0 L30,40 L0,60 Z\"/>\n    <!-- Right face -->\n    <path class=\"tensor-face\" d=\"M30,0 L50,10 L50,50 L30,40 Z\"/>\n    <!-- Top face -->\n    <path class=\"tensor-face\" d=\"M0,20 L20,10 L50,10 L30,0 Z\" fill=\"url(#hatch)\"/>\n    <!-- Hatching lines on top -->\n    <path class=\"tensor-lines\" d=\"M5,17 L25,7 M10,14 L30,4 M15,11 L35,1\"/>\n    <!-- Edges -->\n    <path class=\"tensor\" d=\"M0,20 L30,0 L50,10 L50,50 L30,40 M30,0 L30,40\"/>\n  </g>\n  \n  <!-- Output tensor (right) -->\n  <g id=\"output-tensor\" transform=\"translate(230,45)\">\n    <!-- Back face -->\n    <path class=\"tensor-face\" d=\"M0,20 L30,0 L30,40 L0,60 Z\"/>\n    <!-- Right face -->\n    <path class=\"tensor-face\" d=\"M30,0 L50,10 L50,50 L30,40 Z\"/>\n    <!-- Top face -->\n    <path class=\"tensor-face\" d=\"M0,20 L20,10 L50,10 L30,0 Z\" fill=\"url(#hatch)\"/>\n    <!-- Hatching lines on top -->\n    <path class=\"tensor-lines\" d=\"M5,17 L25,7 M10,14 L30,4 M15,11 L35,1\"/>\n    <!-- Edges -->\n    <path class=\"tensor\" d=\"M0,20 L30,0 L50,10 L50,50 L30,40 M30,0 L30,40\"/>\n  </g>\n  \n  <!-- Arrow -->\n  <line id=\"arrow\" x1=\"95\" y1=\"70\" x2=\"225\" y2=\"70\" class=\"arrow-path\" marker-end=\"url(#arr)\"/>\n  \n  <!-- Filter bank box -->\n  <rect class=\"filter-box\" x=\"125\" y=\"58\" width=\"70\" height=\"24\" rx=\"3\"/>\n  <text class=\"filter-text\" x=\"160\" y=\"67\">Filter Bank with</text>\n  <text class=\"filter-text\" x=\"160\" y=\"77\">3x3 filters</text>\n  \n  <!-- Labels -->\n  <text class=\"label\" x=\"42\" y=\"30\" font-size=\"9\">x<tspan baseline-shift=\"sub\" font-size=\"7\">in</tspan> ∈ ℝ<tspan baseline-shift=\"super\" font-size=\"7\">3×128×128</tspan></text>\n  <text class=\"label\" x=\"225\" y=\"30\" font-size=\"9\">x<tspan baseline-shift=\"sub\" font-size=\"7\">out</tspan> ∈ ℝ<tspan baseline-shift=\"super\" font-size=\"7\">96×128×128</tspan></text>\n  \n  <!-- Dimension labels -->\n  <text class=\"label\" x=\"35\" y=\"110\" font-size=\"9\">128</text>\n  <text class=\"label\" x=\"8\" y=\"110\" font-size=\"9\">128</text>\n  <text class=\"label\" x=\"70\" y=\"75\" font-size=\"9\">3</text>\n  \n  <text class=\"label\" x=\"225\" y=\"110\" font-size=\"9\">128</text>\n  <text class=\"label\" x=\"198\" y=\"110\" font-size=\"9\">128</text>\n  <text class=\"label\" x=\"265\" y=\"75\" font-size=\"9\">96</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const inputTensor = document.getElementById('input-tensor');\n  const outputTensor = document.getElementById('output-tensor');\n  const arrow = document.getElementById('arrow');\n  const filterBox = document.querySelector('.filter-box');\n  \n  // Graph structure\n  const graph = {\n    'input': { out: ['filter'], in: [], label: 'x_in ∈ ℝ³ˣ¹²⁸ˣ¹²⁸', role: 'Input tensor' },\n    'filter': { out: ['output'], in: ['input'], label: 'Filter Bank', role: '3×3 convolution filters' },\n    'output': { out: [], in: ['filter'], label: 'x_out ∈ ℝ⁹⁶ˣ¹²⁸ˣ¹²⁸', role: 'Output tensor' }\n  };\n  \n  // Tooltip handling\n  document.addEventListener('mousemove', e => {\n    if (tooltip.style.display === 'block') {\n      tooltip.style.left = (e.clientX + 12) + 'px';\n      tooltip.style.top = (e.clientY - 28) + 'px';\n    }\n  });\n  \n  function showTooltip(text) {\n    tooltip.textContent = text;\n    tooltip.style.display = 'block';\n  }\n  \n  function hideTooltip() {\n    tooltip.style.display = 'none';\n  }\n  \n  // Popup handling\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  // Input tensor interaction\n  inputTensor.addEventListener('mouseenter', () => {\n    showTooltip('x_in — input tensor');\n    inputTensor.style.opacity = '0.8';\n    arrow.style.stroke = '#e07b30';\n    arrow.style.strokeWidth = '2';\n  });\n  \n  inputTensor.addEventListener('mouseleave', () => {\n    hideTooltip();\n    inputTensor.style.opacity = '1';\n    arrow.style.stroke = '#000';\n    arrow.style.strokeWidth = '1';\n  });\n  \n  inputTensor.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Input Tensor', 'Shape: 3×128×128\\nChannels: 3 (RGB)\\nSpatial dimensions: 128×128 pixels');\n    animateFlow();\n  });\n  \n  // Output tensor interaction\n  outputTensor.addEventListener('mouseenter', () => {\n    showTooltip('x_out — output tensor');\n    outputTensor.style.opacity = '0.8';\n  });\n  \n  outputTensor.addEventListener('mouseleave', () => {\n    hideTooltip();\n    outputTensor.style.opacity = '1';\n  });\n  \n  outputTensor.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('Output Tensor', 'Shape: 96×128×128\\nChannels: 96 (feature maps)\\nSpatial dimensions: 128×128 pixels (preserved)');\n  });\n  \n  // Filter box interaction\n  filterBox.addEventListener('mouseenter', () => {\n    showTooltip('Convolution layer');\n    filterBox.style.fill = '#d0d0d0';\n    arrow.style.stroke = '#e07b30';\n    arrow.style.strokeWidth = '2';\n  });\n  \n  filterBox.addEventListener('mouseleave', () => {\n    hideTooltip();\n    filterBox.style.fill = '#e8e8e8';\n    arrow.style.stroke = '#000';\n    arrow.style.strokeWidth = '1';\n  });\n  \n  filterBox.addEventListener('click', e => {\n    e.stopPropagation();\n    showPopup('3×3 Convolution', 'Kernel size: 3×3\\nInput channels: 3\\nOutput channels: 96\\nStride: 1, Padding: same');\n    animateFlow();\n  });\n  \n  // Flow animation\n  function animateFlow() {\n    // Animate arrow\n    arrow.style.transition = 'none';\n    arrow.style.strokeDasharray = '100';\n    arrow.style.strokeDashoffset = '100';\n    arrow.style.stroke = '#4a7ef5';\n    arrow.style.strokeWidth = '2';\n    \n    requestAnimationFrame(() => {\n      arrow.style.transition = 'stroke-dashoffset 0.6s ease';\n      arrow.style.strokeDashoffset = '0';\n    });\n    \n    // Pulse output after delay\n    setTimeout(() => {\n      outputTensor.style.transformBox = 'fill-box';\n      outputTensor.style.transformOrigin = 'center';\n      outputTensor.style.transition = 'transform 0.15s ease';\n      outputTensor.style.transform = 'scale(1.1)';\n      \n      setTimeout(() => {\n        outputTensor.style.transform = 'scale(1)';\n      }, 200);\n    }, 600);\n    \n    // Reset arrow\n    setTimeout(() => {\n      arrow.style.transition = 'stroke 0.3s ease';\n      arrow.style.stroke = '#000';\n      arrow.style.strokeWidth = '1';\n      arrow.style.strokeDasharray = 'none';\n    }, 1200);\n  }\n  \n} catch (err) {\n  console.error('Interactive error:', err);\n}\n</script>\n</body>\n</html>",
