  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; font-family: sans-serif; }\n        \n        .tooltip {\n            position: fixed;\n            background: rgba(22,22,22,0.88);\n            backdrop-filter: blur(6px);\n            color: #f0f0f0;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 9px;\n            border-radius: 5px;\n            border: 1px solid rgba(255,255,255,0.1);\n            pointer-events: none;\n            z-index: 100;\n            max-width: 240px;\n            opacity: 0;\n            transition: opacity 0.15s ease;\n        }\n        \n        .popup {\n            position: fixed;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: rgba(246,246,246,0.97);\n            backdrop-filter: blur(8px);\n            border-top: 1px solid rgba(0,0,0,0.07);\n            padding: 10px 14px;\n            font: 12px/1.6 sans-serif;\n            color: #1a1a1a;\n            z-index: 101;\n            transform: translateY(100%);\n            transition: transform 0.25s ease;\n        }\n        \n        .popup.show {\n            transform: translateY(0);\n        }\n        \n        .scatter-point {\n            transition: all 0.15s ease;\n            cursor: pointer;\n        }\n        \n        .scatter-point:hover {\n            stroke-width: 2;\n            stroke: #333;\n        }\n        \n        .annotation-box {\n            transition: all 0.15s ease;\n            cursor: pointer;\n        }\n        \n        .annotation-box:hover {\n            stroke: #e07b30;\n            stroke-width: 2;\n        }\n        \n        .trend-line {\n            transition: all 0.15s ease;\n            cursor: pointer;\n        }\n        \n        .trend-line:hover {\n            stroke-width: 3;\n        }\n    </style>\n</head>\n<body>\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 496 216\">\n        <!-- Plot area background -->\n        <rect x=\"120\" y=\"20\" width=\"256\" height=\"156\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\"/>\n        \n        <!-- Grid lines -->\n        <g stroke=\"#ddd\" stroke-width=\"0.5\">\n            <!-- Vertical grid lines -->\n            <line x1=\"171.2\" y1=\"20\" x2=\"171.2\" y2=\"176\"/>\n            <line x1=\"222.4\" y1=\"20\" x2=\"222.4\" y2=\"176\"/>\n            <line x1=\"273.6\" y1=\"20\" x2=\"273.6\" y2=\"176\"/>\n            <line x1=\"324.8\" y1=\"20\" x2=\"324.8\" y2=\"176\"/>\n            \n            <!-- Horizontal grid lines -->\n            <line x1=\"120\" y1=\"59.2\" x2=\"376\" y2=\"59.2\"/>\n            <line x1=\"120\" y1=\"98.4\" x2=\"376\" y2=\"98.4\"/>\n            <line x1=\"120\" y1=\"137.6\" x2=\"376\" y2=\"137.6\"/>\n        </g>\n        \n        <!-- Axes -->\n        <g stroke=\"#000\" stroke-width=\"1\">\n            <!-- X axis -->\n            <line x1=\"120\" y1=\"176\" x2=\"376\" y2=\"176\"/>\n            <!-- Y axis -->\n            <line x1=\"120\" y1=\"20\" x2=\"120\" y2=\"176\"/>\n        </g>\n        \n        <!-- X axis ticks and labels -->\n        <g stroke=\"#000\" stroke-width=\"1\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">\n            <line x1=\"120\" y1=\"176\" x2=\"120\" y2=\"181\"/>\n            <text x=\"120\" y=\"191\" text-anchor=\"middle\">0</text>\n            \n            <line x1=\"171.2\" y1=\"176\" x2=\"171.2\" y2=\"181\"/>\n            <text x=\"171.2\" y=\"191\" text-anchor=\"middle\">5</text>\n            \n            <line x1=\"222.4\" y1=\"176\" x2=\"222.4\" y2=\"181\"/>\n            <text x=\"222.4\" y=\"191\" text-anchor=\"middle\">10</text>\n            \n            <line x1=\"273.6\" y1=\"176\" x2=\"273.6\" y2=\"181\"/>\n            <text x=\"273.6\" y=\"191\" text-anchor=\"middle\">15</text>\n            \n            <line x1=\"324.8\" y1=\"176\" x2=\"324.8\" y2=\"181\"/>\n            <text x=\"324.8\" y=\"191\" text-anchor=\"middle\">20</text>\n        </g>\n        \n        <!-- Y axis ticks and labels -->\n        <g stroke=\"#000\" stroke-width=\"1\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">\n            <line x1=\"120\" y1=\"176\" x2=\"115\" y2=\"176\"/>\n            <text x=\"113\" y=\"179\" text-anchor=\"end\">0</text>\n            \n            <line x1=\"120\" y1=\"137.6\" x2=\"115\" y2=\"137.6\"/>\n            <text x=\"113\" y=\"140.6\" text-anchor=\"end\">50</text>\n            \n            <line x1=\"120\" y1=\"98.4\" x2=\"115\" y2=\"98.4\"/>\n            <text x=\"113\" y=\"101.4\" text-anchor=\"end\">100</text>\n            \n            <line x1=\"120\" y1=\"59.2\" x2=\"115\" y2=\"59.2\"/>\n            <text x=\"113\" y=\"62.2\" text-anchor=\"end\">150</text>\n            \n            <line x1=\"120\" y1=\"20\" x2=\"115\" y2=\"20\"/>\n            <text x=\"113\" y=\"23\" text-anchor=\"end\">200</text>\n        </g>\n        \n        <!-- Axis labels -->\n        <text x=\"248\" y=\"208\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\">Age in years</text>\n        <text x=\"50\" y=\"98\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" transform=\"rotate(-90, 50, 98)\">Height in cm</text>\n        \n        <!-- Trend line (smooth curve through points) -->\n        <path class=\"trend-line\" d=\"M 130.24 146.64 Q 140.48 140.8 150.72 137.6 Q 171.2 131.2 191.68 124.8 Q 212.16 118.4 222.4 115.2 Q 232.64 112 242.88 108.8 Q 253.12 105.6 263.36 102.4 Q 273.6 99.2 283.84 96 Q 294.08 92.8 304.32 89.6 Q 314.56 86.4 324.8 83.2 Q 335.04 80 345.28 76.8 Q 355.52 73.6 365.76 70.4\" \n              fill=\"none\" stroke=\"#66CDAA\" stroke-width=\"2\" data-type=\"trend\"/>\n        \n        <!-- Scatter points -->\n        <g class=\"scatter-points\">\n            <circle class=\"scatter-point\" cx=\"130.24\" cy=\"146.64\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"1\" data-height=\"30\"/>\n            <circle class=\"scatter-point\" cx=\"140.48\" cy=\"137.6\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"2\" data-height=\"40\"/>\n            <circle class=\"scatter-point\" cx=\"150.72\" cy=\"128.56\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"3\" data-height=\"50\"/>\n            <circle class=\"scatter-point\" cx=\"161.04\" cy=\"119.52\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"4\" data-height=\"60\"/>\n            <circle class=\"scatter-point\" cx=\"171.2\" cy=\"110.48\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"5\" data-height=\"70\"/>\n            <circle class=\"scatter-point\" cx=\"181.44\" cy=\"101.44\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"6\" data-height=\"80\"/>\n            <circle class=\"scatter-point\" cx=\"191.68\" cy=\"92.4\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"7\" data-height=\"90\"/>\n            <circle class=\"scatter-point\" cx=\"201.92\" cy=\"83.36\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"8\" data-height=\"100\"/>\n            <circle class=\"scatter-point\" cx=\"212.16\" cy=\"74.32\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"9\" data-height=\"110\"/>\n            <circle class=\"scatter-point\" cx=\"222.4\" cy=\"65.28\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"10\" data-height=\"120\"/>\n            <circle class=\"scatter-point\" cx=\"232.64\" cy=\"56.24\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"11\" data-height=\"130\"/>\n            <circle class=\"scatter-point\" cx=\"242.88\" cy=\"52.72\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"12\" data-height=\"135\"/>\n            <circle class=\"scatter-point\" cx=\"253.12\" cy=\"49.2\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"13\" data-height=\"140\"/>\n            <circle class=\"scatter-point\" cx=\"263.36\" cy=\"45.68\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"14\" data-height=\"145\"/>\n            <circle class=\"scatter-point\" cx=\"273.6\" cy=\"43.92\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"15\" data-height=\"148\"/>\n            <circle class=\"scatter-point\" cx=\"283.84\" cy=\"42.16\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"16\" data-height=\"150\"/>\n            <circle class=\"scatter-point\" cx=\"294.08\" cy=\"38.64\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"17\" data-height=\"155\"/>\n            <circle class=\"scatter-point\" cx=\"304.32\" cy=\"35.12\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"18\" data-height=\"160\"/>\n            <circle class=\"scatter-point\" cx=\"314.56\" cy=\"31.6\" r=\"3\" fill=\"#D2691E\" stroke=\"none\" data-age=\"19\" data-height=\"165\"/>\n        </g>\n        \n        <!-- Left annotation box -->\n        <g class=\"annotation-box\" data-type=\"age-annotation\">\n            <rect x=\"22\" y=\"68\" width=\"88\" height=\"35\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"66\" y=\"82\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Age of child</text>\n            <text x=\"66\" y=\"94\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">is 10 years</text>\n        </g>\n        \n        <!-- Arrow from left annotation to point -->\n        <path d=\"M 110 85.5 L 220 85.5 L 220 65\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n        <text x=\"116\" y=\"81\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">[10]</text>\n        \n        <!-- Right annotation box -->\n        <g class=\"annotation-box\" data-type=\"height-annotation\">\n            <rect x=\"386\" y=\"68\" width=\"88\" height=\"35\" fill=\"white\" stroke=\"#000\" stroke-width=\"1\"/>\n            <text x=\"430\" y=\"82\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">Height of child</text>\n            <text x=\"430\" y=\"94\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">is 139 cms</text>\n        </g>\n        \n        <!-- Arrow from right annotation to axis -->\n        <path d=\"M 386 85.5 L 250 85.5 L 250 65\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\"/>\n        <text x=\"380\" y=\"81\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#000\">[139]</text>\n        \n        <!-- Arrow marker definition -->\n        <defs>\n            <marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n                <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n            </marker>\n        </defs>\n    </svg>\n    \n    <div class=\"tooltip\" id=\"tooltip\"></div>\n    <div class=\"popup\" id=\"popup\"></div>\n\n    <script>\n        try {\n            const tooltip = document.getElementById('tooltip');\n            const popup = document.getElementById('popup');\n            \n            // Show tooltip\n            function showTooltip(e, content) {\n                tooltip.innerHTML = content;\n                tooltip.style.left = (e.pageX + 10) + 'px';\n                tooltip.style.top = (e.pageY - 10) + 'px';\n                tooltip.style.opacity = '1';\n            }\n            \n            // Hide tooltip\n            function hideTooltip() {\n                tooltip.style.opacity = '0';\n            }\n            \n            // Show popup\n            function showPopup(content) {\n                popup.innerHTML = content;\n                popup.classList.add('show');\n            }\n            \n            // Hide popup\n            function hidePopup() {\n                popup.classList.remove('show');\n            }\n            \n            // Add hover and click events to scatter points\n            document.querySelectorAll('.scatter-point').forEach(point => {\n                point.addEventListener('mouseenter', (e) => {\n                    const age = e.target.getAttribute('data-age');\n                    const height = e.target.getAttribute('data-height');\n                    showTooltip(e, `Age: ${age} years<br>Height: ${height} cm`);\n                });\n                \n                point.addEventListener('mouseleave', hideTooltip);\n                \n                point.addEventListener('click', (e) => {\n                    const age = e.target.getAttribute('data-age');\n                    const height = e.target.getAttribute('data-height');\n                    showPopup(`\n                        <strong>Data Point: Child at Age ${age}</strong><br>\n                        Height: ${height} cm<br><br>\n                        This scatter plot shows the relationship between a child's age and height. \n                        Each point represents a measurement at a specific age. The trend line shows \n                        the general pattern of growth, with rapid growth in early years that \n                        gradually slows down as children approach adulthood.\n                    `);\n                });\n            });\n            \n            // Add hover and click events to trend line\n            document.querySelector('.trend-line').addEventListener('mouseenter', (e) => {\n                showTooltip(e, 'Trend line showing growth pattern');\n            });\n            \n            document.querySelector('.trend-line').addEventListener('mouseleave', hideTooltip);\n            \n            document.querySelector('.trend-line').addEventListener('click', () => {\n                showPopup(`\n                    <strong>Growth Trend Line</strong><br><br>\n                    This smooth curve represents the general pattern of height growth over age. \n                    It shows that growth is rapid in early childhood, then gradually slows down. \n                    The curve helps visualize the relationship between age and height, making it \n                    easier to predict expected heights at different ages.\n                `);\n            });\n            \n            // Add events to annotation boxes\n            document.querySelectorAll('.annotation-box').forEach(box => {\n                box.addEventListener('mouseenter', (e) => {\n                    const type = e.currentTarget.getAttribute('data-type');\n                    if (type === 'age-annotation') {\n                        showTooltip(e, 'Age reference annotation');\n                    } else if (type === 'height-annotation') {\n                        showTooltip(e, 'Height reference annotation');\n                    }\n                });\n                \n                box.addEventListener('mouseleave', hideTooltip);\n                \n                box.addEventListener('click', (e) => {\n                    const type = e.currentTarget.getAttribute('data-type');\n                    if (type === 'age-annotation') {\n                        showPopup(`\n                            <strong>Age Reference (10 years)</strong><br><br>\n                            This annotation highlights a specific data point at age 10 years. \n                            At this age, the child's height is approximately 120 cm. This serves \n                            as a reference point to understand the growth pattern at a particular age.\n                        `);\n                    } else if (type === 'height-annotation') {\n                        showPopup(`\n                            <strong>Height Reference (139 cm)</strong><br><br>\n                            This annotation shows the height axis reference. The value of 139 cm \n                            represents a height measurement that can be used to read corresponding \n                            ages from the scatter plot. It demonstrates how to interpret the \n                            age-height relationship from the graph.\n                        `);\n                    }\n                });\n            });\n            \n            // Close popup on escape key or click outside\n            document.addEventListener('keydown', (e) => {\n                if (e.key === 'Escape') {\n                    hidePopup();\n                }\n            });\n            \n            document.addEventListener('click', (e) => {\n                if (!e.target.closest('.scatter-point, .trend-line, .annotation-box') && \n                    !e.target.closest('.popup')) {\n                    hidePopup();\n                }\n            });\n            \n        } catch (error) {\n            console.error('Error in interactive scatter plot:', error);\n        }\n    </script>\n</body>\n</html>",
