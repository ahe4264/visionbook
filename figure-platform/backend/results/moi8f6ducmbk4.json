  "filename": "figure_124",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 615\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <clipPath id=\"plotClip\">\n      <rect x=\"80\" y=\"40\" width=\"480\" height=\"480\"/>\n    </clipPath>\n  </defs>\n  \n  <!-- Plot frame -->\n  <rect x=\"80\" y=\"40\" width=\"480\" height=\"480\" fill=\"none\" stroke=\"#222\" stroke-width=\"1.5\"/>\n  \n  <!-- X-axis ticks and labels -->\n  <g id=\"xAxis\">\n    <!-- Major ticks -->\n    <line x1=\"80\" y1=\"520\" x2=\"80\" y2=\"530\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"80\" y=\"545\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">0</text>\n    \n    <line x1=\"320\" y1=\"520\" x2=\"320\" y2=\"530\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"320\" y=\"545\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">1</text>\n    \n    <line x1=\"560\" y1=\"520\" x2=\"560\" y2=\"530\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"560\" y=\"545\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">2</text>\n    \n    <!-- Minor ticks -->\n    <line x1=\"128\" y1=\"520\" x2=\"128\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"176\" y1=\"520\" x2=\"176\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"224\" y1=\"520\" x2=\"224\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"272\" y1=\"520\" x2=\"272\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"368\" y1=\"520\" x2=\"368\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"416\" y1=\"520\" x2=\"416\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"464\" y1=\"520\" x2=\"464\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"512\" y1=\"520\" x2=\"512\" y2=\"526\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    \n    <!-- X-axis label -->\n    <text x=\"320\" y=\"580\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">Input, <tspan font-style=\"italic\">x</tspan></text>\n  </g>\n  \n  <!-- Y-axis ticks and labels -->\n  <g id=\"yAxis\">\n    <!-- Major ticks -->\n    <line x1=\"80\" y1=\"520\" x2=\"70\" y2=\"520\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"55\" y=\"525\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">0</text>\n    \n    <line x1=\"80\" y1=\"280\" x2=\"70\" y2=\"280\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"55\" y=\"285\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">1</text>\n    \n    <line x1=\"80\" y1=\"40\" x2=\"70\" y2=\"40\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"55\" y=\"45\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\">2</text>\n    \n    <!-- Minor ticks -->\n    <line x1=\"80\" y1=\"472\" x2=\"74\" y2=\"472\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"424\" x2=\"74\" y2=\"424\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"376\" x2=\"74\" y2=\"376\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"328\" x2=\"74\" y2=\"328\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"232\" x2=\"74\" y2=\"232\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"184\" x2=\"74\" y2=\"184\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"136\" x2=\"74\" y2=\"136\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    <line x1=\"80\" y1=\"88\" x2=\"74\" y2=\"88\" stroke=\"#222\" stroke-width=\"0.5\"/>\n    \n    <!-- Y-axis label -->\n    <text x=\"20\" y=\"280\" text-anchor=\"middle\" font-size=\"11\" fill=\"#444\" font-family=\"serif\" transform=\"rotate(-90 20 280)\">Output, <tspan font-style=\"italic\">y</tspan></text>\n  </g>\n  \n  <!-- Plot lines -->\n  <g clip-path=\"url(#plotClip)\">\n    <!-- Line 1: y = x (orange-red) -->\n    <line id=\"line1\" x1=\"80\" y1=\"520\" x2=\"560\" y2=\"40\" stroke=\"#d97b58\" stroke-width=\"1.5\" data-equation=\"y = x\" data-phi0=\"0.0\" data-phi1=\"1.0\"/>\n    \n    <!-- Line 2: y = 1.0 - 0.4x (dark gray) -->\n    <line id=\"line2\" x1=\"80\" y1=\"280\" x2=\"560\" y2=\"472\" stroke=\"#4d545a\" stroke-width=\"1.5\" data-equation=\"y = 1.0 - 0.4x\" data-phi0=\"1.0\" data-phi1=\"-0.4\"/>\n    \n    <!-- Line 3: y = 1.2 - 0.1x (cyan) -->\n    <line id=\"line3\" x1=\"80\" y1=\"232\" x2=\"560\" y2=\"280\" stroke=\"#91d8d3\" stroke-width=\"1.5\" data-equation=\"y = 1.2 - 0.1x\" data-phi0=\"1.2\" data-phi1=\"-0.1\"/>\n  </g>\n  \n  <!-- Line labels -->\n  <text x=\"400\" y=\"175\" font-size=\"11\" fill=\"#d97b58\" font-family=\"sans-serif\" transform=\"rotate(45 400 175)\">φ₀ = 0.0, φ₁ = 1.0</text>\n  <text x=\"354\" y=\"358\" font-size=\"11\" fill=\"#4d545a\" font-family=\"sans-serif\" transform=\"rotate(-22 354 358)\">φ₀ = 1.0, φ₁ = −0.4</text>\n  <text x=\"194\" y=\"246\" font-size=\"11\" fill=\"#91d8d3\" font-family=\"sans-serif\" transform=\"rotate(-5 194 246)\">φ₀ = 1.2, φ₁ = −0.1</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const svg = document.querySelector('svg');\n  let currentHighlight = null;\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type:'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type:'alex-popup', title:null }, '*');\n  }\n  \n  // Escape key to close popup\n  document.addEventListener('keydown', e => {\n    if(e.key === 'Escape') hidePopup();\n  });\n  \n  // Click on background to close popup\n  svg.addEventListener('click', e => {\n    if(e.target === svg || e.target.tagName === 'svg' || e.target.id === 'xAxis' || e.target.id === 'yAxis') {\n      hidePopup();\n    }\n  });\n  \n  // Track mouse for tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Add interactivity to lines\n  const lines = document.querySelectorAll('line[data-equation]');\n  \n  lines.forEach(line => {\n    // Store original values\n    line.dataset.originalStroke = line.getAttribute('stroke');\n    line.dataset.originalWidth = line.getAttribute('stroke-width');\n    line.style.cursor = 'pointer';\n    line.style.transition = 'stroke-width 0.2s ease, opacity 0.2s ease';\n    \n    // Hover effect\n    line.addEventListener('mouseenter', () => {\n      line.style.strokeWidth = '3';\n      line.style.opacity = '1';\n      tooltip.textContent = `${line.dataset.equation} | Slope: ${line.dataset.phi1}, Intercept: ${line.dataset.phi0}`;\n      tooltip.style.display = 'block';\n    });\n    \n    line.addEventListener('mouseleave', () => {\n      line.style.strokeWidth = line.dataset.originalWidth;\n      line.style.opacity = '1';\n      tooltip.style.display = 'none';\n    });\n    \n    // Click to show popup\n    line.addEventListener('click', (e) => {\n      e.stopPropagation();\n      const phi0 = parseFloat(line.dataset.phi0);\n      const phi1 = parseFloat(line.dataset.phi1);\n      const equation = line.dataset.equation;\n      \n      let explanation = '';\n      if(phi1 > 0) {\n        explanation = `This line has a positive slope (φ₁ = ${phi1}), meaning y increases as x increases. `;\n      } else if(phi1 < 0) {\n        explanation = `This line has a negative slope (φ₁ = ${phi1}), meaning y decreases as x increases. `;\n      } else {\n        explanation = `This line has zero slope (φ₁ = 0), meaning it's horizontal. `;\n      }\n      \n      if(phi0 > 0) {\n        explanation += `It intersects the y-axis above the origin at y = ${phi0}.`;\n      } else if(phi0 < 0) {\n        explanation += `It intersects the y-axis below the origin at y = ${phi0}.`;\n      } else {\n        explanation += `It passes through the origin (0, 0).`;\n      }\n      \n      showPopup(`Linear Function: ${equation}`, explanation);\n      \n      // Highlight animation\n      if(currentHighlight) {\n        currentHighlight.style.stroke = currentHighlight.dataset.originalStroke;\n      }\n      line.style.stroke = '#ffcc00';\n      currentHighlight = line;\n      \n      setTimeout(() => {\n        line.style.stroke = line.dataset.originalStroke;\n        currentHighlight = null;\n      }, 2000);\n    });\n  });\n  \n  // Add axis interactivity\n  document.getElementById('xAxis').style.cursor = 'help';\n  document.getElementById('yAxis').style.cursor = 'help';\n  \n  document.getElementById('xAxis').addEventListener('click', (e) => {\n    e.stopPropagation();\n    showPopup('X-Axis: Input', 'The horizontal axis represents the input variable x, ranging from 0 to 2. Each linear function transforms this input according to its equation y = φ₀ + φ₁x.');\n  });\n  \n  document.getElementById('yAxis').addEventListener('click', (e) => {\n    e.stopPropagation();\n    showPopup('Y-Axis: Output', 'The vertical axis represents the output variable y, ranging from 0 to 2. The value of y depends on both the input x and the parameters φ₀ (intercept) and φ₁ (slope).');\n  });\n\n} catch(err) {\n  console.error('Interactive figure error:', err);\n}\n</script>\n</body>\n</html>",
