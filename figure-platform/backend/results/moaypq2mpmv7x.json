  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #fff; }\n.tooltip {\n  position: fixed;\n  background: rgba(0,0,0,0.55);\n  color: #fff;\n  font: 11px/1.4 sans-serif;\n  padding: 5px 8px;\n  border-radius: 4px;\n  pointer-events: none;\n  z-index: 100;\n  max-width: 200px;\n  display: none;\n}\n.popup {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: rgba(245,245,245,0.94);\n  backdrop-filter: blur(6px);\n  border-top: 1px solid rgba(0,0,0,0.1);\n  padding: 8px 12px;\n  font: 12px/1.5 sans-serif;\n  color: #333;\n  z-index: 101;\n  box-shadow: 0 -2px 12px rgba(0,0,0,0.08);\n  display: none;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 800 200\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"8\" refY=\"4\" orient=\"auto\" markerUnits=\"strokeWidth\" fill=\"#333\">\n      <path d=\"M0,0 L0,8 L8,4 z\"/>\n    </marker>\n  </defs>\n  \n  <!-- Stage 1: 3 channels -->\n  <g transform=\"translate(40, 50)\">\n    <!-- Input layer -->\n    <rect class=\"layer\" data-id=\"input\" x=\"0\" y=\"20\" width=\"20\" height=\"60\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"5\" y=\"25\" width=\"10\" height=\"50\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <!-- Arrow -->\n    <line x1=\"25\" y1=\"50\" x2=\"45\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- BN block -->\n    <rect class=\"block\" data-id=\"bn1\" x=\"50\" y=\"40\" width=\"20\" height=\"20\" fill=\"#FF6B35\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"60\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">BN</text>\n    <!-- Arrow -->\n    <line x1=\"75\" y1=\"50\" x2=\"95\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- ReLU block -->\n    <rect class=\"block\" data-id=\"relu1\" x=\"100\" y=\"40\" width=\"20\" height=\"20\" fill=\"#4A90E2\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"110\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">ReLU</text>\n    <!-- Arrow -->\n    <line x1=\"125\" y1=\"50\" x2=\"145\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Conv block -->\n    <rect class=\"block\" data-id=\"conv1\" x=\"150\" y=\"40\" width=\"30\" height=\"20\" fill=\"#7CB342\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"165\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">Conv</text>\n    <!-- Arrow -->\n    <line x1=\"185\" y1=\"50\" x2=\"205\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Output layer -->\n    <rect class=\"layer\" data-id=\"output1\" x=\"210\" y=\"15\" width=\"20\" height=\"70\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"215\" y=\"20\" width=\"10\" height=\"60\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <!-- Label -->\n    <text x=\"120\" y=\"15\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">Concatenate to output</text>\n    <text x=\"20\" y=\"105\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">3 channels</text>\n    <text x=\"100\" y=\"105\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">32+3=35 channels</text>\n  </g>\n\n  <!-- Stage 2: 35 channels -->\n  <g transform=\"translate(290, 50)\">\n    <!-- Input layer (35 channels - wider) -->\n    <rect class=\"layer\" data-id=\"input2\" x=\"0\" y=\"15\" width=\"25\" height=\"70\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"5\" y=\"20\" width=\"15\" height=\"60\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <rect x=\"8\" y=\"23\" width=\"10\" height=\"54\" fill=\"#708090\" opacity=\"0.3\"/>\n    <!-- Arrow -->\n    <line x1=\"30\" y1=\"50\" x2=\"45\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- BN block -->\n    <rect class=\"block\" data-id=\"bn2\" x=\"50\" y=\"40\" width=\"20\" height=\"20\" fill=\"#FF6B35\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"60\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">BN</text>\n    <!-- Arrow -->\n    <line x1=\"75\" y1=\"50\" x2=\"95\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- ReLU block -->\n    <rect class=\"block\" data-id=\"relu2\" x=\"100\" y=\"40\" width=\"20\" height=\"20\" fill=\"#4A90E2\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"110\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">ReLU</text>\n    <!-- Arrow -->\n    <line x1=\"125\" y1=\"50\" x2=\"145\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Conv block -->\n    <rect class=\"block\" data-id=\"conv2\" x=\"150\" y=\"40\" width=\"30\" height=\"20\" fill=\"#7CB342\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"165\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">Conv</text>\n    <!-- Arrow -->\n    <line x1=\"185\" y1=\"50\" x2=\"205\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Output layer -->\n    <rect class=\"layer\" data-id=\"output2\" x=\"210\" y=\"10\" width=\"30\" height=\"80\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"215\" y=\"15\" width=\"20\" height=\"70\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <rect x=\"220\" y=\"20\" width=\"12\" height=\"60\" fill=\"#708090\" opacity=\"0.3\"/>\n    <!-- Label -->\n    <text x=\"120\" y=\"15\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">Concatenate to output</text>\n    <text x=\"100\" y=\"105\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">32+35=67 channels</text>\n  </g>\n\n  <!-- Stage 3: 67 channels -->\n  <g transform=\"translate(540, 50)\">\n    <!-- Input layer (67 channels - even wider) -->\n    <rect class=\"layer\" data-id=\"input3\" x=\"0\" y=\"10\" width=\"35\" height=\"80\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"5\" y=\"15\" width=\"25\" height=\"70\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <rect x=\"10\" y=\"20\" width=\"18\" height=\"60\" fill=\"#708090\" opacity=\"0.3\"/>\n    <rect x=\"14\" y=\"25\" width=\"12\" height=\"50\" fill=\"#4682B4\" opacity=\"0.3\"/>\n    <!-- Arrow -->\n    <line x1=\"40\" y1=\"50\" x2=\"45\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- BN block -->\n    <rect class=\"block\" data-id=\"bn3\" x=\"50\" y=\"40\" width=\"20\" height=\"20\" fill=\"#FF6B35\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"60\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">BN</text>\n    <!-- Arrow -->\n    <line x1=\"75\" y1=\"50\" x2=\"95\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- ReLU block -->\n    <rect class=\"block\" data-id=\"relu3\" x=\"100\" y=\"40\" width=\"20\" height=\"20\" fill=\"#4A90E2\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"110\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">ReLU</text>\n    <!-- Arrow -->\n    <line x1=\"125\" y1=\"50\" x2=\"145\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Conv block -->\n    <rect class=\"block\" data-id=\"conv3\" x=\"150\" y=\"40\" width=\"30\" height=\"20\" fill=\"#7CB342\" stroke=\"#333\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"165\" y=\"54\" font-family=\"sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"#fff\">Conv</text>\n    <!-- Arrow -->\n    <line x1=\"185\" y1=\"50\" x2=\"205\" y2=\"50\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\n    <!-- Output layer -->\n    <rect class=\"layer\" data-id=\"output3\" x=\"210\" y=\"5\" width=\"40\" height=\"90\" fill=\"none\" stroke=\"#8B4513\" stroke-width=\"2\"/>\n    <rect x=\"215\" y=\"10\" width=\"30\" height=\"80\" fill=\"#D2691E\" opacity=\"0.3\"/>\n    <rect x=\"220\" y=\"15\" width=\"22\" height=\"70\" fill=\"#708090\" opacity=\"0.3\"/>\n    <rect x=\"225\" y=\"20\" width=\"14\" height=\"60\" fill=\"#4682B4\" opacity=\"0.3\"/>\n    <!-- Label -->\n    <text x=\"120\" y=\"15\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">Concatenate to output</text>\n    <text x=\"100\" y=\"105\" font-family=\"sans-serif\" font-size=\"11\" text-anchor=\"middle\">32+67=99 channels</text>\n  </g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  const popup = document.getElementById('popup');\n  \n  const descriptions = {\n    'input': 'Input layer with initial channels',\n    'bn1': 'Batch Normalization: Normalizes inputs to stabilize training',\n    'relu1': 'ReLU activation: Introduces non-linearity (max(0, x))',\n    'conv1': 'Convolution: 3×3 filters extract features, outputting 32 channels',\n    'output1': 'Concatenated output: Original channels + 32 new channels',\n    'input2': 'Input from previous stage (35 channels total)',\n    'bn2': 'Batch Normalization for 35-channel input',\n    'relu2': 'ReLU activation on normalized features',\n    'conv2': 'Convolution: Processes 35 channels, outputs 32 more',\n    'output2': 'Concatenated output: 35 + 32 = 67 channels',\n    'input3': 'Input from previous stage (67 channels total)',\n    'bn3': 'Batch Normalization for 67-channel input',\n    'relu3': 'ReLU activation on normalized features',\n    'conv3': 'Convolution: Processes 67 channels, outputs 32 more',\n    'output3': 'Final concatenated output: 67 + 32 = 99 channels'\n  };\n  \n  const popupContent = {\n    'input': 'The network starts with a 3-channel input (e.g., RGB image). Each stage preserves all previous channels through concatenation, creating a dense connection pattern.',\n    'bn1': 'Batch Normalization normalizes the input distribution across the batch, helping with gradient flow and allowing higher learning rates. It computes: y = γ((x - μ)/σ) + β',\n    'relu1': 'ReLU (Rectified Linear Unit) applies f(x) = max(0, x), introducing non-linearity while maintaining efficient gradient propagation for positive values.',\n    'conv1': 'A 3×3 convolutional layer processes the input to extract local features. It outputs 32 new feature channels while preserving spatial dimensions.',\n    'output1': 'Concatenation combines the original 3 channels with the 32 new channels, resulting in 35 channels. This preserves information flow through the network.',\n    'output2': 'The concatenation pattern continues: 35 input channels + 32 new channels = 67 total. This dense connectivity helps gradient flow and feature reuse.',\n    'output3': 'Final stage: 67 + 32 = 99 channels. This architecture is characteristic of DenseNet, where each layer receives all preceding features.'\n  };\n  \n  // Hover interactions\n  document.querySelectorAll('.block, .layer').forEach(elem => {\n    elem.addEventListener('mouseenter', (e) => {\n      const id = e.target.dataset.id;\n      if (descriptions[id]) {\n        tooltip.textContent = descriptions[id];\n        tooltip.style.display = 'block';\n        elem.style.cursor = 'pointer';\n        if (e.target.classList.contains('block')) {\n          e.target.style.strokeWidth = '2';\n        } else {\n          e.target.style.strokeWidth = '3';\n        }\n      }\n    });\n    \n    elem.addEventListener('mousemove', (e) => {\n      tooltip.style.left = (e.clientX + 10) + 'px';\n      tooltip.style.top = (e.clientY - 30) + 'px';\n    });\n    \n    elem.addEventListener('mouseleave', (e) => {\n      tooltip.style.display = 'none';\n      if (e.target.classList.contains('block')) {\n        e.target.style.strokeWidth = '1';\n      } else {\n        e.target.style.strokeWidth = '2';\n      }\n    });\n    \n    elem.addEventListener('click', (e) => {\n      const id = e.target.dataset.id;\n      if (popupContent[id]) {\n        popup.innerHTML = popupContent[id];\n        popup.style.display = 'block';\n        e.stopPropagation();\n      }\n    });\n  });\n  \n  // Close popup on outside click or Escape\n  document.addEventListener('click', () => {\n    popup.style.display = 'none';\n  });\n  \n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      popup.style.display = 'none';\n    }\n  });\n  \n  popup.addEventListener('click', (e) => {\n    e.stopPropagation();\n  });\n\n} catch (error) {\n  console.error('Interaction error:', error);\n}\n</script>\n\n</body>\n</html>",
