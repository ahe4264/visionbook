  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 487 155\">\n  <defs>\n    <marker id=\"arr-gray\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#999\"/>\n    </marker>\n    <marker id=\"arr-black\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel a) -->\n  <text x=\"15\" y=\"25\" font-family=\"sans-serif\" font-size=\"12\">a)</text>\n  \n  <!-- Panel a) nodes -->\n  <circle cx=\"60\" cy=\"78\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"a-1\"/>\n  <text x=\"60\" y=\"82\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">1</text>\n  \n  <circle cx=\"60\" cy=\"118\" r=\"16\" fill=\"#000\" stroke=\"#000\" stroke-width=\"1\" id=\"a-x\"/>\n  <text x=\"60\" y=\"122\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#fff\">x</text>\n  \n  <circle cx=\"120\" cy=\"58\" r=\"16\" fill=\"#ddd\" stroke=\"#000\" stroke-width=\"1\" id=\"a-h1\"/>\n  <text x=\"120\" y=\"62\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₁</text>\n  <path d=\"M110,58 Q115,54 120,58 Q125,62 130,58\" fill=\"none\" stroke=\"#2a9d8f\" stroke-width=\"1.5\"/>\n  \n  <circle cx=\"120\" cy=\"98\" r=\"16\" fill=\"#ddd\" stroke=\"#000\" stroke-width=\"1\" id=\"a-h2\"/>\n  <text x=\"120\" y=\"102\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₂</text>\n  <path d=\"M110,98 Q115,94 120,98 Q125,102 130,98\" fill=\"none\" stroke=\"#2a9d8f\" stroke-width=\"1.5\"/>\n  \n  <circle cx=\"120\" cy=\"138\" r=\"16\" fill=\"#ddd\" stroke=\"#000\" stroke-width=\"1\" id=\"a-h3\"/>\n  <text x=\"120\" y=\"142\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₃</text>\n  <path d=\"M110,138 Q115,134 120,138 Q125,142 130,138\" fill=\"none\" stroke=\"#2a9d8f\" stroke-width=\"1.5\"/>\n  \n  <circle cx=\"180\" cy=\"98\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"a-y\"/>\n  <text x=\"180\" y=\"102\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">y</text>\n  \n  <!-- Panel a) edges -->\n  <line x1=\"76\" y1=\"78\" x2=\"104\" y2=\"58\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e1\"/>\n  <text x=\"85\" y=\"63\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₁₁</text>\n  \n  <line x1=\"76\" y1=\"78\" x2=\"104\" y2=\"98\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e2\"/>\n  <text x=\"85\" y=\"92\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₂₁</text>\n  \n  <line x1=\"76\" y1=\"78\" x2=\"104\" y2=\"138\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e3\"/>\n  <text x=\"85\" y=\"112\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₃₁</text>\n  \n  <line x1=\"76\" y1=\"118\" x2=\"104\" y2=\"98\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e4\"/>\n  <text x=\"85\" y=\"105\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₂₂</text>\n  \n  <line x1=\"76\" y1=\"118\" x2=\"104\" y2=\"138\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e5\"/>\n  <text x=\"85\" y=\"132\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₃₂</text>\n  \n  <line x1=\"136\" y1=\"58\" x2=\"164\" y2=\"98\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e6\"/>\n  <text x=\"145\" y=\"73\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">ψ₁₁</text>\n  \n  <line x1=\"136\" y1=\"98\" x2=\"164\" y2=\"98\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e7\"/>\n  <text x=\"145\" y=\"92\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">ψ₂₁</text>\n  \n  <line x1=\"136\" y1=\"138\" x2=\"164\" y2=\"98\" stroke=\"#999\" stroke-width=\"1\" marker-end=\"url(#arr-gray)\" id=\"a-e8\"/>\n  <text x=\"145\" y=\"128\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">ψ₃₁</text>\n  \n  <circle cx=\"120\" cy=\"28\" r=\"16\" fill=\"#fff\" stroke=\"#e07b30\" stroke-width=\"1.5\" id=\"a-1b\"/>\n  <text x=\"120\" y=\"32\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#e07b30\">1</text>\n  \n  <line x1=\"120\" y1=\"44\" x2=\"120\" y2=\"42\" stroke=\"#e07b30\" stroke-width=\"1.5\" marker-end=\"url(#arr-gray)\" id=\"a-e9\"/>\n  <text x=\"105\" y=\"48\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₁₀</text>\n  \n  <line x1=\"120\" y1=\"44\" x2=\"120\" y2=\"82\" stroke=\"#e07b30\" stroke-width=\"1.5\" marker-end=\"url(#arr-gray)\" id=\"a-e10\"/>\n  <text x=\"105\" y=\"65\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₂₀</text>\n  \n  <line x1=\"120\" y1=\"44\" x2=\"120\" y2=\"122\" stroke=\"#e07b30\" stroke-width=\"1.5\" marker-end=\"url(#arr-gray)\" id=\"a-e11\"/>\n  <text x=\"105\" y=\"85\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\">θ₃₀</text>\n  \n  <!-- Panel b) -->\n  <text x=\"255\" y=\"25\" font-family=\"sans-serif\" font-size=\"12\">b)</text>\n  \n  <!-- Panel b) nodes -->\n  <circle cx=\"290\" cy=\"98\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"b-x\"/>\n  <text x=\"290\" y=\"102\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">x</text>\n  \n  <circle cx=\"350\" cy=\"58\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"b-h1\"/>\n  <text x=\"350\" y=\"62\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₁</text>\n  \n  <circle cx=\"350\" cy=\"98\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"b-h2\"/>\n  <text x=\"350\" y=\"102\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₂</text>\n  \n  <circle cx=\"350\" cy=\"138\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"b-h3\"/>\n  <text x=\"350\" y=\"142\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\">h₃</text>\n  \n  <circle cx=\"410\" cy=\"98\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" id=\"b-y\"/>\n  <text x=\"410\" y=\"102\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\">y</text>\n  \n  <!-- Panel b) edges -->\n  <line x1=\"306\" y1=\"98\" x2=\"334\" y2=\"58\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e1\"/>\n  <line x1=\"306\" y1=\"98\" x2=\"334\" y2=\"98\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e2\"/>\n  <line x1=\"306\" y1=\"98\" x2=\"334\" y2=\"138\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e3\"/>\n  \n  <line x1=\"366\" y1=\"58\" x2=\"394\" y2=\"98\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e4\"/>\n  <line x1=\"366\" y1=\"98\" x2=\"394\" y2=\"98\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e5\"/>\n  <line x1=\"366\" y1=\"138\" x2=\"394\" y2=\"98\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr-black)\" id=\"b-e6\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst graphA = {\n  '1': { out:['h1','h2','h3'], in:[], label:'1', role:'Bias unit' },\n  'x': { out:['h2','h3'], in:[], label:'x', role:'Input' },\n  'h1': { out:['y'], in:['1'], label:'h₁', role:'Hidden unit 1' },\n  'h2': { out:['y'], in:['1','x'], label:'h₂', role:'Hidden unit 2' },\n  'h3': { out:['y'], in:['1','x'], label:'h₃', role:'Hidden unit 3' },\n  'y': { out:[], in:['h1','h2','h3'], label:'y', role:'Output' }\n};\nconst graphB = {\n  'x': { out:['h1','h2','h3'], in:[], label:'x', role:'Input' },\n  'h1': { out:['y'], in:['x'], label:'h₁', role:'Hidden unit 1' },\n  'h2': { out:['y'], in:['x'], label:'h₂', role:'Hidden unit 2' },\n  'h3': { out:['y'], in:['x'], label:'h₃', role:'Hidden unit 3' },\n  'y': { out:[], in:['h1','h2','h3'], label:'y', role:'Output' }\n};\n\nconst edgeMapA = {\n  'a-e1': {from:'1',to:'h1'}, 'a-e2': {from:'1',to:'h2'}, 'a-e3': {from:'1',to:'h3'},\n  'a-e4': {from:'x',to:'h2'}, 'a-e5': {from:'x',to:'h3'},\n  'a-e6': {from:'h1',to:'y'}, 'a-e7': {from:'h2',to:'y'}, 'a-e8': {from:'h3',to:'y'},\n  'a-e9': {from:'1',to:'h1'}, 'a-e10': {from:'1',to:'h2'}, 'a-e11': {from:'1',to:'h3'}\n};\nconst edgeMapB = {\n  'b-e1': {from:'x',to:'h1'}, 'b-e2': {from:'x',to:'h2'}, 'b-e3': {from:'x',to:'h3'},\n  'b-e4': {from:'h1',to:'y'}, 'b-e5': {from:'h2',to:'y'}, 'b-e6': {from:'h3',to:'y'}\n};\n\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('mousemove', e => {\n  if (tooltip.style.display === 'block') {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  }\n});\n\nfunction setupNode(el, nodeId, graph, prefix) {\n  const nodeData = graph[nodeId];\n  if (!nodeData) return;\n  \n  el.addEventListener('mouseenter', () => {\n    el.style.strokeWidth = '2.5';\n    el.style.fillOpacity = '0.8';\n    tooltip.textContent = `${nodeData.label} — ${nodeData.role}`;\n    tooltip.style.display = 'block';\n    \n    const outEdges = [];\n    for (const [edgeId, edge] of Object.entries(prefix === 'a' ? edgeMapA : edgeMapB)) {\n      if (edge.from === nodeId) {\n        const edgeEl = document.getElementById(edgeId);\n        if (edgeEl) {\n          edgeEl.style.stroke = '#e07b30';\n          edgeEl.style.strokeWidth = '2';\n          outEdges.push(edgeEl);\n        }\n      }\n    }\n  });\n  \n  el.addEventListener('mouseleave', () => {\n    el.style.strokeWidth = '1';\n    el.style.fillOpacity = '1';\n    tooltip.style.display = 'none';\n    \n    document.querySelectorAll('line').forEach(e => {\n      e.style.stroke = e.id.startsWith('a-') ? '#999' : '#000';\n      e.style.strokeWidth = '1';\n    });\n  });\n  \n  el.addEventListener('click', e => {\n    e.stopPropagation();\n    let body = `Role: ${nodeData.role}<br>`;\n    if (nodeData.in.length > 0) {\n      body += `Inputs from: ${nodeData.in.join(', ')}<br>`;\n    }\n    if (nodeData.out.length > 0) {\n      body += `Outputs to: ${nodeData.out.join(', ')}<br>`;\n    }\n    if (prefix === 'a') {\n      body += '<br>In panel a), hidden units have activation functions shown as squiggles.';\n    }\n    showPopup(`Node ${nodeData.label}`, body);\n    animateFlow(nodeId, graph, prefix, e.shiftKey);\n  });\n}\n\nfunction animateFlow(startNode, graph, prefix, backward) {\n  const color = backward ? '#e05050' : '#4a7ef5';\n  const edgeMap = prefix === 'a' ? edgeMapA : edgeMapB;\n  \n  const layers = [];\n  if (!backward) {\n    layers[0] = []; layers[1] = []; layers[2] = [];\n    for (const [edgeId, edge] of Object.entries(edgeMap)) {\n      if (['1','x'].includes(edge.from)) layers[0].push({id:edgeId,edge});\n      else if (['h1','h2','h3'].includes(edge.from)) layers[1].push({id:edgeId,edge});\n    }\n  } else {\n    layers[0] = []; layers[1] = [];\n    for (const [edgeId, edge] of Object.entries(edgeMap)) {\n      if (['y'].includes(edge.to)) layers[0].push({id:edgeId,edge});\n      else if (['h1','h2','h3'].includes(edge.to)) layers[1].push({id:edgeId,edge});\n    }\n  }\n  \n  function animateEdges(edgeData, color, delay) {\n    setTimeout(() => {\n      edgeData.forEach(({id, edge}) => {\n        const el = document.getElementById(id);\n        if (!el) return;\n        const len = el.getTotalLength ? el.getTotalLength() : 100;\n        el.style.transition = 'none';\n        el.style.strokeDasharray = len;\n        el.style.strokeDashoffset = backward ? -len : len;\n        el.style.stroke = color;\n        el.style.strokeWidth = '2';\n        requestAnimationFrame(() => {\n          el.style.transition = 'stroke-dashoffset 0.35s ease';\n          el.style.strokeDashoffset = '0';\n        });\n      });\n      \n      setTimeout(() => {\n        const nodeIds = backward \n          ? [...new Set(edgeData.map(d => d.edge.from))]\n          : [...new Set(edgeData.map(d => d.edge.to))];\n        nodeIds.forEach(nid => {\n          const node = document.getElementById(`${prefix}-${nid}`);\n          if (node) {\n            node.style.transformBox = 'fill-box';\n            node.style.transformOrigin = 'center';\n            node.style.transition = 'transform 0.15s ease';\n            node.style.transform = 'scale(1.18)';\n            setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n          }\n        });\n      }, 350);\n    }, delay);\n  }\n  \n  layers.forEach((layer, i) => {\n    if (layer.length > 0) animateEdges(layer, color, i * 380);\n  });\n  \n  setTimeout(() => {\n    document.querySelectorAll('line').forEach(e => {\n      e.style.transition = 'none';\n      e.style.strokeDasharray = '';\n      e.style.strokeDashoffset = '';\n      e.style.stroke = e.id.startsWith('a-') ? '#999' : '#000';\n      e.style.strokeWidth = '1';\n    });\n  }, layers.length * 380 + 500);\n}\n\n// Setup all nodes\n['a-1', 'a-x', 'a-h1', 'a-h2', 'a-h3', 'a-y', 'a-1b'].forEach(id => {\n  const el = document.getElementById(id);\n  const nodeId = id.replace('a-','').replace('b','');\n  if (el) setupNode(el, nodeId, graphA, 'a');\n});\n\n['b-x', 'b-h1', 'b-h2', 'b-h3', 'b-y'].forEach(id => {\n  const el = document.getElementById(id);\n  const nodeId = id.replace('b-','');\n  if (el) setupNode(el, nodeId, graphB, 'b');\n});\n\n// Edge hover\ndocument.querySelectorAll('line').forEach(edge => {\n  edge.addEventListener('mouseenter', () => {\n    edge.style.stroke = '#e07b30';\n    edge.style.strokeWidth = '2';\n    tooltip.textContent = 'Neural connection';\n    tooltip.style.display = 'block';\n  });\n  edge.addEventListener('mouseleave', () => {\n    edge.style.stroke = edge.id.startsWith('a-') ? '#999' : '#000';\n    edge.style.strokeWidth = '1';\n    tooltip.style.display = 'none';\n  });\n});\n\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n} catch(err) { console.error(err); }\n</script>\n</body>\n</html>",
