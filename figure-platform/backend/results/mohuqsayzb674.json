  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { fill:#fff; stroke:#000; stroke-width:1.5; cursor:pointer; }\n.node:hover { stroke-width:3; fill-opacity:0.9; }\n.edge { fill:none; stroke:#000; stroke-width:1; }\n.edge.highlight { stroke:#e07b30; stroke-width:2; }\n.label { font:12px sans-serif; text-anchor:middle; pointer-events:none; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 242 145\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  <g id=\"edges\">\n    <line class=\"edge\" data-from=\"x\" data-to=\"h1\" x1=\"30\" y1=\"72.5\" x2=\"70\" y2=\"30\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"x\" data-to=\"h2\" x1=\"30\" y1=\"72.5\" x2=\"70\" y2=\"58.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"x\" data-to=\"h3\" x1=\"30\" y1=\"72.5\" x2=\"70\" y2=\"86.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"x\" data-to=\"h4\" x1=\"30\" y1=\"72.5\" x2=\"70\" y2=\"115\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h1\" data-to=\"mu\" x1=\"110\" y1=\"30\" x2=\"172\" y2=\"58.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h1\" data-to=\"sigma\" x1=\"110\" y1=\"30\" x2=\"172\" y2=\"86.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h2\" data-to=\"mu\" x1=\"110\" y1=\"58.5\" x2=\"172\" y2=\"58.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h2\" data-to=\"sigma\" x1=\"110\" y1=\"58.5\" x2=\"172\" y2=\"86.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h3\" data-to=\"mu\" x1=\"110\" y1=\"86.5\" x2=\"172\" y2=\"58.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h3\" data-to=\"sigma\" x1=\"110\" y1=\"86.5\" x2=\"172\" y2=\"86.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h4\" data-to=\"mu\" x1=\"110\" y1=\"115\" x2=\"172\" y2=\"58.5\" marker-end=\"url(#arr)\"/>\n    <line class=\"edge\" data-from=\"h4\" data-to=\"sigma\" x1=\"110\" y1=\"115\" x2=\"172\" y2=\"86.5\" marker-end=\"url(#arr)\"/>\n  </g>\n  <g id=\"nodes\">\n    <circle class=\"node\" data-id=\"x\" cx=\"30\" cy=\"72.5\" r=\"15\"/>\n    <text class=\"label\" x=\"30\" y=\"77.5\" font-style=\"italic\">x</text>\n    <circle class=\"node\" data-id=\"h1\" cx=\"90\" cy=\"30\" r=\"15\"/>\n    <text class=\"label\" x=\"90\" y=\"35\">h₁</text>\n    <circle class=\"node\" data-id=\"h2\" cx=\"90\" cy=\"58.5\" r=\"15\"/>\n    <text class=\"label\" x=\"90\" y=\"63.5\">h₂</text>\n    <circle class=\"node\" data-id=\"h3\" cx=\"90\" cy=\"86.5\" r=\"15\"/>\n    <text class=\"label\" x=\"90\" y=\"91.5\">h₃</text>\n    <circle class=\"node\" data-id=\"h4\" cx=\"90\" cy=\"115\" r=\"15\"/>\n    <text class=\"label\" x=\"90\" y=\"120\">h₄</text>\n    <circle class=\"node\" data-id=\"mu\" cx=\"192\" cy=\"58.5\" r=\"15\"/>\n    <text class=\"label\" x=\"192\" y=\"63.5\" font-style=\"italic\">μ</text>\n    <circle class=\"node\" data-id=\"sigma\" cx=\"192\" cy=\"86.5\" r=\"15\"/>\n    <text class=\"label\" x=\"192\" y=\"91.5\" font-style=\"italic\">σ</text>\n  </g>\n  <text x=\"8\" y=\"18\" font=\"10px sans-serif\">c)</text>\n</svg>\n<div id=\"tooltip\"></div>\n<script>\ntry {\nconst svg = document.querySelector('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\nconst graph = {\n  'x':  { out:['h1','h2','h3','h4'], in:[],                        label:'x',  role:'Input data' },\n  'h1': { out:['mu','sigma'],        in:['x'],                     label:'h₁', role:'Hidden unit 1' },\n  'h2': { out:['mu','sigma'],        in:['x'],                     label:'h₂', role:'Hidden unit 2' },\n  'h3': { out:['mu','sigma'],        in:['x'],                     label:'h₃', role:'Hidden unit 3' },\n  'h4': { out:['mu','sigma'],        in:['x'],                     label:'h₄', role:'Hidden unit 4' },\n  'mu':    { out:[],                 in:['h1','h2','h3','h4'],     label:'μ',  role:'Mean parameter' },\n  'sigma': { out:[],                 in:['h1','h2','h3','h4'],     label:'σ',  role:'Variance parameter' }\n};\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Node hover\nnodes.forEach(node => {\n  const id = node.getAttribute('data-id');\n  node.addEventListener('mouseenter', () => {\n    const info = graph[id];\n    tooltip.textContent = `${info.label} — ${info.role}`;\n    tooltip.style.display = 'block';\n    // Highlight outgoing edges\n    edges.forEach(edge => {\n      if (edge.getAttribute('data-from') === id) {\n        edge.classList.add('highlight');\n      }\n    });\n  });\n  node.addEventListener('mouseleave', () => {\n    tooltip.style.display = 'none';\n    edges.forEach(edge => edge.classList.remove('highlight'));\n  });\n});\n\n// Popup functions\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Node click - show popup\nnodes.forEach(node => {\n  const id = node.getAttribute('data-id');\n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const info = graph[id];\n    let body = `<p><strong>${info.role}</strong></p>`;\n    if (info.in.length > 0) {\n      body += `<p>Receives input from: ${info.in.join(', ')}</p>`;\n    }\n    if (info.out.length > 0) {\n      body += `<p>Sends output to: ${info.out.join(', ')}</p>`;\n    }\n    showPopup(info.label, body);\n    animateFlow(id, e.shiftKey);\n  });\n});\n\n// Dismiss popup\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Animate signal flow\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.6s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\nfunction animateFlow(startId, backward = false) {\n  const color = backward ? '#e05050' : '#4a7ef5';\n  \n  // Reset all edges\n  edges.forEach(e => {\n    e.style.transition = 'none';\n    e.style.strokeDasharray = 'none';\n    e.style.strokeDashoffset = '0';\n    e.style.stroke = '#000';\n  });\n  \n  if (!backward) {\n    // Forward pass - layer by layer\n    const layer0 = Array.from(edges).filter(e => e.getAttribute('data-from') === 'x');\n    const layer1 = Array.from(edges).filter(e => ['h1','h2','h3','h4'].includes(e.getAttribute('data-from')));\n    \n    animateEdges(layer0, color, 0);\n    animateEdges(layer1, color, 650);\n    \n    // Pulse hidden nodes\n    setTimeout(() => {\n      ['h1','h2','h3','h4'].forEach(id => {\n        const node = document.querySelector(`[data-id=\"${id}\"]`);\n        node.style.transformBox = 'fill-box';\n        node.style.transformOrigin = 'center';\n        node.style.transition = 'transform 0.15s ease';\n        node.style.transform = 'scale(1.18)';\n        setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n      });\n    }, 350);\n    \n    // Pulse output nodes\n    setTimeout(() => {\n      ['mu','sigma'].forEach(id => {\n        const node = document.querySelector(`[data-id=\"${id}\"]`);\n        node.style.transformBox = 'fill-box';\n        node.style.transformOrigin = 'center';\n        node.style.transition = 'transform 0.15s ease';\n        node.style.transform = 'scale(1.18)';\n        setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n      });\n    }, 1000);\n    \n  } else {\n    // Backward pass - reverse order\n    const layer1 = Array.from(edges).filter(e => ['mu','sigma'].includes(e.getAttribute('data-to')));\n    const layer0 = Array.from(edges).filter(e => e.getAttribute('data-to') === 'x');\n    \n    animateEdges(layer1, color, 0);\n    animateEdges(layer0, color, 650);\n  }\n  \n  // Reset edges after animation\n  setTimeout(() => {\n    edges.forEach(e => {\n      e.style.transition = 'stroke 0.3s ease';\n      e.style.stroke = '#000';\n      e.style.strokeDasharray = 'none';\n    });\n  }, 1850);\n}\n\n// Draggable nodes\nlet dragNode = null, dragOffX = 0, dragOffY = 0;\n\nfunction svgPt(svg, e) {\n  const pt = svg.createSVGPoint();\n  pt.x = e.clientX; pt.y = e.clientY;\n  return pt.matrixTransform(svg.getScreenCTM().inverse());\n}\n\nnodes.forEach(node => {\n  node.addEventListener('mousedown', e => {\n    e.preventDefault(); e.stopPropagation();\n    const p = svgPt(svg, e);\n    dragOffX = p.x - parseFloat(node.getAttribute('cx'));\n    dragOffY = p.y - parseFloat(node.getAttribute('cy'));\n    dragNode = node;\n    node.style.cursor = 'grabbing';\n  });\n});\n\nsvg.addEventListener('mousemove', e => {\n  if (!dragNode) return;\n  const p = svgPt(svg, e);\n  const nx = p.x - dragOffX, ny = p.y - dragOffY;\n  const id = dragNode.getAttribute('data-id');\n  \n  dragNode.setAttribute('cx', nx);\n  dragNode.setAttribute('cy', ny);\n  \n  // Update label\n  const label = dragNode.nextElementSibling;\n  if (label && label.classList.contains('label')) {\n    label.setAttribute('x', nx);\n    label.setAttribute('y', ny + 5);\n  }\n  \n  // Update connected edges\n  edges.forEach(edge => {\n    if (edge.getAttribute('data-from') === id) {\n      edge.setAttribute('x1', nx);\n      edge.setAttribute('y1', ny);\n    } else if (edge.getAttribute('data-to') === id) {\n      edge.setAttribute('x2', nx - 20);\n      edge.setAttribute('y2', ny);\n    }\n  });\n});\n\nsvg.addEventListener('mouseup', () => { \n  if (dragNode) dragNode.style.cursor = 'pointer';\n  dragNode = null; \n});\n\n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
