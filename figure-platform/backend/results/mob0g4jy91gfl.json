  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        html, body { \n            margin: 0; \n            padding: 0; \n            width: 100%; \n            height: 100%; \n            overflow: hidden; \n            background: #fff; \n            font-family: sans-serif;\n        }\n        \n        .tooltip {\n            position: fixed;\n            background: rgba(0,0,0,0.55);\n            color: #fff;\n            font: 11px/1.4 sans-serif;\n            padding: 5px 8px;\n            border-radius: 4px;\n            pointer-events: none;\n            z-index: 100;\n            max-width: 220px;\n            display: none;\n        }\n        \n        .popup {\n            position: fixed;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            background: rgba(245,245,245,0.95);\n            backdrop-filter: blur(6px);\n            border-top: 1px solid rgba(0,0,0,0.1);\n            padding: 8px 12px;\n            font: 12px/1.5 sans-serif;\n            color: #333;\n            z-index: 101;\n            display: none;\n        }\n        \n        .node {\n            cursor: pointer;\n            transition: stroke-width 0.2s ease;\n        }\n        \n        .node:hover {\n            stroke-width: 2;\n        }\n        \n        .edge {\n            cursor: pointer;\n            transition: stroke-width 0.2s ease;\n        }\n        \n        .edge:hover {\n            stroke-width: 2;\n        }\n    </style>\n</head>\n<body>\n    <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 540 80\">\n        <defs>\n            <marker id=\"arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\" markerUnits=\"strokeWidth\">\n                <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#000\" stroke=\"none\"/>\n            </marker>\n        </defs>\n        \n        <!-- Edges -->\n        <line x1=\"68\" y1=\"40\" x2=\"92\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from x to f₀\"/>\n        <line x1=\"128\" y1=\"40\" x2=\"152\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from f₀ to h₁\"/>\n        <line x1=\"188\" y1=\"40\" x2=\"212\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from h₁ to f₁\"/>\n        <line x1=\"248\" y1=\"40\" x2=\"272\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from f₁ to h₂\"/>\n        <line x1=\"308\" y1=\"40\" x2=\"332\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from h₂ to f₂\"/>\n        <line x1=\"368\" y1=\"40\" x2=\"392\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from f₂ to h₃\"/>\n        <line x1=\"428\" y1=\"40\" x2=\"452\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from h₃ to f₃\"/>\n        <line x1=\"488\" y1=\"40\" x2=\"512\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arrow)\" class=\"edge\" data-info=\"Connection from f₃ to tᵢ\"/>\n        \n        <!-- Nodes -->\n        <circle cx=\"50\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"x\" data-info=\"Input node x - starting point of the sequential processing chain\"/>\n        <circle cx=\"110\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"f₀\" data-info=\"Function node f₀ - first processing stage\"/>\n        <circle cx=\"170\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"h₁\" data-info=\"Hidden state h₁ - intermediate representation\"/>\n        <circle cx=\"230\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"f₁\" data-info=\"Function node f₁ - second processing stage\"/>\n        <circle cx=\"290\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"h₂\" data-info=\"Hidden state h₂ - intermediate representation\"/>\n        <circle cx=\"350\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"f₂\" data-info=\"Function node f₂ - third processing stage\"/>\n        <circle cx=\"410\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"h₃\" data-info=\"Hidden state h₃ - intermediate representation\"/>\n        <circle cx=\"470\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"f₃\" data-info=\"Function node f₃ - fourth processing stage\"/>\n        <circle cx=\"530\" cy=\"40\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" class=\"node\" data-label=\"tᵢ\" data-info=\"Target output tᵢ - final result of the sequential processing\"/>\n        \n        <!-- Node Labels -->\n        <text x=\"50\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">x</text>\n        <text x=\"110\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">f₀</text>\n        <text x=\"170\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₁</text>\n        <text x=\"230\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">f₁</text>\n        <text x=\"290\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₂</text>\n        <text x=\"350\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">f₂</text>\n        <text x=\"410\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">h₃</text>\n        <text x=\"470\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">f₃</text>\n        <text x=\"530\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">tᵢ</text>\n    </svg>\n    \n    <div class=\"tooltip\" id=\"tooltip\"></div>\n    <div class=\"popup\" id=\"popup\">\n        <div id=\"popup-content\"></div>\n        <div style=\"margin-top: 8px; font-size: 10px; color: #666;\">Press ESC or click outside to close</div>\n    </div>\n    \n    <script>\n        try {\n            const tooltip = document.getElementById('tooltip');\n            const popup = document.getElementById('popup');\n            const popupContent = document.getElementById('popup-content');\n            \n            // Tooltip functionality\n            document.querySelectorAll('.node, .edge').forEach(element => {\n                element.addEventListener('mouseenter', function(e) {\n                    const info = this.getAttribute('data-info');\n                    if (info) {\n                        tooltip.textContent = info;\n                        tooltip.style.display = 'block';\n                    }\n                });\n                \n                element.addEventListener('mousemove', function(e) {\n                    tooltip.style.left = (e.clientX + 10) + 'px';\n                    tooltip.style.top = (e.clientY - 30) + 'px';\n                });\n                \n                element.addEventListener('mouseleave', function() {\n                    tooltip.style.display = 'none';\n                });\n            });\n            \n            // Click functionality for detailed popup\n            document.querySelectorAll('.node').forEach(node => {\n                node.addEventListener('click', function(e) {\n                    e.stopPropagation();\n                    const label = this.getAttribute('data-label');\n                    const info = this.getAttribute('data-info');\n                    \n                    let content = `<strong>Node: ${label}</strong><br>${info}`;\n                    \n                    if (label === 'x') {\n                        content += `<br><br><strong>Role:</strong> Input node that initiates the sequential processing chain.<br><strong>Type:</strong> Input data`;\n                    } else if (label.startsWith('f')) {\n                        content += `<br><br><strong>Role:</strong> Function/processing node that transforms the input.<br><strong>Type:</strong> Transformation function`;\n                    } else if (label.startsWith('h')) {\n                        content += `<br><br><strong>Role:</strong> Hidden state that stores intermediate representations.<br><strong>Type:</strong> State variable`;\n                    } else if (label === 'tᵢ') {\n                        content += `<br><br><strong>Role:</strong> Target output representing the final result.<br><strong>Type:</strong> Output target`;\n                    }\n                    \n                    popupContent.innerHTML = content;\n                    popup.style.display = 'block';\n                });\n            });\n            \n            document.querySelectorAll('.edge').forEach(edge => {\n                edge.addEventListener('click', function(e) {\n                    e.stopPropagation();\n                    const info = this.getAttribute('data-info');\n                    \n                    popupContent.innerHTML = `<strong>Sequential Connection</strong><br>${info}<br><br><strong>Direction:</strong> Left to right flow<br><strong>Purpose:</strong> Data/information transfer between processing stages`;\n                    popup.style.display = 'block';\n                });\n            });\n            \n            // Close popup functionality\n            document.addEventListener('click', function() {\n                popup.style.display = 'none';\n            });\n            \n            popup.addEventListener('click', function(e) {\n                e.stopPropagation();\n            });\n            \n            document.addEventListener('keydown', function(e) {\n                if (e.key === 'Escape') {\n                    popup.style.display = 'none';\n                }\n            });\n            \n        } catch (error) {\n            console.error('Error initializing interactive elements:', error);\n        }\n    </script>\n</body>\n</html>",
