     <circle cx=\"58.1\" cy=\"86.4\" r=\"3\" fill=\"#0000FF\" data-point=\"3,2\"/>\n          \n          <line x1=\"70.8\" y1=\"115\" x2=\"70.8\" y2=\"86.4\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"4,2\"/>\n          <circle cx=\"70.8\" cy=\"86.4\" r=\"3\" fill=\"#0000FF\" data-point=\"4,2\"/>\n          \n          <line x1=\"83.5\" y1=\"115\" x2=\"83.5\" y2=\"72.1\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"5,3\"/>\n          <circle cx=\"83.5\" cy=\"72.1\" r=\"3\" fill=\"#0000FF\" data-point=\"5,3\"/>\n          \n          <line x1=\"96.2\" y1=\"115\" x2=\"96.2\" y2=\"72.1\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"6,3\"/>\n          <circle cx=\"96.2\" cy=\"72.1\" r=\"3\" fill=\"#0000FF\" data-point=\"6,3\"/>\n          \n          <line x1=\"108.9\" y1=\"115\" x2=\"108.9\" y2=\"86.4\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"7,2\"/>\n          <circle cx=\"108.9\" cy=\"86.4\" r=\"3\" fill=\"#0000FF\" data-point=\"7,2\"/>\n          \n          <line x1=\"121.6\" y1=\"115\" x2=\"121.6\" y2=\"57.8\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"8,4\"/>\n          <circle cx=\"121.6\" cy=\"57.8\" r=\"3\" fill=\"#0000FF\" data-point=\"8,4\"/>\n          \n          <line x1=\"134.3\" y1=\"115\" x2=\"134.3\" y2=\"29.2\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"9,6\"/>\n          <circle cx=\"134.3\" cy=\"29.2\" r=\"3\" fill=\"#0000FF\" data-point=\"9,6\"/>\n          \n          <line x1=\"147\" y1=\"115\" x2=\"147\" y2=\"29.2\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"10,6\"/>\n          <circle cx=\"147\" cy=\"29.2\" r=\"3\" fill=\"#0000FF\" data-point=\"10,6\"/>\n          \n          <line x1=\"159.7\" y1=\"115\" x2=\"159.7\" y2=\"43.5\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"11,5\"/>\n          <circle cx=\"159.7\" cy=\"43.5\" r=\"3\" fill=\"#0000FF\" data-point=\"11,5\"/>\n          \n          <line x1=\"172.4\" y1=\"115\" x2=\"172.4\" y2=\"43.5\" stroke=\"#0000FF\" stroke-width=\"2\" data-point=\"12,5\"/>\n          <circle cx=\"172.4\" cy=\"43.5\" r=\"3\" fill=\"#0000FF\" data-point=\"12,5\"/>\n        </g>\n      </g>\n    </svg>\n  </div>\n</div>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n\n<script>\ntry {\n  const tooltip = document.getElementById('tooltip');\n  let currentHighlight = null;\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  \n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Add interactivity to data points\n  document.querySelectorAll('.dataA line, .dataA circle, .dataB line, .dataB circle').forEach(el => {\n    const point = el.getAttribute('data-point');\n    if (!point) return;\n    const [x, y] = point.split(',');\n    \n    el.addEventListener('mouseenter', e => {\n      if (currentHighlight) {\n        currentHighlight.style.strokeWidth = '';\n        currentHighlight.style.fillOpacity = '';\n      }\n      \n      // Highlight the line and circle pair\n      const isLine = el.tagName === 'line';\n      const sibling = isLine ? el.nextElementSibling : el.previousElementSibling;\n      \n      if (isLine) {\n        el.style.strokeWidth = '3';\n      } else {\n        el.style.fillOpacity = '0.8';\n      }\n      \n      if (sibling) {\n        if (sibling.tagName === 'line') {\n          sibling.style.strokeWidth = '3';\n        } else {\n          sibling.style.fillOpacity = '0.8';\n        }\n      }\n      \n      currentHighlight = el;\n      tooltip.textContent = `n=${x}, l_n=${y}`;\n      tooltip.style.opacity = '1';\n    });\n    \n    el.addEventListener('mouseleave', () => {\n      if (currentHighlight) {\n        currentHighlight.style.strokeWidth = '';\n        currentHighlight.style.fillOpacity = '';\n        const isLine = currentHighlight.tagName === 'line';\n        const sibling = isLine ? currentHighlight.nextElementSibling : currentHighlight.previousElementSibling;\n        if (sibling) {\n          sibling.style.strokeWidth = '';\n          sibling.style.fillOpacity = '';\n        }\n      }\n      tooltip.style.opacity = '0';\n      currentHighlight = null;\n    });\n    \n    el.addEventListener('click', e => {\n      e.stopPropagation();\n      const panelLabel = el.closest('#panelA') ? 'Panel A' : 'Panel B';\n      showPopup(`Data Point - ${panelLabel}`, `Position: n = ${x}, l_n = ${y}<br><br>This data point shows the value at position ${x} in the sequence.`);\n    });\n  });\n  \n  // Click on SVG background to dismiss popup\n  document.querySelectorAll('svg').forEach(svg => {\n    svg.addEventListener('click', e => {\n      if (e.target === svg || e.target.tagName === 'svg' || e.target.tagName === 'g') {\n        hidePopup();\n      }\n    });\n  });\n  \n} catch (error) {\n  console.error('Interactive features error:', error);\n}\n</script>\n</body>\n</html>",
