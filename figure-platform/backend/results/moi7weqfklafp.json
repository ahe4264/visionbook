  "filename": "figure_106",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n  #tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<div id=\"tooltip\"></div>\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n  // Camera analysis comment\n  // x-axis→right, y-axis→up, z-axis→out\n  // elevation ~15°, azimuth ~30°\n  // camera.position.set(10,5,8)\n\n  const scene = new THREE.Scene();\n  \n  const renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setClearColor(0xffffff, 1);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  document.body.appendChild(renderer.domElement);\n\n  const aspect = window.innerWidth / window.innerHeight;\n  const d = 6;\n  const camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\n  camera.position.set(10, 5, 8);\n  camera.lookAt(0, 0, 0);\n\n  scene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.05;\n\n  // Camera box\n  const boxWidth = 3;\n  const boxHeight = 2; \n  const boxDepth = 4;\n  const boxGeometry = new THREE.BoxGeometry(boxWidth, boxHeight, boxDepth);\n  const boxMaterial = new THREE.MeshBasicMaterial({ \n    color: 0xcccccc, \n    transparent: true, \n    opacity: 0.3,\n    side: THREE.DoubleSide\n  });\n  const box = new THREE.Mesh(boxGeometry, boxMaterial);\n  box.position.set(0, 0, 0);\n  scene.add(box);\n\n  // Box edges\n  const edges = new THREE.EdgesGeometry(boxGeometry);\n  const lineMaterial = new THREE.LineBasicMaterial({ color: 0x333333 });\n  const wireframe = new THREE.LineSegments(edges, lineMaterial);\n  box.add(wireframe);\n\n  // Projection plane (front face)\n  const planeGeometry = new THREE.PlaneGeometry(boxWidth, boxHeight);\n  const planeMaterial = new THREE.MeshBasicMaterial({ \n    color: 0xdddddd, \n    transparent: true, \n    opacity: 0.5,\n    side: THREE.DoubleSide\n  });\n  const projectionPlane = new THREE.Mesh(planeGeometry, planeMaterial);\n  projectionPlane.position.set(0, 0, boxDepth/2);\n  scene.add(projectionPlane);\n\n  // Pinhole (black dot at center back)\n  const pinholeGeometry = new THREE.SphereGeometry(0.08, 16, 16);\n  const pinholeMaterial = new THREE.MeshBasicMaterial({ color: 0x000000 });\n  const pinhole = new THREE.Mesh(pinholeGeometry, pinholeMaterial);\n  pinhole.position.set(0, 0, -boxDepth/2);\n  scene.add(pinhole);\n\n  // Optical axis (dashed line)\n  const dashMaterial = new THREE.LineDashedMaterial({ \n    color: 0x666666, \n    dashSize: 0.2, \n    gapSize: 0.1 \n  });\n  const axisGeometry = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(0, 0, -boxDepth/2),\n    new THREE.Vector3(0, 0, boxDepth/2)\n  ]);\n  const opticalAxis = new THREE.Line(axisGeometry, dashMaterial);\n  opticalAxis.computeLineDistances();\n  scene.add(opticalAxis);\n\n  // World coordinate axes\n  const axisLength = 4;\n  const axisRadius = 0.05;\n  \n  // X axis (red)\n  const xAxisGeometry = new THREE.CylinderGeometry(axisRadius, axisRadius, axisLength, 8);\n  const xAxisMaterial = new THREE.MeshBasicMaterial({ color: 0x000000 });\n  const xAxis = new THREE.Mesh(xAxisGeometry, xAxisMaterial);\n  xAxis.rotation.z = -Math.PI/2;\n  xAxis.position.set(axisLength/2, 0, 0);\n  scene.add(xAxis);\n\n  // X arrow\n  const xArrowGeometry = new THREE.ConeGeometry(0.15, 0.4, 8);\n  const xArrow = new THREE.Mesh(xArrowGeometry, xAxisMaterial);\n  xArrow.rotation.z = -Math.PI/2;\n  xArrow.position.set(axisLength, 0, 0);\n  scene.add(xArrow);\n\n  // Y axis (green)\n  const yAxis = new THREE.Mesh(xAxisGeometry, xAxisMaterial);\n  yAxis.position.set(0, axisLength/2, 0);\n  scene.add(yAxis);\n\n  // Y arrow\n  const yArrow = new THREE.Mesh(xArrowGeometry, xAxisMaterial);\n  yArrow.position.set(0, axisLength, 0);\n  scene.add(yArrow);\n\n  // Z axis (blue)\n  const zAxis = new THREE.Mesh(xAxisGeometry, xAxisMaterial);\n  zAxis.rotation.x = Math.PI/2;\n  zAxis.position.set(0, 0, axisLength/2);\n  scene.add(zAxis);\n\n  // Z arrow\n  const zArrow = new THREE.Mesh(xArrowGeometry, xAxisMaterial);\n  zArrow.rotation.x = -Math.PI/2;\n  zArrow.position.set(0, 0, axisLength);\n  scene.add(zArrow);\n\n  // f arrow (red double arrow between pinhole and projection plane)\n  const fArrowMaterial = new THREE.MeshBasicMaterial({ color: 0xff0000 });\n  const fLength = boxDepth * 0.8;\n  const fShaft = new THREE.CylinderGeometry(0.03, 0.03, fLength, 8);\n  const fArrowShaft = new THREE.Mesh(fShaft, fArrowMaterial);\n  fArrowShaft.rotation.x = Math.PI/2;\n  fArrowShaft.position.set(0, -boxHeight/2 - 0.3, 0);\n  scene.add(fArrowShaft);\n\n  // f arrow heads\n  const fArrowHead1 = new THREE.Mesh(xArrowGeometry, fArrowMaterial);\n  fArrowHead1.rotation.x = Math.PI/2;\n  fArrowHead1.position.set(0, -boxHeight/2 - 0.3, fLength/2);\n  scene.add(fArrowHead1);\n\n  const fArrowHead2 = new THREE.Mesh(xArrowGeometry, fArrowMaterial);\n  fArrowHead2.rotation.x = -Math.PI/2;\n  fArrowHead2.position.set(0, -boxHeight/2 - 0.3, -fLength/2);\n  scene.add(fArrowHead2);\n\n  // Text labels using CSS\n  function createLabel(text, position) {\n    const label = document.createElement('div');\n    label.style.position = 'absolute';\n    label.style.fontSize = '11px';\n    label.style.fontFamily = 'sans-serif';\n    label.style.color = '#000';\n    label.textContent = text;\n    document.body.appendChild(label);\n\n    return function update() {\n      const vector = new THREE.Vector3(position.x, position.y, position.z);\n      vector.project(camera);\n      const x = (vector.x + 1) * window.innerWidth / 2;\n      const y = (-vector.y + 1) * window.innerHeight / 2;\n      label.style.left = x + 'px';\n      label.style.top = y + 'px';\n    };\n  }\n\n  const labels = [\n    createLabel('X', { x: axisLength + 0.3, y: 0, z: 0 }),\n    createLabel('Y', { x: 0, y: axisLength + 0.3, z: 0 }),\n    createLabel('Z', { x: 0, y: 0, z: axisLength + 0.3 }),\n    createLabel('Pinhole camera', { x: -boxWidth/2 - 0.5, y: boxHeight/2 + 0.5, z: 0 }),\n    createLabel('Projection plane', { x: -boxWidth/2 - 0.5, y: 0, z: boxDepth/2 }),\n    createLabel('Optical / principal axis', { x: 0, y: -0.5, z: 0 }),\n    createLabel('Pinhole / camera center', { x: 0, y: -0.5, z: -boxDepth/2 - 0.5 }),\n    createLabel('World coordinates', { x: 2, y: 3, z: 0 }),\n    createLabel('f', { x: 0, y: -boxHeight/2 - 0.6, z: 0 })\n  ];\n\n  // Interactivity\n  const tooltip = document.getElementById('tooltip');\n  const raycaster = new THREE.Raycaster();\n  const mouse = new THREE.Vector2();\n\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n\n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n\n  renderer.domElement.addEventListener('click', e => {\n    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects(scene.children, true);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      if (obj === pinhole) {\n        showPopup('Pinhole / Camera Center', 'The pinhole is the optical center of the camera where all light rays converge. In a pinhole camera model, this single point acts as the lens, projecting the 3D world onto the 2D projection plane.');\n      } else if (obj === projectionPlane) {\n        showPopup('Projection Plane', 'The projection plane is where the 3D scene is projected to form a 2D image. Points in the world are mapped to this plane by drawing rays from the point through the pinhole.');\n      } else if (obj === box || obj.parent === box) {\n        showPopup('Pinhole Camera Model', 'This box represents the abstract pinhole camera model used in computer vision. The focal length f is the distance between the pinhole and the projection plane.');\n      }\n    }\n  });\n\n  document.addEventListener('mousemove', e => {\n    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects(scene.children, true);\n    \n    if (intersects.length > 0) {\n      const obj = intersects[0].object;\n      let text = '';\n      \n      if (obj === pinhole) {\n        text = 'Pinhole - optical center';\n      } else if (obj === projectionPlane) {\n        text = 'Projection plane - image formation';\n      } else if (obj === xAxis || obj === xArrow) {\n        text = 'X axis - world coordinates';\n      } else if (obj === yAxis || obj === yArrow) {\n        text = 'Y axis - world coordinates';\n      } else if (obj === zAxis || obj === zArrow) {\n        text = 'Z axis - world coordinates';\n      } else if (obj === fArrowShaft || obj === fArrowHead1 || obj === fArrowHead2) {\n        text = 'Focal length (f)';\n      } else if (obj === box || obj.parent === box) {\n        text = 'Camera body';\n      }\n      \n      if (text) {\n        tooltip.textContent = text;\n        tooltip.style.display = 'block';\n        tooltip.style.left = (e.clientX + 12) + 'px';\n        tooltip.style.top = (e.clientY - 28) + 'px';\n      } else {\n        tooltip.style.display = 'none';\n      }\n    } else {\n      tooltip.style.display = 'none';\n    }\n  });\n\n  window.addEventListener('resize', () => {\n    const a = window.innerWidth / window.innerHeight;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n  });\n\n  function animate() {\n    requestAnimationFrame(animate);\n    controls.update();\n    labels.forEach(update => update());\n    renderer.render(scene, camera);\n  }\n\n  animate();\n\n} catch (err) {\n  console.error('Error:', err);\n  document.body.innerHTML = '<div style=\"padding:20px;font-family:monospace;\">Error loading visualization: ' + err.message + '</div>';\n}\n</script>\n</body>\n</html>",
