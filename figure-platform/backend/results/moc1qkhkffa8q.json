  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n.node { cursor:pointer; }\n.edge { cursor:pointer; }\n</style>\n</head>\n<body>\n<svg id=\"svg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 497 151\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Panel a) -->\n  <text x=\"18\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">a)</text>\n  \n  <!-- Panel a nodes -->\n  <circle class=\"node\" id=\"a-bias\" cx=\"40\" cy=\"60\" r=\"15\" fill=\"#ff4444\" stroke=\"#000\" stroke-width=\"1\" data-label=\"1\" data-desc=\"Bias unit\"/>\n  <text x=\"40\" y=\"65\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#fff\">1</text>\n  \n  <circle class=\"node\" id=\"a-x\" cx=\"40\" cy=\"100\" r=\"15\" fill=\"#ff4444\" stroke=\"#000\" stroke-width=\"1\" data-label=\"x\" data-desc=\"Input feature\"/>\n  <text x=\"40\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#fff\" font-style=\"italic\">x</text>\n  \n  <circle class=\"node\" id=\"a-h1\" cx=\"120\" cy=\"40\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₁\" data-desc=\"Hidden unit 1\"/>\n  <path d=\"M110,40 Q115,35 120,40 Q125,45 130,40\" stroke=\"#00a0a0\" stroke-width=\"2\" fill=\"none\"/>\n  <text x=\"120\" y=\"48\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₁</text>\n  \n  <circle class=\"node\" id=\"a-h2\" cx=\"120\" cy=\"80\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₂\" data-desc=\"Hidden unit 2\"/>\n  <path d=\"M110,80 Q115,75 120,80 Q125,85 130,80\" stroke=\"#00a0a0\" stroke-width=\"2\" fill=\"none\"/>\n  <text x=\"120\" y=\"88\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₂</text>\n  \n  <circle class=\"node\" id=\"a-h3\" cx=\"120\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₃\" data-desc=\"Hidden unit 3\"/>\n  <path d=\"M110,120 Q115,115 120,120 Q125,125 130,120\" stroke=\"#00a0a0\" stroke-width=\"2\" fill=\"none\"/>\n  <text x=\"120\" y=\"128\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₃</text>\n  \n  <circle class=\"node\" id=\"a-y\" cx=\"200\" cy=\"80\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"y\" data-desc=\"Output\"/>\n  <text x=\"200\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">y</text>\n  \n  <!-- Panel a edges -->\n  <line class=\"edge\" id=\"a-e1\" x1=\"55\" y1=\"60\" x2=\"105\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-bias\" data-to=\"a-h1\"/>\n  <text x=\"70\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">θ₁₀</text>\n  \n  <line class=\"edge\" id=\"a-e2\" x1=\"55\" y1=\"60\" x2=\"105\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-bias\" data-to=\"a-h2\"/>\n  <text x=\"70\" y=\"73\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">θ₂₀</text>\n  \n  <line class=\"edge\" id=\"a-e3\" x1=\"55\" y1=\"100\" x2=\"105\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-x\" data-to=\"a-h1\"/>\n  <text x=\"70\" y=\"60\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">θ₁₁</text>\n  \n  <line class=\"edge\" id=\"a-e4\" x1=\"55\" y1=\"100\" x2=\"105\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-x\" data-to=\"a-h2\"/>\n  <text x=\"70\" y=\"87\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">θ₂₁</text>\n  \n  <line class=\"edge\" id=\"a-e5\" x1=\"55\" y1=\"100\" x2=\"105\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-x\" data-to=\"a-h3\"/>\n  <text x=\"70\" y=\"115\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">θ₃₁</text>\n  \n  <line class=\"edge\" id=\"a-e6\" x1=\"135\" y1=\"40\" x2=\"185\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-h1\" data-to=\"a-y\"/>\n  <text x=\"155\" y=\"55\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">φ₁</text>\n  \n  <line class=\"edge\" id=\"a-e7\" x1=\"135\" y1=\"80\" x2=\"185\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-h2\" data-to=\"a-y\"/>\n  <text x=\"160\" y=\"77\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">φ₂</text>\n  \n  <line class=\"edge\" id=\"a-e8\" x1=\"135\" y1=\"120\" x2=\"185\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"a-h3\" data-to=\"a-y\"/>\n  <text x=\"155\" y=\"105\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"10\" fill=\"#666\" font-style=\"italic\">φ₃</text>\n  \n  <!-- Panel b) -->\n  <text x=\"268\" y=\"20\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#000\">b)</text>\n  \n  <!-- Panel b nodes -->\n  <circle class=\"node\" id=\"b-x\" cx=\"290\" cy=\"80\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"x\" data-desc=\"Input feature\"/>\n  <text x=\"290\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">x</text>\n  \n  <circle class=\"node\" id=\"b-h1\" cx=\"370\" cy=\"40\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₁\" data-desc=\"Hidden unit 1\"/>\n  <text x=\"370\" y=\"45\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₁</text>\n  \n  <circle class=\"node\" id=\"b-h2\" cx=\"370\" cy=\"80\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₂\" data-desc=\"Hidden unit 2\"/>\n  <text x=\"370\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₂</text>\n  \n  <circle class=\"node\" id=\"b-h3\" cx=\"370\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"h₃\" data-desc=\"Hidden unit 3\"/>\n  <text x=\"370\" y=\"125\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">h₃</text>\n  \n  <circle class=\"node\" id=\"b-y\" cx=\"450\" cy=\"80\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\" data-label=\"y\" data-desc=\"Output\"/>\n  <text x=\"450\" y=\"85\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#000\" font-style=\"italic\">y</text>\n  \n  <!-- Panel b edges -->\n  <line class=\"edge\" id=\"b-e1\" x1=\"305\" y1=\"80\" x2=\"355\" y2=\"40\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-x\" data-to=\"b-h1\"/>\n  <line class=\"edge\" id=\"b-e2\" x1=\"305\" y1=\"80\" x2=\"355\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-x\" data-to=\"b-h2\"/>\n  <line class=\"edge\" id=\"b-e3\" x1=\"305\" y1=\"80\" x2=\"355\" y2=\"120\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-x\" data-to=\"b-h3\"/>\n  <line class=\"edge\" id=\"b-e4\" x1=\"385\" y1=\"40\" x2=\"435\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-h1\" data-to=\"b-y\"/>\n  <line class=\"edge\" id=\"b-e5\" x1=\"385\" y1=\"80\" x2=\"435\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-h2\" data-to=\"b-y\"/>\n  <line class=\"edge\" id=\"b-e6\" x1=\"385\" y1=\"120\" x2=\"435\" y2=\"80\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\" data-from=\"b-h3\" data-to=\"b-y\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst svg = document.getElementById('svg');\nconst tooltip = document.getElementById('tooltip');\nconst nodes = document.querySelectorAll('.node');\nconst edges = document.querySelectorAll('.edge');\n\n// Build graph connectivity\nconst graph = {\n  'a-bias': { out:['a-h1','a-h2'], in:[], label:'1', role:'Bias unit' },\n  'a-x': { out:['a-h1','a-h2','a-h3'], in:[], label:'x', role:'Input feature' },\n  'a-h1': { out:['a-y'], in:['a-bias','a-x'], label:'h₁', role:'Hidden unit 1' },\n  'a-h2': { out:['a-y'], in:['a-bias','a-x'], label:'h₂', role:'Hidden unit 2' },\n  'a-h3': { out:['a-y'], in:['a-x'], label:'h₃', role:'Hidden unit 3' },\n  'a-y': { out:[], in:['a-h1','a-h2','a-h3'], label:'y', role:'Output' },\n  'b-x': { out:['b-h1','b-h2','b-h3'], in:[], label:'x', role:'Input feature' },\n  'b-h1': { out:['b-y'], in:['b-x'], label:'h₁', role:'Hidden unit 1' },\n  'b-h2': { out:['b-y'], in:['b-x'], label:'h₂', role:'Hidden unit 2' },\n  'b-h3': { out:['b-y'], in:['b-x'], label:'h₃', role:'Hidden unit 3' },\n  'b-y': { out:[], in:['b-h1','b-h2','b-h3'], label:'y', role:'Output' }\n};\n\n// Tooltip positioning\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Show/hide popup\nfunction showPopup(title, body) {\n  window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\nfunction hidePopup() {\n  window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\n// Dismiss popup\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nsvg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n\n// Node interactions\nnodes.forEach(node => {\n  node.addEventListener('mouseenter', e => {\n    node.setAttribute('stroke-width', '2.5');\n    node.style.fillOpacity = '0.9';\n    \n    const id = node.id;\n    const label = node.getAttribute('data-label');\n    const desc = node.getAttribute('data-desc');\n    tooltip.textContent = `${label} — ${desc}`;\n    tooltip.style.display = 'block';\n    \n    // Highlight outgoing edges\n    edges.forEach(edge => {\n      if (edge.getAttribute('data-from') === id) {\n        edge.setAttribute('stroke', '#e07b30');\n        edge.setAttribute('stroke-width', '2');\n      }\n    });\n  });\n  \n  node.addEventListener('mouseleave', e => {\n    node.setAttribute('stroke-width', '1');\n    node.style.fillOpacity = '1';\n    tooltip.style.display = 'none';\n    \n    edges.forEach(edge => {\n      edge.setAttribute('stroke', '#000');\n      edge.setAttribute('stroke-width', '1');\n    });\n  });\n  \n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const id = node.id;\n    const info = graph[id];\n    let body = `Role: ${info.role}\\n`;\n    if (info.in.length > 0) body += `\\nInputs from: ${info.in.map(n => graph[n].label).join(', ')}`;\n    if (info.out.length > 0) body += `\\nOutputs to: ${info.out.map(n => graph[n].label).join(', ')}`;\n    showPopup(info.label, body);\n    \n    // Animate signal flow\n    const isShift = e.shiftKey;\n    const color = isShift ? '#e05050' : '#4a7ef5';\n    \n    // Reset all edges\n    edges.forEach(edge => {\n      edge.style.transition = 'none';\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n      edge.style.stroke = '#000';\n    });\n    \n    if (!isShift) {\n      // Forward pass\n      animateForwardPass(id.includes('a-') ? 'a' : 'b', color);\n    } else {\n      // Backward pass\n      animateBackwardPass(id.includes('a-') ? 'a' : 'b', color);\n    }\n  });\n});\n\n// Edge hover\nedges.forEach(edge => {\n  edge.addEventListener('mouseenter', e => {\n    edge.setAttribute('stroke', '#e07b30');\n    edge.setAttribute('stroke-width', '2');\n  });\n  \n  edge.addEventListener('mouseleave', e => {\n    edge.setAttribute('stroke', '#000');\n    edge.setAttribute('stroke-width', '1');\n  });\n});\n\n// Animate edges\nfunction animateEdges(edgeEls, color, delay) {\n  setTimeout(() => {\n    edgeEls.forEach(e => {\n      const len = e.getTotalLength ? e.getTotalLength() : 200;\n      e.style.transition = 'none';\n      e.style.strokeDasharray = len;\n      e.style.strokeDashoffset = len;\n      e.style.stroke = color;\n      requestAnimationFrame(() => {\n        e.style.transition = 'stroke-dashoffset 0.35s ease';\n        e.style.strokeDashoffset = '0';\n      });\n    });\n  }, delay);\n}\n\n// Pulse node\nfunction pulseNode(nodeEl, delay) {\n  setTimeout(() => {\n    nodeEl.style.transformBox = 'fill-box';\n    nodeEl.style.transformOrigin = 'center';\n    nodeEl.style.transition = 'transform 0.15s ease';\n    nodeEl.style.transform = 'scale(1.18)';\n    setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n  }, delay);\n}\n\n// Forward pass animation\nfunction animateForwardPass(panel, color) {\n  if (panel === 'a') {\n    // Layer 0: bias and input to hidden\n    const layer0 = Array.from(edges).filter(e => \n      ['a-e1','a-e2','a-e3','a-e4','a-e5'].includes(e.id)\n    );\n    animateEdges(layer0, color, 0);\n    pulseNode(document.getElementById('a-h1'), 350);\n    pulseNode(document.getElementById('a-h2'), 350);\n    pulseNode(document.getElementById('a-h3'), 350);\n    \n    // Layer 1: hidden to output\n    const layer1 = Array.from(edges).filter(e => \n      ['a-e6','a-e7','a-e8'].includes(e.id)\n    );\n    animateEdges(layer1, color, 380);\n    pulseNode(document.getElementById('a-y'), 730);\n  } else {\n    // Layer 0: input to hidden\n    const layer0 = Array.from(edges).filter(e => \n      ['b-e1','b-e2','b-e3'].includes(e.id)\n    );\n    animateEdges(layer0, color, 0);\n    pulseNode(document.getElementById('b-h1'), 350);\n    pulseNode(document.getElementById('b-h2'), 350);\n    pulseNode(document.getElementById('b-h3'), 350);\n    \n    // Layer 1: hidden to output\n    const layer1 = Array.from(edges).filter(e => \n      ['b-e4','b-e5','b-e6'].includes(e.id)\n    );\n    animateEdges(layer1, color, 380);\n    pulseNode(document.getElementById('b-y'), 730);\n  }\n  \n  // Reset edges\n  setTimeout(() => {\n    edges.forEach(edge => {\n      edge.style.transition = 'stroke 0.3s ease';\n      edge.style.stroke = '#000';\n    });\n  }, 1200);\n}\n\n// Backward pass animation\nfunction animateBackwardPass(panel, color) {\n  if (panel === 'a') {\n    // Layer 0: output to hidden\n    const layer0 = Array.from(edges).filter(e => \n      ['a-e6','a-e7','a-e8'].includes(e.id)\n    );\n    animateEdges(layer0, color, 0);\n    pulseNode(document.getElementById('a-h1'), 350);\n    pulseNode(document.getElementById('a-h2'), 350);\n    pulseNode(document.getElementById('a-h3'), 350);\n    \n    // Layer 1: hidden to input\n    const layer1 = Array.from(edges).filter(e => \n      ['a-e1','a-e2','a-e3','a-e4','a-e5'].includes(e.id)\n    );\n    animateEdges(layer1, color, 380);\n    pulseNode(document.getElementById('a-bias'), 730);\n    pulseNode(document.getElementById('a-x'), 730);\n  } else {\n    // Layer 0: output to hidden\n    const layer0 = Array.from(edges).filter(e => \n      ['b-e4','b-e5','b-e6'].includes(e.id)\n    );\n    animateEdges(layer0, color, 0);\n    pulseNode(document.getElementById('b-h1'), 350);\n    pulseNode(document.getElementById('b-h2'), 350);\n    pulseNode(document.getElementById('b-h3'), 350);\n    \n    // Layer 1: hidden to input\n    const layer1 = Array.from(edges).filter(e => \n      ['b-e1','b-e2','b-e3'].includes(e.id)\n    );\n    animateEdges(layer1, color, 380);\n    pulseNode(document.getElementById('b-x'), 730);\n  }\n  \n  // Reset edges\n  setTimeout(() => {\n    edges.forEach(edge => {\n      edge.style.transition = 'stroke 0.3s ease';\n      edge.style.stroke = '#000';\n    });\n  }, 1200);\n}\n\n} catch(e) { console.error(e); }\n</script>\n</body>\n</html>",
