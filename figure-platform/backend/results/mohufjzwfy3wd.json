  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n  position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n  -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n  padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n  pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n  box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 246 155\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <text x=\"16\" y=\"20\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">a)</text>\n  \n  <!-- Edges from x to hidden layer -->\n  <line x1=\"40\" y1=\"77.5\" x2=\"90\" y2=\"40\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h1\"/>\n  <line x1=\"40\" y1=\"77.5\" x2=\"90\" y2=\"65\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h2\"/>\n  <line x1=\"40\" y1=\"77.5\" x2=\"90\" y2=\"90\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h3\"/>\n  <line x1=\"40\" y1=\"77.5\" x2=\"90\" y2=\"115\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h4\"/>\n  \n  <!-- Edges from hidden to output layer -->\n  <line x1=\"130\" y1=\"40\" x2=\"180\" y2=\"60\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h1\" data-to=\"y1\"/>\n  <line x1=\"130\" y1=\"65\" x2=\"180\" y2=\"60\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h2\" data-to=\"y1\"/>\n  <line x1=\"130\" y1=\"90\" x2=\"180\" y2=\"60\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h3\" data-to=\"y1\"/>\n  <line x1=\"130\" y1=\"115\" x2=\"180\" y2=\"60\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h4\" data-to=\"y1\"/>\n  \n  <line x1=\"130\" y1=\"40\" x2=\"180\" y2=\"95\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h1\" data-to=\"y2\"/>\n  <line x1=\"130\" y1=\"65\" x2=\"180\" y2=\"95\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h2\" data-to=\"y2\"/>\n  <line x1=\"130\" y1=\"90\" x2=\"180\" y2=\"95\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h3\" data-to=\"y2\"/>\n  <line x1=\"130\" y1=\"115\" x2=\"180\" y2=\"95\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h4\" data-to=\"y2\"/>\n  \n  <!-- Nodes -->\n  <circle cx=\"40\" cy=\"77.5\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"x\"/>\n  <text x=\"40\" y=\"82\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">x</text>\n  \n  <circle cx=\"110\" cy=\"40\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h1\"/>\n  <text x=\"110\" y=\"44\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">h₁</text>\n  \n  <circle cx=\"110\" cy=\"65\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h2\"/>\n  <text x=\"110\" y=\"69\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">h₂</text>\n  \n  <circle cx=\"110\" cy=\"90\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h3\"/>\n  <text x=\"110\" y=\"94\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">h₃</text>\n  \n  <circle cx=\"110\" cy=\"115\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"h4\"/>\n  <text x=\"110\" y=\"119\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">h₄</text>\n  \n  <circle cx=\"200\" cy=\"60\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"y1\"/>\n  <text x=\"200\" y=\"64\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">y₁</text>\n  \n  <circle cx=\"200\" cy=\"95\" r=\"16\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\" data-id=\"y2\"/>\n  <text x=\"200\" y=\"99\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#000\">y₂</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  \n  const graph = {\n    'x':  { out:['h1','h2','h3','h4'], in:[],                     label:'x',  role:'Input' },\n    'h1': { out:['y1','y2'],           in:['x'],                  label:'h₁', role:'Hidden unit 1' },\n    'h2': { out:['y1','y2'],           in:['x'],                  label:'h₂', role:'Hidden unit 2' },\n    'h3': { out:['y1','y2'],           in:['x'],                  label:'h₃', role:'Hidden unit 3' },\n    'h4': { out:['y1','y2'],           in:['x'],                  label:'h₄', role:'Hidden unit 4' },\n    'y1': { out:[],                    in:['h1','h2','h3','h4'],  label:'y₁', role:'Output 1' },\n    'y2': { out:[],                    in:['h1','h2','h3','h4'],  label:'y₂', role:'Output 2' }\n  };\n  \n  const nodes = svg.querySelectorAll('circle[data-id]');\n  const edges = svg.querySelectorAll('line[data-from]');\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  document.addEventListener('mousemove', e => {\n    if (tooltip.style.display === 'block') {\n      tooltip.style.left = (e.clientX + 12) + 'px';\n      tooltip.style.top = (e.clientY - 28) + 'px';\n    }\n  });\n  \n  // Node hover\n  nodes.forEach(node => {\n    const id = node.getAttribute('data-id');\n    const info = graph[id];\n    \n    node.addEventListener('mouseenter', e => {\n      node.style.strokeWidth = '3';\n      node.style.fillOpacity = '0.9';\n      \n      // Highlight outgoing edges\n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === id) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tooltip.textContent = `${info.label} — ${info.role}`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      node.style.strokeWidth = '1.5';\n      node.style.fillOpacity = '1';\n      \n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      \n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      \n      const isBackward = e.shiftKey;\n      const color = isBackward ? '#e05050' : '#4a7ef5';\n      \n      // Reset all edges first\n      edges.forEach(edge => {\n        edge.style.transition = 'none';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n        edge.style.stroke = '#000';\n      });\n      \n      if (isBackward) {\n        // Backward pass\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-to') === 'y1' || e.getAttribute('data-to') === 'y2'), color, 0);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'x'), color, 650);\n        \n        // Pulse nodes\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h1\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h2\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h3\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h4\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"x\"]')), 1000);\n      } else {\n        // Forward pass\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-from') === 'x'), color, 0);\n        animateEdges(Array.from(edges).filter(e => e.getAttribute('data-to') === 'y1' || e.getAttribute('data-to') === 'y2'), color, 650);\n        \n        // Pulse nodes\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h1\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h2\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h3\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"h4\"]')), 350);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"y1\"]')), 1000);\n        setTimeout(() => pulseNode(svg.querySelector('[data-id=\"y2\"]')), 1000);\n      }\n      \n      // Reset after animation\n      setTimeout(() => {\n        edges.forEach(edge => {\n          edge.style.transition = 'stroke 0.3s ease';\n          edge.style.stroke = '#000';\n          edge.style.strokeDasharray = '';\n          edge.style.strokeDashoffset = '';\n        });\n      }, 1800);\n      \n      showPopup(\n        `${info.label} — ${info.role}`,\n        `This node has ${info.in.length} input(s) and ${info.out.length} output(s). ` +\n        (isBackward ? 'Backward pass propagates gradients.' : 'Forward pass computes activations.')\n      );\n    });\n  });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.6s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  function pulseNode(node) {\n    if (!node) return;\n    node.style.transformBox = 'fill-box';\n    node.style.transformOrigin = 'center';\n    node.style.transition = 'transform 0.15s ease';\n    node.style.transform = 'scale(1.18)';\n    setTimeout(() => { node.style.transform = 'scale(1)'; }, 200);\n  }\n  \n  // Edge hover\n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', e => {\n      edge.style.stroke = '#e07b30';\n      edge.style.strokeWidth = '2';\n      \n      const from = graph[edge.getAttribute('data-from')].label;\n      const to = graph[edge.getAttribute('data-to')].label;\n      tooltip.textContent = `${from} → ${to}`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', e => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n  });\n  \n} catch(err) {\n  console.error(err);\n}\n</script>\n\n</body>\n</html>",
