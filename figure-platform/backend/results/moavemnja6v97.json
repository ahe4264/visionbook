  "id": "moavemnja6v97",
  "filename": "cgraph_tree.png",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>cgraph_tree interactive figure</title>\n<style>\n  :root{\n    --bg:#ffffff;\n    --ink:#111111;\n    --muted:#5f6368;\n    --line:#111111;\n    --blue:#3f8fe5;\n    --blue-dark:#2576d6;\n    --gray:#cfcfcf;\n    --gray-dark:#b9b9b9;\n    --accent:#d1495b;\n  }\n  html,body{\n    margin:0;\n    background:var(--bg);\n    color:var(--ink);\n    font-family:Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  }\n  .page{\n    max-width:1400px;\n    margin:0 auto;\n    padding:16px 18px 18px;\n    background:#fff;\n  }\n  .toolbar{\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-start;\n    gap:16px;\n    margin-bottom:10px;\n  }\n  .titlewrap h1{\n    margin:0;\n    font-size:20px;\n    font-weight:650;\n    letter-spacing:.01em;\n  }\n  .titlewrap .subtitle{\n    margin-top:3px;\n    font-size:12px;\n    color:var(--muted);\n    line-height:1.3;\n  }\n  .controls{\n    display:flex;\n    flex-wrap:wrap;\n    gap:6px;\n    align-items:center;\n  }\n  .btn{\n    border:1px solid #b9bcc1;\n    background:#fff;\n    color:#222;\n    font-size:12px;\n    padding:5px 9px;\n    cursor:pointer;\n    transition:background .18s ease, border-color .18s ease, color .18s ease, transform .12s ease;\n    user-select:none;\n  }\n  .btn:hover{ background:#f5f7f9; }\n  .btn:active{ transform:translateY(1px); }\n  .btn.active{\n    border-color:var(--blue-dark);\n    color:var(--blue-dark);\n    background:#eef5ff;\n  }\n  .banner{\n    border-top:1px solid #d7dadd;\n    border-bottom:1px solid #d7dadd;\n    padding:9px 0 10px;\n    margin-bottom:12px;\n    display:grid;\n    grid-template-columns:1fr auto;\n    gap:12px;\n    align-items:center;\n  }\n  .banner .lesson{\n    font-size:13px;\n    line-height:1.45;\n  }\n  .banner .lesson strong{\n    font-weight:650;\n  }\n  .legend{\n    display:flex;\n    gap:10px;\n    font-size:12px;\n    color:var(--muted);\n    flex-wrap:wrap;\n  }\n  .legend span{\n    display:inline-flex;\n    align-items:center;\n    gap:6px;\n  }\n  .swatch{\n    width:12px;height:12px;border-radius:50%;\n    border:1px solid rgba(0,0,0,.15);\n    display:inline-block;\n  }\n  .figureWrap{\n    display:grid;\n    grid-template-columns:minmax(0, 1fr) 250px;\n    gap:18px;\n    align-items:start;\n  }\n  .figurePanel{\n    position:relative;\n    background:#fff;\n  }\n  svg{\n    width:100%;\n    height:auto;\n    display:block;\n    overflow:visible;\n  }\n  .side{\n    border-left:1px solid #e1e3e6;\n    padding-left:14px;\n    font-size:12px;\n  }\n  .side h3{\n    margin:0 0 8px 0;\n    font-size:13px;\n    font-weight:650;\n  }\n  .side .stat{\n    margin:0 0 10px 0;\n    color:#232629;\n    line-height:1.45;\n  }\n  .side .mini{\n    color:var(--muted);\n  }\n  .side .pathlist{\n    display:flex;\n    flex-direction:column;\n    gap:6px;\n    margin-top:6px;\n  }\n  .pathItem{\n    border:1px solid #d8dde2;\n    padding:6px 7px;\n    cursor:pointer;\n    transition:background .18s ease, border-color .18s ease;\n  }\n  .pathItem:hover{ background:#f6f9fc; }\n  .pathItem.active{\n    border-color:var(--blue-dark);\n    background:#eef5ff;\n  }\n  .footerNote{\n    margin-top:8px;\n    font-size:11.5px;\n    color:var(--muted);\n    line-height:1.35;\n  }\n\n  .edge{\n    stroke:var(--line);\n    stroke-width:8;\n    fill:none;\n    stroke-linecap:round;\n    stroke-linejoin:round;\n    transition:stroke .28s ease, stroke-width .28s ease, opacity .28s ease;\n  }\n  .edge.dimmed{ opacity:.18; }\n  .edge.highlight{\n    stroke:var(--accent);\n    stroke-width:10;\n    opacity:1;\n  }\n\n  .node{\n    cursor:pointer;\n    transition:transform .18s ease;\n  }\n  .nodeCircle{\n    stroke:#111;\n    stroke-width:0;\n    transition:fill .28s ease, stroke .28s ease, stroke-width .28s ease, filter .28s ease;\n  }\n  .nodeLabel{\n    font-size:18px;\n    text-anchor:middle;\n    dominant-baseline:middle;\n    fill:#111;\n    pointer-events:none;\n    font-weight:600;\n  }\n  .node .halo{\n    fill:none;\n    stroke:transparent;\n    stroke-width:0;\n    transition:stroke .28s ease, stroke-width .28s ease, opacity .28s ease;\n    opacity:0;\n  }\n  .node.selected .halo{\n    stroke:var(--accent);\n    stroke-width:6;\n    opacity:.9;\n  }\n  .node.dimmed{ opacity:.25; }\n  .node.root .nodeCircle{ fill:var(--gray); }\n  .node.branch .nodeCircle{ fill:var(--gray); }\n  .node.leaf .nodeCircle{ fill:var(--blue); }\n  .node.active .nodeCircle{\n    stroke:var(--accent);\n    stroke-width:4;\n  }\n  .node.dragging .nodeCircle{\n    stroke:var(--blue-dark);\n    stroke-width:4;\n  }\n  .tag{\n    font-size:12px;\n    fill:#444;\n    text-anchor:middle;\n  }\n  .smallcaps{\n    letter-spacing:.06em;\n    text-transform:uppercase;\n    font-size:11px;\n    fill:#666;\n  }\n  .travelDot{\n    fill:var(--accent);\n    opacity:.95;\n    transition:opacity .2s ease;\n  }\n  .hint{\n    font-size:11.5px;\n    color:var(--muted);\n    margin-top:6px;\n  }\n  @media (max-width: 1020px){\n    .figureWrap{ grid-template-columns:1fr; }\n    .side{ border-left:none; padding-left:0; border-top:1px solid #e1e3e6; padding-top:12px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"toolbar\">\n    <div class=\"titlewrap\">\n      <h1>Control-graph tree</h1>\n      <div class=\"subtitle\">An interactive reconstruction of a minimal tree-shaped control-flow graph. Click nodes, highlight root-to-leaf paths, drag nodes to explore alternative layouts, or animate traversal.</div>\n    </div>\n    <div class=\"controls\">\n      <button class=\"btn\" id=\"prevBtn\">◀ Path</button>\n      <button class=\"btn\" id=\"nextBtn\">Path ▶</button>\n      <button class=\"btn\" id=\"toggleBtn\">Highlight Path</button>\n      <button class=\"btn\" id=\"stepBtn\">Step Through</button>\n      <button class=\"btn\" id=\"autoBtn\">Auto Traverse</button>\n      <button class=\"btn\" id=\"resetBtn\">Reset Layout</button>\n    </div>\n  </div>\n\n  <div class=\"banner\">\n    <div class=\"lesson\" id=\"lessonText\"></div>\n    <div class=\"legend\">\n      <span><i class=\"swatch\" style=\"background: var(--gray)\"></i> internal / root node</span>\n      <span><i class=\"swatch\" style=\"background: var(--blue)\"></i> leaf node</span>\n      <span><i class=\"swatch\" style=\"background: var(--accent)\"></i> selected path</span>\n    </div>\n  </div>\n\n  <div class=\"figureWrap\">\n    <div class=\"figurePanel\">\n      <svg id=\"svg\" viewBox=\"0 0 1380 520\" aria-label=\"Interactive control graph tree\">\n        <g id=\"edgesLayer\"></g>\n        <g id=\"labelsLayer\">\n          <text x=\"95\" y=\"36\" class=\"smallcaps\">root / branch</text>\n          <text x=\"92\" y=\"498\" class=\"smallcaps\">leaf</text>\n        </g>\n        <g id=\"nodesLayer\"></g>\n        <g id=\"travelLayer\"></g>\n      </svg>\n      <div class=\"hint\">Tip: drag any node to rearrange the drawing while preserving the same graph connectivity.</div>\n    </div>\n\n    <aside class=\"side\">\n      <h3>Figure details</h3>\n      <div class=\"stat\"><strong>Structure:</strong> 6 nodes, 4 edges, 3 root-to-leaf execution paths.</div>\n      <div class=\"stat mini\">This reconstruction follows the sparse visual layout in the source figure: two branch nodes beneath the root tier and three blue leaf nodes at the bottom.</div>\n\n      <h3>Paths</h3>\n      <div class=\"pathlist\" id=\"pathList\"></div>\n\n      <h3>Selected item</h3>\n      <div class=\"stat\" id=\"detailText\">Nothing selected yet.</div>\n\n      <div class=\"footerNote\">The tree is intentionally minimal: the same logical structure can be drawn in different spatial arrangements without changing control relationships.</div>\n    </aside>\n  </div>\n</div>\n\n<script>\nconst NS = \"http://www.w3.org/2000/svg\";\n\nconst initialNodes = [\n  {id:\"n1\", label:\"R\", type:\"root\", x:95, y:78},\n  {id:\"n2\", label:\"B1\", type:\"branch\", x:482, y:78},\n  {id:\"n3\", label:\"B2\", type:\"branch\", x:1028, y:372},\n  {id:\"n4\", label:\"L1\", type:\"leaf\", x:95, y:375},\n  {id:\"n5\", label:\"L2\", type:\"leaf\", x:1028, y:370},\n  {id:\"n6\", label:\"L3\", type:\"leaf\", x:1340, y:78}\n];\n\nconst initialEdges = [\n  {id:\"e1\", from:\"n1\", to:\"n4\"},\n  {id:\"e2\", from:\"n2\", to:\"n3\"},\n  {id:\"e3\", from:\"n3\", to:\"n5\"},\n  {id:\"e4\", from:\"n3\", to:\"n6\"}\n];\n\nconst paths = [\n  {id:\"p1\", name:\"Path 1\", nodes:[\"n1\",\"n4\"], edges:[\"e1\"], text:\"A direct control transfer from the left root node to its blue leaf.\"},\n  {id:\"p2\", name:\"Path 2\", nodes:[\"n2\",\"n3\",\"n5\"], edges:[\"e2\",\"e3\"], text:\"A two-step branch sequence ending at the lower blue leaf on the right cluster.\"},\n  {id:\"p3\", name:\"Path 3\", nodes:[\"n2\",\"n3\",\"n6\"], edges:[\"e2\",\"e4\"], text:\"The alternative branch from the same interior node, ending at the top-right blue leaf.\"}\n];\n\nconst state = {\n  nodes: JSON.parse(JSON.stringify(initialNodes)),\n  edges: JSON.parse(JSON.stringify(initialEdges)),\n  selectedNode: null,\n  selectedPath: 0,\n  pathVisible: false,\n  auto: false,\n  autoStepTimer: 0,\n  travelT: 0,\n  travelSpeed: 0.006,\n  draggingId: null,\n  dragOffsetX: 0,\n  dragOffsetY: 0\n};\n\nconst svg = document.getElementById(\"svg\");\nconst edgesLayer = document.getElementById(\"edgesLayer\");\nconst nodesLayer = document.getElementById(\"nodesLayer\");\nconst travelLayer = document.getElementById(\"travelLayer\");\nconst lessonText = document.getElementById(\"lessonText\");\nconst detailText = document.getElementById(\"detailText\");\nconst pathList = document.getElementById(\"pathList\");\n\nconst buttons = {\n  prev: document.getElementById(\"prevBtn\"),\n  next: document.getElementById(\"nextBtn\"),\n  toggle: document.getElementById(\"toggleBtn\"),\n  step: document.getElementById(\"stepBtn\"),\n  auto: document.getElementById(\"autoBtn\"),\n  reset: document.getElementById(\"resetBtn\")\n};\n\nfunction getNode(id){\n  return state.nodes.find(n => n.id === id);\n}\n\nfunction edgeInSelected(edgeId){\n  return state.pathVisible && paths[state.selectedPath].edges.includes(edgeId);\n}\n\nfunction nodeInSelected(nodeId){\n  return state.pathVisible && paths[state.selectedPath].nodes.includes(nodeId);\n}\n\nfunction describeSelection(){\n  if(state.selectedNode){\n    const n = getNode(state.selectedNode);\n    const role = n.type === \"leaf\" ? \"leaf node\" : (n.type === \"root\" ? \"root node\" : \"branch node\");\n    const outgoing = state.edges.filter(e => e.from === n.id).length;\n    const incoming = state.edges.filter(e => e.to === n.id).length;\n    return `<strong>${n.label}</strong> is a ${role}. Incoming edges: ${incoming}. Outgoing edges: ${outgoing}. ${n.type === \"leaf\" ? \"Leaves terminate a path.\" : \"Internal nodes redirect control to one or more descendants.\"}`;\n  }\n  const p = paths[state.selectedPath];\n  if(state.pathVisible){\n    return `<strong>${p.name}</strong>: ${p.text}`;\n  }\n  return `Nothing selected yet. Choose a path or click a node to inspect its role in the tree.`;\n}\n\nfunction updateLesson(){\n  const p = paths[state.selectedPath];\n  let text = \"\";\n  if(state.auto){\n    text = `<strong>Auto traverse:</strong> the red marker is moving along ${p.name}. This animation turns a static tree into a dynamic control-flow story, showing how execution advances edge by edge.`;\n  } else if(state.pathVisible){\n    text = `<strong>Highlighted path:</strong> ${p.name} traces one possible control route through the graph. In a tree, each leaf corresponds to a terminating outcome reachable from an ancestor chain.`;\n  } else if(state.selectedNode){\n    const n = getNode(state.selectedNode);\n    text = `<strong>Node inspection:</strong> ${n.label} is ${n.type === \"leaf\" ? \"a leaf\" : (n.type === \"root\" ? \"the root\" : \"an internal branch\")}. Click different nodes to compare where control starts, splits, and ends.`;\n  } else {\n    text = `<strong>How to read this figure:</strong> gray circles denote root or internal branch points, while blue circles denote leaves. Use <em>Highlight Path</em> or <em>Step Through</em> to reveal one execution route at a time.`;\n  }\n  lessonText.innerHTML = text;\n  detailText.innerHTML = describeSelection();\n}\n\nfunction buildPathList(){\n  pathList.innerHTML = \"\";\n  paths.forEach((p, i) => {\n    const div = document.createElement(\"div\");\n    div.className = \"pathItem\" + (i === state.selectedPath ? \" active\" : \"\");\n    div.innerHTML = `<strong>${p.name}</strong><br><span class=\"mini\">${p.nodes.join(\" → \")}</span>`;\n    div.addEventListener(\"click\", () => {\n      state.selectedPath = i;\n      state.pathVisible = true;\n      state.selectedNode = null;\n      render();\n    });\n    pathList.appendChild(div);\n  });\n}\n\nfunction createSVG(tag, attrs = {}){\n  const el = document.createElementNS(NS, tag);\n  for(const [k,v] of Object.entries(attrs)) el.setAttribute(k,v);\n  return el;\n}\n\nfunction linePath(a,b){\n  return `M ${a.x} ${a.y} L ${b.x} ${b.y}`;\n}\n\nfunction renderEdges(){\n  edgesLayer.innerHTML = \"\";\n  state.edges.forEach(edge => {\n    const from = getNode(edge.from);\n    const to = getNode(edge.to);\n    const path = createSVG(\"path\", {\n      d: linePath(from, to),\n      class: \"edge\" + (state.pathVisible ? (edgeInSelected(edge.id) ? \" highlight\" : \" dimmed\") : \"\")\n    });\n    edgesLayer.appendChild(path);\n  });\n}\n\nfunction renderNodes(){\n  nodesLayer.innerHTML = \"\";\n  state.nodes.forEach(n => {\n    const g = createSVG(\"g\", {\n      class:\n        \"node \" + n.type +\n        (state.selectedNode === n.id ? \" selected active\" : \"\") +\n        (state.draggingId === n.id ? \" dragging\" : \"\") +\n        (state.pathVisible && !nodeInSelected(n.id) ? \" dimmed\" : \"\")\n    });\n    g.setAttribute(\"transform\", `translate(${n.x},${n.y})`);\n    g.dataset.id = n.id;\n\n    const halo = createSVG(\"circle\", {class:\"halo\", r:58});\n    const circle = createSVG(\"circle\", {class:\"nodeCircle\", r:46});\n    const label = createSVG(\"text\", {class:\"nodeLabel\", x:0, y:2});\n    label.textContent = n.label;\n    const tag = createSVG(\"text\", {class:\"tag\", x:0, y:72});\n    tag.textContent = n.type;\n\n    g.appendChild(halo);\n    g.appendChild(circle);\n    g.appendChild(label);\n    g.appendChild(tag);\n\n    g.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n      state.selectedNode = n.id;\n      state.pathVisible = false;\n      state.auto = false;\n      render();\n    });\n\n    g.addEventListener(\"pointerdown\", startDrag);\n    nodesLayer.appendChild(g);\n  });\n}\n\nfunction pointAlongPathSegments(points, t){\n  if(points.length < 2) return points[0] || {x:0,y:0};\n  let lengths = [];\n  let total = 0;\n  for(let i=0;i<points.length-1;i++){\n    const dx = points[i+1].x - points[i].x;\n    const dy = points[i+1].y - points[i].y;\n    const len = Math.hypot(dx,dy);\n    lengths.push(len);\n    total += len;\n  }\n  let target = t * total;\n  for(let i=0;i<lengths.length;i++){\n    if(target <= lengths[i]){\n      const a = points[i], b = points[i+1];\n      const u = lengths[i] === 0 ? 0 : target / lengths[i];\n      return {x:a.x + (b.x-a.x)*u, y:a.y + (b.y-a.y)*u};\n    }\n    target -= lengths[i];\n  }\n  return points[points.length-1];\n}\n\nfunction renderTravelDot(){\n  travelLayer.innerHTML = \"\";\n  if(!state.auto && !state.pathVisible) return;\n  const p = paths[state.selectedPath];\n  const pts = p.nodes.map(getNode);\n  const t = state.auto ? state.travelT : 1;\n  const pos = state.auto ? pointAlongPathSegments(pts, t) : null;\n\n  if(state.auto && pos){\n    const dot = createSVG(\"circle\", {class:\"travelDot\", cx:pos.x, cy:pos.y, r:10});\n    travelLayer.appendChild(dot);\n  }\n}\n\nfunction renderButtons(){\n  buttons.toggle.classList.toggle(\"active\", state.pathVisible && !state.auto);\n  buttons.auto.classList.toggle(\"active\", state.auto);\n}\n\nfunction render(){\n  renderEdges();\n  renderNodes();\n  renderTravelDot();\n  buildPathList();\n  updateLesson();\n  renderButtons();\n}\n\nfunction cyclePath(dir){\n  state.selectedPath = (state.selectedPath + dir + paths.length) % paths.length;\n  state.selectedNode = null;\n}\n\nbuttons.prev.addEventListener(\"click\", () => {\n  state.auto = false;\n  cyclePath(-1);\n  state.pathVisible = true;\n  render();\n});\n\nbuttons.next.addEventListener(\"click\", () => {\n  state.auto = false;\n  cyclePath(1);\n  state.pathVisible = true;\n  render();\n});\n\nbuttons.toggle.addEventListener(\"click\", () => {\n  state.auto = false;\n  state.pathVisible = !state.pathVisible;\n  state.selectedNode = null;\n  render();\n});\n\nbuttons.step.addEventListener(\"click\", () => {\n  state.auto = false;\n  cyclePath(1);\n  state.pathVisible = true;\n  state.selectedNode = null;\n  render();\n});\n\nbuttons.auto.addEventListener(\"click\", () => {\n  state.auto = !state.auto;\n  state.pathVisible = true;\n  state.selectedNode = null;\n  if(state.auto) state.travelT = 0;\n  render();\n});\n\nbuttons.reset.addEventListener(\"click\", () => {\n  state.nodes = JSON.parse(JSON.stringify(initialNodes));\n  state.auto = false;\n  state.pathVisible = false;\n  state.selectedNode = null;\n  render();\n});\n\nsvg.addEventListener(\"click\", () => {\n  state.selectedNode = null;\n  render();\n});\n\nfunction svgPoint(evt){\n  const pt = svg.createSVGPoint();\n  pt.x = evt.clientX;\n  pt.y = evt.clientY;\n  return pt.matrixTransform(svg.getScreenCTM().inverse());\n}\n\nfunction startDrag(evt){\n  evt.preventDefault();\n  evt.stopPropagation();\n  const id = evt.currentTarget.dataset.id;\n  const n = getNode(id);\n  const p = svgPoint(evt);\n  state.draggingId = id;\n  state.dragOffsetX = p.x - n.x;\n  state.dragOffsetY = p.y - n.y;\n  state.auto = false;\n  window.addEventListener(\"pointermove\", onDrag);\n  window.addEventListener(\"pointerup\", endDrag);\n  render();\n}\n\nfunction onDrag(evt){\n  if(!state.draggingId) return;\n  const n = getNode(state.draggingId);\n  const p = svgPoint(evt);\n  n.x = Math.max(46, Math.min(1340, p.x - state.dragOffsetX));\n  n.y = Math.max(46, Math.min(474, p.y - state.dragOffsetY));\n  render();\n}\n\nfunction endDrag(){\n  state.draggingId = null;\n  window.removeEventListener(\"pointermove\", onDrag);\n  window.removeEventListener(\"pointerup\", endDrag);\n  render();\n}\n\nfunction animate(){\n  if(state.auto){\n    state.travelT += state.travelSpeed;\n    if(state.travelT >= 1){\n      state.travelT = 0;\n      state.selectedPath = (state.selectedPath + 1) % paths.length;\n    }\n    renderTravelDot();\n    buildPathList();\n    updateLesson();\n    renderButtons();\n  }\n  requestAnimationFrame(animate);\n}\n\nrender();\nrequestAnimationFrame(animate);\n</script>\n</body>\n</html>",
