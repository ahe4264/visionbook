  "filename": "figure_2",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Neural Network Architecture</title>\n    <style>\n        :root {\n            --primary-black: #000000;\n            --hidden-brown: #8B4513;\n            --highlight-blue: #0066CC;\n            --path-highlight: #FF6B6B;\n            --bg-white: #ffffff;\n            --text-gray: #333333;\n            --light-gray: #f5f5f5;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html, body {\n            background: var(--bg-white);\n            font-family: 'Inter', system-ui, -apple-system, sans-serif;\n            color: var(--text-gray);\n            height: 100%;\n            overflow: hidden;\n        }\n\n        .container {\n            display: flex;\n            flex-direction: column;\n            height: 100%;\n            padding: 20px;\n        }\n\n        .header {\n            text-align: center;\n            margin-bottom: 10px;\n        }\n\n        .header h1 {\n            font-size: 18px;\n            font-weight: 600;\n            margin-bottom: 5px;\n        }\n\n        .controls {\n            display: flex;\n            gap: 10px;\n            justify-content: center;\n            margin-bottom: 15px;\n        }\n\n        .controls button {\n            background: var(--light-gray);\n            border: 1px solid #ddd;\n            padding: 6px 12px;\n            font-size: 12px;\n            cursor: pointer;\n            transition: all 0.2s;\n            border-radius: 3px;\n        }\n\n        .controls button:hover {\n            background: #e8e8e8;\n        }\n\n        .controls button.active {\n            background: var(--highlight-blue);\n            color: white;\n            border-color: var(--highlight-blue);\n        }\n\n        .lesson-panel {\n            background: var(--light-gray);\n            padding: 12px 20px;\n            margin-bottom: 20px;\n            border-radius: 4px;\n            min-height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            text-align: center;\n            font-size: 14px;\n            line-height: 1.5;\n        }\n\n        .figure-container {\n            flex: 1;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            position: relative;\n        }\n\n        svg {\n            max-width: 100%;\n            height: auto;\n        }\n\n        .node {\n            fill: var(--bg-white);\n            stroke-width: 2;\n            cursor: pointer;\n            transition: all 0.3s;\n        }\n\n        .node.input, .node.output {\n            stroke: var(--primary-black);\n        }\n\n        .node.hidden {\n            stroke: var(--hidden-brown);\n        }\n\n        .node:hover {\n            stroke-width: 3;\n        }\n\n        .node.highlighted {\n            fill: rgba(0, 102, 204, 0.1);\n            stroke-width: 3;\n        }\n\n        .node.active {\n            fill: rgba(255, 107, 107, 0.2);\n            stroke-width: 3;\n        }\n\n        .node-label {\n            font-size: 14px;\n            font-family: 'Georgia', serif;\n            pointer-events: none;\n            user-select: none;\n        }\n\n        .layer-label {\n            font-size: 13px;\n            font-weight: 500;\n        }\n\n        .layer-label.hidden {\n            fill: var(--hidden-brown);\n        }\n\n        .edge {\n            fill: none;\n            stroke: var(--primary-black);\n            stroke-width: 1.5;\n            marker-end: url(#arrowhead);\n            transition: all 0.3s;\n            opacity: 0.7;\n        }\n\n        .edge.highlighted {\n            stroke: var(--highlight-blue);\n            stroke-width: 2;\n            opacity: 1;\n        }\n\n        .edge.path-highlight {\n            stroke: var(--path-highlight);\n            stroke-width: 2.5;\n            opacity: 1;\n        }\n\n        .edge.dimmed {\n            opacity: 0.2;\n        }\n\n        #arrowhead {\n            fill: var(--primary-black);\n        }\n\n        .stats-panel {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            background: var(--light-gray);\n            padding: 10px 15px;\n            border-radius: 4px;\n            font-size: 12px;\n            display: none;\n        }\n\n        .stats-panel.show {\n            display: block;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>Neural Network Architecture</h1>\n        </div>\n        \n        <div class=\"controls\">\n            <button id=\"btn-input\" data-step=\"0\">Input Layer</button>\n            <button id=\"btn-hidden\" data-step=\"1\">Hidden Layer</button>\n            <button id=\"btn-output\" data-step=\"2\">Output Layer</button>\n            <button id=\"btn-flow\" data-step=\"3\">Data Flow</button>\n            <button id=\"btn-reset\">Reset</button>\n        </div>\n        \n        <div class=\"lesson-panel\" id=\"lesson\">\n            Click on any node to trace the data flow through the network, or use the buttons above to explore each layer.\n        </div>\n        \n        <div class=\"figure-container\">\n            <svg width=\"600\" height=\"400\" viewBox=\"0 0 600 400\">\n                <defs>\n                    <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"10\" \n                            refX=\"9\" refY=\"3\" orient=\"auto\">\n                        <polygon points=\"0 0, 10 3, 0 6\" />\n                    </marker>\n                </defs>\n                \n                <!-- Layer labels -->\n                <text x=\"100\" y=\"40\" class=\"layer-label\" text-anchor=\"middle\">Input layer</text>\n                <text x=\"300\" y=\"40\" class=\"layer-label hidden\" text-anchor=\"middle\">Hidden layer</text>\n                <text x=\"500\" y=\"40\" class=\"layer-label\" text-anchor=\"middle\">Output layer</text>\n                \n                <!-- Edges will be inserted here dynamically -->\n                <g id=\"edges\"></g>\n                \n                <!-- Nodes -->\n                <g id=\"nodes\">\n                    <!-- Input nodes -->\n                    <circle class=\"node input\" data-id=\"x1\" data-layer=\"input\" cx=\"100\" cy=\"100\" r=\"25\"/>\n                    <text x=\"100\" y=\"105\" class=\"node-label\" text-anchor=\"middle\">x₁</text>\n                    \n                    <circle class=\"node input\" data-id=\"x2\" data-layer=\"input\" cx=\"100\" cy=\"200\" r=\"25\"/>\n                    <text x=\"100\" y=\"205\" class=\"node-label\" text-anchor=\"middle\">x₂</text>\n                    \n                    <circle class=\"node input\" data-id=\"x3\" data-layer=\"input\" cx=\"100\" cy=\"300\" r=\"25\"/>\n                    <text x=\"100\" y=\"305\" class=\"node-label\" text-anchor=\"middle\">x₃</text>\n                    \n                    <!-- Hidden nodes -->\n                    <circle class=\"node hidden\" data-id=\"h1\" data-layer=\"hidden\" cx=\"300\" cy=\"80\" r=\"25\"/>\n                    <text x=\"300\" y=\"85\" class=\"node-label\" text-anchor=\"middle\">h₁</text>\n                    \n                    <circle class=\"node hidden\" data-id=\"h2\" data-layer=\"hidden\" cx=\"300\" cy=\"160\" r=\"25\"/>\n                    <text x=\"300\" y=\"165\" class=\"node-label\" text-anchor=\"middle\">h₂</text>\n                    \n                    <circle class=\"node hidden\" data-id=\"h3\" data-layer=\"hidden\" cx=\"300\" cy=\"240\" r=\"25\"/>\n                    <text x=\"300\" y=\"245\" class=\"node-label\" text-anchor=\"middle\">h₃</text>\n                    \n                    <circle class=\"node hidden\" data-id=\"h4\" data-layer=\"hidden\" cx=\"300\" cy=\"320\" r=\"25\"/>\n                    <text x=\"300\" y=\"325\" class=\"node-label\" text-anchor=\"middle\">h₄</text>\n                    \n                    <!-- Output nodes -->\n                    <circle class=\"node output\" data-id=\"y1\" data-layer=\"output\" cx=\"500\" cy=\"150\" r=\"25\"/>\n                    <text x=\"500\" y=\"155\" class=\"node-label\" text-anchor=\"middle\">y₁</text>\n                    \n                    <circle class=\"node output\" data-id=\"y2\" data-layer=\"output\" cx=\"500\" cy=\"250\" r=\"25\"/>\n                    <text x=\"500\" y=\"255\" class=\"node-label\" text-anchor=\"middle\">y₂</text>\n                </g>\n            </svg>\n            \n            <div class=\"stats-panel\" id=\"stats\">\n                <strong>Network Stats:</strong><br>\n                Input nodes: 3<br>\n                Hidden nodes: 4<br>\n                Output nodes: 2<br>\n                Total connections: 20\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const state = {\n            selectedNode: null,\n            highlightedPath: [],\n            currentStep: -1,\n            showStats: false\n        };\n\n        const steps = [\n            {\n                title: \"Input Layer\",\n                description: \"The input layer receives raw data. Each node (x₁, x₂, x₃) represents a feature or dimension of the input data.\",\n                highlight: ['x1', 'x2', 'x3']\n            },\n            {\n                title: \"Hidden Layer\",\n                description: \"The hidden layer performs computations on the inputs. Each hidden node (h₁, h₂, h₃, h₄) combines information from all input nodes.\",\n                highlight: ['h1', 'h2', 'h3', 'h4']\n            },\n            {\n                title: \"Output Layer\",\n                description: \"The output layer produces the final results. Each output node (y₁, y₂) aggregates information from all hidden nodes.\",\n                highlight: ['y1', 'y2']\n            },\n            {\n                title: \"Data Flow\",\n                description: \"Data flows forward through the network: from inputs through hidden nodes to outputs. Each connection has a weight that determines its influence.\",\n                highlight: []\n            }\n        ];\n\n        function createEdges() {\n            const edgesGroup = document.getElementById('edges');\n            edgesGroup.innerHTML = '';\n            \n            const inputNodes = ['x1', 'x2', 'x3'];\n            const hiddenNodes = ['h1', 'h2', 'h3', 'h4'];\n            const outputNodes = ['y1', 'y2'];\n            \n            // Input to hidden connections\n            inputNodes.forEach(input => {\n                hiddenNodes.forEach(hidden => {\n                    const inputNode = document.querySelector(`[data-id=\"${input}\"]`);\n                    const hiddenNode = document.querySelector(`[data-id=\"${hidden}\"]`);\n                    \n                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n                    path.classList.add('edge');\n                    path.setAttribute('data-from', input);\n                    path.setAttribute('data-to', hidden);\n                    \n                    const x1 = parseFloat(inputNode.getAttribute('cx')) + 25;\n                    const y1 = parseFloat(inputNode.getAttribute('cy'));\n                    const x2 = parseFloat(hiddenNode.getAttribute('cx')) - 25;\n                    const y2 = parseFloat(hiddenNode.getAttribute('cy'));\n                    \n                    path.setAttribute('d', `M ${x1} ${y1} L ${x2} ${y2}`);\n                    edgesGroup.appendChild(path);\n                });\n            });\n            \n            // Hidden to output connections\n            hiddenNodes.forEach(hidden => {\n                outputNodes.forEach(output => {\n                    const hiddenNode = document.querySelector(`[data-id=\"${hidden}\"]`);\n                    const outputNode = document.querySelector(`[data-id=\"${output}\"]`);\n                    \n                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n                    path.classList.add('edge');\n                    path.setAttribute('data-from', hidden);\n                    path.setAttribute('data-to', output);\n                    \n                    const x1 = parseFloat(hiddenNode.getAttribute('cx')) + 25;\n                    const y1 = parseFloat(hiddenNode.getAttribute('cy'));\n                    const x2 = parseFloat(outputNode.getAttribute('cx')) - 25;\n                    const y2 = parseFloat(outputNode.getAttribute('cy'));\n                    \n                    path.setAttribute('d', `M ${x1} ${y1} L ${x2} ${y2}`);\n                    edgesGroup.appendChild(path);\n                });\n            });\n        }\n\n        function highlightPath(nodeId) {\n            // Clear previous highlights\n            document.querySelectorAll('.edge').forEach(edge => {\n                edge.classList.remove('path-highlight', 'dimmed');\n            });\n            document.querySelectorAll('.node').forEach(node => {\n                node.classList.remove('active');\n            });\n            \n            const selectedNode = document.querySelector(`[data-id=\"${nodeId}\"]`);\n            const layer = selectedNode.getAttribute('data-layer');\n            \n            selectedNode.classList.add('active');\n            \n            let pathEdges = [];\n            let pathNodes = [nodeId];\n            \n            if (layer === 'input') {\n                // Highlight all edges from this input\n                document.querySelectorAll(`[data-from=\"${nodeId}\"]`).forEach(edge => {\n                    pathEdges.push(edge);\n                    const toNode = edge.getAttribute('data-to');\n                    pathNodes.push(toNode);\n                    \n                    // And all edges from those hidden nodes\n                    document.querySelectorAll(`[data-from=\"${toNode}\"]`).forEach(edge2 => {\n                        pathEdges.push(edge2);\n                        pathNodes.push(edge2.getAttribute('data-to'));\n                    });\n                });\n            } else if (layer === 'hidden') {\n                // Highlight all edges to this hidden node\n                document.querySelectorAll(`[data-to=\"${nodeId}\"]`).forEach(edge => {\n                    pathEdges.push(edge);\n                    pathNodes.push(edge.getAttribute('data-from'));\n                });\n                \n                // And all edges from this hidden node\n                document.querySelectorAll(`[data-from=\"${nodeId}\"]`).forEach(edge => {\n                    pathEdges.push(edge);\n                    pathNodes.push(edge.getAttribute('data-to'));\n                });\n            } else if (layer === 'output') {\n                // Highlight all edges to this output\n                document.querySelectorAll(`[data-to=\"${nodeId}\"]`).forEach(edge => {\n                    pathEdges.push(edge);\n                    const fromNode = edge.getAttribute('data-from');\n                    pathNodes.push(fromNode);\n                    \n                    // And all edges to those hidden nodes\n                    document.querySelectorAll(`[data-to=\"${fromNode}\"]`).forEach(edge2 => {\n                        pathEdges.push(edge2);\n                        pathNodes.push(edge2.getAttribute('data-from'));\n                    });\n                });\n            }\n            \n            // Apply highlights\n            document.querySelectorAll('.edge').forEach(edge => {\n                if (pathEdges.includes(edge)) {\n                    edge.classList.add('path-highlight');\n                } else {\n                    edge.classList.add('dimmed');\n                }\n            });\n            \n            // Update lesson panel\n            const lesson = document.getElementById('lesson');\n            if (layer === 'input') {\n                lesson.textContent = `Input node ${nodeId} connects to all hidden nodes. In a real network, each connection would have a weight determining its influence.`;\n            } else if (layer === 'hidden') {\n                lesson.textContent = `Hidden node ${nodeId} receives weighted inputs from all input nodes and sends its activation to all output nodes.`;\n            } else {\n                lesson.textContent = `Output node ${nodeId} aggregates information from all hidden nodes to produce the final result.`;\n            }\n            \n            state.highlightedPath = pathNodes;\n        }\n\n        function highlightStep(stepIndex) {\n            // Clear all highlights\n            document.querySelectorAll('.node').forEach(node => {\n                node.classList.remove('highlighted', 'active');\n            });\n            document.querySelectorAll('.edge').forEach(edge => {\n                edge.classList.remove('highlighted', 'dimmed', 'path-highlight');\n            });\n            \n            const step = steps[stepIndex];\n            const lesson = document.getElementById('lesson');\n            lesson.textContent = step.description;\n            \n            // Highlight nodes for this step\n            step.highlight.forEach(nodeId => {\n                const node = document.querySelector(`[data-id=\"${nodeId}\"]`);\n                if (node) node.classList.add('highlighted');\n            });\n            \n            // For data flow step, highlight all edges\n            if (stepIndex === 3) {\n                document.querySelectorAll('.edge').forEach(edge => {\n                    edge.classList.add('highlighted');\n                });\n            }\n            \n            // Update button states\n            document.querySelectorAll('.controls button').forEach(btn => {\n                btn.classList.remove('active');\n            });\n            if (stepIndex >= 0 && stepIndex < 4) {\n                document.querySelector(`[data-step=\"${stepIndex}\"]`).classList.add('active');\n            }\n            \n            state.currentStep = stepIndex;\n        }\n\n        function reset() {\n            state.selectedNode = null;\n            state.highlightedPath = [];\n            state.currentStep = -1;\n            \n            document.querySelectorAll('.node').forEach(node => {\n                node.classList.remove('highlighted', 'active');\n            });\n            document.querySelectorAll('.edge').forEach(edge => {\n                edge.classList.remove('highlighted', 'dimmed', 'path-highlight');\n            });\n            document.querySelectorAll('.controls button').forEach(btn => {\n                btn.classList.remove('active');\n            });\n            \n            document.getElementById('lesson').textContent = \n                'Click on any node to trace the data flow through the network, or use the buttons above to explore each layer.';\n        }\n\n        // Event listeners\n        document.querySelectorAll('.node').forEach(node => {\n            node.addEventListener('click', (e) => {\n                const nodeId = e.target.getAttribute('data-id');\n                state.selectedNode = nodeId;\n                state.currentStep = -1;\n                highlightPath(nodeId);\n            });\n        });\n\n        document.querySelectorAll('.controls button').forEach(btn => {\n            btn.addEventListener('click', (e) => {\n                const step = e.target.getAttribute('data-step');\n                if (step !== null) {\n                    state.selectedNode = null;\n                    highlightStep(parseInt(step));\n                } else if (e.target.id === 'btn-reset') {\n                    reset();\n                }\n            });\n        });\n\n        // Initialize\n        createEdges();\n    </script>\n</body>\n</html>",
