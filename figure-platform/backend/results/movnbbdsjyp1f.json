  "id": "movnbbdsjyp1f",
  "filename": "figure_1",
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 175\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"5\" markerHeight=\"5\" refX=\"4\" refY=\"2.5\" orient=\"auto\">\n      <path d=\"M0,0 L0,5 L5,2.5 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Nodes -->\n  <circle cx=\"29.4\" cy=\"58.8\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"x₁\" data-desc=\"First input component\"/>\n  <circle cx=\"29.4\" cy=\"100.3\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"x₂\" data-desc=\"Second input component\"/>\n  <circle cx=\"154.8\" cy=\"38\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"h₁\" data-desc=\"First hidden unit\"/>\n  <circle cx=\"154.8\" cy=\"78.4\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"h₂\" data-desc=\"Second hidden unit\"/>\n  <circle cx=\"154.8\" cy=\"118.7\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"h₃\" data-desc=\"Third hidden unit\"/>\n  <circle cx=\"274.8\" cy=\"78.4\" r=\"18\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.2\" data-label=\"y\" data-desc=\"Scalar output\"/>\n  \n  <!-- Node labels -->\n  <text x=\"29.4\" y=\"63.8\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">x₁</text>\n  <text x=\"29.4\" y=\"105.3\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">x₂</text>\n  <text x=\"154.8\" y=\"43\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">h₁</text>\n  <text x=\"154.8\" y=\"83.4\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">h₂</text>\n  <text x=\"154.8\" y=\"123.7\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">h₃</text>\n  <text x=\"274.8\" y=\"83.4\" font-size=\"12\" font-family=\"serif\" font-style=\"italic\" text-anchor=\"middle\">y</text>\n  \n  <!-- Edges -->\n  <!-- x1 to h1 -->\n  <line x1=\"47.4\" y1=\"58.8\" x2=\"131.8\" y2=\"41.2\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₁\" data-to=\"h₁\"/>\n  <!-- x1 to h2 -->\n  <line x1=\"47.4\" y1=\"58.8\" x2=\"136.8\" y2=\"78.4\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₁\" data-to=\"h₂\"/>\n  <!-- x1 to h3 -->\n  <line x1=\"47.4\" y1=\"58.8\" x2=\"131.8\" y2=\"115.5\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₁\" data-to=\"h₃\"/>\n  <!-- x2 to h1 -->\n  <line x1=\"47.4\" y1=\"100.3\" x2=\"131.8\" y2=\"41.2\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₂\" data-to=\"h₁\"/>\n  <!-- x2 to h2 -->\n  <line x1=\"47.4\" y1=\"100.3\" x2=\"136.8\" y2=\"78.4\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₂\" data-to=\"h₂\"/>\n  <!-- x2 to h3 -->\n  <line x1=\"47.4\" y1=\"100.3\" x2=\"136.8\" y2=\"118.7\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"x₂\" data-to=\"h₃\"/>\n  <!-- h1 to y -->\n  <line x1=\"172.8\" y1=\"38\" x2=\"251.8\" y2=\"75.2\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"h₁\" data-to=\"y\"/>\n  <!-- h2 to y -->\n  <line x1=\"172.8\" y1=\"78.4\" x2=\"256.8\" y2=\"78.4\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"h₂\" data-to=\"y\"/>\n  <!-- h3 to y -->\n  <line x1=\"172.8\" y1=\"118.7\" x2=\"251.8\" y2=\"81.6\" stroke=\"#000\" stroke-width=\"1.2\" marker-end=\"url(#arr)\" data-from=\"h₃\" data-to=\"y\"/>\n  \n  <!-- Caption -->\n  <text x=\"322.8\" y=\"27\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\">Figure 3.7</text>\n  <text x=\"322.8\" y=\"42\" font-size=\"11\" font-family=\"sans-serif\">Visualization of neural net-</text>\n  <text x=\"322.8\" y=\"55\" font-size=\"11\" font-family=\"sans-serif\">work with 2D multivariate input <tspan font-style=\"italic\">x</tspan> =</text>\n  <text x=\"322.8\" y=\"68\" font-size=\"11\" font-family=\"sans-serif\">[<tspan font-style=\"italic\">x</tspan>₁, <tspan font-style=\"italic\">x</tspan>₂]<tspan baseline-shift=\"super\" font-size=\"9\">T</tspan> and scalar output <tspan font-style=\"italic\">y</tspan>.</text>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\nconst tooltip = document.getElementById('tooltip');\nconst svg = document.querySelector('svg');\n\n// Hover effects\ndocument.querySelectorAll('circle, line').forEach(el => {\n  el.addEventListener('mouseenter', e => {\n    if (el.tagName === 'circle') {\n      el.style.strokeWidth = '2.7';\n      tooltip.textContent = el.dataset.label + ': ' + el.dataset.desc;\n    } else if (el.tagName === 'line') {\n      el.style.strokeWidth = '2.7';\n      tooltip.textContent = 'Connection: ' + el.dataset.from + ' → ' + el.dataset.to;\n    }\n    tooltip.style.display = 'block';\n  });\n  \n  el.addEventListener('mouseleave', e => {\n    el.style.strokeWidth = '1.2';\n    tooltip.style.display = 'none';\n  });\n});\n\ndocument.addEventListener('mousemove', e => {\n  tooltip.style.left = (e.clientX + 12) + 'px';\n  tooltip.style.top = (e.clientY - 28) + 'px';\n});\n\n// Popup functions\nfunction showPopup(title, body) { \n  window.parent.postMessage({ type:'alex-popup', title, body }, '*'); \n}\nfunction hidePopup() { \n  window.parent.postMessage({ type:'alex-popup', title:null }, '*'); \n}\n\n// Click handlers\ndocument.querySelectorAll('circle').forEach(node => {\n  node.addEventListener('click', e => {\n    e.stopPropagation();\n    const label = node.dataset.label;\n    let body = '';\n    if (label === 'x₁' || label === 'x₂') {\n      body = 'Input nodes receive the raw data values. In this network, the 2D input vector x = [x₁, x₂]ᵀ represents the features fed to the network. Each input connects to all hidden units.';\n    } else if (label.startsWith('h')) {\n      body = 'Hidden units perform nonlinear transformations of their inputs. Each hidden neuron computes a weighted sum of all inputs plus a bias, then applies an activation function. These intermediate representations enable the network to learn complex patterns.';\n    } else if (label === 'y') {\n      body = 'The output node produces the final scalar prediction. It combines the outputs from all hidden units through another weighted sum and activation. This architecture can approximate any continuous function given sufficient hidden units.';\n    }\n    showPopup(label + ' - Neural Network Component', body);\n  });\n});\n\n// Forward propagation animation on line click\ndocument.querySelectorAll('line').forEach(edge => {\n  edge.addEventListener('click', e => {\n    e.stopPropagation();\n    animateSignalFlow();\n  });\n});\n\n// Click on background to close popup\nsvg.addEventListener('click', e => {\n  if (e.target === svg || e.target.tagName === 'svg') {\n    hidePopup();\n  }\n});\n\n// Escape key to close popup\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') hidePopup();\n});\n\n// Signal flow animation\nfunction animateSignalFlow() {\n  const nodes = document.querySelectorAll('circle');\n  const edges = document.querySelectorAll('line');\n  \n  // Reset all\n  nodes.forEach(n => {\n    n.style.transition = 'fill 0.35s ease';\n    n.style.fill = '#fff';\n  });\n  edges.forEach(e => {\n    e.style.transition = 'stroke 0.35s ease';\n    e.style.stroke = '#000';\n  });\n  \n  // Phase 1: Activate inputs\n  setTimeout(() => {\n    nodes[0].style.fill = '#c8e0ff'; // x1\n    nodes[1].style.fill = '#c8e0ff'; // x2\n  }, 100);\n  \n  // Phase 2: Activate input->hidden connections\n  setTimeout(() => {\n    edges[0].style.stroke = '#4a90e2';\n    edges[1].style.stroke = '#4a90e2';\n    edges[2].style.stroke = '#4a90e2';\n    edges[3].style.stroke = '#4a90e2';\n    edges[4].style.stroke = '#4a90e2';\n    edges[5].style.stroke = '#4a90e2';\n  }, 450);\n  \n  // Phase 3: Activate hidden nodes\n  setTimeout(() => {\n    nodes[2].style.fill = '#c8e0ff'; // h1\n    nodes[3].style.fill = '#c8e0ff'; // h2\n    nodes[4].style.fill = '#c8e0ff'; // h3\n  }, 800);\n  \n  // Phase 4: Activate hidden->output connections\n  setTimeout(() => {\n    edges[6].style.stroke = '#4a90e2';\n    edges[7].style.stroke = '#4a90e2';\n    edges[8].style.stroke = '#4a90e2';\n  }, 1150);\n  \n  // Phase 5: Activate output\n  setTimeout(() => {\n    nodes[5].style.fill = '#c8e0ff'; // y\n  }, 1500);\n  \n  // Reset after animation\n  setTimeout(() => {\n    nodes.forEach(n => n.style.fill = '#fff');\n    edges.forEach(e => e.style.stroke = '#000');\n  }, 2200);\n}\n\n} catch(err) {\n  console.error('Script error:', err);\n}\n</script>\n</body>\n</html>",
