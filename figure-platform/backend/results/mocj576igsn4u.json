  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.node { cursor:pointer; }\n.edge { transition:stroke 0.2s, stroke-width 0.2s; }\n.label { font:11px sans-serif; fill:#000; }\n.hidden { opacity:0; position:fixed; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 432 125\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"8\" markerHeight=\"8\" refX=\"8\" refY=\"4\" orient=\"auto\">\n      <path d=\"M0,0 L0,8 L8,4 z\" fill=\"#E3A088\"/>\n    </marker>\n  </defs>\n  \n  <!-- Word embeddings row -->\n  <g id=\"inputs\">\n    <rect x=\"20\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"It\"/>\n    <text x=\"40\" y=\"99\" text-anchor=\"middle\" class=\"label\">It</text>\n    \n    <rect x=\"82\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"takes\"/>\n    <text x=\"102\" y=\"99\" text-anchor=\"middle\" class=\"label\">takes</text>\n    \n    <rect x=\"144\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"great\"/>\n    <text x=\"164\" y=\"99\" text-anchor=\"middle\" class=\"label\">great</text>\n    \n    <rect x=\"206\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"personal\"/>\n    <text x=\"226\" y=\"99\" text-anchor=\"middle\" class=\"label\">personal</text>\n    \n    <rect x=\"268\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"courage\"/>\n    <text x=\"288\" y=\"99\" text-anchor=\"middle\" class=\"label\">courage</text>\n    \n    <rect x=\"330\" y=\"85\" width=\"40\" height=\"20\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"to\"/>\n    <text x=\"350\" y=\"99\" text-anchor=\"middle\" class=\"label\">to</text>\n  </g>\n  \n  <!-- Neural networks row -->\n  <g id=\"networks\">\n    <rect x=\"20\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 1\"/>\n    <rect x=\"82\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 2\"/>\n    <rect x=\"144\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 3\"/>\n    <rect x=\"206\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 4\"/>\n    <rect x=\"268\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 5\"/>\n    <rect x=\"330\" y=\"35\" width=\"40\" height=\"30\" fill=\"#C1DDD2\" stroke=\"#999\" stroke-width=\"1\" class=\"node\" data-label=\"RNN block 6\"/>\n  </g>\n  \n  <!-- Outputs row -->\n  <g id=\"outputs\">\n    <rect x=\"20\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 1\"/>\n    <rect x=\"82\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 2\"/>\n    <rect x=\"144\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 3\"/>\n    <rect x=\"206\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 4\"/>\n    <rect x=\"268\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 5\"/>\n    <rect x=\"330\" y=\"8\" width=\"40\" height=\"15\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"2,2\" class=\"node\" data-label=\"Output 6\"/>\n  </g>\n  \n  <!-- Edges -->\n  <g id=\"edges\">\n    <!-- Input to network -->\n    <line x1=\"40\" y1=\"85\" x2=\"40\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"102\" y1=\"85\" x2=\"102\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"164\" y1=\"85\" x2=\"164\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"226\" y1=\"85\" x2=\"226\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"288\" y1=\"85\" x2=\"288\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"350\" y1=\"85\" x2=\"350\" y2=\"65\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <!-- Network to output -->\n    <line x1=\"40\" y1=\"35\" x2=\"40\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"102\" y1=\"35\" x2=\"102\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"164\" y1=\"35\" x2=\"164\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"226\" y1=\"35\" x2=\"226\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"288\" y1=\"35\" x2=\"288\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"350\" y1=\"35\" x2=\"350\" y2=\"23\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    \n    <!-- Horizontal connections between networks -->\n    <line x1=\"60\" y1=\"50\" x2=\"82\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"122\" y1=\"50\" x2=\"144\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"184\" y1=\"50\" x2=\"206\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"246\" y1=\"50\" x2=\"268\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"308\" y1=\"50\" x2=\"330\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n    <line x1=\"370\" y1=\"50\" x2=\"390\" y2=\"50\" class=\"edge\" stroke=\"#E3A088\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  </g>\n  \n  <!-- Labels -->\n  <text x=\"8\" y=\"19\" class=\"label\" font-size=\"10\">Outputs</text>\n  <text x=\"8\" y=\"52\" class=\"label\" font-size=\"10\">Identical neural</text>\n  <text x=\"8\" y=\"62\" class=\"label\" font-size=\"10\">networks</text>\n  <text x=\"8\" y=\"98\" class=\"label\" font-size=\"10\">Word</text>\n  <text x=\"8\" y=\"108\" class=\"label\" font-size=\"10\">embeddings</text>\n</svg>\n\n<div class=\"hidden\" id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const nodes = document.querySelectorAll('.node');\n  const edges = document.querySelectorAll('.edge');\n  \n  // Graph connectivity\n  const graph = {\n    'It': { out:['RNN block 1'], in:[], label:'It', role:'Input word' },\n    'takes': { out:['RNN block 2'], in:[], label:'takes', role:'Input word' },\n    'great': { out:['RNN block 3'], in:[], label:'great', role:'Input word' },\n    'personal': { out:['RNN block 4'], in:[], label:'personal', role:'Input word' },\n    'courage': { out:['RNN block 5'], in:[], label:'courage', role:'Input word' },\n    'to': { out:['RNN block 6'], in:[], label:'to', role:'Input word' },\n    'RNN block 1': { out:['Output 1','RNN block 2'], in:['It'], label:'RNN 1', role:'Hidden state processor' },\n    'RNN block 2': { out:['Output 2','RNN block 3'], in:['takes','RNN block 1'], label:'RNN 2', role:'Hidden state processor' },\n    'RNN block 3': { out:['Output 3','RNN block 4'], in:['great','RNN block 2'], label:'RNN 3', role:'Hidden state processor' },\n    'RNN block 4': { out:['Output 4','RNN block 5'], in:['personal','RNN block 3'], label:'RNN 4', role:'Hidden state processor' },\n    'RNN block 5': { out:['Output 5','RNN block 6'], in:['courage','RNN block 4'], label:'RNN 5', role:'Hidden state processor' },\n    'RNN block 6': { out:['Output 6'], in:['to','RNN block 5'], label:'RNN 6', role:'Hidden state processor' }\n  };\n  \n  // Tooltip positioning\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Tooltip styles\n  tooltip.style.cssText = `position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25);`;\n  \n  // Node hover\n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', e => {\n      const label = e.target.getAttribute('data-label');\n      const info = graph[label];\n      if (info) {\n        tooltip.textContent = info.label + ' — ' + info.role;\n        tooltip.classList.remove('hidden');\n      }\n      e.target.style.strokeWidth = '2.5';\n      e.target.style.fillOpacity = '0.85';\n      \n      // Highlight outgoing edges\n      edges.forEach(edge => {\n        edge.style.stroke = '#E3A088';\n        edge.style.strokeWidth = '1';\n      });\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      tooltip.classList.add('hidden');\n      e.target.style.strokeWidth = '1';\n      e.target.style.fillOpacity = '1';\n    });\n  });\n  \n  // Edge hover\n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', e => {\n      e.target.style.stroke = '#e07b30';\n      e.target.style.strokeWidth = '2';\n    });\n    edge.addEventListener('mouseleave', e => {\n      e.target.style.stroke = '#E3A088';\n      e.target.style.strokeWidth = '1';\n    });\n  });\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  // Node click for popup\n  nodes.forEach(node => {\n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const label = e.target.getAttribute('data-label');\n      const info = graph[label];\n      if (info) {\n        let body = `<p>Role: ${info.role}</p>`;\n        if (info.in.length > 0) body += `<p>Inputs from: ${info.in.join(', ')}</p>`;\n        if (info.out.length > 0) body += `<p>Outputs to: ${info.out.join(', ')}</p>`;\n        showPopup(info.label, body);\n      }\n      \n      // Animate signal flow\n      animateSignalFlow(e.target);\n    });\n  });\n  \n  // Dismiss popup\n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  // Signal flow animation\n  function animateSignalFlow(startNode) {\n    // Reset all edges\n    edges.forEach(e => {\n      e.style.transition = 'none';\n      e.style.strokeDasharray = 'none';\n      e.style.strokeDashoffset = '0';\n    });\n    \n    // Animate edges in layers\n    setTimeout(() => {\n      edges.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 50;\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = '#4a7ef5';\n        e.style.transition = 'stroke-dashoffset 0.35s ease';\n        setTimeout(() => {\n          e.style.strokeDashoffset = '0';\n        }, 50);\n      });\n    }, 100);\n    \n    // Restore original colors after animation\n    setTimeout(() => {\n      edges.forEach(e => {\n        e.style.stroke = '#E3A088';\n        e.style.strokeDasharray = 'none';\n      });\n    }, 1500);\n  }\n  \n} catch(e) {\n  console.error('Script error:', e);\n}\n</script>\n</body>\n</html>",
