  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif; padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15); pointer-events:none; z-index:100; max-width:150px; white-space:nowrap; box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none; }\n</style>\n</head>\n<body>\n\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 486 129\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <text x=\"15\" y=\"25\" font-family=\"sans-serif\" font-size=\"13\" fill=\"#000\">a)</text>\n  \n  <g id=\"nodes\">\n    <circle cx=\"65\" cy=\"64.5\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"x\" data-label=\"x\" data-role=\"Input node\"/>\n    \n    <circle cx=\"150\" cy=\"35\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h1\" data-label=\"h₁\" data-role=\"Hidden unit 1\"/>\n    <circle cx=\"150\" cy=\"64.5\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h2\" data-label=\"h₂\" data-role=\"Hidden unit 2\"/>\n    <circle cx=\"150\" cy=\"94\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h3\" data-label=\"h₃\" data-role=\"Hidden unit 3\"/>\n    \n    <circle cx=\"235\" cy=\"64.5\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"y\" data-label=\"y\" data-role=\"Output node\"/>\n    \n    <circle cx=\"320\" cy=\"35\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h1p\" data-label=\"h'₁\" data-role=\"Hidden unit 1'\"/>\n    <circle cx=\"320\" cy=\"64.5\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h2p\" data-label=\"h'₂\" data-role=\"Hidden unit 2'\"/>\n    <circle cx=\"320\" cy=\"94\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"h3p\" data-label=\"h'₃\" data-role=\"Hidden unit 3'\"/>\n    \n    <circle cx=\"405\" cy=\"64.5\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\" data-id=\"yp\" data-label=\"y'\" data-role=\"Output node\"/>\n    \n    <text x=\"65\" y=\"69\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">x</text>\n    <text x=\"150\" y=\"39\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h₁</text>\n    <text x=\"150\" y=\"69\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h₂</text>\n    <text x=\"150\" y=\"99\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h₃</text>\n    <text x=\"235\" y=\"69\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">y</text>\n    <text x=\"320\" y=\"39\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h'₁</text>\n    <text x=\"320\" y=\"69\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h'₂</text>\n    <text x=\"320\" y=\"99\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">h'₃</text>\n    <text x=\"405\" y=\"69\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\" fill=\"#000\">y'</text>\n    \n    <path d=\"M 143,32 Q 150,35 157,32 Q 150,37 143,32\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n    <path d=\"M 143,61.5 Q 150,64.5 157,61.5 Q 150,67.5 143,61.5\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n    <path d=\"M 143,91 Q 150,94 157,91 Q 150,97 143,91\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n    <path d=\"M 313,32 Q 320,35 327,32 Q 320,37 313,32\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n    <path d=\"M 313,61.5 Q 320,64.5 327,61.5 Q 320,67.5 313,61.5\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n    <path d=\"M 313,91 Q 320,94 327,91 Q 320,97 313,91\" fill=\"none\" stroke=\"#008b8b\" stroke-width=\"1.5\"/>\n  </g>\n  \n  <g id=\"edges\">\n    <line x1=\"80\" y1=\"64.5\" x2=\"135\" y2=\"35\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h1\"/>\n    <line x1=\"80\" y1=\"64.5\" x2=\"135\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h2\"/>\n    <line x1=\"80\" y1=\"64.5\" x2=\"135\" y2=\"94\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"x\" data-to=\"h3\"/>\n    \n    <line x1=\"165\" y1=\"35\" x2=\"220\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h1\" data-to=\"y\"/>\n    <line x1=\"165\" y1=\"64.5\" x2=\"220\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h2\" data-to=\"y\"/>\n    <line x1=\"165\" y1=\"94\" x2=\"220\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h3\" data-to=\"y\"/>\n    \n    <line x1=\"250\" y1=\"64.5\" x2=\"305\" y2=\"35\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"y\" data-to=\"h1p\"/>\n    <line x1=\"250\" y1=\"64.5\" x2=\"305\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"y\" data-to=\"h2p\"/>\n    <line x1=\"250\" y1=\"64.5\" x2=\"305\" y2=\"94\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"y\" data-to=\"h3p\"/>\n    \n    <line x1=\"335\" y1=\"35\" x2=\"390\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h1p\" data-to=\"yp\"/>\n    <line x1=\"335\" y1=\"64.5\" x2=\"390\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h2p\" data-to=\"yp\"/>\n    <line x1=\"335\" y1=\"94\" x2=\"390\" y2=\"64.5\" marker-end=\"url(#arr)\" stroke=\"#000\" stroke-width=\"1\" data-from=\"h3p\" data-to=\"yp\"/>\n  </g>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  const nodes = document.querySelectorAll('circle[data-id]');\n  const edges = document.querySelectorAll('line[data-from]');\n  \n  const graph = {\n    'x':   { out:['h1','h2','h3'], in:[], label:'x', role:'Input node' },\n    'h1':  { out:['y'], in:['x'], label:'h₁', role:'Hidden unit 1' },\n    'h2':  { out:['y'], in:['x'], label:'h₂', role:'Hidden unit 2' },\n    'h3':  { out:['y'], in:['x'], label:'h₃', role:'Hidden unit 3' },\n    'y':   { out:['h1p','h2p','h3p'], in:['h1','h2','h3'], label:'y', role:'Output node' },\n    'h1p': { out:['yp'], in:['y'], label:'h\\'₁', role:'Hidden unit 1\\'' },\n    'h2p': { out:['yp'], in:['y'], label:'h\\'₂', role:'Hidden unit 2\\'' },\n    'h3p': { out:['yp'], in:['y'], label:'h\\'₃', role:'Hidden unit 3\\'' },\n    'yp':  { out:[], in:['h1p','h2p','h3p'], label:'y\\'', role:'Output node' }\n  };\n  \n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\n  svg.addEventListener('click', e => { if (e.target === svg || e.target.tagName === 'svg') hidePopup(); });\n  \n  document.addEventListener('mousemove', e => {\n    if (tooltip.style.display === 'block') {\n      tooltip.style.left = (e.clientX + 12) + 'px';\n      tooltip.style.top = (e.clientY - 28) + 'px';\n    }\n  });\n  \n  nodes.forEach(node => {\n    const nodeId = node.getAttribute('data-id');\n    const nodeData = graph[nodeId];\n    \n    node.addEventListener('mouseenter', () => {\n      node.style.strokeWidth = '2.5';\n      node.style.fillOpacity = '0.05';\n      node.style.fill = '#000';\n      \n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === nodeId) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      tooltip.textContent = nodeData.label + ' — ' + nodeData.role;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', () => {\n      node.style.strokeWidth = '1';\n      node.style.fillOpacity = '0';\n      node.style.fill = 'none';\n      \n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      \n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      const body = `<p>${nodeData.role}</p><p>Connections: ${nodeData.out.length} outgoing, ${nodeData.in.length} incoming</p>`;\n      showPopup(nodeData.label, body);\n      animateFlow(nodeId, e.shiftKey);\n    });\n  });\n  \n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', () => {\n      edge.style.stroke = '#e07b30';\n      edge.style.strokeWidth = '2';\n      tooltip.textContent = edge.getAttribute('data-from') + ' → ' + edge.getAttribute('data-to');\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', () => {\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n      tooltip.style.display = 'none';\n    });\n  });\n  \n  function animateEdges(edgeEls, color, delay) {\n    setTimeout(() => {\n      edgeEls.forEach(e => {\n        const len = e.getTotalLength ? e.getTotalLength() : 200;\n        e.style.transition = 'none';\n        e.style.strokeDasharray = len;\n        e.style.strokeDashoffset = len;\n        e.style.stroke = color;\n        requestAnimationFrame(() => {\n          e.style.transition = 'stroke-dashoffset 0.35s ease';\n          e.style.strokeDashoffset = '0';\n        });\n      });\n    }, delay);\n  }\n  \n  function pulseNode(nodeEl, delay) {\n    setTimeout(() => {\n      nodeEl.style.transformBox = 'fill-box';\n      nodeEl.style.transformOrigin = 'center';\n      nodeEl.style.transition = 'transform 0.15s ease';\n      nodeEl.style.transform = 'scale(1.18)';\n      setTimeout(() => { nodeEl.style.transform = 'scale(1)'; }, 200);\n    }, delay + 350);\n  }\n  \n  function animateFlow(startId, backward) {\n    const color = backward ? '#e05050' : '#4a7ef5';\n    const layers = backward ? \n      [['yp'], ['h1p','h2p','h3p'], ['y'], ['h1','h2','h3'], ['x']] :\n      [['x'], ['h1','h2','h3'], ['y'], ['h1p','h2p','h3p'], ['yp']];\n    \n    layers.forEach((layer, i) => {\n      const layerEdges = [];\n      layer.forEach(nodeId => {\n        edges.forEach(edge => {\n          if (backward ? edge.getAttribute('data-to') === nodeId : edge.getAttribute('data-from') === nodeId) {\n            layerEdges.push(edge);\n          }\n        });\n      });\n      \n      if (layerEdges.length > 0) {\n        animateEdges(layerEdges, color, i * 380);\n      }\n      \n      layer.forEach(nodeId => {\n        const nodeEl = document.querySelector(`circle[data-id=\"${nodeId}\"]`);\n        if (nodeEl && i < layers.length - 1) {\n          pulseNode(nodeEl, (i + 1) * 380);\n        }\n      });\n    });\n    \n    setTimeout(() => {\n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n      });\n    }, layers.length * 380 + 500);\n  }\n  \n} catch(e) {\n  console.error(e);\n}\n</script>\n\n</body>\n</html>",
