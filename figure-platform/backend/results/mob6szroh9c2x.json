  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n.node { transition:all 0.15s ease; cursor:pointer; }\n.edge { transition:all 0.15s ease; }\n.node:hover { stroke-width:2.5; }\n.tooltip { position:fixed; background:rgba(22,22,22,0.88); backdrop-filter:blur(6px); color:#f0f0f0; font:11px/1.4 sans-serif; padding:5px 9px; border-radius:5px; border:1px solid rgba(255,255,255,0.1); pointer-events:none; z-index:100; max-width:240px; display:none; }\n.popup { position:fixed; bottom:0; left:0; right:0; background:rgba(246,246,246,0.97); backdrop-filter:blur(8px); border-top:1px solid rgba(0,0,0,0.07); padding:10px 14px; font:12px/1.6 sans-serif; color:#1a1a1a; z-index:101; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 390 125\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#000\"/>\n    </marker>\n  </defs>\n  \n  <!-- Edges -->\n  <line class=\"edge\" data-from=\"x\" data-to=\"h1\" x1=\"40\" y1=\"62.5\" x2=\"110\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"x\" data-to=\"h2\" x1=\"40\" y1=\"62.5\" x2=\"110\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"x\" data-to=\"h3\" x1=\"40\" y1=\"62.5\" x2=\"110\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <line class=\"edge\" data-from=\"h1\" data-to=\"h1p\" x1=\"130\" y1=\"35\" x2=\"200\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h1\" data-to=\"h2p\" x1=\"130\" y1=\"35\" x2=\"200\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h1\" data-to=\"h3p\" x1=\"130\" y1=\"35\" x2=\"200\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <line class=\"edge\" data-from=\"h2\" data-to=\"h1p\" x1=\"130\" y1=\"62.5\" x2=\"200\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h2\" data-to=\"h2p\" x1=\"130\" y1=\"62.5\" x2=\"200\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h2\" data-to=\"h3p\" x1=\"130\" y1=\"62.5\" x2=\"200\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <line class=\"edge\" data-from=\"h3\" data-to=\"h1p\" x1=\"130\" y1=\"90\" x2=\"200\" y2=\"35\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h3\" data-to=\"h2p\" x1=\"130\" y1=\"90\" x2=\"200\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h3\" data-to=\"h3p\" x1=\"130\" y1=\"90\" x2=\"200\" y2=\"90\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <line class=\"edge\" data-from=\"h1p\" data-to=\"yp\" x1=\"220\" y1=\"35\" x2=\"290\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h2p\" data-to=\"yp\" x1=\"220\" y1=\"62.5\" x2=\"290\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  <line class=\"edge\" data-from=\"h3p\" data-to=\"yp\" x1=\"220\" y1=\"90\" x2=\"290\" y2=\"62.5\" stroke=\"#000\" stroke-width=\"1\" marker-end=\"url(#arr)\"/>\n  \n  <!-- Nodes -->\n  <g class=\"node\" data-id=\"x\">\n    <circle cx=\"40\" cy=\"62.5\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"40\" y=\"67\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">x</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h1\">\n    <circle cx=\"120\" cy=\"35\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"120\" y=\"39\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h₁</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h2\">\n    <circle cx=\"120\" cy=\"62.5\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"120\" y=\"67\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h₂</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h3\">\n    <circle cx=\"120\" cy=\"90\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"120\" y=\"94\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h₃</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h1p\">\n    <circle cx=\"210\" cy=\"35\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"210\" y=\"39\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h'₁</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h2p\">\n    <circle cx=\"210\" cy=\"62.5\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"210\" y=\"67\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h'₂</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"h3p\">\n    <circle cx=\"210\" cy=\"90\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"210\" y=\"94\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">h'₃</text>\n  </g>\n  \n  <g class=\"node\" data-id=\"yp\">\n    <circle cx=\"300\" cy=\"62.5\" r=\"15\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1\"/>\n    <text x=\"300\" y=\"67\" text-anchor=\"middle\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#008B8B\">y'</text>\n  </g>\n</svg>\n\n<div class=\"tooltip\" id=\"tooltip\"></div>\n<div class=\"popup\" id=\"popup\"></div>\n\n<script>\ntry {\n  const graph = {\n    'x': { out: ['h1','h2','h3'], in: [], label: 'Input', desc: 'Input layer node that receives data and distributes to first hidden layer' },\n    'h1': { out: ['h1p','h2p','h3p'], in: ['x'], label: 'Hidden 1-1', desc: 'First hidden layer, node 1. Applies activation function to weighted sum of inputs' },\n    'h2': { out: ['h1p','h2p','h3p'], in: ['x'], label: 'Hidden 1-2', desc: 'First hidden layer, node 2. Applies activation function to weighted sum of inputs' },\n    'h3': { out: ['h1p','h2p','h3p'], in: ['x'], label: 'Hidden 1-3', desc: 'First hidden layer, node 3. Applies activation function to weighted sum of inputs' },\n    'h1p': { out: ['yp'], in: ['h1','h2','h3'], label: 'Hidden 2-1', desc: 'Second hidden layer, node 1. Combines features from first hidden layer' },\n    'h2p': { out: ['yp'], in: ['h1','h2','h3'], label: 'Hidden 2-2', desc: 'Second hidden layer, node 2. Combines features from first hidden layer' },\n    'h3p': { out: ['yp'], in: ['h1','h2','h3'], label: 'Hidden 2-3', desc: 'Second hidden layer, node 3. Combines features from first hidden layer' },\n    'yp': { out: [], in: ['h1p','h2p','h3p'], label: 'Output', desc: 'Output layer node that produces final prediction from second hidden layer' }\n  };\n\n  const tooltip = document.getElementById('tooltip');\n  const popup = document.getElementById('popup');\n  const nodes = document.querySelectorAll('.node');\n  const edges = document.querySelectorAll('.edge');\n\n  nodes.forEach(node => {\n    const nodeId = node.getAttribute('data-id');\n    const circle = node.querySelector('circle');\n    \n    node.addEventListener('mouseenter', e => {\n      edges.forEach(edge => {\n        if (edge.getAttribute('data-from') === nodeId || edge.getAttribute('data-to') === nodeId) {\n          edge.style.stroke = '#e07b30';\n          edge.style.strokeWidth = '2';\n        }\n      });\n      \n      const info = graph[nodeId];\n      tooltip.innerHTML = `<strong>${info.label}</strong><br>Connections: ${info.in.length} in, ${info.out.length} out`;\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      edges.forEach(edge => {\n        edge.style.stroke = '#000';\n        edge.style.strokeWidth = '1';\n      });\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      e.stopPropagation();\n      animateForwardPass(nodeId);\n      showPopup(nodeId);\n    });\n  });\n\n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', e => {\n      const from = edge.getAttribute('data-from');\n      const to = edge.getAttribute('data-to');\n      tooltip.innerHTML = `Edge: ${from} → ${to}<br>Weighted connection`;\n      tooltip.style.display = 'block';\n      edge.style.stroke = '#e07b30';\n      edge.style.strokeWidth = '2';\n    });\n    \n    edge.addEventListener('mouseleave', e => {\n      tooltip.style.display = 'none';\n      edge.style.stroke = '#000';\n      edge.style.strokeWidth = '1';\n    });\n  });\n\n  document.addEventListener('mousemove', e => {\n    if (tooltip.style.display === 'block') {\n      tooltip.style.left = (e.pageX + 10) + 'px';\n      tooltip.style.top = (e.pageY - 25) + 'px';\n    }\n  });\n\n  function animateForwardPass(startNode) {\n    const layers = [['x'], ['h1','h2','h3'], ['h1p','h2p','h3p'], ['yp']];\n    let startLayer = layers.findIndex(layer => layer.includes(startNode));\n    \n    edges.forEach(edge => {\n      edge.style.strokeDasharray = '';\n      edge.style.strokeDashoffset = '';\n      edge.style.stroke = '#000';\n    });\n    \n    for (let i = startLayer; i < layers.length - 1; i++) {\n      setTimeout(() => {\n        const currentLayerNodes = layers[i];\n        const nextLayerNodes = layers[i + 1];\n        \n        edges.forEach(edge => {\n          const from = edge.getAttribute('data-from');\n          const to = edge.getAttribute('data-to');\n          \n          if (currentLayerNodes.includes(from) && nextLayerNodes.includes(to)) {\n            const length = edge.getTotalLength();\n            edge.style.strokeDasharray = length;\n            edge.style.strokeDashoffset = length;\n            edge.style.transition = 'stroke-dashoffset 0.4s ease';\n            edge.style.stroke = '#4a7ef5';\n            requestAnimationFrame(() => {\n              edge.style.strokeDashoffset = '0';\n            });\n          }\n        });\n        \n        setTimeout(() => {\n          nextLayerNodes.forEach(nodeId => {\n            const node = document.querySelector(`[data-id=\"${nodeId}\"] circle`);\n            node.style.transform = 'scale(1.15)';\n            setTimeout(() => {\n              node.style.transform = 'scale(1)';\n            }, 150);\n          });\n        }, 400);\n      }, (i - startLayer) * 500);\n    }\n    \n    setTimeout(() => {\n      edges.forEach(edge => {\n        edge.style.transition = 'all 0.15s ease';\n        edge.style.strokeDasharray = '';\n        edge.style.strokeDashoffset = '';\n        edge.style.stroke = '#000';\n      });\n    }, 2000);\n  }\n\n  function showPopup(nodeId) {\n    const info = graph[nodeId];\n    popup.innerHTML = `<strong>${info.label}</strong>: ${info.desc}`;\n    popup.style.display = 'block';\n  }\n\n  document.addEventListener('click', e => {\n    if (!e.target.closest('.node')) {\n      popup.style.display = 'none';\n    }\n  });\n\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') {\n      popup.style.display = 'none';\n    }\n  });\n\n} catch (error) {\n  console.error('Error in interactive figure:', error);\n}\n</script>\n</body>\n</html>",
