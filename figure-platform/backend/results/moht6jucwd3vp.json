  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip {\n    position:fixed; background:rgba(0,0,0,0.50); backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px); color:#fff; font:11px/1.3 sans-serif;\n    padding:3px 8px; border-radius:4px; border:1px solid rgba(255,255,255,0.15);\n    pointer-events:none; z-index:100; max-width:150px; white-space:nowrap;\n    box-shadow:0 2px 6px rgba(0,0,0,0.25); display:none;\n}\n</style>\n</head>\n<body>\n<div id=\"tooltip\"></div>\n<script src=\"https://unpkg.com/three@0.128.0/build/three.min.js\"></script>\n<script src=\"https://unpkg.com/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\ntry {\n// x-axis→right, y-axis→up, z-axis→toward viewer\n// elevation ~30°, azimuth ~45°\n// camera.position.set(5,3,5)\n\nconst scene = new THREE.Scene();\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setClearColor(0xffffff, 1);\nrenderer.setPixelRatio(window.devicePixelRatio);\nrenderer.setSize(window.innerWidth, window.innerHeight);\ndocument.body.appendChild(renderer.domElement);\n\nconst aspect = window.innerWidth / window.innerHeight;\nconst d = 3;\nconst camera = new THREE.OrthographicCamera(-d*aspect, d*aspect, d, -d, 0.1, 1000);\ncamera.position.set(5, 3, 5);\ncamera.lookAt(0, 0, 0);\n\nscene.add(new THREE.AmbientLight(0xffffff, 1.0));\n\nconst controls = new THREE.OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.1;\n\n// Create projection plane (vertical gray rectangle)\nconst planeGeometry = new THREE.PlaneGeometry(2.5, 3);\nconst planeMaterial = new THREE.MeshBasicMaterial({ color: 0xf0f0f0, side: THREE.DoubleSide, transparent: true, opacity: 0.5 });\nconst plane = new THREE.Mesh(planeGeometry, planeMaterial);\nplane.position.set(0, 0, 0);\nplane.rotation.y = Math.PI / 6;\nscene.add(plane);\n\n// Add plane outline\nconst planeEdges = new THREE.EdgesGeometry(planeGeometry);\nconst planeLines = new THREE.LineSegments(planeEdges, new THREE.LineBasicMaterial({ color: 0x000000 }));\nplaneLines.position.copy(plane.position);\nplaneLines.rotation.copy(plane.rotation);\nscene.add(planeLines);\n\n// Create viewing point (small green sphere)\nconst viewGeometry = new THREE.SphereGeometry(0.1, 16, 16);\nconst viewMaterial = new THREE.MeshBasicMaterial({ color: 0x00aa00 });\nconst viewPoint = new THREE.Mesh(viewGeometry, viewMaterial);\nviewPoint.position.set(-2, 0, 1.5);\nscene.add(viewPoint);\n\n// Create object point (small red sphere)\nconst objGeometry = new THREE.SphereGeometry(0.1, 16, 16);\nconst objMaterial = new THREE.MeshBasicMaterial({ color: 0xff0000 });\nconst objPoint = new THREE.Mesh(objGeometry, objMaterial);\nobjPoint.position.set(1.5, 0.5, -1);\nscene.add(objPoint);\n\n// Create projection lines\nconst projectionMaterial = new THREE.LineBasicMaterial({ color: 0xff0000 });\nconst projectionGeometry = new THREE.BufferGeometry().setFromPoints([viewPoint.position, objPoint.position]);\nconst projectionLine = new THREE.Line(projectionGeometry, projectionMaterial);\nscene.add(projectionLine);\n\n// Create grid lines (blue)\nconst gridMaterial = new THREE.LineBasicMaterial({ color: 0x0066ff, transparent: true, opacity: 0.6 });\nconst gridSpacing = 0.5;\nconst gridSize = 3;\n\n// Horizontal grid lines\nfor (let i = -gridSize; i <= gridSize; i++) {\n    const y = i * gridSpacing;\n    const points = [];\n    for (let x = -gridSize; x <= gridSize; x++) {\n        points.push(new THREE.Vector3(x * gridSpacing, y, -2));\n    }\n    const geometry = new THREE.BufferGeometry().setFromPoints(points);\n    const line = new THREE.Line(geometry, gridMaterial);\n    scene.add(line);\n}\n\n// Vertical grid lines\nfor (let i = -gridSize; i <= gridSize; i++) {\n    const x = i * gridSpacing;\n    const points = [];\n    for (let y = -gridSize; y <= gridSize; y++) {\n        points.push(new THREE.Vector3(x, y * gridSpacing, -2));\n    }\n    const geometry = new THREE.BufferGeometry().setFromPoints(points);\n    const line = new THREE.Line(geometry, gridMaterial);\n    scene.add(line);\n}\n\n// Add coordinate axes\nconst axesMaterial = new THREE.LineBasicMaterial({ color: 0x008800 });\nconst xAxisGeometry = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-2, 0, 0),\n    new THREE.Vector3(2, 0, 0)\n]);\nconst xAxis = new THREE.Line(xAxisGeometry, axesMaterial);\nscene.add(xAxis);\n\n// Add axis arrows\nconst arrowGeometry = new THREE.ConeGeometry(0.1, 0.3, 8);\nconst arrowMaterial = new THREE.MeshBasicMaterial({ color: 0x008800 });\nconst xArrow = new THREE.Mesh(arrowGeometry, arrowMaterial);\nxArrow.position.set(2, 0, 0);\nxArrow.rotation.z = -Math.PI / 2;\nscene.add(xArrow);\n\n// Add labels\nconst loader = new THREE.FontLoader();\nconst textMaterial = new THREE.MeshBasicMaterial({ color: 0x000000 });\n\n// Create text sprites for labels\nfunction createTextSprite(text, position) {\n    const canvas = document.createElement('canvas');\n    const context = canvas.getContext('2d');\n    canvas.width = 64;\n    canvas.height = 64;\n    context.font = '28px sans-serif';\n    context.fillStyle = '#000000';\n    context.textAlign = 'center';\n    context.textBaseline = 'middle';\n    context.fillText(text, 32, 32);\n    \n    const texture = new THREE.CanvasTexture(canvas);\n    const spriteMaterial = new THREE.SpriteMaterial({ map: texture });\n    const sprite = new THREE.Sprite(spriteMaterial);\n    sprite.position.copy(position);\n    sprite.scale.set(0.5, 0.5, 1);\n    return sprite;\n}\n\nconst vLabel = createTextSprite('v', new THREE.Vector3(1.2, -0.3, 0));\nscene.add(vLabel);\n\nconst wLabel = createTextSprite('w', new THREE.Vector3(-2.3, -0.3, 1.8));\nscene.add(wLabel);\n\nconst bLabel = createTextSprite('(b)', new THREE.Vector3(-1.5, -1.5, 0));\nscene.add(bLabel);\n\n// Tooltip functionality\nconst tooltip = document.getElementById('tooltip');\nconst raycaster = new THREE.Raycaster();\nconst mouse = new THREE.Vector2();\n\nfunction onMouseMove(event) {\n    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n    \n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([viewPoint, objPoint, plane]);\n    \n    if (intersects.length > 0) {\n        const obj = intersects[0].object;\n        let text = '';\n        if (obj === viewPoint) text = 'w — viewing point';\n        else if (obj === objPoint) text = 'v — object point';\n        else if (obj === plane) text = 'Projection plane';\n        \n        if (text) {\n            tooltip.textContent = text;\n            tooltip.style.display = 'block';\n            tooltip.style.left = (event.clientX + 12) + 'px';\n            tooltip.style.top = (event.clientY - 28) + 'px';\n        }\n    } else {\n        tooltip.style.display = 'none';\n    }\n}\n\n// Click functionality\nfunction onClick(event) {\n    raycaster.setFromCamera(mouse, camera);\n    const intersects = raycaster.intersectObjects([viewPoint, objPoint, plane]);\n    \n    if (intersects.length > 0) {\n        const obj = intersects[0].object;\n        let title = '', body = '';\n        \n        if (obj === viewPoint) {\n            title = 'Viewing Point (w)';\n            body = 'The observer\\'s position in 3D space. All projection rays originate from this point.';\n        } else if (obj === objPoint) {\n            title = 'Object Point (v)';\n            body = 'A point in 3D space being projected onto the projection plane through perspective projection.';\n        } else if (obj === plane) {\n            title = 'Projection Plane';\n            body = 'The 2D surface where the 3D scene is projected. The intersection of projection rays with this plane creates the 2D image.';\n        }\n        \n        if (title) {\n            showPopup(title, body);\n        }\n    }\n}\n\nfunction showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n}\n\nfunction hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n}\n\ndocument.addEventListener('mousemove', onMouseMove);\ndocument.addEventListener('click', onClick);\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') hidePopup(); });\nrenderer.domElement.addEventListener('click', e => {\n    if (e.target === renderer.domElement) {\n        const intersects = raycaster.intersectObjects(scene.children);\n        if (intersects.length === 0) hidePopup();\n    }\n});\n\n// Resize handler\nwindow.addEventListener('resize', () => {\n    const a = window.innerWidth / window.innerHeight;\n    camera.left = -d * a;\n    camera.right = d * a;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n});\n\n// Animation loop\nfunction animate() {\n    requestAnimationFrame(animate);\n    controls.update();\n    renderer.render(scene, camera);\n}\n\nanimate();\n\n} catch (error) {\n    console.error('Error:', error);\n    document.body.innerHTML = '<div style=\"padding:20px;font-family:sans-serif;\">Error loading 3D visualization</div>';\n}\n</script>\n</body>\n</html>",
