"/>\n      <text x=\"-20\" y=\"79\" class=\"tick-label\" text-anchor=\"middle\">0.2</text>\n      <line x1=\"-3\" y1=\"37.5\" x2=\"0\" y2=\"37.5\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"-20\" y=\"41.5\" class=\"tick-label\" text-anchor=\"middle\">0.3</text>\n      <line x1=\"-3\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"-20\" y=\"4\" class=\"tick-label\" text-anchor=\"middle\">0.4</text>\n      \n      <!-- X-axis ticks and labels -->\n      <line x1=\"0\" y1=\"150\" x2=\"0\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"0\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">0</text>\n      <line x1=\"28.6\" y1=\"150\" x2=\"28.6\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"28.6\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">2</text>\n      <line x1=\"57.1\" y1=\"150\" x2=\"57.1\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"57.1\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">4</text>\n      <line x1=\"85.7\" y1=\"150\" x2=\"85.7\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"85.7\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">6</text>\n      <line x1=\"114.3\" y1=\"150\" x2=\"114.3\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"114.3\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">8</text>\n      <line x1=\"142.9\" y1=\"150\" x2=\"142.9\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"142.9\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">10</text>\n      <line x1=\"171.4\" y1=\"150\" x2=\"171.4\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"171.4\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">12</text>\n      <line x1=\"200\" y1=\"150\" x2=\"200\" y2=\"153\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"200\" y=\"165\" class=\"tick-label\" text-anchor=\"middle\">14</text>\n      \n      <!-- Bars -->\n      <rect class=\"bar\" x=\"0\" y=\"146\" width=\"12\" height=\"4\" fill=\"#cd7f32\" data-z=\"0\" data-p=\"0.002\"/>\n      <rect class=\"bar\" x=\"14.3\" y=\"141\" width=\"12\" height=\"9\" fill=\"#cd7f32\" data-z=\"1\" data-p=\"0.015\"/>\n      <rect class=\"bar\" x=\"28.6\" y=\"126\" width=\"12\" height=\"24\" fill=\"#cd7f32\" data-z=\"2\" data-p=\"0.045\"/>\n      <rect class=\"bar\" x=\"42.9\" y=\"108\" width=\"12\" height=\"42\" fill=\"#cd7f32\" data-z=\"3\" data-p=\"0.089\"/>\n      <rect class=\"bar\" x=\"57.1\" y=\"87\" width=\"12\" height=\"63\" fill=\"#cd7f32\" data-z=\"4\" data-p=\"0.134\"/>\n      <rect class=\"bar\" x=\"71.4\" y=\"69\" width=\"12\" height=\"81\" fill=\"#cd7f32\" data-z=\"5\" data-p=\"0.161\"/>\n      <rect class=\"bar\" x=\"85.7\" y=\"60\" width=\"12\" height=\"90\" fill=\"#cd7f32\" data-z=\"6\" data-p=\"0.161\"/>\n      <rect class=\"bar\" x=\"100\" y=\"66\" width=\"12\" height=\"84\" fill=\"#cd7f32\" data-z=\"7\" data-p=\"0.138\"/>\n      <rect class=\"bar\" x=\"114.3\" y=\"84\" width=\"12\" height=\"66\" fill=\"#cd7f32\" data-z=\"8\" data-p=\"0.103\"/>\n      <rect class=\"bar\" x=\"128.6\" y=\"105\" width=\"12\" height=\"45\" fill=\"#cd7f32\" data-z=\"9\" data-p=\"0.069\"/>\n      <rect class=\"bar\" x=\"142.9\" y=\"123\" width=\"12\" height=\"27\" fill=\"#cd7f32\" data-z=\"10\" data-p=\"0.041\"/>\n      <rect class=\"bar\" x=\"157.1\" y=\"135\" width=\"12\" height=\"15\" fill=\"#cd7f32\" data-z=\"11\" data-p=\"0.023\"/>\n      <rect class=\"bar\" x=\"171.4\" y=\"143\" width=\"12\" height=\"7\" fill=\"#cd7f32\" data-z=\"12\" data-p=\"0.011\"/>\n      \n      <!-- Labels -->\n      <text x=\"100\" y=\"-10\" class=\"annotation\" text-anchor=\"middle\">λ = 6.0</text>\n      <text x=\"100\" y=\"190\" class=\"axis-label\" text-anchor=\"middle\">z</text>\n    </g>\n  </g>\n</svg>\n\n<div class=\"tooltip\" style=\"display:none\"></div>\n<div class=\"popup\" style=\"display:none\"></div>\n\n<script>\ntry {\n  const tooltip = document.querySelector('.tooltip');\n  const popup = document.querySelector('.popup');\n  const bars = document.querySelectorAll('.bar');\n  \n  // Poisson probability function\n  function factorial(n) {\n    if (n <= 1) return 1;\n    return n * factorial(n - 1);\n  }\n  \n  function poisson(k, lambda) {\n    return Math.exp(-lambda) * Math.pow(lambda, k) / factorial(k);\n  }\n  \n  // Hover handlers\n  bars.forEach(bar => {\n    bar.addEventListener('mouseenter', (e) => {\n      const z = parseInt(bar.dataset.z);\n      const p = parseFloat(bar.dataset.p);\n      tooltip.innerHTML = `z = ${z}<br>P(X = ${z}) ≈ ${p.toFixed(3)}`;\n      tooltip.style.display = 'block';\n    });\n    \n    bar.addEventListener('mouseleave', () => {\n      tooltip.style.display = 'none';\n    });\n    \n    bar.addEventListener('mousemove', (e) => {\n      tooltip.style.left = e.clientX + 10 + 'px';\n      tooltip.style.top = e.clientY - 30 + 'px';\n    });\n  });\n  \n  // Click handlers\n  bars.forEach(bar => {\n    bar.addEventListener('click', (e) => {\n      e.stopPropagation();\n      const z = parseInt(bar.dataset.z);\n      const panel = bar.closest('g').querySelector('.annotation').textContent;\n      const lambda = parseFloat(panel.split('=')[1]);\n      const exact = poisson(z, lambda);\n      \n      popup.innerHTML = `<strong>${panel}</strong> — Poisson distribution at z = ${z}: ` +\n                       `P(X = ${z}) = e<sup>−${lambda}</sup> × ${lambda}<sup>${z}</sup> / ${z}! ≈ ${exact.toFixed(4)}`;\n      popup.style.display = 'block';\n    });\n  });\n  \n  // Dismiss popup\n  document.addEventListener('click', (e) => {\n    if (!e.target.classList.contains('bar')) {\n      popup.style.display = 'none';\n    }\n  });\n  \n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      popup.style.display = 'none';\n    }\n  });\n  \n} catch(err) {\n  console.error(err);\n}\n</script>\n</body>\n</html>",
