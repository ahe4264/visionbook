  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\nsvg { display:block; }\n.bar { cursor:pointer; transition:fill 0.2s ease; }\n.bar:hover { fill:#e08840; }\n.axis-label { font:11px sans-serif; fill:#000; }\n.tick-label { font:10px sans-serif; fill:#000; }\n.panel-label { font:11px sans-serif; fill:#000; }\n.annotation { font:11px sans-serif; fill:#000; }\n.tooltip {\n  position:fixed; background:rgba(0,0,0,0.55); color:#fff;\n  font:11px/1.4 sans-serif; padding:5px 8px; border-radius:4px;\n  pointer-events:none; z-index:100; max-width:220px;\n}\n.popup {\n  position:fixed; bottom:0; left:0; right:0;\n  background:rgba(245,245,245,0.95); backdrop-filter:blur(6px);\n  border-top:1px solid rgba(0,0,0,0.1);\n  padding:8px 12px; font:12px/1.5 sans-serif; color:#333; z-index:101;\n}\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 750 250\">\n  <!-- Panel a) -->\n  <g transform=\"translate(8,8)\">\n    <text x=\"0\" y=\"15\" class=\"panel-label\">a)</text>\n    <g transform=\"translate(25,25)\">\n      <!-- Axes -->\n      <line x1=\"0\" y1=\"150\" x2=\"200\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\"/>\n      <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\"/>\n      \n      <!-- Y-axis ticks and labels -->\n      <line x1=\"-3\" y1=\"150\" x2=\"0\" y2=\"150\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"-20\" y=\"154\" class=\"tick-label\" text-anchor=\"middle\">0</text>\n      <line x1=\"-3\" y1=\"112.5\" x2=\"0\" y2=\"112.5\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"-20\" y=\"116.5\" class=\"tick-label\" text-anchor=\"middle\">0.1</text>\n      <line x1=\"-3\" y1=\"75\" x2=\"0\" y2=\"75\" stroke=\"#000\" stroke-width=\"1\"/>\n      <text x=\"-20\" y=\"79\" class=\"tick-label\" text-anchor=\"middle\">0.2</text>\n      <line x1=\"-3\" y1=\"37.5\" x2=\"0\" y2=\"37.5\" stroke=\"#000\" stroke-w