  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nhtml, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#fff; }\n#tooltip { position:fixed; background:rgba(0,0,0,0.55); color:#fff; font:11px/1.4 sans-serif; padding:3px 8px; border-radius:4px; pointer-events:none; z-index:100; white-space:nowrap; display:none; }\n</style>\n</head>\n<body>\n<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 300\" preserveAspectRatio=\"xMidYMid meet\">\n  <defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"5\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#333\"/>\n    </marker>\n  </defs>\n  \n  <!-- Part a) -->\n  <text x=\"30\" y=\"30\" font-size=\"11\" font-family=\"sans-serif\">a)</text>\n  \n  <!-- Input nodes -->\n  <circle cx=\"60\" cy=\"90\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Input 1\"/>\n  <text x=\"60\" y=\"95\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">1</text>\n  \n  <circle cx=\"60\" cy=\"150\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Input x\"/>\n  <text x=\"60\" y=\"155\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">x</text>\n  \n  <!-- Hidden layer nodes -->\n  <circle cx=\"150\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h1\"/>\n  <text x=\"150\" y=\"50\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h¹₁</text>\n  \n  <circle cx=\"150\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h2\"/>\n  <text x=\"150\" y=\"110\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h²₁</text>\n  \n  <circle cx=\"150\" cy=\"180\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h3\"/>\n  <text x=\"150\" y=\"170\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h³₁</text>\n  \n  <!-- Output node -->\n  <circle cx=\"240\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Output y\"/>\n  <text x=\"240\" y=\"125\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">y</text>\n  \n  <!-- Edges for part a) -->\n  <line x1=\"75\" y1=\"90\" x2=\"129\" y2=\"66\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"1\" data-to=\"h1\"/>\n  <line x1=\"75\" y1=\"90\" x2=\"129\" y2=\"120\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"1\" data-to=\"h2\"/>\n  <line x1=\"75\" y1=\"90\" x2=\"129\" y2=\"174\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"1\" data-to=\"h3\"/>\n  \n  <line x1=\"75\" y1=\"150\" x2=\"129\" y2=\"66\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h1\"/>\n  <line x1=\"75\" y1=\"150\" x2=\"129\" y2=\"120\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h2\"/>\n  <line x1=\"75\" y1=\"150\" x2=\"129\" y2=\"174\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h3\"/>\n  \n  <line x1=\"165\" y1=\"60\" x2=\"219\" y2=\"114\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\"/>\n  <line x1=\"165\" y1=\"120\" x2=\"219\" y2=\"120\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\"/>\n  <line x1=\"165\" y1=\"180\" x2=\"219\" y2=\"126\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\"/>\n  \n  <!-- Weights labels -->\n  <text x=\"90\" y=\"70\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">w₁₁</text>\n  <text x=\"90\" y=\"125\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">w₂₁</text>\n  <text x=\"90\" y=\"175\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">w₃₁</text>\n  \n  <text x=\"195\" y=\"85\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">v₁</text>\n  <text x=\"195\" y=\"125\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">v₂</text>\n  <text x=\"195\" y=\"160\" font-size=\"9\" font-family=\"sans-serif\" fill=\"#666\">v₃</text>\n  \n  <!-- Y circle -->\n  <circle cx=\"150\" cy=\"45\" r=\"15\" fill=\"none\" stroke=\"#ff6666\" stroke-width=\"1.5\" stroke-dasharray=\"3,3\"/>\n  <text x=\"150\" y=\"25\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\" fill=\"#ff6666\">Y</text>\n  \n  <!-- Part b) -->\n  <text x=\"330\" y=\"30\" font-size=\"11\" font-family=\"sans-serif\">b)</text>\n  \n  <!-- Input node -->\n  <circle cx=\"360\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Input x\"/>\n  <text x=\"360\" y=\"125\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">x</text>\n  \n  <!-- Hidden layer -->\n  <circle cx=\"450\" cy=\"60\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h1\"/>\n  <text x=\"450\" y=\"65\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h₁</text>\n  \n  <circle cx=\"450\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h2\"/>\n  <text x=\"450\" y=\"125\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h₂</text>\n  \n  <circle cx=\"450\" cy=\"180\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Hidden h3\"/>\n  <text x=\"450\" y=\"185\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">h₃</text>\n  \n  <!-- Output node -->\n  <circle cx=\"540\" cy=\"120\" r=\"15\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\" data-label=\"Output y\"/>\n  <text x=\"540\" y=\"125\" font-size=\"11\" font-family=\"sans-serif\" text-anchor=\"middle\">y</text>\n  \n  <!-- Edges for part b) -->\n  <line x1=\"375\" y1=\"120\" x2=\"429\" y2=\"66\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h1\"/>\n  <line x1=\"375\" y1=\"120\" x2=\"429\" y2=\"120\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h2\"/>\n  <line x1=\"375\" y1=\"120\" x2=\"429\" y2=\"174\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"x\" data-to=\"h3\"/>\n  \n  <line x1=\"465\" y1=\"60\" x2=\"519\" y2=\"114\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h1\" data-to=\"y\"/>\n  <line x1=\"465\" y1=\"120\" x2=\"519\" y2=\"120\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h2\" data-to=\"y\"/>\n  <line x1=\"465\" y1=\"180\" x2=\"519\" y2=\"126\" stroke=\"#333\" stroke-width=\"1.5\" marker-end=\"url(#arr)\" data-from=\"h3\" data-to=\"y\"/>\n</svg>\n\n<div id=\"tooltip\"></div>\n\n<script>\ntry {\n  const svg = document.querySelector('svg');\n  const tooltip = document.getElementById('tooltip');\n  \n  // Tooltip functionality\n  document.addEventListener('mousemove', e => {\n    tooltip.style.left = (e.clientX + 12) + 'px';\n    tooltip.style.top = (e.clientY - 28) + 'px';\n  });\n  \n  // Hover effects\n  const nodes = svg.querySelectorAll('circle[data-label]');\n  const edges = svg.querySelectorAll('line[data-from]');\n  \n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', e => {\n      e.target.style.strokeWidth = '3';\n      tooltip.textContent = e.target.getAttribute('data-label');\n      tooltip.style.display = 'block';\n    });\n    \n    node.addEventListener('mouseleave', e => {\n      e.target.style.strokeWidth = '1.5';\n      tooltip.style.display = 'none';\n    });\n    \n    node.addEventListener('click', e => {\n      const label = e.target.getAttribute('data-label');\n      let body = '';\n      if (label.includes('Input')) {\n        body = 'Input nodes receive the initial data values. In neural networks, these nodes pass the input features to the hidden layer without any transformation.';\n      } else if (label.includes('Hidden')) {\n        body = 'Hidden layer nodes apply weighted sums and activation functions to transform the input. Each hidden node combines inputs from all previous layer nodes to learn complex patterns.';\n      } else if (label.includes('Output')) {\n        body = 'The output node produces the final prediction by combining all hidden layer outputs. It represents the network\\'s computed result for the given input.';\n      }\n      showPopup(label, body);\n    });\n  });\n  \n  edges.forEach(edge => {\n    edge.addEventListener('mouseenter', e => {\n      e.target.style.strokeWidth = '3';\n      const from = e.target.getAttribute('data-from');\n      const to = e.target.getAttribute('data-to');\n      tooltip.textContent = `Connection: ${from} → ${to}`;\n      tooltip.style.display = 'block';\n    });\n    \n    edge.addEventListener('mouseleave', e => {\n      e.target.style.strokeWidth = '1.5';\n      tooltip.style.display = 'none';\n    });\n    \n    edge.addEventListener('click', e => {\n      const from = e.target.getAttribute('data-from');\n      const to = e.target.getAttribute('data-to');\n      showPopup(`Edge: ${from} → ${to}`, 'This connection represents a weighted link in the neural network. The weight determines how strongly the source node influences the target node during forward propagation.');\n    });\n  });\n  \n  // Signal flow animation\n  svg.addEventListener('click', e => {\n    if (e.target === svg || e.target.tagName === 'svg') {\n      hidePopup();\n      // Trigger signal flow animation\n      animateSignalFlow();\n    }\n  });\n  \n  function animateSignalFlow() {\n    // Reset all elements\n    nodes.forEach(n => {\n      n.style.transition = 'fill 0.35s ease';\n      n.style.fill = '#fff';\n    });\n    edges.forEach(e => {\n      e.style.transition = 'stroke 0.35s ease';\n      e.style.stroke = '#333';\n    });\n    \n    // Animate part a) network\n    setTimeout(() => {\n      // Highlight inputs\n      const inputs = svg.querySelectorAll('circle[data-label*=\"Input\"]');\n      inputs.forEach(n => n.style.fill = '#c8e0ff');\n    }, 100);\n    \n    setTimeout(() => {\n      // Highlight edges from inputs\n      const inputEdges = svg.querySelectorAll('line[data-from=\"1\"], line[data-from=\"x\"]');\n      inputEdges.forEach(e => e.style.stroke = '#4a90e2');\n    }, 500);\n    \n    setTimeout(() => {\n      // Highlight hidden nodes\n      const hidden = svg.querySelectorAll('circle[data-label*=\"Hidden\"]');\n      hidden.forEach(n => n.style.fill = '#c8f0c8');\n    }, 900);\n    \n    setTimeout(() => {\n      // Highlight output edges\n      const outputEdges = svg.querySelectorAll('line[data-to=\"y\"]');\n      outputEdges.forEach(e => e.style.stroke = '#5cb85c');\n    }, 1300);\n    \n    setTimeout(() => {\n      // Highlight output\n      const outputs = svg.querySelectorAll('circle[data-label*=\"Output\"]');\n      outputs.forEach(n => n.style.fill = '#ffe0c8');\n    }, 1700);\n    \n    // Reset after animation\n    setTimeout(() => {\n      nodes.forEach(n => n.style.fill = '#fff');\n      edges.forEach(e => e.style.stroke = '#333');\n    }, 2500);\n  }\n  \n  // Popup functions\n  function showPopup(title, body) {\n    window.parent.postMessage({ type: 'alex-popup', title, body }, '*');\n  }\n  \n  function hidePopup() {\n    window.parent.postMessage({ type: 'alex-popup', title: null }, '*');\n  }\n  \n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') hidePopup();\n  });\n  \n} catch(err) {\n  console.error('Error:', err);\n}\n</script>\n</body>\n</html>",
