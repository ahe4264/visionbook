{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item (v2)",
  "description": "Example, exercise, theorem, figure, table, or exercise_group.",
  "type": "object",
  "required": ["id", "kind", "source"],
  "additionalProperties": false,
  "properties": {
    "id":    { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
    "kind":  { "enum": ["example", "exercise", "exercise_group", "theorem", "figure", "table"] },
    "title": { "type": "string", "maxLength": 160 },

    "prompt_md":   { "type": "string", "description": "For exercise/exercise_group/example: the full problem statement, with any enclosing group directive prepended at splice time." },
    "solution_md": { "type": "string" },
    "answer":      { "type": ["string", "null"] },
    "proof_md":    { "type": "string" },
    "caption_md":  { "type": "string", "description": "For figure/table." },

    "difficulty":  { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "skills":      { "type": "array", "items": { "type": "string" } },
    "tags":        { "type": "array", "items": { "type": "string" } },

    "concepts":          { "type": "array", "items": { "type": "string" }, "description": "Concept ids this item tests or illustrates (1-3, populated by link step)." },
    "parent_group_id":   { "type": ["string", "null"], "description": "For sub-exercises that belong to an exercise_group." },
    "sub_item_ids":      { "type": "array", "items": { "type": "string" }, "description": "For exercise_group: IDs of its numbered sub-parts." },
    "embedded_in":       { "type": ["string", "null"], "description": "For figure/table that lives inside another item (example/exercise/proof). null = standalone." },

    "source": {
      "type": "object",
      "required": ["file", "spans"],
      "additionalProperties": false,
      "properties": {
        "file":    { "type": "string" },
        "label":   { "type": "string", "description": "e.g. 'Example 3', 'Theorem 1.2.3', 'Figure 1.1.8'." },
        "section": { "type": "string" },
        "spans": {
          "type": "array",
          "minItems": 1,
          "description": "One or more disjoint line ranges. Single-range is typical; multi-range lets a record include out-of-sequence material that belongs to it (e.g., an exercise plus a figure caption that appears a few lines later).",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "string", "pattern": "^L[0-9]{5}$" },
              "end":   { "type": "string", "pattern": "^L[0-9]{5}$" }
            }
          }
        }
      }
    },

    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter":         { "type": "integer" },
        "chapter_title":   { "type": "string"  },
        "section":         { "type": "string"  },
        "section_title":   { "type": "string"  },
        "section_order":   { "type": "integer" },
        "item_order_in_section": { "type": "integer" },
        "book_order":      { "type": "integer" },
        "first_line":      { "type": "integer" }
      }
    },

    "raw_body": {
      "type": "string",
      "description": "Verbatim text spliced from source.spans. Present during splice + Pass B; moved to items.raw.jsonl (id-keyed) before the final items.jsonl is emitted. Optional in the final file."
    },

    "_provenance": {
      "type": "object",
      "additionalProperties": {
        "enum": ["book_extracted", "book_paraphrased", "llm_inferred"]
      }
    },

    "quality_flags": { "type": "array", "items": { "type": "string" } },

    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pass_a_model":    { "type": "string" },
        "pass_b_model":    { "type": "string" },
        "split_succeeded": { "type": "boolean" },
        "verified":        { "type": "boolean" },
        "best_effort":     { "type": "boolean" }
      }
    }
  }
}
